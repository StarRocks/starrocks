-- name: test_iceberg_v3_dv_expire_snapshots
-- Deletion vectors (Puffin files) through compaction and snapshot expiry on a format-version 3 table. The rewrite
-- applies every DV, including one that deletes a whole data file, and drops them from the table. Expiring the
-- snapshots before the current one must then delete the Puffin and data files only the expired snapshots
-- reference, and keep the DV the current snapshot still reads.

create external catalog iceberg_v3_dv_exp_${uuid0} PROPERTIES ("type"="iceberg",
    "iceberg.catalog.type"="hive",
    "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);

create database iceberg_v3_dv_exp_${uuid0}.db_${uuid0};
set catalog iceberg_v3_dv_exp_${uuid0};
use db_${uuid0};

create table t(
    id int,
    v string,
    p int
) partition by(p) properties ("format-version" = "3", "location" = "oss://${oss_bucket}/v3_dv_exp_${uuid0}/t");

-- four data files: (a, p=0), (a, p=1), (b, p=0), (b, p=1)
insert into t select x, concat('a', x), x % 2 from table(generate_series(1, 20)) s(x);
insert into t select x, concat('b', x), x % 2 from table(generate_series(21, 40)) s(x);

-- partial DVs on both 'a' files, and a DV deleting every row of the (b, p=0) file. The predicate on v cannot be
-- answered from file bounds, so it writes a DV instead of dropping the file.
delete from t where id in (1, 2, 3);
delete from t where v like 'b%' and p = 0;

-- expected: 27 504, and three DVs
select count(*), sum(id) from t;
select content, upper(file_format), record_count from t$files where content != 0 order by record_count;
shell: ossutil64 ls oss://${oss_bucket}/v3_dv_exp_${uuid0}/t/data/ | grep -c 'puffin$'

[UC]alter table t execute rewrite_data_files("rewrite_all" = "true");

-- expected: 27 504; one data file per partition and no delete file
select count(*), sum(id) from t;
select content, record_count from t$files order by content, record_count;

-- a new DV the current snapshot reads
insert into t values (100, 'c100', 0);
delete from t where id = 5;

-- a far-future bound: Iceberg never expires the current snapshot, and now() (whole seconds) can keep a snapshot
-- committed in the same second
alter table t execute expire_snapshots(older_than = '2099-01-01 00:00:00');

-- expected: one snapshot, 27 599
select count(*) from t$snapshots;
select count(*), sum(id) from t;
-- expected: only the live DV and the three live data files are left
select content, upper(file_format), record_count from t$files order by content, record_count;
shell: ossutil64 ls oss://${oss_bucket}/v3_dv_exp_${uuid0}/t/data/ | grep -c 'puffin$'
shell: ossutil64 ls oss://${oss_bucket}/v3_dv_exp_${uuid0}/t/data/ | grep -c 'parquet$'

drop table t force;
drop database db_${uuid0};
set catalog default_catalog;
drop catalog iceberg_v3_dv_exp_${uuid0};

shell: ossutil64 rm -rf oss://${oss_bucket}/v3_dv_exp_${uuid0} >/dev/null || echo "exit 0" >/dev/null
