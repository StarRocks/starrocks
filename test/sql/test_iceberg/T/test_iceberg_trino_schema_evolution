-- name: test_iceberg_trino_initial_default_time_types
-- Trino writes the rows before the columns are added; StarRocks fills the initial-defaults when reading them, and
-- predicates on those columns see the defaults.
trino: CREATE SCHEMA iceberg.sqltest_db_${uuid0} WITH (location = 'oss://${oss_bucket}/sqltest_db_${uuid0}.db');
trino: CREATE TABLE iceberg.sqltest_db_${uuid0}.t (id integer) WITH (format = 'PARQUET', format_version = 3);
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (1), (2);
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN c integer DEFAULT 7;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN tm time(6) DEFAULT TIME '01:02:03';
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN tz timestamp(6) with time zone DEFAULT TIMESTAMP '2024-01-01 00:00:01 UTC';
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (3, 8, TIME '04:05:06', TIMESTAMP '2024-07-01 12:00:00 UTC');
create external catalog ice_cat_${uuid0} properties ("type" = "iceberg", "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);
set time_zone = 'UTC';
select id, c, tm, tz from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where c = 7 order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where tz = '2024-01-01 00:00:01' order by id;
set time_zone = 'Asia/Shanghai';
select id, tm, tz from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where tz = '2024-01-01 08:00:01' order by id;
set time_zone = 'UTC';
drop catalog ice_cat_${uuid0};
trino: DROP TABLE iceberg.sqltest_db_${uuid0}.t;
trino: DROP SCHEMA iceberg.sqltest_db_${uuid0};

-- name: test_iceberg_trino_orc_schema_evolution
-- ORC columns resolve by Iceberg field id: renamed columns keep their data, a dropped and re-added column does not
-- read the old data, and a struct subfield added after the file was written reads NULL instead of failing.
trino: CREATE SCHEMA iceberg.sqltest_db_${uuid0} WITH (location = 'oss://${oss_bucket}/sqltest_db_${uuid0}.db');
trino: CREATE TABLE iceberg.sqltest_db_${uuid0}.t (id integer, c1 varchar, s row(a integer), d integer) WITH (format = 'ORC');
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (1, 'x', row(100), 10), (2, 'y', NULL, 20);
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t RENAME COLUMN c1 TO c1_new;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t RENAME COLUMN s.a TO a_new;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t DROP COLUMN d;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN d integer;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN s.b integer;
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (3, 'z', row(300, 3000), 30);
create external catalog ice_cat_${uuid0} properties ("type" = "iceberg", "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);
select id, c1_new, d, s from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id, s.a_new, s.b from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id, s.b from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where s.b is null order by id;
drop catalog ice_cat_${uuid0};
trino: DROP TABLE iceberg.sqltest_db_${uuid0}.t;
trino: DROP SCHEMA iceberg.sqltest_db_${uuid0};

-- name: test_iceberg_trino_parquet_only_added_subfields
-- Only subfields added after the parquet file was written are used: the struct keeps its own nulls.
trino: CREATE SCHEMA iceberg.sqltest_db_${uuid0} WITH (location = 'oss://${oss_bucket}/sqltest_db_${uuid0}.db');
trino: CREATE TABLE iceberg.sqltest_db_${uuid0}.t (id integer, s row(name varchar, a integer), l array(row(a integer))) WITH (format = 'PARQUET');
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (1, row('n1', 10), array[row(1), NULL]), (2, NULL, NULL);
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN s.b integer;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN l.element.b integer;
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (3, row('n3', 30, 300), array[row(3, 33)]);
create external catalog ice_cat_${uuid0} properties ("type" = "iceberg", "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);
select id, s, l from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id, s.b from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id, array_map(x -> x.b, l) from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where s.b is null order by id;
drop catalog ice_cat_${uuid0};
trino: DROP TABLE iceberg.sqltest_db_${uuid0}.t;
trino: DROP SCHEMA iceberg.sqltest_db_${uuid0};

-- name: test_iceberg_trino_parquet_nested_and_string_defaults
-- PARQUET: a subfield added to a struct nested in a struct, empty-string and binary initial-defaults, and a filter on a
-- default column read in several chunks.
trino: CREATE SCHEMA iceberg.sqltest_db_${uuid0} WITH (location = 'oss://${oss_bucket}/sqltest_db_${uuid0}.db');
trino: CREATE TABLE iceberg.sqltest_db_${uuid0}.t (id integer, n row(t row(a integer), x integer)) WITH (format = 'PARQUET', format_version = 3);
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (1, row(row(10), 100)), (2, NULL), (3, row(NULL, 300)), (4, row(row(40), 400)), (5, row(row(50), 500));
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN n.t.b integer;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN c integer DEFAULT 7;
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN e varchar DEFAULT '';
trino: ALTER TABLE iceberg.sqltest_db_${uuid0}.t ADD COLUMN bin varbinary DEFAULT X'616263';
trino: INSERT INTO iceberg.sqltest_db_${uuid0}.t VALUES (6, row(row(60, 600), 6), 8, 'z', X'00ff');
create external catalog ice_cat_${uuid0} properties ("type" = "iceberg", "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);
select id, n, c, e, hex(bin) from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id, n.t.b from ice_cat_${uuid0}.sqltest_db_${uuid0}.t order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where n.t is null order by id;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where e = '' order by id;
set chunk_size = 2;
select id from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where c = 7 order by id;
select count(*), max(c), min(c) from ice_cat_${uuid0}.sqltest_db_${uuid0}.t where c >= 7;
set chunk_size = 4096;
drop catalog ice_cat_${uuid0};
trino: DROP TABLE iceberg.sqltest_db_${uuid0}.t;
trino: DROP SCHEMA iceberg.sqltest_db_${uuid0};

