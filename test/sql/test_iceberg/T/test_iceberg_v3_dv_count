-- name: test_iceberg_v3_dv_count
-- COUNT(*) on a format-version 3 table answers a data file whose only delete is a deletion vector (DV) from
-- metadata: the file's record_count minus the DV's cardinality, without opening the file. A data file whose
-- DV deletes every row is not scanned at all, so it contributes no group.

create external catalog iceberg_v3_dv_count_${uuid0} PROPERTIES ("type"="iceberg",
    "iceberg.catalog.type"="hive",
    "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);

create database iceberg_v3_dv_count_${uuid0}.db_${uuid0} properties (
    "location" = "oss://${oss_bucket}/test_iceberg_v3_dv_count/${uuid0}/db_${uuid0}"
);
set catalog iceberg_v3_dv_count_${uuid0};
use db_${uuid0};

create table t(
    id int,
    v string,
    p string
) partition by(p) properties ("format-version" = "3");

-- one data file per partition
insert into t values (1, 'a1', 'a'), (2, 'a2', 'a'), (3, 'a3', 'a'), (4, 'a4', 'a');
insert into t values (1, 'b1', 'b'), (2, 'b2', 'b'), (3, 'b3', 'b');
insert into t values (1, 'c1', 'c'), (2, 'c2', 'c');

-- p=a and p=b each get a DV that leaves rows; p=c gets a DV that deletes the whole file
delete from t where v in ('a1', 'a3', 'b2', 'c1', 'c2');

-- expected: (1, PUFFIN, 1), (1, PUFFIN, 2), (1, PUFFIN, 2)
select content, upper(file_format), record_count from t$files where content != 0 order by content, record_count;

-- expected: 4
select count(*) from t;
-- expected: (a, 2), (b, 2); no group for p=c
select p, count(*) from t group by p order by p;
-- expected: 2
select count(*) from t where p = 'b';

set enable_profile = true;
set enable_async_profile = false;
set pipeline_dop = 1;

-- the p=a and p=b files are counted from metadata: no DV is loaded and no row is read. expected: 1, 1
select count(*) from t where p in ('a', 'b');
select cast(regexp_extract(get_query_profile(last_query_id()), 'RawRowsRead: ([0-9]+)', 1) as bigint) = 0,
    ifnull(cast(regexp_extract(get_query_profile(last_query_id()), 'IcebergDVBuildCount: ([0-9]+)', 1) as bigint), 0) = 0;

-- the fully deleted p=c file is not scanned at all: no scan range, no DV. expected: 0, then 1, 1
select count(*) from t where p = 'c';
select ifnull(cast(regexp_extract(get_query_profile(last_query_id()), 'ScanRanges: ([0-9]+)', 1) as bigint), 0) = 0,
    ifnull(cast(regexp_extract(get_query_profile(last_query_id()), 'IcebergDVBuildCount: ([0-9]+)', 1) as bigint), 0) = 0;

-- control: a predicate on a data column keeps the read path, which loads the DVs of the p=a and p=b files
-- (their id ranges, deleted rows included, both pass id > 2, so no file is pruned). expected: 2 (a4, b3), then 1
select count(*) from t where id > 2;
select cast(regexp_extract(get_query_profile(last_query_id()), 'IcebergDVBuildCount: ([0-9]+)', 1) as bigint) = 2;

set enable_profile = false;

drop table t force;
drop database db_${uuid0};
drop catalog iceberg_v3_dv_count_${uuid0};
