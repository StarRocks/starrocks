-- name: test_iceberg_rollback_to_timestamp_and_set_current_snapshot
create external catalog iceberg_sql_test_${uuid0} PROPERTIES ("type"="iceberg", "iceberg.catalog.type"="hive", "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}","enable_iceberg_metadata_cache"="true","aws.s3.access_key" = "${oss_ak}","aws.s3.secret_key" = "${oss_sk}","aws.s3.endpoint" = "${oss_endpoint}");
create database iceberg_sql_test_${uuid0}.iceberg_db_${uuid0};
create table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1(k1 int);

insert into iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 select 1;
shell: sleep 1
insert into iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 select 2;
shell: sleep 1
insert into iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 select 3;
[UC]T2=SELECT committed_at FROM iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1$snapshots ORDER BY committed_at LIMIT 1, 1;
[UC]S3=SELECT snapshot_id FROM iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1$snapshots ORDER BY committed_at DESC LIMIT 1;

-- the latest snapshot committed strictly before the second one is the first one
alter table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 execute rollback_to_timestamp(timestamp = '${T2}');
select k1 from iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 order by k1;

-- the third snapshot is no longer an ancestor of the current one, set_current_snapshot still moves to it
alter table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 execute set_current_snapshot(snapshot_id = ${S3});
select k1 from iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 order by k1;

-- positional arguments
alter table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 execute rollback_to_timestamp('${T2}');
select k1 from iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 order by k1;
alter table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 execute set_current_snapshot(${S3});
select k1 from iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 order by k1;

drop table iceberg_sql_test_${uuid0}.iceberg_db_${uuid0}.t1 force;
drop database iceberg_sql_test_${uuid0}.iceberg_db_${uuid0};
drop catalog iceberg_sql_test_${uuid0};
