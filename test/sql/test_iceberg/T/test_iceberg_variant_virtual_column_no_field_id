-- name: test_iceberg_variant_virtual_column_no_field_id
-- get_variant_*(v, path) is rewritten to a virtual column read from v. A data file without field ids (add_files of a
-- file not written by Iceberg) must still bind it to v: every query runs with and without the rewrite.

create external catalog iceberg_variant_no_field_id_${uuid0}
PROPERTIES (
    "type"="iceberg",
    "iceberg.catalog.type"="hadoop",
    "iceberg.catalog.warehouse"="oss://${oss_bucket}/test_iceberg_variant_virtual_column_no_field_id/${uuid0}/warehouse/"
);

shell: ossutil64 mkdir oss://${oss_bucket}/test_iceberg_variant_virtual_column_no_field_id/${uuid0}/warehouse/db_${uuid0} > /dev/null

use iceberg_variant_no_field_id_${uuid0}.db_${uuid0};

CREATE TABLE t_nested (id BIGINT, data VARIANT) properties('format-version' = '3');
shell: ossutil64 cp ../be/test/formats/parquet/test_data/variant_shredding_nested_residual.parquet oss://${oss_bucket}/test_iceberg_variant_virtual_column_no_field_id/${uuid0}/data/nested.parquet > /dev/null
alter table t_nested execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_virtual_column_no_field_id/${uuid0}/data/nested.parquet', file_format='parquet');

set cbo_variant_path_rewrite = true;
function: assert_explain_verbose_contains("select get_variant_string(data, '$.kind') from t_nested", "ExtendedColumnAccessPath")
select id, get_variant_string(data, '$.kind'), get_variant_string(data, '$.commit.collection') from t_nested order by id;
select count(*) from t_nested where get_variant_string(data, '$.kind') = 'commit';
select id, data, get_variant_string(data, '$.kind') from t_nested order by id;

set cbo_variant_path_rewrite = false;
function: assert_explain_not_contains("select get_variant_string(data, '$.kind') from t_nested", "ExtendedColumnAccessPath")
select id, get_variant_string(data, '$.kind'), get_variant_string(data, '$.commit.collection') from t_nested order by id;
select count(*) from t_nested where get_variant_string(data, '$.kind') = 'commit';
select id, data, get_variant_string(data, '$.kind') from t_nested order by id;

set cbo_variant_path_rewrite = true;
drop table t_nested force;
drop database db_${uuid0};
drop catalog iceberg_variant_no_field_id_${uuid0};
shell: ossutil64 rm -rf oss://${oss_bucket}/test_iceberg_variant_virtual_column_no_field_id/${uuid0}/ > /dev/null
