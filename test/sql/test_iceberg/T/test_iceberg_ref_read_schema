-- name: test_iceberg_ref_read_schema
-- A branch is read with the table's current schema; a tag with the schema of its snapshot. Time travel to a
-- snapshot from before an equality key was renamed resolves the key by field id under the snapshot schema.

create external catalog iceberg_ref_schema_${uuid0} PROPERTIES ("type"="iceberg",
    "iceberg.catalog.type"="hive",
    "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);

create database iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0} properties (
    "location" = "oss://${oss_bucket}/ref_schema_db_${uuid0}/db"
);

-- branch vs tag after a rename and a column dropped and re-added under the same name
create table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref(
    id int,
    a string,
    b int
) properties ("format-version" = "2");

insert into iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref values (1, 'x', 10), (2, 'y', 20);
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref create branch br1;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref create tag tg1;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref drop column b;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref add column b int;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref rename column a to a2;
insert into iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref values (3, 'z', 30);

select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref for version as of 'br1' order by id;
select a2, b from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref for version as of 'br1' where b is null order by a2;
select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref for version as of 'tg1' order by id;
select a, b from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref for version as of 'tg1' where b = 20;
select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref order by id;

-- equality deletes on a key renamed after the tag and the branch
create table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq(
    id int,
    v string
) properties ("format-version" = "2");

insert into iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq values (1, 'a'), (2, 'b'), (3, 'c');

-- the delete file is written by an iceberg table whose id has the same field id (1), so the key is matched by field
-- id after the rename
create table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq_deletes(
    id int
) properties ("format-version" = "2", "location" = "oss://${oss_bucket}/ref_schema_db_${uuid0}/t_eq_deletes");

insert into iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq_deletes values (2);

alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq execute add_equality_delete_files(location="oss://${oss_bucket}/ref_schema_db_${uuid0}/t_eq_deletes/data", file_format="parquet", equality_columns="id");
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq create tag before_rename;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq create branch br_before_rename;
alter table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq rename column id to id2;
insert into iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq values (4, 'd');

select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq for version as of 'before_rename' order by id;
select count(*) from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq for version as of 'before_rename';
select v from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq for version as of 'before_rename' where id >= 2 order by v;
select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq for version as of 'br_before_rename' order by id2;
select * from iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq order by id2;

drop table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_ref force;
drop table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq force;
drop table iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0}.t_eq_deletes force;
drop database iceberg_ref_schema_${uuid0}.ref_schema_db_${uuid0};
drop catalog iceberg_ref_schema_${uuid0};
shell: ossutil64 rm -rf oss://${oss_bucket}/ref_schema_db_${uuid0} >/dev/null || echo "exit 0" >/dev/null
