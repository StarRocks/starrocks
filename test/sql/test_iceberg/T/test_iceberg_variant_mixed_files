-- name: test_iceberg_variant_mixed_files
-- One table holding shredded files (Spark and Iceberg Java API) and unshredded files must answer like an
-- all-unshredded table. Files: be/test/formats/parquet/test_data/variant_spark/ (see README.md there).
create external catalog iceberg_variant_mixed_${uuid0}
PROPERTIES (
    "type"="iceberg",
    "iceberg.catalog.type"="hadoop",
    "iceberg.catalog.warehouse"="oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/warehouse/"
);
shell: ossutil64 mkdir oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/warehouse/db > /dev/null
shell: ossutil64 cp -r ../be/test/formats/parquet/test_data/variant_spark/ oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/ --include "*.parquet" > /dev/null

use iceberg_variant_mixed_${uuid0}.db;
set time_zone = 'Asia/Shanghai';

create table mixed (id int, v variant) properties ('format-version' = '3');
create table plain (id int, v variant) properties ('format-version' = '3');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/shred_01_typed.parquet', file_format='parquet');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_02_conflict.parquet', file_format='parquet');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/api_shred_03_nulls.parquet', file_format='parquet');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_04_scalars.parquet', file_format='parquet');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/shred_05_inference.parquet', file_format='parquet');
alter table mixed execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_06_top_int.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_01_typed.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_02_conflict.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_03_nulls.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_04_scalars.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_05_inference.parquet', file_format='parquet');
alter table plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/data/noshred_06_top_int.parquet', file_format='parquet');

select count(*), count(v), min(id), max(id) from mixed;
function: assert_equal_result("select id, cast(v as string) from mixed order by id", "select id, cast(v as string) from plain order by id")
function: assert_equal_result("select id, cast(variant_query(v, '$.i') as string), cast(variant_query(v, '$.s') as string), cast(variant_query(v, '$.o.z.w') as string), cast(variant_query(v, '$.arr[1]') as string), cast(variant_query(v, '$.ao[0].k') as string), cast(variant_query(v, '$.x') as string) from mixed order by id", "select id, cast(variant_query(v, '$.i') as string), cast(variant_query(v, '$.s') as string), cast(variant_query(v, '$.o.z.w') as string), cast(variant_query(v, '$.arr[1]') as string), cast(variant_query(v, '$.ao[0].k') as string), cast(variant_query(v, '$.x') as string) from plain order by id")
function: assert_equal_result("select id, get_variant_int(v, '$.i'), get_variant_string(v, '$.s'), get_variant_double(v, '$.dec'), get_variant_datetime(v, '$.t'), get_variant_int(v, '$') from mixed order by id", "select id, get_variant_int(v, '$.i'), get_variant_string(v, '$.s'), get_variant_double(v, '$.dec'), get_variant_datetime(v, '$.t'), get_variant_int(v, '$') from plain order by id")
function: assert_equal_result("select id from mixed where get_variant_int(v, '$.i') between 5 and 160 order by id", "select id from plain where get_variant_int(v, '$.i') between 5 and 160 order by id")
function: assert_equal_result("select id from mixed where get_variant_string(v, '$.s') in ('alpha', 'r150', 'ten') order by id", "select id from plain where get_variant_string(v, '$.s') in ('alpha', 'r150', 'ten') order by id")
function: assert_equal_result("select id from mixed where variant_query(v, '$.i') is null order by id", "select id from plain where variant_query(v, '$.i') is null order by id")
function: assert_equal_result("select variant_typeof(variant_query(v, '$.i')), count(*), sum(get_variant_int(v, '$.i')) from mixed group by 1 order by 1", "select variant_typeof(variant_query(v, '$.i')), count(*), sum(get_variant_int(v, '$.i')) from plain group by 1 order by 1")
select variant_typeof(variant_query(v, '$.i')), count(*), sum(get_variant_int(v, '$.i')) from mixed group by 1 order by 1;

drop table mixed force;
drop table plain force;
drop catalog iceberg_variant_mixed_${uuid0};
shell: ossutil64 rm -rf oss://${oss_bucket}/test_iceberg_variant_mixed_files/${uuid0}/ > /dev/null

-- name: test_iceberg_variant_schema_evolution
-- The shredded layout of `$.a` differs in every file (int8, int64 above 2^53, double, array<int16>, string,
-- object, unshredded), and `b`/`c` come and go or change type. Sorting and grouping merge chunks of different
-- files, whose shredded columns must be reconciled without losing rows or values.
create external catalog iceberg_variant_evo_${uuid0}
PROPERTIES (
    "type"="iceberg",
    "iceberg.catalog.type"="hadoop",
    "iceberg.catalog.warehouse"="oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/warehouse/"
);
shell: ossutil64 mkdir oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/warehouse/db > /dev/null
shell: ossutil64 cp -r ../be/test/formats/parquet/test_data/variant_spark/ oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/ --include "evo_*.parquet" > /dev/null

use iceberg_variant_evo_${uuid0}.db;
set time_zone = 'Asia/Shanghai';

create table evo (id int, v variant) properties ('format-version' = '3');
create table evo_plain (id int, v variant) properties ('format-version' = '3');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e1_int.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e2_bigint.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e3_double.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e4_array.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e5_string.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e6_object.parquet', file_format='parquet');
alter table evo execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_e7_mixed.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e1_int.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e2_bigint.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e3_double.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e4_array.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e5_string.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e6_object.parquet', file_format='parquet');
alter table evo_plain execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/data/evo_noshred_e7_mixed.parquet', file_format='parquet');

select count(*), count(v), count(distinct id) from evo;
-- One row per file; values above 2^53 must come back exactly.
select id, cast(v as string), cast(variant_query(v, '$.a') as string), variant_typeof(variant_query(v, '$.a')),
       get_variant_int(v, '$.a'), get_variant_double(v, '$.a'), get_variant_string(v, '$.b'), get_variant_double(v, '$.c'),
       get_variant_int(v, '$.a.x'), get_variant_int(v, '$.a[1]')
from evo where id in (1000, 2000, 2099, 3000, 4000, 5000, 6000, 7000, 7001, 7002) order by id;
select variant_typeof(variant_query(v, '$.a')), count(*), min(id), max(id) from evo group by 1 order by 1;
select variant_typeof(variant_query(v, '$.b')), count(*) from evo group by 1 order by 1;
select sum(get_variant_int(v, '$.a')), count(get_variant_int(v, '$.a')), cast(max(get_variant_int(v, '$.a')) as string) from evo;

function: assert_equal_result("select id, cast(v as string) from evo order by id", "select id, cast(v as string) from evo_plain order by id")
function: assert_equal_result("select id, cast(variant_query(v, '$.a') as string), cast(variant_query(v, '$.b') as string), cast(variant_query(v, '$.c') as string), cast(variant_query(v, '$.a.x') as string), cast(variant_query(v, '$.a[1]') as string) from evo order by id", "select id, cast(variant_query(v, '$.a') as string), cast(variant_query(v, '$.b') as string), cast(variant_query(v, '$.c') as string), cast(variant_query(v, '$.a.x') as string), cast(variant_query(v, '$.a[1]') as string) from evo_plain order by id")
function: assert_equal_result("select id, get_variant_int(v, '$.a'), get_variant_double(v, '$.a'), get_variant_string(v, '$.a'), get_variant_string(v, '$.b'), get_variant_int(v, '$.b'), get_variant_double(v, '$.c') from evo order by id", "select id, get_variant_int(v, '$.a'), get_variant_double(v, '$.a'), get_variant_string(v, '$.a'), get_variant_string(v, '$.b'), get_variant_int(v, '$.b'), get_variant_double(v, '$.c') from evo_plain order by id")
function: assert_equal_result("select variant_typeof(variant_query(v, '$.a')), count(*), sum(get_variant_int(v, '$.a')) from evo group by 1 order by 1", "select variant_typeof(variant_query(v, '$.a')), count(*), sum(get_variant_int(v, '$.a')) from evo_plain group by 1 order by 1")
function: assert_equal_result("select id from evo where get_variant_int(v, '$.a') > 50 order by id", "select id from evo_plain where get_variant_int(v, '$.a') > 50 order by id")
function: assert_equal_result("select id from evo where get_variant_double(v, '$.a') between 3010 and 3020 order by id", "select id from evo_plain where get_variant_double(v, '$.a') between 3010 and 3020 order by id")
function: assert_equal_result("select id from evo where get_variant_string(v, '$.a') in ('a5001', 'a7001') order by id", "select id from evo_plain where get_variant_string(v, '$.a') in ('a5001', 'a7001') order by id")
-- Rows of all files in one chunk, read in an order that interleaves the files.
function: assert_equal_result("select id, cast(v as string) from evo order by id % 7, id", "select id, cast(v as string) from evo_plain order by id % 7, id")
function: assert_equal_result("select * from (select id, v from evo union all select id, v from evo_plain) t order by id, cast(v as string)", "select * from (select id, v from evo_plain union all select id, v from evo_plain) t order by id, cast(v as string)")

drop table evo force;
drop table evo_plain force;
drop catalog iceberg_variant_evo_${uuid0};
shell: ossutil64 rm -rf oss://${oss_bucket}/test_iceberg_variant_schema_evolution/${uuid0}/ > /dev/null

-- name: test_iceberg_variant_shredded_pruning
-- prune_rowgroups.parquet: ids 0-2999 sorted, 6 row groups, pages of 100 rows; v = {n: id, s: 's'+6 digits,
-- m: id unless id % 10 = 0, g: id / 1000}. Predicates on shredded paths, which may skip row groups by their
-- statistics, must still return every matching row.
create external catalog iceberg_variant_prune_${uuid0}
PROPERTIES (
    "type"="iceberg",
    "iceberg.catalog.type"="hadoop",
    "iceberg.catalog.warehouse"="oss://${oss_bucket}/test_iceberg_variant_shredded_pruning/${uuid0}/warehouse/"
);
shell: ossutil64 mkdir oss://${oss_bucket}/test_iceberg_variant_shredded_pruning/${uuid0}/warehouse/db > /dev/null
shell: ossutil64 cp ../be/test/formats/parquet/test_data/variant_spark/prune_rowgroups.parquet oss://${oss_bucket}/test_iceberg_variant_shredded_pruning/${uuid0}/data/prune_rowgroups.parquet > /dev/null

use iceberg_variant_prune_${uuid0}.db;
create table prune (id int, v variant) properties ('format-version' = '3');
alter table prune execute add_files(location='oss://${oss_bucket}/test_iceberg_variant_shredded_pruning/${uuid0}/data/prune_rowgroups.parquet', file_format='parquet');

-- Predicates on a shredded string path (row group statistics apply) and on an integer path.
select count(*), min(id), max(id) from prune where get_variant_string(v, '$.s') = 's001234';
select count(*), min(id), max(id) from prune where get_variant_string(v, '$.s') >= 's002900';
select count(*), min(id), max(id) from prune where get_variant_string(v, '$.s') in ('s000005', 's000010');
select count(*), min(id), max(id) from prune where get_variant_string(v, '$.s') like 's0029%';

select count(*), sum(get_variant_int(v, '$.n')) from prune where get_variant_int(v, '$.n') = 1234;
select count(*), sum(get_variant_int(v, '$.n')) from prune where get_variant_int(v, '$.n') in (5, 2990);
select count(*), min(id), max(id) from prune where get_variant_int(v, '$.n') between 1200 and 1210;

-- IS NULL / IS NOT NULL on a path that is missing in every tenth row.
select count(*), sum(id) from prune where variant_query(v, '$.m') is null;
select count(*), sum(id) from prune where variant_query(v, '$.m') is not null and get_variant_int(v, '$.g') = 2;
select count(*) from prune where get_variant_int(v, '$.n') in (1, 2, 3) or get_variant_string(v, '$.s') like 's0029%';

drop table prune force;
drop catalog iceberg_variant_prune_${uuid0};
shell: ossutil64 rm -rf oss://${oss_bucket}/test_iceberg_variant_shredded_pruning/${uuid0}/ > /dev/null
