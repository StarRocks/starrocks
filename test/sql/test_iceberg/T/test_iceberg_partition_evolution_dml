-- name: test_iceberg_partition_evolution_dml
-- DML on rows of files written under an older partition spec, then a dynamic INSERT OVERWRITE that replaces one
-- partition of the current spec: deleted rows never come back, and the overwrite keeps the deletes of older-spec
-- files. Format v3 supports DELETE only. An INSERT whose partition values are constants stays dynamic under
-- non-identity transforms.

create external catalog iceberg_evo_dml_${uuid0} PROPERTIES ("type"="iceberg",
    "iceberg.catalog.type"="hive",
    "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}",
    "aws.s3.endpoint" = "${oss_endpoint}"
);

create database iceberg_evo_dml_${uuid0}.evo_dml_db_${uuid0} properties (
    "location" = "oss://${oss_bucket}/evo_dml_db_${uuid0}"
);
use iceberg_evo_dml_${uuid0}.evo_dml_db_${uuid0};

-- format v2, identity(p) -> bucket(id)
create table v2_bkt(id int, v string, ts datetime, p string) partition by (p) properties ("format-version" = "2");
insert into v2_bkt values (1, 's0', '2026-01-01 10:00:00', 'a'), (2, 's0', '2026-01-01 10:00:00', 'a'), (3, 's0', '2026-01-02 10:00:00', 'b'), (4, 's0', '2026-01-02 10:00:00', 'b');
alter table v2_bkt drop partition column p;
alter table v2_bkt add partition column bucket(id, 4);
insert into v2_bkt values (11, 's1', '2026-01-01 10:00:00', 'a'), (12, 's1', '2026-01-02 10:00:00', 'b');
delete from v2_bkt where id = 1;
update v2_bkt set v = 'u' where id = 2;
merge into v2_bkt t using (select 3 as id, 'm' as v union all select 100, 'm') s on t.id = s.id when matched then update set v = s.v when not matched then insert values (s.id, s.v, '2026-01-03 10:00:00', 'c');
insert overwrite v2_bkt select 21, 'ow', cast('2026-01-01 10:00:00' as datetime), 'a';
select id, v, p from v2_bkt order by id;

