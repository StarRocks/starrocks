-- name: test_iceberg_metadata_column_predicate

create external catalog iceberg_sql_test_${uuid0} PROPERTIES ("type"="iceberg", "iceberg.catalog.type"="hive", "iceberg.catalog.hive.metastore.uris"="${iceberg_catalog_hive_metastore_uris}","enable_iceberg_metadata_cache"="true");

create database iceberg_sql_test_${uuid0}.iceberg_db_${uuid0} properties ("location" = "oss://${oss_bucket}/test_iceberg_metadata_column_predicate/${uuid0}/iceberg_db_${uuid0}");
set catalog iceberg_sql_test_${uuid0};
use iceberg_sql_test_${uuid0}.iceberg_db_${uuid0};

-- Predicates on `_file` must be applied by the scan, both with and without the count optimization.
create table t1 (c1 int, c2 string);
insert into t1 values (1, 'a'), (2, 'b'), (3, 'c');
insert into t1 values (4, 'd'), (5, 'e');

select count(*) from t1 where _file = 'nonexistent';
select c1 from t1 where _file = 'nonexistent' order by c1;
select count(*) from t1 where _file is null;
select count(*) from t1 where _file like '%.parquet';
select c1 from t1 where _file not like '%.parquet' order by c1;
select count(*) from t1 where _file = 'nonexistent' or c1 = 1;
select count(distinct _file) from t1 where _file like '%.parquet';

-- Partitioned table: the identity partition predicate and the `_file` predicate both apply.
create table t2 (c1 int, p int) partition by (p);
insert into t2 values (1, 1), (2, 1), (3, 2);
insert into t2 values (4, 2), (5, 3);

select count(*) from t2 where _file = 'nonexistent';
select count(*) from t2 where _file = 'nonexistent' and p = 1;
select count(*) from t2 where _file like '%.parquet' and p = 2;
select c1 from t2 where _file like '%.parquet' and c1 > 2 order by c1;

-- DELETE with a `_file` predicate must not delete rows of other files.
delete from t1 where _file = 'nonexistent';
select count(*) from t1;
delete from t2 where _file = 'nonexistent' and p = 1;
select count(*) from t2;

drop table t1 force;
drop table t2 force;
drop database iceberg_sql_test_${uuid0}.iceberg_db_${uuid0};
set catalog default_catalog;
drop catalog iceberg_sql_test_${uuid0};
