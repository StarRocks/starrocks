-- name: test_first_last_value_reverse
CREATE TABLE t_rev_dec (
    id INT,
    grp INT,
    kind INT,
    amt DECIMAL(38, 10)
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 4
PROPERTIES ("replication_num" = "1");
-- result:
-- !result
INSERT INTO t_rev_dec VALUES
    (1, 1, 1, 1.5), (2, 1, 14, 2.25), (3, 1, 1, 3.125), (4, 1, 14, 4.0625), (5, 1, 1, 5),
    (6, 2, 14, -6.5), (7, 2, 1, 7), (8, 2, 1, NULL);
-- result:
-- !result
SELECT id, FIRST_VALUE(CASE WHEN kind = 14 THEN amt END IGNORE NULLS)
    OVER (PARTITION BY grp ORDER BY id ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS v
FROM t_rev_dec ORDER BY id;
-- result:
1	2.2500000000
2	2.2500000000
3	4.0625000000
4	4.0625000000
5	None
6	-6.5000000000
7	None
8	None
-- !result
SELECT grp, group_concat(concat(id, '=', ifnull(CAST(v AS STRING), 'N')) ORDER BY id)
FROM (SELECT id, grp, FIRST_VALUE(CASE WHEN kind = 14 THEN amt END IGNORE NULLS)
          OVER (PARTITION BY grp ORDER BY id ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS v
      FROM t_rev_dec) x
GROUP BY grp ORDER BY grp;
-- result:
1	1=2.2500000000,2=2.2500000000,3=4.0625000000,4=4.0625000000,5=N
2	6=-6.5000000000,7=N,8=N
-- !result
SELECT id, LAST_VALUE(amt IGNORE NULLS)
    OVER (PARTITION BY grp ORDER BY id ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS v
FROM t_rev_dec ORDER BY id;
-- result:
1	5.0000000000
2	5.0000000000
3	5.0000000000
4	5.0000000000
5	5.0000000000
6	7.0000000000
7	7.0000000000
8	None
-- !result
SELECT id, FIRST_VALUE(amt)
    OVER (PARTITION BY grp ORDER BY id ROWS BETWEEN 1 PRECEDING AND UNBOUNDED FOLLOWING) AS v
FROM t_rev_dec ORDER BY id;
-- result:
1	1.5000000000
2	1.5000000000
3	2.2500000000
4	3.1250000000
5	4.0625000000
6	-6.5000000000
7	-6.5000000000
