-- Inner pair wrapped in an outer join: the inner o-c pair merges remotely while
-- the LEFT JOIN to regions stays local (outer joins are never merged). The local
-- outer join's distribution (broadcast vs shuffle) is non-deterministic, so the recorded
-- plan uses [REGEX] to assert the merged inner-pair QUERY, the separate regions QUERY and the
-- local LEFT OUTER JOIN while ignoring the volatile distribution; the select checks correctness.
explain select o.order_id, c.region, r.region_group
from jdbc_join_pushdown_${uuid0}.db_join_pushdown.orders o
join jdbc_join_pushdown_${uuid0}.db_join_pushdown.customers c on o.customer_id = c.customer_id
left join jdbc_join_pushdown_${uuid0}.db_join_pushdown.regions r on c.customer_id = r.customer_id
where o.amount >= 20
order by o.order_id;

select o.order_id, c.region, r.region_group
from jdbc_join_pushdown_${uuid0}.db_join_pushdown.orders o
join jdbc_join_pushdown_${uuid0}.db_join_pushdown.customers c on o.customer_id = c.customer_id
left join jdbc_join_pushdown_${uuid0}.db_join_pushdown.regions r on c.customer_id = r.customer_id
where o.amount >= 20
order by o.order_id;

