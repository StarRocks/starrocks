-- Joins a pushed-down JDBC scan with a local internal table; the OlapScanNode prints a
-- non-deterministic tabletList, so the recorded plan uses [REGEX] to assert the merged remote QUERY
-- and the local vip_customers OlapScan while ignoring the volatile tablet ids.
explain select o.order_id, c.region, v.label, o.amount
from jdbc_join_pushdown_${uuid0}.db_join_pushdown.orders o
join jdbc_join_pushdown_${uuid0}.db_join_pushdown.customers c
on o.customer_id = c.customer_id
join default_catalog.db_join_pushdown_internal_${uuid0}.vip_customers v
on o.customer_id = v.customer_id
where o.amount >= 20
order by o.order_id;

select o.order_id, c.region, v.label, o.amount
from jdbc_join_pushdown_${uuid0}.db_join_pushdown.orders o
join jdbc_join_pushdown_${uuid0}.db_join_pushdown.customers c
on o.customer_id = c.customer_id
join default_catalog.db_join_pushdown_internal_${uuid0}.vip_customers v
on o.customer_id = v.customer_id
where o.amount >= 20
order by o.order_id;

-- Different catalogs never merge: a local HASH JOIN over two separate JDBC scans. The build/probe
-- side of this equal-cardinality inner join is a tie the optimizer breaks non-deterministically
-- across FE restarts, so the recorded plan uses [REGEX] to assert both per-catalog JDBC QUERYs are
-- present (in either order) rather than pinning the join side.
explain select o.order_id, c.region, o.amount
from jdbc_join_pushdown_${uuid0}.db_join_pushdown.orders o
join jdbc_join_pushdown_alt_${uuid0}.db_join_pushdown.customers c
on o.customer_id = c.customer_id
where o.order_id in (2, 3, 4)
order by o.order_id;

