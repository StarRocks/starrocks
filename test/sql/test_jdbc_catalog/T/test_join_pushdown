from table(jdbc_join_pushdown_${uuid0}.native_query('select order_id, customer_id, amount from db_join_pushdown.orders')) q1
join table(jdbc_join_pushdown_${uuid0}.native_query('select customer_id, region from db_join_pushdown.customers')) q2
on q1.customer_id = q2.customer_id
where q1.amount >= 20
order by q1.order_id, q2.region;

