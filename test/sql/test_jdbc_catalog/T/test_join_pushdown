-- create catalog
set catalog default_catalog;
create external catalog jdbc_join_pushdown_${uuid0}
properties
(
    "type"="jdbc",
    "user"="${external_mysql_user}",
    "password"="${external_mysql_password}",
    "jdbc_uri"="jdbc:mysql://${external_mysql_ip}:${external_mysql_port}",
    "driver_url"="${jdbc_url}",
    "driver_class"="com.mysql.cj.jdbc.Driver"
);

create external catalog jdbc_join_pushdown_alt_${uuid0}
properties
(
    "type"="jdbc",
    "user"="${external_mysql_user}",
    "password"="${external_mysql_password}",
    "jdbc_uri"="jdbc:mysql://${external_mysql_ip}:${external_mysql_port}",
    "driver_url"="${jdbc_url}",
    "driver_class"="com.mysql.cj.jdbc.Driver"
);

create database db_join_pushdown_internal_${uuid0};
create table db_join_pushdown_internal_${uuid0}.vip_customers (
    customer_id int,
    label varchar(20)
)
duplicate key(customer_id)
distributed by hash(customer_id) buckets 1
properties("replication_num" = "1");
insert into db_join_pushdown_internal_${uuid0}.vip_customers values (10, 'gold'), (30, 'silver'), (40, 'bronze');

