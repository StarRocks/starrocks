-- name: test_jdbc_catalog_agg_pushdown
-- prepare external MySQL table
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'drop database if exists db_agg_pushdown; create database db_agg_pushdown;'
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'use db_agg_pushdown; CREATE TABLE orders (order_id int not null, region varchar(20), customer_id int not null, amount int not null, status varchar(20));'
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'use db_agg_pushdown; INSERT INTO orders VALUES (1,"east",1,10,"open"),(2,"east",2,20,"paid"),(3,"west",1,30,"paid"),(4,"west",3,40,"paid"),(5,"south",4,15,"open"),(6,"north",5,5,"open");'
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'use db_agg_pushdown; CREATE TABLE t2 (id int not null, lock_status int not null, project_id int not null);'
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'use db_agg_pushdown; INSERT INTO t2 VALUES (1,0,3),(2,0,4),(3,0,8),(4,1,5),(5,1,7),(6,2,1);'

-- create catalog
set catalog default_catalog;
create external catalog jdbc_agg_pushdown_${uuid0}
properties
(
    "type"="jdbc",
    "user"="${external_mysql_user}",
    "password"="${external_mysql_password}",
    "jdbc_uri"="jdbc:mysql://${external_mysql_ip}:${external_mysql_port}",
    "driver_url"="${jdbc_url}",
    "driver_class"="com.mysql.cj.jdbc.Driver"
);

set catalog jdbc_agg_pushdown_${uuid0};
use db_agg_pushdown;

explain select region, count(*), count(distinct customer_id), max(amount)
from orders
where amount >= 10
group by region
having max(amount) >= 20
order by region;

set enable_jdbc_agg_push_down=true;

explain select region, count(*), count(distinct customer_id), max(amount)
from orders
where amount >= 10
group by region
having max(amount) >= 20
order by region;

select region, count(*), count(distinct customer_id), max(amount)
from orders
where amount >= 10
group by region
having max(amount) >= 20
order by region;

explain select count(*), max(amount)
from orders
where status = 'paid';

explain select count(*)
from t2
where id > 1
group by lock_status
having sum(project_id) > 10;

select count(*), max(amount)
from orders
where status = 'paid';

-- Scalar aggregates (no GROUP BY): sum / min / avg fold into one remote query.
explain select sum(amount), min(amount), avg(amount) from orders where amount >= 10;
select sum(amount), min(amount), avg(amount) from orders where amount >= 10;

-- GROUP BY without HAVING.
explain select region, sum(amount) from orders group by region order by region;
select region, sum(amount) from orders group by region order by region;

-- HAVING on count(*).
explain select region, count(*) as cnt from orders group by region having count(*) >= 2 order by region;
select region, count(*) as cnt from orders group by region having count(*) >= 2 order by region;

-- HAVING combining two aggregate conditions.
explain select region, count(*), sum(amount) from orders
group by region having count(*) >= 1 and sum(amount) > 25 order by region;
select region, count(*), sum(amount) from orders
group by region having count(*) >= 1 and sum(amount) > 25 order by region;

-- count(distinct) over a filtered scan.
explain select count(distinct region) from orders where amount >= 10;
select count(distinct region) from orders where amount >= 10;

-- Predicate variety before aggregation: IN + BETWEEN.
explain select region, max(amount) from orders
where region in ('east', 'west') and amount between 10 and 50 group by region order by region;
select region, max(amount) from orders
where region in ('east', 'west') and amount between 10 and 50 group by region order by region;

-- order by + limit on an aggregated result (deterministic top-N).
explain select region, sum(amount) as s from orders group by region order by s desc, region limit 2;
select region, sum(amount) as s from orders group by region order by s desc, region limit 2;

-- join + aggregate: two JDBC tables joined then aggregated, all pushed into one remote query.
explain select t.lock_status, count(*) as cnt, sum(o.amount) as total
from orders o
join t2 t on o.customer_id = t.id
group by t.lock_status
having sum(o.amount) > 10
order by t.lock_status;

select t.lock_status, count(*) as cnt, sum(o.amount) as total
from orders o
join t2 t on o.customer_id = t.id
group by t.lock_status
having sum(o.amount) > 10
order by t.lock_status;

-- HAVING on a group-key (non-aggregate) condition.
explain select region, sum(amount) as s from orders
group by region having region <> 'north' order by region;
select region, sum(amount) as s from orders
group by region having region <> 'north' order by region;

-- Grouped avg / min / max together fold into one remote aggregate.
explain select region, avg(amount) as a, min(amount) as mn, max(amount) as mx
from orders group by region order by region;
select region, avg(amount) as a, min(amount) as mn, max(amount) as mx
from orders group by region order by region;

-- Multiple distinct columns are not pushable: the aggregate stays local.
explain select count(distinct customer_id), count(distinct region) from orders where amount >= 5;
select count(distinct customer_id), count(distinct region) from orders where amount >= 5;

-- Aggregate + project expression: an expression over the aggregate output.
explain select region, sum(amount) * 10 as s10 from orders
group by region having count(*) >= 1 order by region;
select region, sum(amount) * 10 as s10 from orders
group by region having count(*) >= 1 order by region;

-- order by + limit + offset on an aggregated result.
explain select region, sum(amount) as s from orders
group by region order by s desc, region limit 2 offset 1;
select region, sum(amount) as s from orders
group by region order by s desc, region limit 2 offset 1;

-- cleanup
set enable_jdbc_agg_push_down=false;
set catalog default_catalog;
drop catalog jdbc_agg_pushdown_${uuid0};
shell: mysql -h${external_mysql_ip} -u${external_mysql_user} -p${external_mysql_password} -P${external_mysql_port} -e 'drop database db_agg_pushdown;'
