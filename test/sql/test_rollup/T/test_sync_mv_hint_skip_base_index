SELECT k2, k1 FROM t_x [_SYNC_MV_] ORDER BY k2;
SELECT k1, k2, v1 FROM t_x ORDER BY k1;
function: assert_query_error_contains("SELECT * FROM t_y [_SYNC_MV_]", "Unknown table")
drop database db_${uuid0} force;
