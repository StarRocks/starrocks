-- name: test_show_alter_rollup_predicates
-- Test Point:
--   SHOW ALTER TABLE ROLLUP honours WHERE, ORDER BY and LIMIT. The grammar accepts them for
--   every alter type and the analyzer validates them, but only SchemaChangeProcDir and
--   OptimizeProcDir used to apply them, so a rollup predicate was parsed, checked and then
--   dropped -- the statement answered as if it had not been written.
-- Method: two rollups on two tables, then project each result to the columns that do not change
--         between runs. The rows also carry a job id, two timestamps and a progress counter.

create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t1 (
  k1 int,
  v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1");

CREATE TABLE t2 (
  k1 int,
  v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1");

ALTER TABLE t1 ADD ROLLUP rollup_alpha (k1, v1) FROM t1;
function: wait_alter_table_finish("ROLLUP", 8)

ALTER TABLE t2 ADD ROLLUP rollup_beta (k1, v1) FROM t2;
function: wait_alter_table_finish("ROLLUP", 8)

-- Both jobs are there to begin with.
function: print_query_columns("SHOW ALTER TABLE ROLLUP", "TableName", "RollupIndexName", "State")

-- WHERE matching nothing. Unapplied, both rows come back.
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE TableName = 'no_such_table'", "TableName", "RollupIndexName")

-- WHERE selecting one of the two.
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE TableName = 't2'", "TableName", "RollupIndexName", "State")

-- ORDER BY and LIMIT. t2's rollup was submitted second, so descending must answer with it and
-- ascending with t1's. The two directions agreeing is the symptom of an ORDER BY that never ran,
-- since getAlterJobInfosByDb already returns the rows in ascending job id order.
function: print_query_columns("SHOW ALTER TABLE ROLLUP ORDER BY JobId DESC LIMIT 1", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER TABLE ROLLUP ORDER BY JobId ASC LIMIT 1", "TableName", "RollupIndexName")

-- ORDER BY on a column whose index differs between the two layouts -- State is 8 here and 9 in
-- SchemaChangeProcDir. Both jobs end FINISHED so the order cannot tell the two apart; this only
-- checks the column resolves and the sort runs. RollupProcDirTest carries the index assertion.
function: print_query_columns("SHOW ALTER TABLE ROLLUP ORDER BY State DESC", "TableName", "State")

-- The date column is the one place the two layouts disagree on a name: RollupProcDir shows it as
-- FinishedTime, SchemaChangeProcDir and OptimizeProcDir as FinishTime, and the analyzer's
-- predicate vocabulary was written against the latter. Both spellings have to reach the same
-- filter, or a finish-time predicate is dropped with nothing to show for it.
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE FinishedTime > '2999-01-01'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE FinishTime > '2999-01-01'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE FinishedTime > '2000-01-01' AND TableName = 't2'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER TABLE ROLLUP WHERE FinishTime > '2000-01-01' AND TableName = 't2'", "TableName", "RollupIndexName")

-- Same for ORDER BY, which resolves the name through RollupProcDir's title list. JobId breaks the
-- tie: both rollups can land in the same second on empty tables, and a function result is compared
-- as one string (sr_sql_lib.check -> assert_equal for FUNCTION_FLAG), so row order is asserted and
-- a tie would make this flaky. With the tie broken, rollup_beta leads either way.
function: print_query_columns("SHOW ALTER TABLE ROLLUP ORDER BY FinishedTime DESC, JobId DESC", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER TABLE ROLLUP ORDER BY FinishTime DESC, JobId DESC", "TableName", "RollupIndexName")

drop database db_${uuid0} force;

-- name: test_show_alter_materialized_view_predicates
-- Test Point:
--   SHOW ALTER MATERIALIZED VIEW answers from the same layout. ShowAlterStmtAnalyzer routes both
--   ROLLUP and MATERIALIZED_VIEW to /jobs/<dbId>/rollup, and a synchronous materialized view is
--   stored as a rollup index -- processCreateMaterializedView and processBatchAddRollup both end
--   in MaterializedViewHandler#createMaterializedViewJob. So the predicates were dropped on this
--   statement too, and they have to come back on it too.
-- Method: mirrors the rollup case above, through the materialized view spelling of the statement.

create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t1 (
  k1 int,
  v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1");

CREATE TABLE t2 (
  k1 int,
  v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1");

CREATE MATERIALIZED VIEW mv_alpha AS SELECT k1, sum(v1) FROM t1 GROUP BY k1;
function: wait_materialized_view_finish()

CREATE MATERIALIZED VIEW mv_beta AS SELECT k1, sum(v1) FROM t2 GROUP BY k1;
function: wait_materialized_view_finish()

-- Both jobs are there to begin with. RollupIndexName carries the materialized view's name.
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW", "TableName", "RollupIndexName", "State")

-- WHERE matching nothing. Unapplied, both rows come back.
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW WHERE TableName = 'no_such_table'", "TableName", "RollupIndexName")

-- WHERE selecting one of the two.
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW WHERE TableName = 't2'", "TableName", "RollupIndexName", "State")

-- ORDER BY and LIMIT. mv_beta was submitted second, so the two directions must disagree.
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW ORDER BY JobId DESC LIMIT 1", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW ORDER BY JobId ASC LIMIT 1", "TableName", "RollupIndexName")

-- Both spellings of the finish-time column, as in the rollup case.
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW WHERE FinishedTime > '2999-01-01'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW WHERE FinishTime > '2999-01-01'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW WHERE FinishedTime > '2000-01-01' AND TableName = 't2'", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW ORDER BY FinishedTime DESC, JobId DESC", "TableName", "RollupIndexName")
function: print_query_columns("SHOW ALTER MATERIALIZED VIEW ORDER BY FinishTime DESC, JobId DESC", "TableName", "RollupIndexName")

drop database db_${uuid0} force;
