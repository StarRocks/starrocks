-- name: test_mv_fast_schema_change @sequential @slow
-- Test Point: Preserve MV schema-change defaults and recomputed data in each fast evolution mode.
-- Method: Deferred manual refresh, strict refresh results, full base/MV comparisons and exact default-value checks.
-- Scope: MV fast schema evolution, column identity, physical defaults and configuration restoration.
[UC]function: orig_mv_fast_schema_change_mode=execute_sql("ADMIN SHOW FRONTEND CONFIG LIKE 'mv_fast_schema_change_mode'", True)["result"][0][2]
CREATE DATABASE mv_fse_strict_${uuid0};
USE mv_fse_strict_${uuid0};

admin set frontend config('mv_fast_schema_change_mode' = 'strict');

drop table if exists t1;
drop materialized view if exists test_mv1;
CREATE TABLE t1 (
  dt datetime,
  `c0` int(11) NULL COMMENT "",
  `c1` varchar(20) NULL COMMENT "",
  `c2` varchar(200) NULL COMMENT "",
  `c3` int(11) NULL COMMENT ""
) ENGINE=OLAP
DUPLICATE KEY(`dt`, `c0`, `c1`)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(`c0`, `c1`) BUCKETS 48
PROPERTIES (
  "replication_num" = "1"
);
insert into t1 SELECT '2026-01-01', generate_series % 10, generate_series, generate_series, generate_series FROM TABLE(generate_series(1, 100));

CREATE MATERIALIZED VIEW test_mv1 
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY hash(c0) 
PROPERTIES (
  "replication_num" = "1",
  "query_rewrite_consistency" = "force_mv"
)
REFRESH DEFERRED MANUAL
AS
SELECT dt, c0, count(c1) as cnt_c1 from t1 group by dt, c0;

function: refresh_mv_manual("mv_fse_strict_${uuid0}", "test_mv1")

-- A logical oracle reads the base table without substituting an MV, even in force_mv mode.
function: check_no_hit_materialized_view('SELECT /*+ SET_VAR(enable_materialized_view_rewrite=false) */ dt AS dt, c0 AS c0, count(c1) AS cnt_c1 FROM t1 GROUP BY dt, c0 ORDER BY ALL;', 'TABLE: test_mv1')
function: assert_equal_result('SELECT dt, c0, cnt_c1 FROM test_mv1 ORDER BY ALL;', 'SELECT /*+ SET_VAR(enable_materialized_view_rewrite=false) */ dt AS dt, c0 AS c0, count(c1) AS cnt_c1 FROM t1 GROUP BY dt, c0 ORDER BY ALL;')

-- Check every refreshed group, rather than only the first three.
SELECT dt, c0, cnt_c1 FROM test_mv1 ORDER BY ALL;

set enable_materialized_view_rewrite = false;
function: print_hit_materialized_view("select dt, c0, count(c1) as cnt_c1 from t1 group by dt, c0", "test_mv1")
SELECT * FROM test_mv1 ORDER BY ALL LIMIT 3;
