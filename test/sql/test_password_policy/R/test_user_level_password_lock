-- name: test_user_level_password_lock
create password policy global_retry_${uuid0} properties (
    "PASSWORD_MIN_LENGTH" = "8",
    "PASSWORD_MAX_RETRIES" = "3"
);
-- result:
-- !result
create password policy user_retry_${uuid1} properties (
    "PASSWORD_MIN_LENGTH" = "8",
    "PASSWORD_MAX_RETRIES" = "1"
);
-- result:
-- !result
alter system set password policy global_retry_${uuid0};
-- result:
-- !result
create user user_retry_${uuid0} identified by "12345678";
-- result:
-- !result
alter user 'user_retry_${uuid0}' set properties ('PASSWORD_POLICY' = 'user_retry_${uuid1}');
-- result:
-- !result
function: assert_login_fail("user_retry_${uuid0}", "wrong_password", "Access denied")
-- result:
None
-- !result
function: assert_login_fail("user_retry_${uuid0}", "12345678", "locked")
-- result:
None
-- !result
show property for 'user_retry_${uuid0}' like 'PASSWORD_POLICY';
-- result:
[REGEX]^PASSWORD_POLICY\tuser_retry_[0-9a-f]+$
-- !result
alter user user_retry_${uuid0} unlock;
-- result:
-- !result
function: assert_login_success("user_retry_${uuid0}", "12345678", "user_retry_${uuid0}")
-- result:
None
-- !result
CLEANUP {
    alter system unset password policy;
    alter user 'user_retry_${uuid0}' set properties ('PASSWORD_POLICY' = '');
    drop user if exists user_retry_${uuid0};
    drop password policy user_retry_${uuid1};
    drop password policy global_retry_${uuid0};
} END CLEANUP
