-- name: test_sys_users

CREATE PASSWORD POLICY pp1 comment "pp1 comment"
properties (
    "PASSWORD_MIN_LENGTH" = "8",
    "PASSWORD_MIN_UPPER_CASE_CHARS" = "1",
    "PASSWORD_MIN_LOWER_CASE_CHARS" = "1",
    "PASSWORD_MIN_NUMERIC_CHARS" = "1",
    "PASSWORD_MIN_SPECIAL_CHARS" = "1",
    "PASSWORD_MAX_AGE_DAYS" = "7"
);

alter system set password policy pp1;

drop user if exists u1;
create user u1 identified by "1234567aB!" expire_password=true;
select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED from sys.users where USER="u1";
alter user u1 identified by "1234567aC!" expire_password=false;
select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED from sys.users where USER="u1";

alter system unset password policy;

drop password policy pp1;

-- name: test_sys_users_user_level_password_policy
alter system unset password policy;

drop user if exists sys_user_${uuid0};

create password policy sys_global_pp_${uuid0}
properties (
    "PASSWORD_MIN_LENGTH" = "8"
);

create password policy sys_user_pp_${uuid1}
properties (
    "PASSWORD_MIN_LENGTH" = "3"
);

alter system set password policy sys_global_pp_${uuid0};

create user sys_user_${uuid0} identified by "12345678";

select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED
from sys.users
where USER = "sys_user_${uuid0}";

alter user 'sys_user_${uuid0}' set properties ('PASSWORD_POLICY' = 'sys_user_pp_${uuid1}');

select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED
from sys.users
where USER = "sys_user_${uuid0}";

alter user 'sys_user_${uuid0}' set properties ('PASSWORD_POLICY' = '');

select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED
from sys.users
where USER = "sys_user_${uuid0}";

CLEANUP {
    alter system unset password policy;
    alter user 'sys_user_${uuid0}' set properties ('PASSWORD_POLICY' = '');
    drop user if exists sys_user_${uuid0};
    drop password policy sys_user_pp_${uuid1};
    drop password policy sys_global_pp_${uuid0};
} END CLEANUP
