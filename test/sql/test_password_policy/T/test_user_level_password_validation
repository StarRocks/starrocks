-- name: test_user_level_password_validation
create password policy global_pp_${uuid0} properties ("PASSWORD_MIN_LENGTH" = "8");

create password policy user_pp_${uuid1} properties ("PASSWORD_MIN_LENGTH" = "3");

alter system set password policy global_pp_${uuid0};

create user user_pp_${uuid0} identified by "12345678";

alter user 'user_pp_${uuid0}' set properties ('PASSWORD_POLICY' = 'user_pp_${uuid1}');

show property for 'user_pp_${uuid0}' like 'PASSWORD_POLICY';

alter user user_pp_${uuid0} identified by '123';

alter user 'user_pp_${uuid0}' set properties ('PASSWORD_POLICY' = '');

alter user user_pp_${uuid0} identified by '123';

CLEANUP {
    alter system unset password policy;
    drop user if exists user_pp_${uuid0};
    drop password policy user_pp_${uuid1};
    drop password policy global_pp_${uuid0};
} END CLEANUP
