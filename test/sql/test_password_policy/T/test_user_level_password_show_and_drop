-- name: test_user_level_password_show_and_drop
alter system unset password policy;

create password policy bound_pp_${uuid0} properties ("PASSWORD_MIN_LENGTH" = "3");

create user bound_user_${uuid0} identified by "123";

alter user 'bound_user_${uuid0}' set properties ('PASSWORD_POLICY' = 'bound_pp_${uuid0}');

show property for 'bound_user_${uuid0}' like 'PASSWORD_POLICY';

drop password policy bound_pp_${uuid0};

alter user 'bound_user_${uuid0}' set properties ('PASSWORD_POLICY' = '');

drop password policy bound_pp_${uuid0};

drop user bound_user_${uuid0};

CLEANUP {
    alter system unset password policy;
    alter user 'bound_user_${uuid0}' set properties ('PASSWORD_POLICY' = '');
    drop user if exists bound_user_${uuid0};
    drop password policy bound_pp_${uuid0};
} END CLEANUP
