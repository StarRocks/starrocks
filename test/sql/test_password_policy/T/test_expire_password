-- name: test_expire_password
alter user root expire_password=true;

drop user if exists u1;

create user u1 expire_password=true;

select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED from sys.users where USER="u1";

alter user u1 expire_password=false;

select HOST, USER, PASSWORD_EXPIRED, PASSWORD_POLICY, IS_LOCKED from sys.users where USER="u1";