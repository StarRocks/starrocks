-- name: test_create_user_with_password_policy
create password policy global_pp_${uuid0} properties ("PASSWORD_MIN_LENGTH" = "8");

create password policy user_pp_${uuid1} properties ("PASSWORD_MIN_LENGTH" = "3");

alter system set password policy global_pp_${uuid0};

create user create_user_pp_${uuid2} identified by '123' properties ('PASSWORD_POLICY' = 'user_pp_${uuid1}');

show property for 'create_user_pp_${uuid2}' like 'PASSWORD_POLICY';

alter user create_user_pp_${uuid2} identified by '123';

CLEANUP {
    alter system unset password policy;
    drop user if exists create_user_pp_${uuid2};
    drop password policy user_pp_${uuid1};
    drop password policy global_pp_${uuid0};
} END CLEANUP
