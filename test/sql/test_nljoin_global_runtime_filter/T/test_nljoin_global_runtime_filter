-- A build-side expression that can fail (division by zero) must not abort the query
-- when the probe side never reaches the join; when the probe is non-empty the
-- expression is genuinely evaluated and the failure must still surface.
set enable_global_runtime_filter = true;
set sql_mode = 'ERROR_FOR_DIVISION_BY_ZERO';

-- empty probe: folding the range boundary evaluates the build expression, but the
-- failure is tolerated and the join itself never runs -> 0 rows, no error
select count(*) from
    (select * from nl_grf_probe_${uuid0} where c_int > 1000000) p
    join [broadcast] nl_grf_build_multi_${uuid0} b on p.c_double > b.c_double / (b.c_double - 10);

-- non-empty probe: the join evaluates the erroring expression -> still reports the error
with probe as (
    select p.* from nl_grf_probe_${uuid0} p join [shuffle] nl_grf_dim_${uuid0} d on p.c_int = d.c_int
)
select count(*) from probe p join [broadcast] nl_grf_build_multi_${uuid0} b on p.c_double > b.c_double / (b.c_double - 10);

-- A later build chunk fails; the other RF must still filter out the probe rows.
set pipeline_dop = 1;
with probe as (
    select p.* from nl_grf_probe_${uuid0} p join [shuffle] nl_grf_dim_${uuid0} d on p.c_int = d.c_int
)
select count(*) from probe p
join [broadcast] (select c_int from nl_grf_build_big_${uuid0} order by c_int limit 10000) b
on p.c_double > 1.0 / (b.c_int - 9999)
and p.c_double > b.c_int + 1000000.0;
set pipeline_dop = 0;

set sql_mode = '';

