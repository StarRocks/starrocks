-- Force a real NLJoin build spill. Only CROSS JOIN selects the spillable NLJoin operator
-- (see CrossJoinNode::decompose_to_pipeline); the disabled CBO rules below keep this a CROSS
-- JOIN instead of rewriting the ON predicate into an INNER JOIN, so the spill path is covered.
set enable_spill = true;
set spill_mode = "force";
set pipeline_dop = 2;
set spillable_operator_mask = 16;
set spill_operator_min_bytes = 0;
set spill_mem_table_size = 4096;
set cbo_disabled_rules = "TF_PUSH_DOWN_JOIN_CLAUSE,TF_PUSH_DOWN_PREDICATE_JOIN";

with probe as (
    select p.* from nl_grf_probe_${uuid0} p join [shuffle] nl_grf_dim_${uuid0} d on p.c_int = d.c_int
)
select count(*) from probe x cross join [broadcast] nl_grf_build_big_${uuid0} b on x.c_int > b.c_int
where x.c_int > b.c_int;

set cbo_disabled_rules = "";
set spillable_operator_mask = -1;
set spill_operator_min_bytes = 52428800;
set spill_mem_table_size = 104857600;
set pipeline_dop = 0;
set enable_spill = false;
set spill_mode = "auto";

