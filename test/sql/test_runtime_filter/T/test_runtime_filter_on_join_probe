-- name: test_runtime_filter_on_join_probe
-- A partitioned global runtime filter whose partition_exprs span tables on both sides of a lower join
-- cannot reach a scan, so the FE attaches it to that join. The join probe must evaluate it.
CREATE DATABASE db_${uuid0};
USE db_${uuid0};
CREATE TABLE t_a (k bigint, dt int, v int) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ("replication_num" = "1");
CREATE TABLE t_d (dt int, wk int) DUPLICATE KEY(dt) DISTRIBUTED BY HASH(dt) BUCKETS 1 PROPERTIES ("replication_num" = "1");
CREATE TABLE t_w (dt int) DUPLICATE KEY(dt) DISTRIBUTED BY HASH(dt) BUCKETS 1 PROPERTIES ("replication_num" = "1");
CREATE TABLE t_c (k bigint, wk int) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ("replication_num" = "1");
-- 800 probe rows: 100 keys x 50 dates
INSERT INTO t_a SELECT g % 100, g % 50, g FROM TABLE(generate_series(0, 799)) t(g);
-- 50 dates -> 10 weeks
INSERT INTO t_d SELECT g, g DIV 5 FROM TABLE(generate_series(0, 49)) t(g);
INSERT INTO t_w SELECT g FROM TABLE(generate_series(0, 49)) t(g);
-- build: keys 0, 10, ..., 90 x weeks 0..1
INSERT INTO t_c SELECT g % 10 * 10, g DIV 10 FROM TABLE(generate_series(0, 19)) t(g);

SET disable_join_reorder = true;
SET enable_profile = true;
SET enable_async_profile = false;
SET pipeline_dop = 1;

-- Both filters of the shuffle join (on k and on wk) land on the broadcast join t_a x t_d, so fewer than
-- the 800 probe rows are shuffled to it.
SELECT count(*), sum(t_a.v) FROM t_a JOIN [broadcast] t_d ON t_a.dt = t_d.dt JOIN [shuffle] t_c ON t_a.k = t_c.k AND t_d.wk = t_c.wk;
SELECT CAST(regexp_extract(get_query_profile(last_query_id()), '(?s)EXCHANGE_SINK \\(plan_node_id=5\\):.*?PushRowNum: ([0-9]+)', 1) AS BIGINT) < 800;
SELECT /*+ SET_VAR(enable_global_runtime_filter=false) */ count(*), sum(t_a.v) FROM t_a JOIN [broadcast] t_d ON t_a.dt = t_d.dt JOIN [shuffle] t_c ON t_a.k = t_c.k AND t_d.wk = t_c.wk;

-- The output of t_a x t_w has no wk for the partition_exprs (k, wk), so both filters stay on the join
-- with t_d, the lowest node that carries k and wk, and are evaluated there.
SELECT count(*), sum(t_a.v) FROM t_a JOIN [broadcast] t_w ON t_a.dt = t_w.dt JOIN [broadcast] t_d ON t_a.dt = t_d.dt JOIN [shuffle] t_c ON t_a.k = t_c.k AND t_d.wk = t_c.wk;
SELECT CAST(regexp_extract(get_query_profile(last_query_id()), '(?s)EXCHANGE_SINK \\(plan_node_id=9\\):.*?PushRowNum: ([0-9]+)', 1) AS BIGINT) < 800;
SELECT /*+ SET_VAR(enable_global_runtime_filter=false) */ count(*), sum(t_a.v) FROM t_a JOIN [broadcast] t_w ON t_a.dt = t_w.dt JOIN [broadcast] t_d ON t_a.dt = t_d.dt JOIN [shuffle] t_c ON t_a.k = t_c.k AND t_d.wk = t_c.wk;

DROP DATABASE db_${uuid0};
