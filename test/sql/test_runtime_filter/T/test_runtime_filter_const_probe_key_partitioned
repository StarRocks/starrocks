-- name: test_runtime_filter_const_probe_key_partitioned
-- A join key that has the same value on every row (not_null_col IS NULL) is a constant column on the probe side.
-- The partition of each probe row still comes from all the shuffle keys and differs from row to row, so the
-- global runtime filter of a shuffle join must test each row against its own partition's filter (RB-1193).
create table repro_cust (customer_id int not null, customer_level tinyint null) duplicate key(customer_id)
distributed by hash(customer_id) buckets 3 properties ("replication_num" = "1");
insert into repro_cust values (1,1),(2,2),(3,1),(4,3),(5,NULL),(6,2),(7,-128),(8,127),(9,0),(10,1),(11,2),(12,3);
set enable_global_runtime_filter = true;
select customer_id from repro_cust where (customer_id is null, customer_level) in (select customer_level, customer_level from repro_cust) order by customer_id;
select customer_id from repro_cust where (customer_id is not null, customer_level) in (select customer_level, customer_level from repro_cust) order by customer_id;
select a.customer_id from repro_cust a join [shuffle] repro_cust b on (a.customer_id is not null) = b.customer_level and a.customer_level = b.customer_level order by 1;
select a.customer_id from repro_cust a where exists (select 1 from repro_cust b where (a.customer_id is null) = b.customer_level and a.customer_level = b.customer_level) order by 1;
set enable_global_runtime_filter = false;
select customer_id from repro_cust where (customer_id is not null, customer_level) in (select customer_level, customer_level from repro_cust) order by customer_id;
select a.customer_id from repro_cust a join [shuffle] repro_cust b on (a.customer_id is not null) = b.customer_level and a.customer_level = b.customer_level order by 1;
