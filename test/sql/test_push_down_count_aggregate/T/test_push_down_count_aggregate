-- name: test_push_down_count_aggregate
DROP TABLE if exists pdc_t0;

DROP TABLE if exists pdc_t1;

CREATE TABLE pdc_t0
(
v1 BIGINT NOT NULL,
v2 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v1`)
DISTRIBUTED BY HASH(`v1`) BUCKETS 1
PROPERTIES("replication_num" = "1");

CREATE TABLE pdc_t1
(
v4 BIGINT NOT NULL,
v5 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v4`)
DISTRIBUTED BY HASH(`v4`) BUCKETS 1
PROPERTIES("replication_num" = "1");

INSERT INTO pdc_t0 (v1, v2) VALUES (1, 10), (1, 20);

INSERT INTO pdc_t1 (v4, v5) VALUES (1, 100), (1, 200), (1, 300);

set cbo_push_down_aggregate_mode=1;

-- count(*) must count the 6 join rows, not the rows of a collapsed pdc_t0.
select t0.v1, sum(t0.v2), count(*) from pdc_t0 t0 join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t1.v5), count(*) from pdc_t0 t0 left join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, count(*) from pdc_t0 t0 join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t0.v2) from pdc_t0 t0 join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

set cbo_push_down_aggregate_mode=-1;

select t0.v1, sum(t0.v2), count(*) from pdc_t0 t0 join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t1.v5), count(*) from pdc_t0 t0 left join pdc_t1 t1 on t0.v1 = t1.v4 group by t0.v1;

set cbo_push_down_aggregate_mode=0;

DROP TABLE pdc_t0;

DROP TABLE pdc_t1;
