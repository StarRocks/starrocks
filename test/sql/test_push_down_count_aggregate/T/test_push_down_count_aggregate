-- name: test_push_down_count_aggregate
DROP TABLE if exists pdc_t0_${uuid0};

DROP TABLE if exists pdc_t1_${uuid0};

CREATE TABLE pdc_t0_${uuid0}
(
v1 BIGINT NOT NULL,
v2 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v1`)
DISTRIBUTED BY HASH(`v1`) BUCKETS 1
PROPERTIES("replication_num" = "1");

CREATE TABLE pdc_t1_${uuid0}
(
v4 BIGINT NOT NULL,
v5 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v4`)
DISTRIBUTED BY HASH(`v4`) BUCKETS 1
PROPERTIES("replication_num" = "1");

INSERT INTO pdc_t0_${uuid0} (v1, v2) VALUES (1, 10), (1, 20);

INSERT INTO pdc_t1_${uuid0} (v4, v5) VALUES (1, 100), (1, 200), (1, 300);

set cbo_push_down_aggregate_mode=1;

-- count(*) must count the 6 join rows, not the rows of a collapsed left side.
select t0.v1, sum(t0.v2), count(*) from pdc_t0_${uuid0} t0 join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t1.v5), count(*) from pdc_t0_${uuid0} t0 left join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, count(*) from pdc_t0_${uuid0} t0 join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t0.v2) from pdc_t0_${uuid0} t0 join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

set cbo_push_down_aggregate_mode=-1;

select t0.v1, sum(t0.v2), count(*) from pdc_t0_${uuid0} t0 join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

select t0.v1, sum(t1.v5), count(*) from pdc_t0_${uuid0} t0 left join pdc_t1_${uuid0} t1 on t0.v1 = t1.v4 group by t0.v1;

-- A semi/anti join only filters its preserved side, so count() may be pushed below it. Add rows whose
-- keys are absent from pdc_t1_${uuid0} so the semi/anti split is observable, then check that forcing the
-- push down (mode=1) returns exactly what leaving the aggregate above the join (mode=-1) returns.
INSERT INTO pdc_t0_${uuid0} (v1, v2) VALUES (2, 30), (2, 40), (3, 50);

set cbo_push_down_aggregate_mode=1;

select t0.v1, count(*) from pdc_t0_${uuid0} t0 where t0.v1 in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

select t0.v1, sum(t0.v2), count(*) from pdc_t0_${uuid0} t0 where t0.v1 in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

select t0.v1, count(*) from pdc_t0_${uuid0} t0 where t0.v1 not in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

set cbo_push_down_aggregate_mode=-1;

select t0.v1, count(*) from pdc_t0_${uuid0} t0 where t0.v1 in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

select t0.v1, sum(t0.v2), count(*) from pdc_t0_${uuid0} t0 where t0.v1 in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

select t0.v1, count(*) from pdc_t0_${uuid0} t0 where t0.v1 not in (select t1.v4 from pdc_t1_${uuid0} t1) group by t0.v1 order by 1;

-- A UNION branch projecting a constant erases the group-by key, so a count pushed into each branch would
-- land ungrouped and emit a phantom row. With both inputs empty the query must return no rows at all,
-- under forced push down exactly as without it.
CREATE TABLE pdc_e0_${uuid0}
(
v1 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v1`)
DISTRIBUTED BY HASH(`v1`) BUCKETS 1
PROPERTIES("replication_num" = "1");

CREATE TABLE pdc_e1_${uuid0}
(
v4 BIGINT NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`v4`)
DISTRIBUTED BY HASH(`v4`) BUCKETS 1
PROPERTIES("replication_num" = "1");

set cbo_push_down_aggregate_mode=1;

select k, count(*) from (select 1 as k from pdc_e0_${uuid0} union all select 1 from pdc_e1_${uuid0}) u group by k order by 1;

set cbo_push_down_aggregate_mode=-1;

select k, count(*) from (select 1 as k from pdc_e0_${uuid0} union all select 1 from pdc_e1_${uuid0}) u group by k order by 1;

DROP TABLE pdc_e0_${uuid0};

DROP TABLE pdc_e1_${uuid0};

set cbo_push_down_aggregate_mode=0;

DROP TABLE pdc_t0_${uuid0};

DROP TABLE pdc_t1_${uuid0};
