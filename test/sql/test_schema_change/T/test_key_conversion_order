-- name: test_key_conversion_order @native
CREATE DATABASE schema_order_${uuid0};
USE schema_order_${uuid0};
SET enable_pipeline_engine = true;
SET enable_query_cache = false;
SET pipeline_dop = 4;
SET cbo_enable_low_cardinality_optimize = false;
CREATE TABLE reorder_probe (
    d DATE NOT NULL, region BIGINT NOT NULL, goods BIGINT NOT NULL, qty BIGINT SUM
) AGGREGATE KEY(d, region, goods)
DISTRIBUTED BY HASH(goods) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO reorder_probe
SELECT '2025-11-01', CASE n%4 WHEN 0 THEN 9 WHEN 1 THEN 10 WHEN 2 THEN 90 ELSE 100 END, n, 1
FROM (SELECT generate_series AS n FROM TABLE(generate_series(0,4194303))) s
UNION ALL SELECT '2025-11-01', 55, 9000000, 10;
ALTER TABLE reorder_probe MODIFY COLUMN region VARCHAR(32) NOT NULL;
function: wait_alter_table_finish()
SET enable_tablet_internal_parallel = false;
SELECT * FROM reorder_probe WHERE goods = 9000000;
SELECT COUNT(*), SUM(qty) FROM reorder_probe;
SET enable_tablet_internal_parallel = true;
SET tablet_internal_parallel_mode = 'force_split';
SELECT * FROM reorder_probe WHERE goods = 9000000;
SELECT COUNT(*), SUM(qty) FROM reorder_probe;

CREATE TABLE date_probe (k DATETIME NOT NULL, suffix INT NOT NULL, v BIGINT SUM)
AGGREGATE KEY(k, suffix) DISTRIBUTED BY HASH(suffix) BUCKETS 1 PROPERTIES ("replication_num" = "1");
INSERT INTO date_probe VALUES
('2026-11-17 01:00:00', 2, 1), ('2026-11-17 02:00:00', 1, 2),
('2026-11-17 03:00:00', 2, 3), ('2026-11-18 00:00:00', 0, 4);
ALTER TABLE date_probe MODIFY COLUMN k DATE NOT NULL;
function: wait_alter_table_finish()
[ORDER] SELECT * FROM date_probe ORDER BY k, suffix;

CREATE TABLE string_probe (k VARCHAR(32), suffix INT NOT NULL, v BIGINT SUM)
AGGREGATE KEY(k, suffix) DISTRIBUTED BY HASH(suffix) BUCKETS 1 PROPERTIES ("replication_num" = "1");
INSERT INTO string_probe VALUES (NULL, 0, 1), ('01', 2, 2), ('1', 1, 3), ('1', 2, 4), ('10', 0, 5), ('9', 0, 6), ('bad', 0, 7);
