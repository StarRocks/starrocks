-- name: test_ai_complete
-- EXPLAIN only; explicit Providers avoid mutating cluster defaults.

CREATE AI PROVIDER ai_complete_${uuid0} TYPE chat
PROPERTIES ('endpoint' = 'https://models.example.test/v1/chat/completions',
'model' = 'integration-test-model', 'protocol' = 'openai');

EXPLAIN SELECT ai_complete(prompt => 'prompt-overload', provider => 'ai_complete_${uuid0}', model => 'integration-test-model');
EXPLAIN SELECT ai_complete(prompt => 'prompt-options-overload', provider => 'ai_complete_${uuid0}', model => 'integration-test-model',
    options => json_object()
);
EXPLAIN SELECT ai_complete(prompt => 'model-prompt-overload', provider => 'ai_complete_${uuid0}', model => 'explicit-model');
EXPLAIN SELECT ai_complete(prompt => 'model-prompt-options-overload', provider => 'ai_complete_${uuid0}', model => 'explicit-model',
    options => json_object('temperature', 0.0)
);

-- Typed NULL and nullable VALUES/UNION columns remain plannable.
EXPLAIN SELECT ai_complete(prompt => CAST(NULL AS VARCHAR), provider => 'ai_complete_${uuid0}', model => 'integration-test-model');
EXPLAIN SELECT id, ai_complete(prompt => prompt, provider => 'ai_complete_${uuid0}', model => 'integration-test-model')
FROM (VALUES
    (1, 'values-first'),
    (2, CAST(NULL AS VARCHAR)),
    (3, 'values-third')
) AS v(id, prompt)
ORDER BY id;
EXPLAIN SELECT id, ai_complete(prompt => prompt, provider => 'ai_complete_${uuid0}', model => 'explicit-model')
FROM (
    SELECT 4 AS id, 'union-first' AS prompt
    UNION ALL
    SELECT 5, CAST(NULL AS VARCHAR)
    UNION ALL
    SELECT 6, 'union-third'
) AS u
ORDER BY id;

-- JSON contents are validated during execution; EXPLAIN only checks type and constancy.
EXPLAIN SELECT ai_complete(prompt => 'reserved-option', provider => 'ai_complete_${uuid0}', model => 'integration-test-model', options => json_object('model', 'forbidden'));
EXPLAIN SELECT ai_complete(prompt => 'nonconstant-options', provider => 'ai_complete_${uuid0}', model => 'integration-test-model', options => json_object('temperature', temperature))
FROM (VALUES (0.1)) AS v(temperature);
EXPLAIN SELECT DISTINCT ai_complete(prompt => 'forbidden-distinct', provider => 'ai_complete_${uuid0}', model => 'integration-test-model');

EXPLAIN SELECT ai_complete(prompt => NULL, provider => 'ai_complete_${uuid0}', model => 'm');
EXPLAIN SELECT ai_complete(prompt => 'prompt', provider => 'ai_complete_${uuid0}', model => 'm', options => CAST(NULL AS JSON));

CLEANUP {
    DROP AI PROVIDER IF EXISTS ai_complete_${uuid0};
} END CLEANUP
