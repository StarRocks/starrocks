-- name: test_ai_complete
fixture_suffix=SELECT '${uuid0}';
CREATE AI PROVIDER ai_chat_${uuid0} TYPE chat
PROPERTIES ('endpoint' = 'https://models.example.test/v1/chat/completions',
'model' = 'chat-model', 'api_key' = 'fixture-not-a-real-key');

EXPLAIN SELECT ai_complete(prompt => 'prompt', provider => 'ai_chat_${uuid0}', model => 'explicit-model');

CLEANUP {
    DROP AI PROVIDER IF EXISTS ai_chat_${fixture_suffix};
} END CLEANUP
