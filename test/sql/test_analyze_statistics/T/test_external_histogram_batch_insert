-- name: test_external_histogram_batch_insert @sequential

CREATE EXTERNAL CATALOG analyze_hive_batch_${uuid0} PROPERTIES (
    'type' = 'hive',
    'hive.metastore.uris' = '${hive_metastore_uris}',
    'aws.s3.access_key' = '${oss_ak}',
    'aws.s3.secret_key' = '${oss_sk}',
    'aws.s3.endpoint' = '${oss_endpoint}'
);

-- All three rows fit in one external histogram statistics INSERT. Keeping one MCV leaves
-- another distinct date/int value for the real histogram() bucket aggregate.
ADMIN SET FRONTEND CONFIG ('histogram_batch_insert_buffer_size' = '20971520');

ANALYZE TABLE analyze_hive_batch_${uuid0}.hive_oss_db.hive_oss_par_parquet_snappy
UPDATE HISTOGRAM ON col_int, col_string, col_date
PROPERTIES ('histogram_sample_ratio' = '1.0', 'histogram_mcv_size' = '1');

SELECT column_name, IF(buckets IS NULL, 'NULL', 'SET'), IF(mcv IS NULL, 'NULL', 'SET')
FROM default_catalog._statistics_.external_histogram_statistics
WHERE catalog_name = 'analyze_hive_batch_${uuid0}'
    AND db_name = 'hive_oss_db'
    AND table_name = 'hive_oss_par_parquet_snappy'
ORDER BY column_name;

-- Force each oversized row to flush separately, and verify every row is replaced.
ADMIN SET FRONTEND CONFIG ('histogram_batch_insert_buffer_size' = '1');

ANALYZE TABLE analyze_hive_batch_${uuid0}.hive_oss_db.hive_oss_par_parquet_snappy
UPDATE HISTOGRAM ON col_int, col_string, col_date
PROPERTIES ('histogram_sample_ratio' = '1.0', 'histogram_mcv_size' = '0');

SELECT column_name, IF(buckets IS NULL, 'NULL', 'SET'), IF(mcv IS NULL, 'NULL', 'SET')
FROM default_catalog._statistics_.external_histogram_statistics
WHERE catalog_name = 'analyze_hive_batch_${uuid0}'
    AND db_name = 'hive_oss_db'
    AND table_name = 'hive_oss_par_parquet_snappy'
ORDER BY column_name;

ADMIN SET FRONTEND CONFIG ('histogram_batch_insert_buffer_size' = '20971520');
DROP CATALOG analyze_hive_batch_${uuid0};

CLEANUP {
    ADMIN SET FRONTEND CONFIG ('histogram_batch_insert_buffer_size' = '20971520');
    DROP CATALOG IF EXISTS analyze_hive_batch_${uuid0};
} END CLEANUP
