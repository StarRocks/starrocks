-- name: test_enable_local_first_tablet_write @cloud
create database db_${uuid0};
use db_${uuid0};

-- One bucket on purpose: this is the shape the feature exists for -- without it the whole load
-- lands on the single compute node that owns the tablet. `file_bundling` is required, not
-- incidental: it is what puts the transaction on combined txn logs (each writing node emits a
-- PARTIAL txn log and the sender folds them into one) and what makes every segment carry its own
-- bundle filename plus offset, so segments written into different nodes' bundles can be folded
-- into one rowset.
create table t_local (k1 bigint, k2 int, v1 string, v2 bigint)
    duplicate key(k1, k2)
    distributed by hash(k1) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'true');

set enable_local_first_tablet_write = true;

-- Enough rows for many chunks, so the load actually lands data on more than whichever node
-- happened to receive the first chunk.
insert into t_local select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), count(distinct k1), sum(k1), sum(v2) from t_local;

-- A second transaction into the same tablet: the folded rowsets must accumulate, not replace.
insert into t_local select generate_series, cast(generate_series % 7 as int), concat('w', generate_series), generate_series * 5 from table(generate_series(1, 20000));
select count(*), sum(v2) from t_local;
select k1, k2, v1, v2 from t_local where k1 = 12345 order by v1;

-- Deletes must still erase rows written by earlier transactions.
delete from t_local where k1 <= 10000;
select count(*), sum(k1), sum(v2) from t_local;

-- Back to the default: the same load must give exactly the same answer.
set enable_local_first_tablet_write = false;
truncate table t_local;
insert into t_local select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), sum(k1), sum(v2) from t_local;

-- A table without file bundling is refused: there is no combined txn log to fold the per-node logs
-- into, and the folded rowset would mix segments that carry a bundle offset with segments that do
-- not. It must load correctly on the single-node path rather than fail.
set enable_local_first_tablet_write = true;
create table t_no_bundle (k1 bigint, k2 int, v1 string)
    duplicate key(k1, k2)
    distributed by hash(k1) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'false');
insert into t_no_bundle select generate_series, cast(generate_series % 7 as int), concat('v', generate_series) from table(generate_series(1, 20000));
select count(*), sum(k1) from t_no_bundle;

-- A primary-key table is NOT refused. Spreading a tablet's rows leaves no order between rows that
-- share a key, which the caller opts into; ordering BETWEEN transactions is unaffected, which is
-- what the second load asserts here.
create table t_pk (k1 bigint, k2 int, v1 string)
    primary key(k1, k2)
    distributed by hash(k1, k2) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'true', 'enable_persistent_index' = 'true');
insert into t_pk select generate_series, cast(generate_series % 7 as int), concat('v', generate_series) from table(generate_series(1, 20000));
insert into t_pk select generate_series, cast(generate_series % 7 as int), concat('w', generate_series) from table(generate_series(1, 20000));
select count(*), sum(k1) from t_pk;
select k1, k2, v1 from t_pk where k1 = 12345;

-- Bucket-level parallelism already fills the cluster here, so the gate keeps the feature out of it
-- regardless of the session variable. Correctness is unchanged either way.
create table t_many_buckets (k1 bigint, k2 int, v1 string)
    duplicate key(k1, k2)
    distributed by hash(k1) buckets 16
    properties('replication_num' = '1', 'file_bundling' = 'true');
insert into t_many_buckets select generate_series, cast(generate_series % 7 as int), concat('v', generate_series) from table(generate_series(1, 20000));
select count(*), sum(k1) from t_many_buckets;

drop database db_${uuid0} force;
