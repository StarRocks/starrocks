-- Do not explicitly enable partitionwise aggregation: the key types must select it.
-- RowsSpilled/RowsRestored alone can include buffered rows. Require positive bytes
-- written to storage AND read back, allowing either local or remote spill storage.
create view assert_spill_readback as
select assert_true(coalesce(max(cast(nullif(regexp_extract(line,
           'BytesFlushTo(LocalDisk|RemoteStorage): ([0-9.]+)', 2), '') as double)), 0) > 0) as spilled,
       assert_true(coalesce(max(cast(nullif(regexp_extract(line,
           'BytesRestoreFrom(LocalDisk|RemoteStorage): ([0-9.]+)', 2), '') as double)), 0) > 0) as restored
from table(unnest(split(coalesce(get_query_profile(last_query_id()), ''), '\n'))) p(line);
-- result:
-- !result

create view derived_map_agg as
select tags['app'] as app, date_trunc('hour', ts) as hr, sum(v) as total
from facts
where tags['app'] in
      (select tags['app'] from facts where ts >= '2026-10-01')
group by tags['app'], date_trunc('hour', ts);
-- result:
-- !result

create view direct_map_agg as
select count(*) as group_count, sum(s) as total, max(s) as max_total
from (select tags, sum(v) as s from facts group by tags) t;
-- result:
-- !result

create view array_map_agg as
select count(*) as group_count, sum(s) as total, max(s) as max_total
from (select [tags] as k, sum(v) as s from facts group by [tags]) t;
-- result:
-- !result

create view struct_map_agg as
select count(*) as group_count, sum(s) as total, max(s) as max_total
from (select named_struct('m', tags) as k, sum(v) as s
      from facts group by named_struct('m', tags)) t;
-- result:
-- !result

create view distinct_map as
select count(*) as group_count, sum(coalesce(cardinality(tags), 0)) as entries
from (select distinct tags from facts) t;
-- result:
-- !result

-- The customer shape must actually push an aggregate below the semi join and
-- introduce the raw MAP as a grouping key, not merely aggregate scalar app/hour.
function: assert_explain_matches("select * from derived_map_agg", "LEFT SEMI JOIN", "group by: [0-9]+: ts, [0-9]+: tags")
