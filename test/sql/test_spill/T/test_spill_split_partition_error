-- name: test_spill_split_partition_error @sequential

set enable_spill=true;
set spill_mode="force";
set pipeline_dop=1;
set spill_mem_table_size=262144;
set spill_mem_table_num=2;

CREATE TABLE t1 (
    k1 INT,
    k2 VARCHAR(64),
    k3 VARCHAR(128))
DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 8 PROPERTIES('replication_num'='1');
insert into t1 SELECT generate_series,
                      concat('key-', generate_series),
                      concat('payload-', repeat('x', 40), '-', generate_series)
               FROM TABLE(generate_series(1, 1000000));

-- Fail a hash-join partition split once it has already moved part of the partition into its two
-- halves, and make the flush task yield right afterwards.
--
-- Regression: _split_input_partitions() checked the yield flag before the split status, so a split
-- that failed while the task happened to exhaust its time slice lost the error for good. The
-- DeferOp in _split_partition() had already flushed the two halves on the way out and marked their
-- mem tables done(), so the resubmitted task returned early on is_done() and reported the split as
-- complete, and the query never learned that a partition had only been half split. Without the fix
-- this case shows exactly that: the injected error never reaches the client and the query returns
-- as if nothing had gone wrong.
--
-- That swallowed error is what let a half-written partition survive into the restore phase in
-- production, where the chunk left behind by an allocation failure was a binary column whose
-- offsets promised bytes its payload buffer did not hold, and the BE died at address 0 in
--
--   BinaryColumnBase<uint32>::append <- JoinHashTable::append_chunk
--     <- SingleHashJoinBuilder::do_append_chunk
--     <- SpillableHashJoinProbeOperator::_load_partition_build_side
--
-- The query must now fail with the injected error instead of carrying on.
admin enable failpoint 'spill_split_partition_error';
admin enable failpoint 'spill_split_yield_after_error';

select count(l.k1),count(l.k2),count(l.k3) from t1 l join t1 r on l.k1 = r.k1;

admin disable failpoint 'spill_split_yield_after_error';
admin disable failpoint 'spill_split_partition_error';

-- The same query must be correct again, proving the BE survived and that the failed split left no
-- partition behind that looks complete.
select count(l.k1),count(l.k2),count(l.k3) from t1 l join t1 r on l.k1 = r.k1;

CLEANUP {
    admin disable failpoint 'spill_split_yield_after_error';
    admin disable failpoint 'spill_split_partition_error';
} END CLEANUP
