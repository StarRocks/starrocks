-- name: test_spill_partition_wise_agg_restore_cancelled @sequential

CREATE TABLE `t0` (
  `c0` int(11) NULL COMMENT "",
  `c1` varchar(20) NULL COMMENT ""
) ENGINE=OLAP
DUPLICATE KEY(`c0`)
COMMENT "OLAP"
DISTRIBUTED BY HASH(`c0`) BUCKETS 1
PROPERTIES (
"replication_num" = "1"
);

insert into t0 SELECT generate_series, generate_series FROM TABLE(generate_series(1,  1000000));

admin enable failpoint 'spill_restore_sleep';
-- The query times out while partition restore tasks are still sleeping in flight. The source operator then closes
-- and frees the aggregator's spiller; the restore completion must not touch it afterwards.
select /*+SET_VAR(query_timeout=20,pipeline_dop=1,new_planner_agg_stage=3,spill_mode='force',enable_spill=true,spill_partitionwise_agg=true,spill_operator_min_bytes=1024,spill_mem_table_size=1024) */ count(*), sum(murmur_hash3_32(c1, cnt)) from (select c1, count(*) cnt from t0 group by c1) t;
admin disable failpoint 'spill_restore_sleep';

function: wait_util_no_queries()
shell: sleep 25

select /*+SET_VAR(pipeline_dop=1,new_planner_agg_stage=3,spill_mode='force',enable_spill=true,spill_partitionwise_agg=true,spill_operator_min_bytes=1024,spill_mem_table_size=1024) */ count(*), sum(murmur_hash3_32(c1, cnt)) from (select c1, count(*) cnt from t0 group by c1) t;

CLEANUP {
  admin disable failpoint 'spill_restore_sleep';
} END CLEANUP
