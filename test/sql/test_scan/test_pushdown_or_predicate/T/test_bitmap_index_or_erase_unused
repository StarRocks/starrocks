-- name: test_bitmap_index_or_erase_unused
-- Regression: (a=1 AND b=2) can use the bitmap index, but the enclosing OR is not used because its own leaf
-- c=7 fails the selectivity gate (c has only 3 distinct values). The OR's bitmap never narrows the scan, so
-- a=1 and b=2 must stay in the residual predicate. Before the fix they were erased and row 100001 was lost.
set scan_or_to_union_limit = 1;
CREATE TABLE t_or_bitmap_erase_${uuid0} (
  id BIGINT NOT NULL,
  a  INT    NOT NULL,
  b  INT    NOT NULL,
  c  INT    NOT NULL,
  d  INT    NOT NULL,
  INDEX idx_a (a) USING BITMAP,
  INDEX idx_b (b) USING BITMAP,
  INDEX idx_c (c) USING BITMAP,
  INDEX idx_d (d) USING BITMAP
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
-- One INSERT so every row shares a segment. a, b and d have >= 1000 distinct values, so they pass the bitmap
-- selectivity gate (bitmap_max_filter_ratio=1). c has 3 distinct values, so it fails the gate.
INSERT INTO t_or_bitmap_erase_${uuid0}
SELECT generate_series, generate_series + 1000, generate_series + 1000, 10 + generate_series % 2, generate_series + 1000
FROM TABLE(generate_series(1, 5000))
UNION ALL SELECT 100001, 1, 2, 10, 1
UNION ALL SELECT 100002, 5, 5, 7, 1
UNION ALL SELECT 100003, 1, 3, 10, 1;
-- 100001 matches (a=1 AND b=2), 100002 matches c=7, 100003 matches neither.
select id from t_or_bitmap_erase_${uuid0} where d = 1 and ((a = 1 and b = 2) or c = 7) order by id;
drop table t_or_bitmap_erase_${uuid0};
