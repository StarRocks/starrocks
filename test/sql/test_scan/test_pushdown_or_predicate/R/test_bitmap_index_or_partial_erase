-- name: test_bitmap_index_or_partial_erase
-- Regression: in (b = 1 AND (c = 1 OR c = 2)) OR (b = 2 AND c = 3), the inner OR fails the bitmap selectivity gate
-- (c has 10 distinct values), but its AND passes on b alone and the outer OR is used. The outer OR's bitmap narrows the
-- scan to the union of its children, (b = 2 AND c = 3) is fully erased, and before the fix the eraser dropped it from
-- the residual OR, leaving only (c = 1 OR c = 2). Row 100002 matches (b = 2 AND c = 3) and was lost.
set scan_or_to_union_limit = 1;
-- result:
-- !result
CREATE TABLE t_or_bitmap_partial_erase_${uuid0} (
  id BIGINT NOT NULL,
  b  INT    NOT NULL,
  c  INT    NOT NULL,
  d  INT    NOT NULL,
  INDEX idx_b (b) USING BITMAP,
  INDEX idx_c (c) USING BITMAP,
  INDEX idx_d (d) USING BITMAP
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
-- result:
-- !result
INSERT INTO t_or_bitmap_partial_erase_${uuid0}
SELECT generate_series, 1000 + generate_series % 3000, generate_series % 10, generate_series + 1000
FROM TABLE(generate_series(1, 30000))
UNION ALL SELECT 100001, 1, 1, 1
UNION ALL SELECT 100002, 2, 3, 1
UNION ALL SELECT 100003, 1, 3, 1
UNION ALL SELECT 100004, 2, 1, 1;
-- result:
-- !result
select id from t_or_bitmap_partial_erase_${uuid0} where d = 1 and ((b = 1 and (c = 1 or c = 2)) or (b = 2 and c = 3)) order by id;
-- result:
100001
100002
-- !result
select /*+ SET_VAR(enable_pushdown_or_predicate = false) */ id from t_or_bitmap_partial_erase_${uuid0} where d = 1 and ((b = 1 and (c = 1 or c = 2)) or (b = 2 and c = 3)) order by id;
-- result:
100001
100002
-- !result
drop table t_or_bitmap_partial_erase_${uuid0};
