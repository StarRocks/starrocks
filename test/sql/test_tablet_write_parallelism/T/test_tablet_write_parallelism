-- name: test_tablet_write_parallelism @cloud
create database db_${uuid0};
use db_${uuid0};

-- One bucket on purpose: this is the shape tablet_write_parallelism exists for -- without it the
-- whole load lands on the single compute node that owns the tablet. `file_bundling` is required,
-- not incidental: it is what puts the transaction on combined txn logs (each writing node emits a
-- PARTIAL txn log and the sender folds them into one) and what makes every segment carry its own
-- bundle filename plus offset, so segments written into different nodes' bundles can be folded
-- into one rowset.
create table t_shard (k1 bigint, k2 int, v1 string, v2 bigint)
    duplicate key(k1, k2)
    distributed by hash(k1) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'true');

set tablet_write_parallelism = 3;

-- Enough rows for many chunks, so the load actually lands data on more than whichever node
-- happened to receive the first chunk.
insert into t_shard select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), count(distinct k1), sum(k1), sum(v2) from t_shard;

-- A second transaction into the same tablet: the folded rowsets must accumulate, not replace.
insert into t_shard select generate_series, cast(generate_series % 7 as int), concat('w', generate_series), generate_series * 5 from table(generate_series(1, 20000));
select count(*), sum(v2) from t_shard;
select k1, k2, v1, v2 from t_shard where k1 = 12345 order by v1;

-- Deletes must still erase rows written by earlier transactions.
delete from t_shard where k1 <= 10000;
select count(*), sum(k1), sum(v2) from t_shard;

-- -1 asks for every alive compute node, which is what local-first routing needs so that each sink
-- instance can keep its rows on its own machine.
set tablet_write_parallelism = -1;
truncate table t_shard;
insert into t_shard select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), sum(k1), sum(v2) from t_shard;

-- The round-robin spread must give the same answer as local-first.
set tablet_write_local_first = false;
truncate table t_shard;
insert into t_shard select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), sum(k1), sum(v2) from t_shard;
set tablet_write_local_first = true;

-- Back to the default parallelism: the same load must give exactly the same answer.
set tablet_write_parallelism = 1;
truncate table t_shard;
insert into t_shard select generate_series, cast(generate_series % 7 as int), concat('v', generate_series), generate_series * 3 from table(generate_series(1, 20000));
select count(*), sum(k1), sum(v2) from t_shard;

-- A table without file bundling is refused (no combined txn log to fold into, and a rowset that
-- would mix bundled and unbundled segments); it must load correctly on the single-node path rather
-- than fail. A primary-key table is NOT refused: spreading a tablet's rows leaves no order between
-- rows sharing a key, which is a precondition the session opts into rather than something the
-- system can check. Ordering BETWEEN transactions is unaffected -- the second load below asserts it.
set tablet_write_parallelism = 3;
create table t_no_bundle (k1 bigint, k2 int, v1 string)
    duplicate key(k1, k2)
    distributed by hash(k1) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'false');
insert into t_no_bundle select generate_series, cast(generate_series % 7 as int), concat('v', generate_series) from table(generate_series(1, 20000));
select count(*), sum(k1) from t_no_bundle;

create table t_pk (k1 bigint, k2 int, v1 string)
    primary key(k1, k2)
    distributed by hash(k1, k2) buckets 1
    properties('replication_num' = '1', 'file_bundling' = 'true', 'enable_persistent_index' = 'true');
insert into t_pk select generate_series, cast(generate_series % 7 as int), concat('v', generate_series) from table(generate_series(1, 20000));
insert into t_pk select generate_series, cast(generate_series % 7 as int), concat('w', generate_series) from table(generate_series(1, 20000));
select count(*), sum(k1) from t_pk;
select k1, k2, v1 from t_pk where k1 = 12345;

drop database db_${uuid0} force;
