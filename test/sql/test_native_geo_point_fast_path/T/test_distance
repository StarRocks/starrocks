-- name: test_native_geo_distance_point_fast_path
SELECT id, ST_Distance(ST_GeomFromWKB(UNHEX(wkb),'EPSG:4326'),ST_GeomFromText('POINT (3 4)','EPSG:4326')), ST_Distance(ST_GeogFromWKB(UNHEX(wkb)),ST_GeogFromWKB(UNHEX(wkb))) FROM (SELECT 1 AS id, '010100000000000000000000000000000000000000' AS wkb UNION ALL SELECT 2,'000000000140080000000000004010000000000000' UNION ALL SELECT 3,NULL UNION ALL SELECT 4,'0101000000000000000000F87F000000000000F87F') points ORDER BY id;
SELECT ST_Distance(ST_GeomFromText('POINT (0 0)','EPSG:4326'),ST_GeomFromText('POINT (3 4)','EPSG:4326')), ST_Distance(ST_GeogFromText('POINT (0 0)'),ST_GeogFromText('POINT (1 0)')) BETWEEN 111195.10117748 AND 111195.10117749;
SELECT ST_Distance(ST_GeomFromText('POINT EMPTY','EPSG:4326'),ST_GeomFromText('POINT (0 0)','EPSG:4326')), ST_Distance(ST_GeogFromText('POINT (0 0)'),ST_GeogFromText('POINT EMPTY')), ST_Distance(ST_GeomFromWKB(CAST(NULL AS VARBINARY),'EPSG:4326'),ST_GeomFromText('POINT (0 0)','EPSG:4326'));
SELECT ST_Distance(ST_GeomFromText('POINT (0 1)','EPSG:4326'),ST_GeomFromText('LINESTRING (-1 0,1 0)','EPSG:4326')), ST_Distance(ST_GeogFromText('POINT (0 1)'),ST_GeogFromText('LINESTRING (-1 0,1 0)')) BETWEEN 111195.10 AND 111195.11;
