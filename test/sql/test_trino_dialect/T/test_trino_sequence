set sql_dialect='trino';
select sequence(1, 5);
select sequence(5, 1);
select sequence(1, 10, 3);
select sequence(3, 3, -1);
select sequence(a, b) from (select 5 as a, 1 as b union all select 1, 3) t order by a;
select sequence(a, b, c) from (select cast(null as bigint) as a, 3 as b, 0 as c) t;
select sequence(a, NULL) from (select 1 as a) t;
select sequence(1, 3, 0);
select sequence(1, 3, -1);
select cardinality(sequence(1, 10000));
select sequence(0, 10000);
