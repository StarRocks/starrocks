-- name: testTrinoFormat
CREATE TABLE format_tbl
    (c1 int,
    c_str varchar(16),
    c_int int,
    c_big bigint,
    c_dec decimal(10, 3),
    c_bool boolean,
    c_date date)
    DUPLICATE KEY(c1)
    DISTRIBUTED BY HASH(c1)
    BUCKETS 1
    PROPERTIES ("replication_num" = "1");
-- result:
-- !result
insert into format_tbl values
(1, 'a', 8, -1234567, 2.675, true, '2026-01-02'),
(2, 'bc', -8, 0, -0.005, false, '0999-12-31'),
(3, null, null, null, null, null, null),
(4, '', 12345, 9223372036854775807, 1234567.891, true, '2026-11-18');
-- result:
-- !result
set sql_dialect='trino';
-- result:
-- !result
select c1, format('%s|%s|%s|%s|%s', c_str, c_int, c_big, c_bool, c_date) from format_tbl order by c1;
-- result:
1	a|8|-1234567|true|2026-01-02
2	bc|-8|0|false|0999-12-31
3	null|null|null|null|null
4	|12345|9223372036854775807|true|2026-11-18
-- !result
select c1, format('%03d|%-5d|%5d|%d', c_int, c_int, c_int, c_big) from format_tbl order by c1;
-- result:
1	008|8    |    8|-1234567
2	-08|-8   |   -8|0
3	null|null | null|null
4	12345|12345|12345|9223372036854775807
-- !result
select c1, format('%.2f|%.0f|%f|%,.2f', c_dec, c_dec, c_dec, c_dec) from format_tbl order by c1;
-- result:
1	2.68|3|2.675000|2.68
2	-0.01|-0|-0.005000|-0.01
3	nu||null|nu
4	1234567.89|1234568|1234567.891000|1,234,567.89
-- !result
select c1, format('%2$s-%1$s %%', c_str, c_int) from format_tbl order by c1;
-- result:
1	8-a %
2	-8-bc %
3	null-null %
4	12345- %
