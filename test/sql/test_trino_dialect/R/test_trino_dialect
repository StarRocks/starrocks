-- name: testTrinoDialect
CREATE TABLE map_array_tbl
    (c1 int,
    c2 map<varchar(8), int>,
    c3 array<int>)
    PRIMARY KEY(c1)
    DISTRIBUTED BY HASH(c1)
    BUCKETS 1
    PROPERTIES ("replication_num" = "1");
-- result:
-- !result
insert into map_array_tbl values
(1, map{"key1":1}, [1]),
(2, map{"key1":5, "key2":6}, [1, 2]),
(3, null, null);
-- result:
-- !result
select c2['key1'], c3[1] from map_array_tbl order by c1;
-- result:
1	1
5	1
None	None
-- !result
select c2['not-existed'] from map_array_tbl order by c1;
-- result:
None
None
None
-- !result
select c3[100] from map_array_tbl order by c1;
-- result:
None
None
None
-- !result
select element_at(c2, 'not-existed'), element_at(c3, 100) from map_array_tbl order by c1;
-- result:
None	None
None	None
None	None
-- !result
set sql_dialect='trino';
-- result:
-- !result
select c2['key1'], c3[1] from map_array_tbl order by c1;
-- result:
1	1
5	1
None	None
-- !result
select c2['not-existed'] from map_array_tbl order by c1;
-- result:
[REGEX].*Key not present in map: 'not-existed'.*
-- !result
select c3[100] from map_array_tbl order by c1;
-- result:
[REGEX].*Array subscript must be less than or equal to array length: 100 > 1.*
-- !result
select element_at(c2, 'not-existed'), element_at(c3, 100) from map_array_tbl order by c1;
-- result:
None	None
None	None
None	None
-- !result
select sequence(a, b, c) from (select 1 as a, 3 as b, cast(null as bigint) as c) t;
-- result:
None
-- !result
select sequence(a, b, c) from (select 3 as a, 1 as b, -1 as c) t;
-- result:
[3,2,1]
-- !result
select sequence(1, 3, -1);
-- result:
[REGEX].*sequence stop value should be greater than or equal to start value.*
-- !result
select sequence(DATE '2024-01-03', DATE '2024-01-01', INTERVAL -'1' DAY);
-- result:
["2024-01-03","2024-01-02","2024-01-01"]
-- !result
select sequence(a, b, c) from (select cast(null as bigint) as a, 3 as b, 0 as c) t;
-- result:
None
-- !result
select sequence(1, 3, 0);
-- result:
[REGEX].*step must not be zero.*
-- !result
select sequence(a, NULL) from (select 1 as a) t;
-- result:
None
-- !result
select sequence(NULL, a) from (select 1 as a) t;
-- result:
None
-- !result