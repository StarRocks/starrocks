-- name: testTrinoStandaloneUnnest
set sql_dialect='trino';
-- result:
-- !result
select x from unnest(array[1, 2, 3]) as t(x) order by x;
-- result:
1
2
3
-- !result
select * from unnest(array[1, 2], array['a', 'b', 'c']) as t(x, y) order by y;
-- result:
1	a
2	b
None	c
-- !result
select t.x, s.v from unnest(array[1, 2]) as t(x) join (select 2 as k, 'two' as v) s on t.x = s.k;
-- result:
2	two
-- !result