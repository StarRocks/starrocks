-- name: test_generated_column_show_create_collection
-- SHOW CREATE TABLE of a generated column that contains an array or map literal must not fail
-- and must render executable SQL (no PseudoType prefix).
create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t_arr (id int, a int, b int, c boolean AS array_contains([a, b], 3))
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_map (id int, s varchar(20), m varchar(20) AS map{1: s}[1])
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_mapf (id int, s varchar(20), m varchar(20) AS map(1, s)[1])
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_typed (id int, a int, x boolean AS array_contains(ARRAY<BIGINT>[1, 2], a))
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");

insert into t_arr values (1, 1, 3), (2, 1, 2);
insert into t_map values (1, 'v1'), (2, NULL);
insert into t_mapf values (1, 'v1'), (2, NULL);
insert into t_typed values (1, 1), (2, 3);

select * from t_arr order by id;
select * from t_map order by id;
select * from t_mapf order by id;
select * from t_typed order by id;

function: assert_query_contains("show create table t_arr", "AS array_contains([`a`, `b`], 3)")
function: assert_query_contains("show create table t_map", "AS map{1:`s`}[1]")
function: assert_query_contains("show create table t_mapf", "AS map{1:`s`}[1]")
function: assert_query_contains("show create table t_typed", "AS array_contains(ARRAY<BIGINT>[1, 2], `a`)")

-- The rendered generated column definitions can be executed again and compute the same values.
CREATE TABLE t_arr_copy (id int, a int, b int, c boolean NULL AS array_contains([`a`, `b`], 3))
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_map_copy (id int, s varchar(20), m varchar(20) NULL AS map{1:`s`}[1])
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
insert into t_arr_copy values (1, 1, 3), (2, 1, 2);
insert into t_map_copy values (1, 'v1'), (2, NULL);
select * from t_arr_copy order by id;
select * from t_map_copy order by id;
function: assert_query_contains("show create table t_arr_copy", "AS array_contains([`a`, `b`], 3)")
function: assert_query_contains("show create table t_map_copy", "AS map{1:`s`}[1]")

drop database db_${uuid0} force;

-- name: test_pk_generated_column_show_create
-- Primary key tables render columns through another method of Column. SHOW CREATE TABLE must keep the struct
-- subfield valid and the type of a typed array literal, and CREATE TABLE LIKE must replay the rendered DDL.
create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t_pk (id int NOT NULL, a int, b int, d date, s varchar(20),
x int AS named_struct('f', a).f, y boolean AS array_contains(ARRAY<DATE>['2020-1-1'], d),
c boolean AS array_contains([a, b], 3), m varchar(20) AS map{1: s}[1])
PRIMARY KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_pk_like LIKE t_pk;
insert into t_pk values (1, 10, 3, '2020-01-01', 'v1'), (2, 20, 2, '2020-01-02', NULL);
insert into t_pk_like values (1, 10, 3, '2020-01-01', 'v1'), (2, 20, 2, '2020-01-02', NULL);
select * from t_pk order by id;
select * from t_pk_like order by id;

function: assert_query_contains("show create table t_pk", "`a`).`f` COMMENT")
function: assert_query_contains("show create table t_pk", "AS array_contains(ARRAY<DATE>[")
function: assert_query_contains("show create table t_pk", "AS array_contains([`a`, `b`], 3)")
function: assert_query_contains("show create table t_pk", "AS map{1:`s`}[1]")
function: assert_query_contains("show create table t_pk_like", "`a`).`f` COMMENT")
function: assert_query_contains("show create table t_pk_like", "AS array_contains(ARRAY<DATE>[")
function: assert_query_contains("show create table t_pk_like", "AS array_contains([`a`, `b`], 3)")
function: assert_query_contains("show create table t_pk_like", "AS map{1:`s`}[1]")

drop database db_${uuid0} force;
