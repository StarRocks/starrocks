-- name: test_orc_nan_min_max
-- An ORC writer keeps min = max = NaN when the first value of a row group is NaN; such bounds must not skip it.

create external catalog hive_orc_nan_${uuid0} PROPERTIES ("type"="hive",
    "hive.metastore.uris"="${hive_metastore_uris}",
    "aws.s3.access_key"="${oss_ak}",
    "aws.s3.secret_key"="${oss_sk}",
    "aws.s3.endpoint"="${oss_endpoint}"
);
set catalog hive_orc_nan_${uuid0};
create database hive_db_${uuid0} properties ("location" = "oss://${oss_bucket}/orc_nan_db_${uuid0}");
use hive_db_${uuid0};

-- written by the ORC C++ writer: rows (0, NaN, NaN), (1, 1, 1), (2, 10, 10), (3, 3, 3), every bound NaN
create table t1(id int, x double, y float) properties("file_format"="orc", "location"="oss://${oss_bucket}/orc_nan_db_${uuid0}/t1");
shell: ossutil64 cp ./sql/test_hive/data/nan_first_value.orc oss://${oss_bucket}/orc_nan_db_${uuid0}/t1/nan_first_value.orc > /dev/null
select id from t1 order by id;
select id from t1 where x > 5 order by id;
select id from t1 where x < 2 order by id;
select id from t1 where x = 10 order by id;
select id from t1 where x between 2 and 11 order by id;
select id from t1 where y > 5 order by id;
select id from t1 where y <= 3 order by id;

drop table t1 force;
drop database hive_db_${uuid0};
drop catalog hive_orc_nan_${uuid0};
set catalog default_catalog;

shell: ossutil64 rm -rf oss://${oss_bucket}/orc_nan_db_${uuid0} >/dev/null || echo "exit 0" >/dev/null
