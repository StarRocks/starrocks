-- name: test_rf_prune_range_date_broadcast
create database test_rf_prune_${uuid0};
use test_rf_prune_${uuid0};
set enable_runtime_filter_partition_prune = true;
set global_runtime_filter_wait_timeout = 10000;
CREATE TABLE fact_dt (dt DATE NOT NULL, id INT NOT NULL, v INT) ENGINE=OLAP
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(dt) (
    PARTITION p0105 VALUES [('2024-01-05'), ('2024-01-06')),
    PARTITION p0106 VALUES [('2024-01-06'), ('2024-01-07')),
    PARTITION p0107 VALUES [('2024-01-07'), ('2024-01-08')),
    PARTITION p0108 VALUES [('2024-01-08'), ('2024-01-09')),
    PARTITION p0109 VALUES [('2024-01-09'), ('2024-01-10'))
)
DISTRIBUTED BY HASH(id) BUCKETS 2
PROPERTIES ("replication_num" = "1");
INSERT INTO fact_dt VALUES
    ('2024-01-05', 1, 10), ('2024-01-05', 2, 11),
    ('2024-01-06', 3, 20), ('2024-01-06', 4, 21),
    ('2024-01-07', 5, 30), ('2024-01-07', 6, 31),
    ('2024-01-08', 7, 40), ('2024-01-08', 8, 41),
    ('2024-01-09', 9, 50), ('2024-01-09', 10, 51);
CREATE TABLE dim_dt (dt DATE NOT NULL, name VARCHAR(16)) ENGINE=OLAP
DUPLICATE KEY(dt) DISTRIBUTED BY HASH(dt) BUCKETS 1 PROPERTIES ("replication_num" = "1");
-- one build value: only p0107 survives, 4 partitions x 2 buckets pruned
INSERT INTO dim_dt VALUES ('2024-01-07', 'hit');
SELECT f.dt, f.id, f.v FROM fact_dt f JOIN [broadcast] dim_dt d ON f.dt = d.dt ORDER BY f.id;
-- build values on the partition lower bounds: p0105 and p0109 survive
TRUNCATE TABLE dim_dt;
INSERT INTO dim_dt VALUES ('2024-01-05', 'lower'), ('2024-01-09', 'lower');
SELECT f.dt, f.id FROM fact_dt f JOIN [broadcast] dim_dt d ON f.dt = d.dt ORDER BY f.id;
-- no build value matches any partition: everything pruned, zero rows
TRUNCATE TABLE dim_dt;
INSERT INTO dim_dt VALUES ('2024-03-01', 'miss');
SELECT count(*), ifnull(sum(f.v), 0) FROM fact_dt f JOIN [broadcast] dim_dt d ON f.dt = d.dt;
-- every partition has a build value: nothing pruned, all rows
TRUNCATE TABLE dim_dt;
INSERT INTO dim_dt VALUES ('2024-01-05', 'a'), ('2024-01-06', 'b'), ('2024-01-07', 'c'), ('2024-01-08', 'd'), ('2024-01-09', 'e');
SELECT count(*), sum(f.v) FROM fact_dt f JOIN [broadcast] dim_dt d ON f.dt = d.dt;
-- switch off: the same rows come back
set enable_runtime_filter_partition_prune = false;
TRUNCATE TABLE dim_dt;
INSERT INTO dim_dt VALUES ('2024-01-07', 'c');
SELECT f.dt, f.id, f.v FROM fact_dt f JOIN [broadcast] dim_dt d ON f.dt = d.dt ORDER BY f.id;
drop database test_rf_prune_${uuid0} force;


