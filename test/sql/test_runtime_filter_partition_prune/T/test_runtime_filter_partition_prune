-- name: test_rf_prune_list_string
create database test_rf_prune_${uuid0};
use test_rf_prune_${uuid0};
set enable_runtime_filter_partition_prune = true;
-- a low-cardinality dictionary would rewrite the probe slot to an integer, which the pruner skips
set cbo_enable_low_cardinality_optimize = false;
set global_runtime_filter_wait_timeout = 10000;
CREATE TABLE fact_city (city VARCHAR(16), id INT NOT NULL, v INT) ENGINE=OLAP
DUPLICATE KEY(city, id)
PARTITION BY LIST(city) (
    PARTITION pbj VALUES IN ('beijing'),
    PARTITION psh VALUES IN ('shanghai', 'shenzhen', 'guangzhou'),
    PARTITION pnull VALUES IN (NULL)
)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO fact_city VALUES ('beijing', 1, 1), ('shanghai', 2, 2), ('shenzhen', 3, 3), ('guangzhou', 4, 4), (NULL, 5, 5);
CREATE TABLE dim_city (city VARCHAR(16)) ENGINE=OLAP DUPLICATE KEY(city) DISTRIBUTED BY HASH(city) BUCKETS 1 PROPERTIES ("replication_num" = "1");
-- plain equality: the planner already drops the NULL-only partition through the derived IS NOT NULL, so 2 candidates remain and 'shenzhen' keeps only psh
INSERT INTO dim_city VALUES ('shenzhen');
SELECT f.city, f.id FROM fact_city f JOIN [broadcast] dim_city d ON f.city = d.city ORDER BY f.id;
-- null-safe equality with a NULL build key: all 3 partitions are candidates and the NULL row must survive, so pnull stays
INSERT INTO dim_city VALUES (NULL);
SELECT f.city, f.id FROM fact_city f JOIN [broadcast] dim_city d ON f.city <=> d.city ORDER BY f.id;
-- plain equality with the same build side: back to 2 candidates, NULL cannot match
SELECT f.city, f.id FROM fact_city f JOIN [broadcast] dim_city d ON f.city = d.city ORDER BY f.id;
-- CHAR partition column: the join runtime IN filter is built on the CHAR probe slot
CREATE TABLE fact_code (code CHAR(8) NOT NULL, id INT NOT NULL, v INT) ENGINE=OLAP
DUPLICATE KEY(code, id)
PARTITION BY LIST(code) (
    PARTITION pa VALUES IN ('AA'),
    PARTITION pb VALUES IN ('BB'),
    PARTITION pc VALUES IN ('CC')
)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO fact_code VALUES ('AA', 1, 1), ('BB', 2, 2), ('CC', 3, 3);
CREATE TABLE dim_code (code CHAR(8) NOT NULL) ENGINE=OLAP DUPLICATE KEY(code) DISTRIBUTED BY HASH(code) BUCKETS 1 PROPERTIES ("replication_num" = "1");
INSERT INTO dim_code VALUES ('BB');
SELECT f.code, f.id FROM fact_code f JOIN [broadcast] dim_code d ON f.code = d.code ORDER BY f.id;
-- a partition holding NULL next to a real value stays a candidate under `=`: only its NULL rows can never match
CREATE TABLE fact_mix (city VARCHAR(16), id INT NOT NULL) ENGINE=OLAP
DUPLICATE KEY(city, id)
PARTITION BY LIST(city) (
    PARTITION pmix VALUES IN ('guangzhou', NULL),
    PARTITION psh VALUES IN ('shanghai')
)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO fact_mix VALUES ('guangzhou', 1), (NULL, 2), ('shanghai', 3);
TRUNCATE TABLE dim_city;
INSERT INTO dim_city VALUES ('guangzhou');
SELECT f.city, f.id FROM fact_mix f JOIN [broadcast] dim_city d ON f.city = d.city ORDER BY f.id;
-- the same partition is pruned once no build value can live in it
TRUNCATE TABLE dim_city;
INSERT INTO dim_city VALUES ('shanghai');
SELECT f.city, f.id FROM fact_mix f JOIN [broadcast] dim_city d ON f.city = d.city ORDER BY f.id;
drop database test_rf_prune_${uuid0} force;


