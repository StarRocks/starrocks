-- name: test_non_eq_correlated_subquery
CREATE TABLE ne_outer (
  id int,
  k int,
  ts int
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 2
PROPERTIES("replication_num" = "1");
-- result:
-- !result
CREATE TABLE ne_inner (
  k int,
  ts int,
  v int
) ENGINE=OLAP
DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2
PROPERTIES("replication_num" = "1");
