-- name: test_redistribute @cloud
[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");
CREATE TABLE t_hash (
    k BIGINT NOT NULL,
    v BIGINT
) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO t_hash VALUES (1, 10);
-- result:
-- !result
[UC]hash_bookmark_id=SELECT bookmark_create("${db[0]}", "t_hash", "sql_test", "1800000");
ALTER TABLE t_hash DISTRIBUTED BY HASH(k) BUCKETS 4;
-- result:
-- !result
function: wait_optimize_table_finish()
-- result:
None
-- !result
SELECT k FROM t_hash bk [_BOOKMARK_${hash_bookmark_id}_];
-- result:
[REGEX]E: \(1064, "Getting analyzing error\. Detail message: physical partition \d+ in bookmark \d+ no longer exists on table 't_hash'\."\)
-- !result
SET enable_range_distribution = true;
-- result:
-- !result
CREATE TABLE t_range (
    k BIGINT NOT NULL,
    v BIGINT
) DUPLICATE KEY(k)
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO t_range VALUES (1, 10);
-- result:
-- !result
[UC]range_bookmark_id=SELECT bookmark_create("${db[0]}", "t_range", "sql_test", "1800000");
function: set_first_tablet_id("t_range")
-- result:
None
-- !result
ALTER TABLE t_range SPLIT TABLET (${tablet_id}) PROPERTIES ('tablet_reshard_target_size' = '-2');
-- result:
-- !result
LOOP {
  PROPERTY: {"timeout": 60, "interval": 1, "desc": "wait for split tablet job to finish"}
  result=SELECT count(*) FROM INFORMATION_SCHEMA.tablet_reshard_jobs WHERE DB_NAME = database() AND TABLE_NAME = 't_range' AND JOB_TYPE = 'SPLIT_TABLET' AND JOB_STATE = 'FINISHED';
  CHECK: int(${result}[-1][0]) >= 1
} END LOOP
INSERT INTO t_range VALUES (2, 20);
-- result:
-- !result
SELECT k FROM t_range bk [_BOOKMARK_${range_bookmark_id}_] ORDER BY k;
-- result:
1
-- !result
[UC]SELECT bookmark_release("${db[0]}", "t_hash", "${hash_bookmark_id}", "sql_test");
[UC]SELECT bookmark_release("${db[0]}", "t_range", "${range_bookmark_id}", "sql_test");
