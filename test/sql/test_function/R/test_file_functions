-- name: test_to_file
select to_file(named_struct('content_type', 'image/jpeg', 'URI', 's3://bucket/a.jpg'));
-- result:
{"uri":"s3://bucket/a.jpg","offset":null,"size":null,"content_type":"image/jpeg","checksum":null,"inline":null}
-- !result
select to_file(named_struct('inline', to_binary('610062', 'hex'), 'size', 3, 'uri', NULL, 'offset', 0, 'checksum', 'opaque'));
-- result:
{"uri":null,"offset":0,"size":3,"content_type":null,"checksum":"opaque","inline":"610062"}
-- !result
select to_file(named_struct('inline', to_binary('', 'hex')));
-- result:
{"uri":null,"offset":null,"size":null,"content_type":null,"checksum":null,"inline":""}
-- !result
select to_file(named_struct('uri', '', 'offset', 0, 'size', 0));
-- result:
{"uri":"","offset":0,"size":0,"content_type":null,"checksum":null,"inline":null}
-- !result
select to_file(NULL) is null, to_file(cast(NULL as struct<uri varchar(20)>)) is null;
-- result:
1	1
-- !result
select to_file(named_struct('content_type', 'image/jpeg'));
-- result:
[REGEX].*TO_FILE requires exactly one.*
-- !result
select to_file(named_struct('inline', to_binary('', 'hex'), 'uri', ''));
-- result:
[REGEX].*TO_FILE requires exactly one.*
-- !result
select to_file(named_struct('uri', 'a', 'offset', -1));
-- result:
[REGEX].*TO_FILE field .*offset.*must be >= 0.*
-- !result
select to_file(named_struct('inline', to_binary('61', 'hex'), 'size', -1));
-- result:
[REGEX].*TO_FILE field .*size.*must be >= 0.*
-- !result
