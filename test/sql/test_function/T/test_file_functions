-- name: test_to_file
select to_file(named_struct('content_type', 'image/jpeg', 'URI', 's3://bucket/a.jpg'));
select to_file(named_struct('inline', to_binary('610062', 'hex'), 'size', NULL, 'uri', NULL, 'offset', NULL, 'checksum', 'opaque'));
select to_file(named_struct('inline', to_binary('', 'hex')));
select to_file(named_struct('uri', '', 'offset', 0, 'size', 0));
select to_file(NULL) is null, to_file(cast(NULL as struct<uri varchar(20)>)) is null;
select to_file(named_struct('content_type', 'image/jpeg'));
select to_file(named_struct('inline', to_binary('', 'hex'), 'uri', ''));
select to_file(named_struct('uri', 'a', 'offset', -1));
select to_file(named_struct('inline', to_binary('61', 'hex'), 'size', -1));
select to_file(named_struct('inline', to_binary('61', 'hex'), 'offset', 0));
select to_file(named_struct('inline', to_binary('61', 'hex'), 'size', 3));
create database test_to_file_${uuid0};
use test_to_file_${uuid0};
create table input_files (id int, uri char(16), payload varbinary, file_size int, metadata struct<uri varchar(256), size int>)
duplicate key(id) distributed by hash(id) buckets 1 properties("replication_num"="1");
insert into input_files values
(1, 'a.jpg', NULL, 12, named_struct('uri', 'a.jpg', 'size', 12)),
(2, NULL, to_binary('01', 'hex'), NULL, NULL),
(3, '', NULL, 0, named_struct('uri', '', 'size', 0));
select id, to_file(metadata), to_file(metadata) is null from input_files order by id;
select id, to_file(named_struct('size', file_size, 'uri', uri, 'inline', payload)) from input_files order by id;
select to_file(named_struct('size', file_size, 'uri', uri)) from input_files;
select to_file(named_struct('uri', 'a', 'inline', payload)) from input_files;
select to_file(named_struct('uri', uri, 'size', file_size - 13)) from input_files where id = 1;
select to_file(named_struct('uri', uri, 'offset', file_size - 13)) from input_files where id = 1;
drop database test_to_file_${uuid0};

-- name: test_file_getters
select fl_get_uri(f), fl_get_offset(f), fl_get_size(f), fl_get_content_type(f), fl_get_checksum(f), fl_get_inline(f) is null
from (select to_file(named_struct('URI', 'a.jpg', 'size', 12, 'offset', 0, 'checksum', 'opaque', 'content_type', 'image/jpeg')) f) t;
select fl_get_uri(f) is null, fl_get_offset(f) is null, fl_get_size(f) is null, fl_get_content_type(f) is null, fl_get_checksum(f) is null, hex(fl_get_inline(f))
from (select to_file(named_struct('inline', to_binary('610062', 'hex'))) f) t;
select length(fl_get_uri(to_file(named_struct('uri', '')))), length(fl_get_inline(to_file(named_struct('inline', to_binary('', 'hex')))));
select fl_get_uri(NULL) is null;

-- name: test_try_to_file
select try_to_file(NULL) is null, try_to_file(cast(NULL as struct<uri varchar(20)>)) is null;
select fl_get_uri(try_to_file(named_struct('uri', 'a', 'offset', -1))) is null;
select try_to_file(named_struct('path', 'a'));
select try_to_file(named_struct('uri', fl_get_uri(to_file(named_struct('uri', NULL)))));
select count(*), sum(cast(f is null as int)), sum(fl_get_size(f)) from (
select try_to_file(named_struct('uri', if(generate_series % 3 = 0, NULL, 'a'),
'size', if(generate_series % 5 = 0, -generate_series, generate_series))) f from table(generate_series(1, 10000))) t;
create database test_try_to_file_${uuid0};
use test_try_to_file_${uuid0};
create table input_files (id int, uri varchar(256), payload varbinary, file_offset bigint, file_size bigint)
duplicate key(id) distributed by hash(id) buckets 1 properties("replication_num"="1");
insert into input_files values
(1, 'a.jpg', NULL, 0, 12),
(2, NULL, to_binary('610062', 'hex'), NULL, NULL),
(3, NULL, NULL, 0, 0),
(4, 'both', to_binary('61', 'hex'), 0, 1),
(5, 'negative-offset', NULL, -1, 1),
(6, 'negative-size', NULL, 0, -1),
(7, '', NULL, NULL, NULL),
(8, NULL, to_binary('', 'hex'), 0, 0);
select id, f is null, fl_get_uri(f), hex(fl_get_inline(f)), fl_get_offset(f), fl_get_size(f)
from (select id, try_to_file(named_struct('uri', uri, 'inline', payload, 'offset', file_offset, 'size', file_size)) f from input_files) t order by id;
select id from input_files where try_to_file(named_struct('uri', uri, 'inline', payload, 'offset', file_offset, 'size', file_size)) is not null order by id;
create table input_metadata (id int, s struct<uri varchar(20), size bigint>)
duplicate key(id) distributed by hash(id) buckets 1 properties("replication_num"="1");
insert into input_metadata values (1, named_struct('uri', 'a', 'size', 1)), (2, NULL), (3, named_struct('uri', 'b', 'size', -1));
select id, try_to_file(s) is null, fl_get_uri(try_to_file(s)) from input_metadata order by id;
drop database test_try_to_file_${uuid0};

-- name: test_get_presigned
CREATE STORAGE VOLUME "presign_${uuid0}"
TYPE = S3
LOCATIONS = ("s3://${oss_bucket}/test_presign_${uuid0}/")
PROPERTIES
(
    "aws.s3.endpoint" = "${oss_endpoint}",
    "aws.s3.access_key" = "${oss_ak}",
    "aws.s3.secret_key" = "${oss_sk}"
);
select u like 'http%', u like '%X-Amz-Signature=%', u like '%X-Amz-Expires=3600%', u like '%dir/a.png?%'
from (select get_presigned_url('presign_${uuid0}', 's3://${oss_bucket}/dir/a.png') u) t;
select fl_get_uri(f) like 'http%', fl_get_uri(f) like '%X-Amz-Signature=%', fl_get_uri(f) like '%X-Amz-Expires=3600%', fl_get_offset(f), fl_get_size(f), fl_get_content_type(f), fl_get_checksum(f), fl_get_inline(f) is null
from (select get_presigned_file('presign_${uuid0}', to_file(named_struct('uri', 's3://${oss_bucket}/dir/a.png', 'offset', 0, 'size', 12, 'content_type', 'image/png', 'checksum', 'opaque'))) f) t;
select fl_get_uri(f) is null, hex(fl_get_inline(f)), fl_get_content_type(f)
from (select get_presigned_file('presign_${uuid0}', to_file(named_struct('inline', to_binary('610062', 'hex'), 'content_type', 'text/plain')), 60) f) t;
create database test_get_presigned_${uuid0};
use test_get_presigned_${uuid0};
create table media (id int, uri varchar(256), ttl bigint)
duplicate key(id) distributed by hash(id) buckets 1 properties("replication_num"="1");
insert into media values
(1, 's3://${oss_bucket}/dir/a.png', 60),
(2, NULL, 0),
(3, 'oss://${oss_bucket}/dir/b c.png', NULL),
(4, 'https://example.com/c.png', 0);
select id, u is null, u like '%X-Amz-Signature=%', u like concat('%X-Amz-Expires=', ifnull(ttl, 3600), '%')
from (select id, ttl, get_presigned_url('presign_${uuid0}', uri, ttl) u from media where id <= 3) t order by id;
select id, fl_get_uri(f) = uri, fl_get_uri(f) like '%X-Amz-Signature=%', fl_get_uri(f) like concat('%X-Amz-Expires=', ifnull(ttl, 3600), '&%')
from (select id, uri, ttl, get_presigned_file('presign_${uuid0}', to_file(named_struct('uri', uri)), ttl) f from media where id in (1, 3, 4)) t order by id;
select count(*) from media where fl_get_uri(get_presigned_file('presign_${uuid0}', try_to_file(named_struct('uri', uri)))) like '%X-Amz-Signature=%';
select get_presigned_url('presign_${uuid0}', uri, 60) from media where id = 4;
drop database test_get_presigned_${uuid0};
DROP STORAGE VOLUME "presign_${uuid0}";
