-- name: test_binary_literal_in_view
-- description: Regression for StarRocks/starrocks#84252. View and MV definitions are stored as SQL generated
--              from the analyzed statement, which wrote the literal x'616263' as '616263', so the stored
--              definition read it back as the VARCHAR '616263'.
CREATE DATABASE test_binary_literal_in_view_${uuid0};
USE test_binary_literal_in_view_${uuid0};
CREATE TABLE tc (k INT, b VARBINARY(20))
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ("replication_num" = "1");
INSERT INTO tc VALUES (1, x'616263'), (2, x'6869');
CREATE VIEW vbin AS SELECT x'616263' c, hex(x'616263') h, length(x'616263') l;
SELECT hex(c), h, l FROM vbin;
CREATE VIEW vbin2 AS SELECT k, b FROM tc WHERE b = x'616263';
SELECT k, hex(b) FROM vbin2;
CREATE MATERIALIZED VIEW mv_bin REFRESH MANUAL PROPERTIES ("replication_num" = "1")
AS SELECT k, hex(b) hb FROM tc WHERE b = x'616263';
REFRESH MATERIALIZED VIEW mv_bin WITH SYNC MODE;
SELECT k, hb FROM mv_bin;
DROP DATABASE test_binary_literal_in_view_${uuid0} FORCE;
