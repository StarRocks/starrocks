select x.v3 + 1000 c3, b.v6 + 2000 c6, x.v1 + 3000 c1, b.v4 + 4000 c4 from (select v1, v2, v3, v1 + 0 as p0, v1 + 1 as p1, v1 + 2 as p2, v1 + 3 as p3 from t_or_a) x join t_or_b b on x.v1 = b.v4 or x.v2 = b.v5 order by 1, 2, 3, 4;
