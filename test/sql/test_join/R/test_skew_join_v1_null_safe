-- name: test_skew_join_v1_null_safe
CREATE TABLE sj_skew(
    c_key INT NOT NULL,
    c_val INT
)
DUPLICATE KEY(c_key)
DISTRIBUTED BY HASH(c_key) BUCKETS 1
PROPERTIES (
    "replication_num"="1"
);
-- result:
-- !result
CREATE TABLE sj_other(
    c_key INT NOT NULL,
    c_val INT
)
DUPLICATE KEY(c_key)
DISTRIBUTED BY HASH(c_key) BUCKETS 1
PROPERTIES (
    "replication_num"="1"
);
-- result:
