-- name: test_cdc_not_trackable_recreate_partition @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE part_t (dt date, k int, v int)
DUPLICATE KEY(dt, k)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ("2026-06-01"),
    PARTITION p2 VALUES LESS THAN ("2026-07-01")
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO part_t VALUES ("2026-05-15", 1, 10);

[UC]bk_base=SELECT bookmark_create("${db[0]}", "part_t", "nt", "1800000");

-- DROP then re-ADD with the same name creates a fresh partition id; the
-- bookmark's physical id is orphaned.
ALTER TABLE part_t DROP PARTITION p1;
ALTER TABLE part_t ADD PARTITION p1 VALUES LESS THAN ("2026-06-01");
INSERT INTO part_t VALUES ("2026-05-20", 2, 20);

[UC]bk_head=SELECT bookmark_create("${db[0]}", "part_t", "nt", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "part_t", "${bk_base}", "nt");
    SELECT bookmark_release("${db[0]}", "part_t", "${bk_head}", "nt");
} END CLEANUP

SELECT * FROM part_t [_CHANGES_${bk_base}_${bk_head}_];


-- name: test_cdc_not_trackable_schema_rewrite @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE dup_t (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO dup_t VALUES (1, 10);

[UC]bk_base=SELECT bookmark_create("${db[0]}", "dup_t", "nt", "1800000");

-- INT → VARCHAR can't reuse the zonemap, so the alter rewrites partition data
-- and advances the base index meta id.
ALTER TABLE dup_t MODIFY COLUMN v VARCHAR(50);
function: wait_alter_table_finish()
-- The rewrite advances the base index id (index_id != origin_index_id), confirming the shadow-tablet
-- data-rewrite path that makes a window spanning it not trackable.
function: assert_latest_schema_change_job_path("${db[0]}", "dup_t", "slow")

INSERT INTO dup_t VALUES (2, 'hi');

[UC]bk_head=SELECT bookmark_create("${db[0]}", "dup_t", "nt", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk_base}", "nt");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk_head}", "nt");
} END CLEANUP

SELECT * FROM dup_t [_CHANGES_${bk_base}_${bk_head}_];


