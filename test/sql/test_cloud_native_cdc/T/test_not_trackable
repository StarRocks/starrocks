-- All cases here cover scenarios that break CHANGES trackability between the
-- base and head bookmarks. Each case sets up the break differently, then runs
-- a CHANGES query that must surface a `SemanticException`. The expected error
-- format is `CHANGES from bookmark X to Y on table 'T' not trackable: physical
-- partition P <dropped|rewritten|resharded>`, so cases assert via [REGEX].

-- name: test_cdc_not_trackable_drop_partition @cloud

CREATE TABLE part_t (dt date, k int, v int)
DUPLICATE KEY(dt, k)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ("2026-06-01"),
    PARTITION p2 VALUES LESS THAN ("2026-07-01")
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO part_t VALUES ("2026-05-15", 1, 10);
INSERT INTO part_t VALUES ("2026-06-15", 2, 20);

[UC]function: bk_base=create_bookmark("${db[0]}", "part_t", "nt")

ALTER TABLE part_t DROP PARTITION p1;
INSERT INTO part_t VALUES ("2026-06-20", 3, 30);

[UC]function: bk_head=create_bookmark("${db[0]}", "part_t", "nt")

CLEANUP {
    function: release_bookmark("${db[0]}", "part_t", ${bk_base}, "nt")
    function: release_bookmark("${db[0]}", "part_t", ${bk_head}, "nt")
} END CLEANUP

SELECT * FROM part_t [_CHANGES_${bk_base}_${bk_head}_];


