function: wait_optimize_table_finish()

INSERT INTO dup_t VALUES (2, 20);

[UC]function: bk_head=create_bookmark("${db[0]}", "dup_t", "nt")

CLEANUP {
    function: release_bookmark("${db[0]}", "dup_t", ${bk_base}, "nt")
    function: release_bookmark("${db[0]}", "dup_t", ${bk_head}, "nt")
} END CLEANUP

SELECT * FROM dup_t [_CHANGES_${bk_base}_${bk_head}_];
