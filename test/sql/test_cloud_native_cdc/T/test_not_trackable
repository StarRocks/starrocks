-- name: test_cdc_hint_partition_not_present @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE rp2 (k bigint NOT NULL, dt date NOT NULL, v bigint)
DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]bk0=SELECT bookmark_create("${db[0]}", "rp2", "nt", "1800000");
INSERT INTO rp2 VALUES (2, '2026-02-15', 20);
[UC]bk1=SELECT bookmark_create("${db[0]}", "rp2", "nt", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "rp2", "${bk0}", "nt");
    SELECT bookmark_release("${db[0]}", "rp2", "${bk1}", "nt");
} END CLEANUP

-- p1 had no changes in the window → not present in the changeset → not trackable.
SELECT k, dt, v FROM rp2 PARTITION(p1) [_CHANGES_${bk0}_${bk1}_];
