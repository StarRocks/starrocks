-- name: test_cdc_dup_basic @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE dup_t (k int, c varchar(10), v int, dim_id int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

CREATE TABLE dim_t (dim_id int, name varchar(20))
DUPLICATE KEY(dim_id) DISTRIBUTED BY HASH(dim_id) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO dim_t VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');

[UC]bk0=SELECT bookmark_create("${db[0]}", "dup_t", "basic", "1800000");

-- Three INSERT rounds with bookmarks at every boundary.
INSERT INTO dup_t VALUES (1, 'x', 100, 1);
[UC]bk1=SELECT bookmark_create("${db[0]}", "dup_t", "basic", "1800000");
INSERT INTO dup_t VALUES (2, 'y', 200, 2), (3, 'x', 300, 1);
[UC]bk2=SELECT bookmark_create("${db[0]}", "dup_t", "basic", "1800000");
INSERT INTO dup_t VALUES (4, 'y', 400, 3), (5, 'x', 500, 99);
[UC]bk3=SELECT bookmark_create("${db[0]}", "dup_t", "basic", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk0}", "basic");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk1}", "basic");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk2}", "basic");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk3}", "basic");
} END CLEANUP

-- Empty window returns 0 rows.
SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk0}_] ORDER BY k;

-- Full window: all 5 rows, change_type=0 (INSERT), one distinct __ROW_VERSION__
-- per source rowset (3 rounds → 3 distinct values).
SELECT k, c, v, __CHANGE_TYPE__ FROM dup_t [_CHANGES_${bk0}_${bk3}_] ORDER BY k;
SELECT count(*), count(DISTINCT __ROW_VERSION__)
FROM dup_t [_CHANGES_${bk0}_${bk3}_];

-- Mid-window excludes round 1; adjacent windows partition the full delta.
SELECT count(*) FROM dup_t [_CHANGES_${bk1}_${bk3}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk0}_${bk1}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk1}_${bk2}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk2}_${bk3}_];

-- Filter on data column.
SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk3}_]
WHERE k >= 3 ORDER BY k;

-- Filter on the synthesized __CHANGE_TYPE__ column matches every row (all are INSERTs).
SELECT count(*) FROM dup_t [_CHANGES_${bk0}_${bk3}_]
WHERE __CHANGE_TYPE__ = 0;

-- Predicate pushdown: the WHERE lands on the CHANGES scan node itself (a PREDICATES
-- line), not a filter above it -- verify both the location and the predicate content.
function: assert_explain_contains("SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk3}_] WHERE k >= 3", "ChangesScanNode", "PREDICATES: ", "k >= 3")

-- A real-column + synthesized-column conjunction pushes BOTH predicates onto the scan...
function: assert_explain_contains("SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk3}_] WHERE k >= 3 AND __CHANGE_TYPE__ = 0", "PREDICATES: ", "k >= 3", "__CHANGE_TYPE__ = 0")

-- ...and still returns the correctly filtered rows.
SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk3}_]
WHERE k >= 3 AND __CHANGE_TYPE__ = 0 ORDER BY k;

-- GROUP BY + HAVING + multi-aggregate over a CHANGES scan.
SELECT c, count(*) AS cnt, sum(v) AS total, min(k), max(k), avg(v)
FROM dup_t [_CHANGES_${bk0}_${bk3}_]
GROUP BY c
HAVING count(*) >= 2
ORDER BY c;

-- Inner join: CHANGES delta joined with a regular dim table.
SELECT f.k, d.name, f.v, f.__CHANGE_TYPE__
FROM dup_t f [_CHANGES_${bk0}_${bk3}_]
JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;

-- Left join keeps the row whose dim side is missing (dim_id=99).
SELECT f.k, d.name
FROM dup_t f [_CHANGES_${bk0}_${bk3}_]
LEFT JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;


-- name: test_cdc_dup_compaction @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE dup_t (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]bk_pre=SELECT bookmark_create("${db[0]}", "dup_t", "cp", "1800000");

-- Three INSERTs create three rowsets, then COMPACT folds them.
INSERT INTO dup_t VALUES (1, 10);
INSERT INTO dup_t VALUES (2, 20);
INSERT INTO dup_t VALUES (3, 30);
[UC]ALTER TABLE dup_t COMPACT;
SELECT sleep(15);

[UC]bk_post=SELECT bookmark_create("${db[0]}", "dup_t", "cp", "1800000");

-- Two more INSERTs after compaction.
INSERT INTO dup_t VALUES (4, 40);
INSERT INTO dup_t VALUES (5, 50);

[UC]bk_after=SELECT bookmark_create("${db[0]}", "dup_t", "cp", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk_pre}", "cp");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk_post}", "cp");
    SELECT bookmark_release("${db[0]}", "dup_t", "${bk_after}", "cp");
} END CLEANUP

-- A window spanning the compaction event still returns every row exactly once.
-- This is intentionally not checking NUM_ROWSET — CDC must work whether or not
-- compaction has finished by the time the head bookmark is captured.
SELECT k, v, __CHANGE_TYPE__ FROM dup_t [_CHANGES_${bk_pre}_${bk_after}_] ORDER BY k;
SELECT count(*) FROM dup_t [_CHANGES_${bk_pre}_${bk_after}_];


-- name: test_cdc_dup_added_partition @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

-- A detail (DUPLICATE KEY) table gains a brand-new partition mid-stream. A CHANGES range that
-- spans the add reads the new partition in FULL mode -- the whole head, every row as an INSERT --
-- rather than walking a version chain the new partition never had. This is the added-partition
-- path for a non-primary-key table (the primary-key case lives in test_pk_net_change_partitioned).
CREATE TABLE dup_ap (dt date, k int, v int)
DUPLICATE KEY(dt, k) PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01')
) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');

INSERT INTO dup_ap VALUES ('2024-01-10', 1, 10);

[UC]bk0=SELECT bookmark_create("${db[0]}", "dup_ap", "ap", "1800000");

-- p2 is new since bk0; it takes three loads, then a compaction folds them into one output. FULL
-- must surface that compaction output (its rows never appeared as an incremental insert).
ALTER TABLE dup_ap ADD PARTITION p2 VALUES LESS THAN ('2024-03-01');
INSERT INTO dup_ap VALUES ('2024-02-05', 2, 20);
INSERT INTO dup_ap VALUES ('2024-02-06', 3, 30);
INSERT INTO dup_ap VALUES ('2024-02-07', 4, 40);
[UC]ALTER TABLE dup_ap COMPACT;
SELECT sleep(15);

[UC]bk1=SELECT bookmark_create("${db[0]}", "dup_ap", "ap", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_ap", "${bk0}", "ap");
    SELECT bookmark_release("${db[0]}", "dup_ap", "${bk1}", "ap");
} END CLEANUP

-- bk0->bk1: p1 is unchanged, p2 is a PartitionAdded change. Every p2 row (2,3,4) surfaces exactly
-- once as an INSERT, whether or not the compaction had finished when bk1 was captured.
SELECT dt, k, v, __CHANGE_TYPE__ FROM dup_ap [_CHANGES_${bk0}_${bk1}_] ORDER BY k;
SELECT count(*) FROM dup_ap [_CHANGES_${bk0}_${bk1}_];


-- name: test_cdc_dup_net_change_from_empty_base @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

-- With net-change on, a range whose base is the empty initial version reads in FULL mode -- it
-- reads the head directly instead of walking the version chain. A detail table has no per-key fold,
-- so the FULL result must equal the default (net-change off) read of the same range.
CREATE TABLE dup_nc (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');

[UC]bk0=SELECT bookmark_create("${db[0]}", "dup_nc", "nc", "1800000");

-- Three loads then a compaction, then one more load: the head carries a compaction output whose
-- rows the incremental walk treats as pre-existing. FULL must still surface all four rows.
INSERT INTO dup_nc VALUES (1, 10);
INSERT INTO dup_nc VALUES (2, 20);
INSERT INTO dup_nc VALUES (3, 30);
[UC]ALTER TABLE dup_nc COMPACT;
SELECT sleep(15);
INSERT INTO dup_nc VALUES (4, 40);

[UC]bk1=SELECT bookmark_create("${db[0]}", "dup_nc", "nc", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_nc", "${bk0}", "nc");
    SELECT bookmark_release("${db[0]}", "dup_nc", "${bk1}", "nc");
} END CLEANUP

SET enable_cdc_net_change = true;
-- bk0 is the empty initial version, so this reads bk0->bk1 in FULL mode: all four rows as INSERTs.
SELECT k, v, __CHANGE_TYPE__ FROM dup_nc [_CHANGES_${bk0}_${bk1}_] ORDER BY k;
SELECT count(*) FROM dup_nc [_CHANGES_${bk0}_${bk1}_];

-- Same range with net-change off (a DELTA walk from the empty base). A detail table's net change
-- equals its raw change, so the rows are identical to the FULL read above.
SET enable_cdc_net_change = false;
SELECT k, v, __CHANGE_TYPE__ FROM dup_nc [_CHANGES_${bk0}_${bk1}_] ORDER BY k;


-- name: test_cdc_dup_added_partition_delete_predicate @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

-- A new partition read in FULL mode that received a DELETE ... WHERE before the head bookmark carries
-- a delete-predicate rowset. A full scan reads segments raw and cannot apply that predicate, so rather
-- than silently surfacing the deleted rows the read must fail -- CHANGES does not support DELETE on
-- detail tables (the version-chain path rejects it the same way).
CREATE TABLE dup_dp (dt date, k int, v int)
DUPLICATE KEY(dt, k) PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01')
) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');

INSERT INTO dup_dp VALUES ('2024-01-10', 1, 10);

[UC]bk0=SELECT bookmark_create("${db[0]}", "dup_dp", "dp", "1800000");

-- p2 is new since bk0; insert two rows then delete one of them via a predicate.
ALTER TABLE dup_dp ADD PARTITION p2 VALUES LESS THAN ('2024-03-01');
INSERT INTO dup_dp VALUES ('2024-02-05', 2, 20), ('2024-02-06', 3, 30);
DELETE FROM dup_dp WHERE dt = '2024-02-06';

[UC]bk1=SELECT bookmark_create("${db[0]}", "dup_dp", "dp", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "dup_dp", "${bk0}", "dp");
    SELECT bookmark_release("${db[0]}", "dup_dp", "${bk1}", "dp");
} END CLEANUP

-- bk0->bk1 routes the added p2 to FULL mode; its delete-predicate rowset makes the read fail with
-- DELETE_PREDICATE_FOUND (the tablet id in the message is dynamic).
SELECT count(*) FROM dup_dp [_CHANGES_${bk0}_${bk1}_];
