-- name: test_cdc_dup_basic @cloud

CREATE TABLE dup_t (k int, c varchar(10), v int, dim_id int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

CREATE TABLE dim_t (dim_id int, name varchar(20))
DUPLICATE KEY(dim_id) DISTRIBUTED BY HASH(dim_id) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO dim_t VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');

[UC]function: bk0=create_bookmark("${db[0]}", "dup_t", "basic")

-- Three INSERT rounds with bookmarks at every boundary.
INSERT INTO dup_t VALUES (1, 'x', 100, 1);
[UC]function: bk1=create_bookmark("${db[0]}", "dup_t", "basic")
INSERT INTO dup_t VALUES (2, 'y', 200, 2), (3, 'x', 300, 1);
[UC]function: bk2=create_bookmark("${db[0]}", "dup_t", "basic")
INSERT INTO dup_t VALUES (4, 'y', 400, 3), (5, 'x', 500, 99);
[UC]function: bk3=create_bookmark("${db[0]}", "dup_t", "basic")

CLEANUP {
    function: release_bookmark("${db[0]}", "dup_t", ${bk0}, "basic")
    function: release_bookmark("${db[0]}", "dup_t", ${bk1}, "basic")
    function: release_bookmark("${db[0]}", "dup_t", ${bk2}, "basic")
    function: release_bookmark("${db[0]}", "dup_t", ${bk3}, "basic")
} END CLEANUP

-- Empty window returns 0 rows.
SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk0}_] ORDER BY k;

-- Full window: all 5 rows, change_type=0 (INSERT), one distinct __ROW_VERSION__
-- per source rowset (3 rounds → 3 distinct values).
SELECT k, c, v, __CHANGE_TYPE__ FROM dup_t [_CHANGES_${bk0}_${bk3}_] ORDER BY k;
SELECT count(*), count(DISTINCT __ROW_VERSION__)
FROM dup_t [_CHANGES_${bk0}_${bk3}_];

-- Mid-window excludes round 1; adjacent windows partition the full delta.
SELECT count(*) FROM dup_t [_CHANGES_${bk1}_${bk3}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk0}_${bk1}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk1}_${bk2}_];
SELECT count(*) FROM dup_t [_CHANGES_${bk2}_${bk3}_];

-- Filter on data column.
SELECT k, c, v FROM dup_t [_CHANGES_${bk0}_${bk3}_]
WHERE k >= 3 ORDER BY k;

-- Filter on the synthesized __CHANGE_TYPE__ column matches every row (all are INSERTs).
SELECT count(*) FROM dup_t [_CHANGES_${bk0}_${bk3}_]
WHERE __CHANGE_TYPE__ = 0;

-- GROUP BY + HAVING + multi-aggregate over a CHANGES scan.
SELECT c, count(*) AS cnt, sum(v) AS total, min(k), max(k), avg(v)
FROM dup_t [_CHANGES_${bk0}_${bk3}_]
GROUP BY c
HAVING count(*) >= 2
ORDER BY c;

-- Inner join: CHANGES delta joined with a regular dim table.
SELECT f.k, d.name, f.v, f.__CHANGE_TYPE__
FROM dup_t f [_CHANGES_${bk0}_${bk3}_]
JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;

-- Left join keeps the row whose dim side is missing (dim_id=99).
SELECT f.k, d.name
FROM dup_t f [_CHANGES_${bk0}_${bk3}_]
LEFT JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;


-- name: test_cdc_dup_compaction @cloud

CREATE TABLE dup_t (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]function: bk_pre=create_bookmark("${db[0]}", "dup_t", "cp")

-- Three INSERTs create three rowsets, then COMPACT folds them.
INSERT INTO dup_t VALUES (1, 10);
INSERT INTO dup_t VALUES (2, 20);
INSERT INTO dup_t VALUES (3, 30);
[UC]ALTER TABLE dup_t COMPACT;
SELECT sleep(15);

[UC]function: bk_post=create_bookmark("${db[0]}", "dup_t", "cp")

-- Two more INSERTs after compaction.
INSERT INTO dup_t VALUES (4, 40);
INSERT INTO dup_t VALUES (5, 50);

[UC]function: bk_after=create_bookmark("${db[0]}", "dup_t", "cp")

CLEANUP {
    function: release_bookmark("${db[0]}", "dup_t", ${bk_pre}, "cp")
    function: release_bookmark("${db[0]}", "dup_t", ${bk_post}, "cp")
    function: release_bookmark("${db[0]}", "dup_t", ${bk_after}, "cp")
} END CLEANUP

-- A window spanning the compaction event still returns every row exactly once.
-- This is intentionally not checking NUM_ROWSET — CDC must work whether or not
-- compaction has finished by the time the head bookmark is captured.
SELECT k, v, __CHANGE_TYPE__ FROM dup_t [_CHANGES_${bk_pre}_${bk_after}_] ORDER BY k;
SELECT count(*) FROM dup_t [_CHANGES_${bk_pre}_${bk_after}_];
