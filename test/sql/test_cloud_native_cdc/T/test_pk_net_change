-- name: test_pk_net_change @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE pk_nc (k int, v int, c varchar(10))
PRIMARY KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');

[UC]bk0=SELECT bookmark_create("${db[0]}", "pk_nc", "pknc", "1800000");

-- bk0->bk1: seed three keys.
INSERT INTO pk_nc VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c');
[UC]bk1=SELECT bookmark_create("${db[0]}", "pk_nc", "pknc", "1800000");

-- bk1->bk2: first update of k=2.
UPDATE pk_nc SET v = 200 WHERE k = 2;
[UC]bk2=SELECT bookmark_create("${db[0]}", "pk_nc", "pknc", "1800000");

-- bk2->bk3: second update of k=2 (so k=2 is updated twice across the window),
-- plus a delete of k=3.
UPDATE pk_nc SET v = 201 WHERE k = 2;
DELETE FROM pk_nc WHERE k = 3;
[UC]bk3=SELECT bookmark_create("${db[0]}", "pk_nc", "pknc", "1800000");

-- bk3->bk4: insert a fresh key k=4 and update the never-before-touched k=1.
INSERT INTO pk_nc VALUES (4, 40, 'd');
UPDATE pk_nc SET v = 11 WHERE k = 1;
[UC]bk4=SELECT bookmark_create("${db[0]}", "pk_nc", "pknc", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "pk_nc", "${bk0}", "pknc");
    SELECT bookmark_release("${db[0]}", "pk_nc", "${bk1}", "pknc");
    SELECT bookmark_release("${db[0]}", "pk_nc", "${bk2}", "pknc");
    SELECT bookmark_release("${db[0]}", "pk_nc", "${bk3}", "pknc");
    SELECT bookmark_release("${db[0]}", "pk_nc", "${bk4}", "pknc");
} END CLEANUP

-- Baseline (net-change off): the full window emits every per-transaction diff.
-- 7 INSERTs (k1,k2,k3 born; k2 twice more; k4 born; k1 updated) and 4 DELETEs
-- (k2 old twice, k3, k1 old).
SELECT __CHANGE_TYPE__, count(*) FROM pk_nc [_CHANGES_${bk0}_${bk4}_]
GROUP BY __CHANGE_TYPE__ ORDER BY __CHANGE_TYPE__;

SET enable_cdc_net_change = true;

-- From an empty base every key that still exists collapses to a single INSERT at
-- its final value; a key that was born and then deleted vanishes entirely. So
-- there are zero DELETEs. k=1 ends at v=11, k=2 collapses two updates to its
-- final v=201, k=3 (born then deleted) is gone, k=4 is a plain insert.
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_nc [_CHANGES_${bk0}_${bk4}_] ORDER BY k;

-- Same window, only the per-change-type counts: three INSERTs, no DELETE.
SELECT __CHANGE_TYPE__, count(*) FROM pk_nc [_CHANGES_${bk0}_${bk4}_]
GROUP BY __CHANGE_TYPE__ ORDER BY __CHANGE_TYPE__;

-- From a populated base (bk1, where k1=10/k2=20/k3=30 already exist), the net
-- change of each key carries its base value in the DELETE and its final value in
-- the INSERT; intermediate update values are dropped. An update surfaces as
-- DELETE(old)+INSERT(final), a delete as a lone DELETE, an insert as a lone
-- INSERT.
--   k=1: updated once          -> DEL(1,10,a) + INS(1,11,a)
--   k=2: updated twice (20->200->201), only the base and final survive
--                              -> DEL(2,20,b) + INS(2,201,b)
--   k=3: deleted               -> DEL(3,30,c)
--   k=4: inserted              -> INS(4,40,d)
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_nc [_CHANGES_${bk1}_${bk4}_]
ORDER BY k, __CHANGE_TYPE__ DESC;

-- By default the net-change window is sort-based: the plan enforces a SORT below the
-- analytic node so each key's rows arrive grouped before MIN/MAX.
function: assert_explain_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk1}_${bk4}_]', 'SORT')

-- window_partition_mode = 2 switches the window to hash-based (the analytic groups by a
-- hash table, so no SORT is enforced). Assert the PLAN actually changed -- a result-only
-- check would not prove it, since sort-based and hash-based yield the same net rows -- then
-- confirm the net result is indeed identical to the sort-based plan above.
SET window_partition_mode = 2;
function: assert_explain_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk1}_${bk4}_]', 'useHashBasedPartition')
function: assert_explain_not_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk1}_${bk4}_]', 'SORT')
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_nc [_CHANGES_${bk1}_${bk4}_]
ORDER BY k, __CHANGE_TYPE__ DESC;

-- Single-version ranges skip the analytic window (net change == raw change).
-- bk0->bk1 is one INSERT; bk1->bk2 is one UPDATE. Both span a single version.
SET enable_cdc_net_change = true;
SET window_partition_mode = 1;

function: assert_explain_not_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk0}_${bk1}_]', 'ANALYTIC')
function: assert_explain_not_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk1}_${bk2}_]', 'ANALYTIC')

-- A multi-version range still gets the window.
function: assert_explain_contains('SELECT k, v FROM pk_nc [_CHANGES_${bk1}_${bk4}_]', 'ANALYTIC')

-- Data self-check: on a single version the net change equals the raw change, so
-- the net-change-on result must be byte-identical to the net-change-off result.
-- bk1->bk2 is a single UPDATE of k=2, surfacing as DELETE(old)+INSERT(new).
SET enable_cdc_net_change = false;
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_nc [_CHANGES_${bk1}_${bk2}_] ORDER BY k, __CHANGE_TYPE__ DESC;
SET enable_cdc_net_change = true;
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_nc [_CHANGES_${bk1}_${bk2}_] ORDER BY k, __CHANGE_TYPE__ DESC;

-- name: test_pk_net_change_partitioned @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE pk_mp (k int NOT NULL, dt date NOT NULL, v int)
PRIMARY KEY(k, dt) PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01'),
    PARTITION p2 VALUES LESS THAN ('2024-03-01')
) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');

-- Seed both partitions so bm0 sits past the empty initial version. A DataChanged range
-- whose base is the empty initial version reads FULL (the window is folded away), so bm0 must
-- carry data for bm0->bm1 to stay a genuine incremental range where the multi-version partition
-- still gets a window.
INSERT INTO pk_mp VALUES (100, '2024-01-01', 1), (200, '2024-02-01', 2);

[UC]bm0=SELECT bookmark_create("${db[0]}", "pk_mp", "pkmp", "1800000");

-- bm0->bm1: p1 advances one version, p2 advances two (insert + update). Mixed range.
INSERT INTO pk_mp VALUES (1, '2024-01-15', 10);
INSERT INTO pk_mp VALUES (2, '2024-02-15', 20);
UPDATE pk_mp SET v = 21 WHERE k = 2;
[UC]bm1=SELECT bookmark_create("${db[0]}", "pk_mp", "pkmp", "1800000");

-- bm1->bm2: each partition advances exactly one version. All single-version range.
INSERT INTO pk_mp VALUES (3, '2024-01-20', 30);
INSERT INTO pk_mp VALUES (4, '2024-02-20', 40);
[UC]bm2=SELECT bookmark_create("${db[0]}", "pk_mp", "pkmp", "1800000");

-- bm2->bm3: a brand-new partition p3 appears and gets a single load. From bm2 (which
-- has only p1/p2) p3 is a PartitionAdded change spanning one version.
ALTER TABLE pk_mp ADD PARTITION p3 VALUES LESS THAN ('2024-04-01');
INSERT INTO pk_mp VALUES (5, '2024-03-15', 50);
[UC]bm3=SELECT bookmark_create("${db[0]}", "pk_mp", "pkmp", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "pk_mp", "${bm0}", "pkmp");
    SELECT bookmark_release("${db[0]}", "pk_mp", "${bm1}", "pkmp");
    SELECT bookmark_release("${db[0]}", "pk_mp", "${bm2}", "pkmp");
    SELECT bookmark_release("${db[0]}", "pk_mp", "${bm3}", "pkmp");
} END CLEANUP

SET enable_cdc_net_change = true;
SET window_partition_mode = 1;

-- Mixed range (p1 single version, p2 multiple versions): window kept.
function: assert_explain_contains('SELECT k, dt, v FROM pk_mp [_CHANGES_${bm0}_${bm1}_]', 'ANALYTIC')

-- All-single-version range across both partitions: window skipped.
function: assert_explain_not_contains('SELECT k, dt, v FROM pk_mp [_CHANGES_${bm1}_${bm2}_]', 'ANALYTIC')

-- Data self-check on the all-single-version range: net-on == net-off.
SET enable_cdc_net_change = false;
SELECT k, dt, v, __CHANGE_TYPE__ FROM pk_mp [_CHANGES_${bm1}_${bm2}_] ORDER BY k;
SET enable_cdc_net_change = true;
SELECT k, dt, v, __CHANGE_TYPE__ FROM pk_mp [_CHANGES_${bm1}_${bm2}_] ORDER BY k;

-- Single-version PartitionAdded range (new partition p3, one load): window skipped.
function: assert_explain_not_contains('SELECT k, dt, v FROM pk_mp [_CHANGES_${bm2}_${bm3}_]', 'ANALYTIC')

-- Data self-check on the added partition: net-on == net-off.
SET enable_cdc_net_change = false;
SELECT k, dt, v, __CHANGE_TYPE__ FROM pk_mp [_CHANGES_${bm2}_${bm3}_] ORDER BY k;
SET enable_cdc_net_change = true;
SELECT k, dt, v, __CHANGE_TYPE__ FROM pk_mp [_CHANGES_${bm2}_${bm3}_] ORDER BY k;
