-- name: test_cdc_prune_random_tablet @cloud

CREATE TABLE rnd (k int, v int)
DUPLICATE KEY(k)
DISTRIBUTED BY RANDOM BUCKETS 4
PROPERTIES ('replication_num' = '1');

[UC]function: bk0=create_bookmark("${db[0]}", "rnd", "np")
INSERT INTO rnd VALUES (1, 10), (2, 20), (7, 70), (15, 150);
[UC]function: bk1=create_bookmark("${db[0]}", "rnd", "np")

CLEANUP {
    function: release_bookmark("${db[0]}", "rnd", ${bk0}, "np")
    function: release_bookmark("${db[0]}", "rnd", ${bk1}, "np")
} END CLEANUP

-- RANDOM distribution cannot map a value to a bucket, so no tablet is pruned: tabletRatio=4/4.
function: assert_explain_contains("SELECT k, v FROM rnd [_CHANGES_${bk0}_${bk1}_] WHERE k = 7", "ChangesScanNode", "tabletRatio=4/4")
SELECT k, v FROM rnd [_CHANGES_${bk0}_${bk1}_] WHERE k = 7 ORDER BY k;

-- NOTE: RANGE *distribution* tablet pruning is intentionally not exercised end-to-end here. A
-- freshly created range-distributed table has a single (-inf,+inf) tablet; producing multiple
-- range tablets requires an asynchronous SplitTabletJob (BE-driven reshard), which is out of scope
-- for a planner-focused SQL test. RANGE distribution routes through the same shared
-- RangeDistributionPruner as the OLAP scan; that path is covered by the plan-level parity test
-- CloudNativeChangesPlanTest.testChangesPruningParityWithOlapScan.
