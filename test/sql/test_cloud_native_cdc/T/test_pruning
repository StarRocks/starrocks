-- name: test_cdc_prune_range_partition @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE r (k bigint NOT NULL, dt date NOT NULL, v bigint)
DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01'),
    PARTITION p3 VALUES LESS THAN ('2026-04-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]bk0=SELECT bookmark_create("${db[0]}", "r", "rp", "1800000");
INSERT INTO r VALUES (1, '2026-01-15', 10), (2, '2026-02-15', 20), (3, '2026-03-15', 30);
[UC]bk1=SELECT bookmark_create("${db[0]}", "r", "rp", "1800000");

CLEANUP {
    SELECT bookmark_release("${db[0]}", "r", "${bk0}", "rp");
    SELECT bookmark_release("${db[0]}", "r", "${bk1}", "rp");
} END CLEANUP

-- All three partitions changed in the window; the partition-column predicate prunes p1,
-- so the CHANGES scan reports partitions=2/3 in EXPLAIN.
function: assert_explain_contains("SELECT k, dt, v FROM r [_CHANGES_${bk0}_${bk1}_] WHERE dt >= '2026-02-01'", "ChangesScanNode", "partitions=2/3")
-- The pruned scan still returns exactly the rows in the kept partitions.
SELECT k, dt, v FROM r [_CHANGES_${bk0}_${bk1}_] WHERE dt >= '2026-02-01' ORDER BY k;


