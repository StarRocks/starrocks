-- name: test_cdc_prune_range_partition @cloud

CREATE TABLE r (k bigint NOT NULL, dt date NOT NULL, v bigint)
DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01'),
    PARTITION p3 VALUES LESS THAN ('2026-04-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]function: bk0=create_bookmark("${db[0]}", "r", "rp")
INSERT INTO r VALUES (1, '2026-01-15', 10), (2, '2026-02-15', 20), (3, '2026-03-15', 30);
[UC]function: bk1=create_bookmark("${db[0]}", "r", "rp")

CLEANUP {
    function: release_bookmark("${db[0]}", "r", ${bk0}, "rp")
    function: release_bookmark("${db[0]}", "r", ${bk1}, "rp")
} END CLEANUP

-- All three partitions changed in the window; the partition-column predicate prunes p1,
-- so the CHANGES scan reports partitions=2/3 in EXPLAIN.
function: assert_explain_contains("SELECT k, dt, v FROM r [_CHANGES_${bk0}_${bk1}_] WHERE dt >= '2026-02-01'", "ChangesScanNode", "partitions=2/3")
-- The pruned scan still returns exactly the rows in the kept partitions.
SELECT k, dt, v FROM r [_CHANGES_${bk0}_${bk1}_] WHERE dt >= '2026-02-01' ORDER BY k;


-- name: test_cdc_prune_list_partition @cloud

CREATE TABLE l (k int NOT NULL, city varchar(16) NOT NULL, v int)
DUPLICATE KEY(k, city)
PARTITION BY LIST(city) (
    PARTITION p_bj VALUES IN ('bj'),
    PARTITION p_sh VALUES IN ('sh'),
    PARTITION p_gz VALUES IN ('gz')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

[UC]function: bk0=create_bookmark("${db[0]}", "l", "lp")
INSERT INTO l VALUES (1, 'bj', 10), (2, 'sh', 20), (3, 'gz', 30);
[UC]function: bk1=create_bookmark("${db[0]}", "l", "lp")

CLEANUP {
    function: release_bookmark("${db[0]}", "l", ${bk0}, "lp")
    function: release_bookmark("${db[0]}", "l", ${bk1}, "lp")
} END CLEANUP

-- The list predicate keeps p_bj and p_sh, prunes p_gz: partitions=2/3.
function: assert_explain_contains("SELECT k, city, v FROM l [_CHANGES_${bk0}_${bk1}_] WHERE city IN ('bj', 'sh')", "ChangesScanNode", "partitions=2/3")
SELECT k, city, v FROM l [_CHANGES_${bk0}_${bk1}_] WHERE city IN ('bj', 'sh') ORDER BY k;


