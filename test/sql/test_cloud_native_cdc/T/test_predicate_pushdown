-- name: test_cdc_mixed_index_bloom_filter @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

-- A CHANGES window can span an ADD-bloom-filter boundary, so within one window some segments carry the
-- bloom filter on v while the segments written before it do not. A v = <absent> predicate must stay
-- correct and be pushed down through both: the bloom-filter segments are skipped via the index
-- (BloomFilterFilterRows), the pre-index segments via the vectorized predicate (PredFilterRows).
CREATE TABLE bf_t (k int NOT NULL, v int)
PRIMARY KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');

[UC]bk0=SELECT bookmark_create("${db[0]}", "bf_t", "pbf", "1800000");
-- batch 1: no bloom filter yet; v = 1..1000 (contains the probe value 500).
INSERT INTO bf_t SELECT number, number FROM TABLE(generate_series(1, 1000)) g(number);
ALTER TABLE bf_t SET ("bloom_filter_columns" = "v");
function: wait_alter_table_finish()
-- batch 2: written with the bloom filter; v = 1,3,..,1999 (odd), so v = 500 is within the value range
-- but absent -- the bloom filter can exclude these segments where the zonemap cannot.
INSERT INTO bf_t SELECT 1000 + number, 2 * number - 1 FROM TABLE(generate_series(1, 1000)) g(number);
[UC]bk1=SELECT bookmark_create("${db[0]}", "bf_t", "pbf", "1800000");

-- Correctness across the mixed-index window: exactly the one batch-1 row with v = 500.
SELECT k, v, __CHANGE_TYPE__ FROM bf_t [_CHANGES_${bk0}_${bk1}_] WHERE v = 500;

-- The predicate reaches the CHANGES scan node.
function: assert_explain_contains("SELECT count(*) FROM bf_t [_CHANGES_${bk0}_${bk1}_] WHERE v = 500", "ChangesScanNode", "PREDICATES", "v = 500")

-- Both filter paths are exercised: the bloom-filter segments are skipped via the index and the
-- pre-index segments via the vectorized predicate.
SET enable_profile = true;
SET enable_async_profile = false;
SELECT count(*) FROM bf_t [_CHANGES_${bk0}_${bk1}_] WHERE v = 500;
SELECT CAST(regexp_extract(get_query_profile(last_query_id()), 'BloomFilterFilterRows: ([0-9]+)', 1) AS INT) > 0 AS bloom_filter_used, CAST(regexp_extract(get_query_profile(last_query_id()), 'PredFilterRows: ([0-9]+)', 1) AS INT) > 0 AS predicate_used;

CLEANUP {
    SELECT bookmark_release("${db[0]}", "bf_t", "${bk0}", "pbf");
    SELECT bookmark_release("${db[0]}", "bf_t", "${bk1}", "pbf");
    SET enable_profile = false;
} END CLEANUP
