    SELECT bookmark_release("${db[0]}", "dup_t", "${bk1}", "pdup");
    SET enable_profile = false;
} END CLEANUP

SELECT count(*) FROM dup_t [_CHANGES_${bk0}_${bk1}_] WHERE k > 500;

