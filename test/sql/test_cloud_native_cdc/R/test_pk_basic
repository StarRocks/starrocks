-- name: test_cdc_pk_basic @cloud
[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");
CREATE TABLE pk_t (k int, v int, c varchar(10))
PRIMARY KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');
-- result:
-- !result
[UC]bk0=SELECT bookmark_create("${db[0]}", "pk_t", "pk", "1800000");
INSERT INTO pk_t VALUES (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c');
-- result:
-- !result
[UC]bk1=SELECT bookmark_create("${db[0]}", "pk_t", "pk", "1800000");
UPDATE pk_t SET v = 200 WHERE k = 2;
-- result:
-- !result
[UC]bk2=SELECT bookmark_create("${db[0]}", "pk_t", "pk", "1800000");
DELETE FROM pk_t WHERE k = 3;
-- result:
-- !result
[UC]bk3=SELECT bookmark_create("${db[0]}", "pk_t", "pk", "1800000");
INSERT INTO pk_t VALUES (4, 40, 'd');
-- result:
-- !result
[UC]bk4=SELECT bookmark_create("${db[0]}", "pk_t", "pk", "1800000");
CLEANUP {
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk0}", "pk");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk1}", "pk");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk2}", "pk");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk3}", "pk");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk4}", "pk");
} END CLEANUP

SELECT k, v, c FROM pk_t [_CHANGES_${bk0}_${bk0}_] ORDER BY k;
-- result:
-- !result
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk0}_${bk1}_] ORDER BY k;
-- result:
1	10	a	0
2	20	b	0
3	30	c	0
-- !result
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk1}_${bk2}_]
ORDER BY __CHANGE_TYPE__ DESC, k;
-- result:
2	20	b	1
2	200	b	0
-- !result
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk2}_${bk3}_] ORDER BY k;
-- result:
3	30	c	1
-- !result
SELECT k, v, c, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk0}_${bk4}_]
ORDER BY __ROW_VERSION__, __CHANGE_TYPE__ DESC, k;
-- result:
1	10	a	0
2	20	b	0
3	30	c	0
2	20	b	1
2	200	b	0
3	30	c	1
4	40	d	0
-- !result
SELECT __CHANGE_TYPE__, count(*) FROM pk_t [_CHANGES_${bk0}_${bk4}_]
GROUP BY __CHANGE_TYPE__ ORDER BY __CHANGE_TYPE__;
-- result:
0	5
1	2
-- !result
SELECT count(*), count(DISTINCT __ROW_VERSION__) FROM pk_t [_CHANGES_${bk0}_${bk4}_];
-- result:
7	4
-- !result
SELECT count(*) FROM pk_t [_CHANGES_${bk0}_${bk1}_];
-- result:
3
-- !result
SELECT count(*) FROM pk_t [_CHANGES_${bk1}_${bk2}_];
-- result:
2
-- !result
SELECT count(*) FROM pk_t [_CHANGES_${bk2}_${bk3}_];
-- result:
1
-- !result
SELECT count(*) FROM pk_t [_CHANGES_${bk3}_${bk4}_];
-- result:
1
-- !result
SELECT k, v FROM pk_t [_CHANGES_${bk0}_${bk4}_] WHERE k >= 2 ORDER BY k, v;
-- result:
2	20
2	20
2	200
3	30
3	30
4	40
-- !result
function: assert_explain_contains("SELECT k, v FROM pk_t [_CHANGES_${bk0}_${bk4}_] WHERE k >= 2", "ChangesScanNode", "PREDICATES: ", "k >= 2")
