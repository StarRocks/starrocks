-- name: test_cdc_pk_update_compaction @cloud
[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");
CREATE TABLE pk_t (k int, v int)
PRIMARY KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');
-- result:
-- !result
INSERT INTO pk_t VALUES (1, 10), (2, 20), (3, 30);
-- result:
-- !result
[UC]bk_pre=SELECT bookmark_create("${db[0]}", "pk_t", "pkc", "1800000");
UPDATE pk_t SET v = 200 WHERE k = 2;
-- result:
-- !result
DELETE FROM pk_t WHERE k = 3;
-- result:
-- !result
[UC]ALTER TABLE pk_t COMPACT;
SELECT sleep(15);
-- result:
1
-- !result
[UC]bk_post=SELECT bookmark_create("${db[0]}", "pk_t", "pkc", "1800000");
UPDATE pk_t SET v = 11 WHERE k = 1;
-- result:
-- !result
INSERT INTO pk_t VALUES (5, 50);
-- result:
-- !result
[UC]bk_after=SELECT bookmark_create("${db[0]}", "pk_t", "pkc", "1800000");
CLEANUP {
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk_pre}", "pkc");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk_post}", "pkc");
    SELECT bookmark_release("${db[0]}", "pk_t", "${bk_after}", "pkc");
} END CLEANUP

SELECT k, v, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk_pre}_${bk_post}_]
ORDER BY __CHANGE_TYPE__ DESC, k;
-- result:
2	20	1
3	30	1
2	200	0
-- !result
SELECT k, v, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk_post}_${bk_after}_]
ORDER BY __ROW_VERSION__, __CHANGE_TYPE__ DESC, k;
-- result:
1	10	1
1	11	0
5	50	0
-- !result
SELECT k, v, __CHANGE_TYPE__ FROM pk_t [_CHANGES_${bk_pre}_${bk_after}_]
ORDER BY __ROW_VERSION__, __CHANGE_TYPE__ DESC, k;
-- result:
2	20	1
2	200	0
3	30	1
1	10	1
1	11	0
5	50	0
-- !result
SELECT __CHANGE_TYPE__, count(*) FROM pk_t [_CHANGES_${bk_pre}_${bk_after}_]
GROUP BY __CHANGE_TYPE__ ORDER BY __CHANGE_TYPE__;
-- result:
0	3
1	3
-- !result
