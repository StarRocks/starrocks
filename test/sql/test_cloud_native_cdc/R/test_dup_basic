CREATE TABLE dup_t (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
[UC]function: bk_pre=create_bookmark("${db[0]}", "dup_t", "smoke_a")
INSERT INTO dup_t VALUES (1, 10);
-- result:
-- !result
INSERT INTO dup_t VALUES (2, 20), (3, 30);
-- result:
-- !result
[UC]function: bk_post=create_bookmark("${db[0]}", "dup_t", "smoke_b")
SELECT k, v, __CHANGE_TYPE__ FROM dup_t
CHANGES FROM VERSION ${bk_pre} TO VERSION ${bk_pre}
ORDER BY k;
-- result:
-- !result
SELECT k, v, __CHANGE_TYPE__ FROM dup_t
CHANGES FROM VERSION ${bk_pre} TO VERSION ${bk_post}
ORDER BY k;
-- result:
1	10	0
2	20	0
3	30	0
-- !result
SELECT count(*),
       (count(DISTINCT __ROW_VERSION__) BETWEEN 1 AND count(*)) AS row_version_bounded
FROM dup_t CHANGES FROM VERSION ${bk_pre} TO VERSION ${bk_post};
-- result:
3	1
