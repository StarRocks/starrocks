-- name: test_cdc_dup_compaction @cloud
CREATE TABLE dup_t (k int, v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
[UC]function: bk_pre=create_bookmark("${db[0]}", "dup_t", "cp")
INSERT INTO dup_t VALUES (1, 10);
-- result:
-- !result
INSERT INTO dup_t VALUES (2, 20);
-- result:
-- !result
INSERT INTO dup_t VALUES (3, 30);
-- result:
-- !result
[UC]ALTER TABLE dup_t COMPACT;
SELECT sleep(15);
-- result:
1
-- !result
[UC]function: bk_post=create_bookmark("${db[0]}", "dup_t", "cp")
INSERT INTO dup_t VALUES (4, 40);
-- result:
