-- name: test_cdc_dup_filter_and_aggregate @cloud
CREATE TABLE dup_t (k int, c varchar(10), v int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
[UC]function: bk_a=create_bookmark("${db[0]}", "dup_t", "fa_a")
INSERT INTO dup_t VALUES (1, 'x', 100), (2, 'y', 200);
-- result:
-- !result
INSERT INTO dup_t VALUES (3, 'x', 300), (4, 'y', 400), (5, 'x', 500);
-- result:
-- !result
[UC]function: bk_b=create_bookmark("${db[0]}", "dup_t", "fa_b")
SELECT k, c, v FROM dup_t [_CHANGES_${bk_a}_${bk_b}_]
WHERE k >= 3 ORDER BY k;
-- result:
3	x	300
4	y	400
5	x	500
-- !result
SELECT count(*) FROM dup_t [_CHANGES_${bk_a}_${bk_b}_]
WHERE __CHANGE_TYPE__ = 0;
-- result:
5
-- !result
SELECT c, count(*) AS cnt, sum(v) AS total
FROM dup_t [_CHANGES_${bk_a}_${bk_b}_]
GROUP BY c
HAVING count(*) >= 2
ORDER BY c;
-- result:
x	3	900
y	2	600
-- !result
SELECT c, min(k), max(k), avg(v)
FROM dup_t [_CHANGES_${bk_a}_${bk_b}_]
GROUP BY c
ORDER BY c;
-- result:
x	1	5	300.0
y	2	4	300.0
-- !result
function: release_bookmark("${db[0]}", "dup_t", ${bk_a}, "fa_a")
-- result:
None
-- !result
function: release_bookmark("${db[0]}", "dup_t", ${bk_b}, "fa_b")
-- result:
None
-- !result
-- name: test_cdc_dup_join_with_dim_table @cloud
CREATE TABLE fact_t (k int, dim_id int, amount int)
DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
CREATE TABLE dim_t (dim_id int, name varchar(20))
DUPLICATE KEY(dim_id) DISTRIBUTED BY HASH(dim_id) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO dim_t VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');
-- result:
-- !result
[UC]function: bk_a=create_bookmark("${db[0]}", "fact_t", "join_a")
INSERT INTO fact_t VALUES (10, 1, 100), (11, 2, 200), (12, 1, 50);
-- result:
-- !result
INSERT INTO fact_t VALUES (13, 3, 300), (14, 2, 150);
-- result:
-- !result
[UC]function: bk_b=create_bookmark("${db[0]}", "fact_t", "join_b")
SELECT f.k, d.name, f.amount, f.__CHANGE_TYPE__
FROM fact_t f [_CHANGES_${bk_a}_${bk_b}_]
JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;
-- result:
10	alpha	100	0
11	beta	200	0
12	alpha	50	0
13	gamma	300	0
14	beta	150	0
-- !result
SELECT d.name, count(*) AS cnt, sum(f.amount) AS total
FROM fact_t f [_CHANGES_${bk_a}_${bk_b}_]
JOIN dim_t d ON f.dim_id = d.dim_id
WHERE f.amount >= 100
GROUP BY d.name
HAVING sum(f.amount) > 100
ORDER BY d.name;
-- result:
beta	2	350
gamma	1	300
-- !result
INSERT INTO fact_t VALUES (15, 99, 999);
-- result:
-- !result
[UC]function: bk_c=create_bookmark("${db[0]}", "fact_t", "join_c")
SELECT f.k, d.name
FROM fact_t f [_CHANGES_${bk_b}_${bk_c}_]
LEFT JOIN dim_t d ON f.dim_id = d.dim_id
ORDER BY f.k;
-- result:
15	None
-- !result
function: release_bookmark("${db[0]}", "fact_t", ${bk_a}, "join_a")
-- result:
None
-- !result
function: release_bookmark("${db[0]}", "fact_t", ${bk_b}, "join_b")
-- result:
None
-- !result
function: release_bookmark("${db[0]}", "fact_t", ${bk_c}, "join_c")
-- result:
None
-- !result