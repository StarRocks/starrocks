[UC]ADMIN SET FRONTEND CONFIG ("materialized_view_min_refresh_interval" = "1");
CREATE MATERIALIZED VIEW mv_cf
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED ASYNC EVERY(INTERVAL 2 SECOND)
PROPERTIES ('replication_num' = '1')
AS SELECT dt, k, v FROM cf_base;
