-- name: test_native_geo_intersects_pruning

-- PostGIS 3.6.4 behavior reference; both operand orders and varying rows.
WITH p AS (SELECT 0 id, 'POLYGON ((0 0,1 0,1 1,0 1,0 0))' lhs, 'POLYGON ((3 0,4 0,4 1,3 1,3 0))' rhs UNION ALL SELECT 1 id, 'POLYGON ((0 0,10 10,10 10.1,0 0.1,0 0))' lhs, 'POLYGON ((0 0.2,10 10.2,10 10.3,0 0.3,0 0.2))' rhs UNION ALL SELECT 2 id, 'POLYGON ((0 0,10 0,10 10,0 10,0 0))' lhs, 'POLYGON ((2 2,3 2,3 3,2 3,2 2))' rhs UNION ALL SELECT 3 id, 'POLYGON ((0 0,10 0,10 10,0 10,0 0),(3 3,7 3,7 7,3 7,3 3))' lhs, 'POLYGON ((4 4,6 4,6 6,4 6,4 4))' rhs UNION ALL SELECT 4 id, 'POLYGON ((0 0,1 0,1 1,0 1,0 0))' lhs, 'POLYGON ((1 0,2 0,2 1,1 1,1 0))' rhs UNION ALL SELECT 5 id, 'POLYGON ((0 0,1 0,1 1,0 1,0 0))' lhs, 'POLYGON ((1 1,2 1,2 2,1 2,1 1))' rhs UNION ALL SELECT 6 id, 'POLYGON ((0 0,2 0,2 1,0 1,0 0))' lhs, 'POLYGON ((1 0,3 0,3 -1,1 -1,1 0))' rhs UNION ALL SELECT 7 id, 'MULTIPOLYGON (EMPTY,((0 0,1 0,1 1,0 1,0 0)),((20 20,30 20,30 30,20 30,20 20)))' lhs, 'POLYGON ((25 25,26 25,26 26,25 26,25 25))' rhs UNION ALL SELECT 8 id, 'POLYGON ((0 0,1 0,1 0,1 1,0 1,0 0))' lhs, 'POLYGON ((1 0,2 0,2 1,1 1,1 0))' rhs UNION ALL SELECT 9 id, 'POLYGON ((10000000 10000000,10000001 10000001,10000000 10000001,10000000 10000000))' lhs, 'POLYGON ((10000000.5 10000000.4,10000000.6 10000000.4,10000000.6 10000000.3,10000000.5 10000000.4))' rhs), g AS (SELECT id, ST_GeomFromText(lhs,'EPSG:3857') a, ST_GeomFromText(rhs,'EPSG:3857') b FROM p) SELECT id, ST_Intersects(a,b), ST_Intersects(b,a) FROM g ORDER BY id;
-- result:
0	0	0
1	0	0
2	1	1
3	0	0
4	1	1
5	1	1
6	1	1
7	1	1
8	1	1
9	0	0
