-- name: test_native_geo_intersects_orientation

-- PostGIS 3.6.4: the first two pairs are disjoint in both operand orders.
WITH p AS (SELECT ST_GeomFromText('POLYGON ((0 0,1048576 1048577,0 1,0 0))','EPSG:4326') a,ST_GeomFromText('POLYGON ((2097151.999999925 2097153.999999925,3145727.999999865 3145730.999999865,2097151.999999925 2097154.999999925,2097151.999999925 2097153.999999925))','EPSG:4326') b) SELECT ST_Intersects(a,b),ST_Intersects(b,a) FROM p;
-- result:
0	0
-- !result
WITH p AS (SELECT ST_GeomFromText('POLYGON ((0 0,0.25 0.2500002384185791,0 2.384185791015625e-07,0 0))','EPSG:4326') a,ST_GeomFromText('POLYGON ((0.49999999999998213 0.50000047683714033,0.7499999999999678 0.75000071525570511,0.49999999999998213 0.50000071525571943,0.49999999999998213 0.50000047683714033))','EPSG:4326') b) SELECT ST_Intersects(a,b),ST_Intersects(b,a) FROM p;
-- result:
0	0
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,1 1,0 1,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON ((1 1,2 1,1 2,1 1))','EPSG:4326'));
-- result:
1
-- !result
-- The existing boundary tolerance deliberately differs from PostGIS here.
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,1 1,0 1,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON ((1.0000000000000036 1.0000000000000036,2.0000000000000036 1.0000000000000036,1.0000000000000036 2.0000000000000036,1.0000000000000036 1.0000000000000036))','EPSG:4326'));
-- result:
1
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,1 1,0 1,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON ((1.0000000000000142 1.0000000000000142,2.0000000000000142 1.0000000000000142,1.0000000000000142 2.0000000000000142,1.0000000000000142 1.0000000000000142))','EPSG:4326'));
-- result:
0
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))','EPSG:4326'),NULL);
-- result:
None
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON EMPTY','EPSG:4326'));
-- result:
0
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON ((2 -1,5 -1,5 2,2 2,2 -1))','EPSG:4326'));
-- result:
1
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))','EPSG:4326'),ST_GeomFromText('POLYGON ((1 1,2 1,2 2,1 2,1 1))','EPSG:4326'));
-- result:
1
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0),(1 1,3 1,3 3,1 3,1 1))','EPSG:4326'),ST_GeomFromText('POLYGON ((1.5 1.5,2 1.5,2 2,1.5 2,1.5 1.5))','EPSG:4326'));
-- result:
0
-- !result
SELECT ST_Intersects(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))','EPSG:4326'),ST_GeomFromText('MULTIPOLYGON (EMPTY,((1 1,2 1,2 2,1 2,1 1)))','EPSG:4326'));
-- result:
1
-- !result
