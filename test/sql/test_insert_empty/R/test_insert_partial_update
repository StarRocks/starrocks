    pk BIGINT NOT NULL,
    v1 INT NOT NULL DEFAULT '0',
    title VARCHAR(255) NOT NULL DEFAULT '',
    INDEX gin_title (title) USING GIN ("parser" = "english")
)
PRIMARY KEY(pk)
DISTRIBUTED BY HASH(pk) BUCKETS 1
PROPERTIES ("replicated_storage" = "true", "replication_num" = "1");
