-- name: test_group_execution_complex_key_in_filter
-- A colocate hash join under group execution whose join keys include an ARRAY or MAP column. No runtime IN filter can
-- be built for such a key, and the build side must skip it instead of crashing the BE.
set enable_group_execution = true;
-- With a small pipeline dop every node gets enough buckets for group execution, so the join builds its runtime
-- filters per driver (the colocate runtime-filter path).
set pipeline_dop = 1;
CREATE TABLE t0 (
    k_id INT NOT NULL,
    c_varchar_nn VARCHAR(50) NOT NULL,
    a_int ARRAY<INT> NULL,
    m_str_int MAP<VARCHAR(20), INT> NULL
) DUPLICATE KEY(k_id) DISTRIBUTED BY HASH(k_id) BUCKETS 4
PROPERTIES ("colocate_with" = "${uuid0}", "replication_num" = "1");
CREATE TABLE t1 (
    k_id INT NOT NULL,
    c_varchar_nn VARCHAR(50) NOT NULL,
    a_int ARRAY<INT> NULL,
    m_str_int MAP<VARCHAR(20), INT> NULL
) DUPLICATE KEY(k_id) DISTRIBUTED BY HASH(k_id) BUCKETS 4
PROPERTIES ("colocate_with" = "${uuid0}", "replication_num" = "1");
INSERT INTO t0 VALUES
    (1, 'n1', [3,2,1], map{'k':1}), (2, 'n2', [0], map{'b':2}), (3, 'n0', [1,2], map{'':0}),
    (4, 'n1', [2,1], map{'a':1}), (5, 'n2', [10,20,30], map{'x':10}), (6, 'n0', [NULL,NULL], map{'c':3}),
    (7, 'n1', [7,7,7], map{'a':5}), (8, 'n2', [100], NULL), (9, 'n0', NULL, map{}),
    (10, 'n1', [], map{'a':1}), (11, 'n2', [1,NULL,3], map{'a':2}), (12, 'n0', [NULL], map{'a':NULL});
INSERT INTO t1 SELECT * FROM t0 WHERE k_id % 3 != 0;
SELECT * FROM t0 a RIGHT SEMI JOIN [COLOCATE] t0 b USING (a_int, k_id) ORDER BY k_id;
SELECT * FROM t0 a RIGHT SEMI JOIN [COLOCATE] t0 b USING (k_id, m_str_int) ORDER BY k_id;
SELECT t0.k_id, t1.c_varchar_nn FROM t0 JOIN [COLOCATE] t1 ON t0.k_id = t1.k_id AND t0.a_int = t1.a_int AND t0.m_str_int = t1.m_str_int ORDER BY t0.k_id;
SELECT count(*) FROM t0 a LEFT SEMI JOIN [COLOCATE] t1 b ON a.k_id = b.k_id AND a.a_int = b.a_int;
