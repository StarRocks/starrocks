-- name: test_transparent_mv_union_hive
-- Test Point: Hive UNION compensation preserves filtered scans, aggregates and join multiplicity.
-- Method: Assert every refresh, plan markers, complete partition results and rewrite-disabled Hive oracles.
-- Scope: Hive partition compensation; union rewrite mode 2.

create external catalog mv_hive_${uuid0}
properties
(
    "type" = "hive",
    "hive.catalog.type" = "hive",
    "hive.metastore.uris" = "${hive_metastore_uris}"
);

set new_planner_optimize_timeout=10000;
-- create hive table
set catalog mv_hive_${uuid0};
create database mv_hive_db_${uuid0};
use mv_hive_db_${uuid0};

CREATE TABLE mv_hive_${uuid0}.mv_hive_db_${uuid0}.t1 (
  num int,
  dt date
)
PARTITION BY (dt);
