-- Release only this invocation's objects even when an earlier assertion fails.
CLEANUP {
  SET CATALOG default_catalog;
  DROP DATABASE IF EXISTS default_catalog.db_${uuid0} FORCE;
  DROP TABLE IF EXISTS mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 FORCE;
  DROP DATABASE IF EXISTS mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0} FORCE;
  DROP CATALOG IF EXISTS mv_iceberg_${uuid0};
} END CLEANUP
