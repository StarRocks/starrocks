-- name: test_mv_rewrite_with_iceberg @slow
-- Test Point: Cover MV rewrite over a multi-column partitioned Iceberg table.
-- Method: Assert refresh success, plan selection, stale MV data, and independent base-table results.
function: create_iceberg_catalog('mv_iceberg_${uuid0}', 'hive')


set new_planner_optimize_timeout=10000;
-- create iceberg table
set catalog mv_iceberg_${uuid0};
create database mv_iceberg_db_${uuid0};
use mv_iceberg_db_${uuid0};

CREATE TABLE mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 (
    num int,
    dt string,
    con int
)
PARTITION BY (dt, con);
INSERT INTO mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1  VALUES
    (1,"2020-06-15", 1),(2,"2020-06-15", 1),
    (2,"2020-06-18", 1),(3,"2020-06-18", 1),
    (3,"2020-06-21", 1),(4,"2020-06-21", 1);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};

CREATE MATERIALIZED VIEW mv1 PARTITION BY (dt) REFRESH MANUAL 
AS 
SELECT dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 GROUP BY dt;
function: refresh_mv_manual('db_${uuid0}', 'mv1')

function: print_hit_materialized_view("SELECT dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 where dt='2020-06-15' GROUP BY dt;", "mv1")
function: print_hit_materialized_view("SELECT dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 GROUP BY dt;", "mv1")
select * from mv1 order by dt;
SELECT dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 where dt='2020-06-15' GROUP BY dt ORDER BY dt;
SELECT dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 GROUP BY dt ORDER BY dt;
-- Read the source without MV rewrite to keep the data oracle independent.
SELECT /*+ SET_VAR(enable_materialized_view_rewrite=false) */ dt,sum(num) FROM mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 GROUP BY dt ORDER BY dt;

INSERT INTO mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1  VALUES
