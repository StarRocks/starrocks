-- name: test_transparent_mv_hive @slow
-- Test Point: Checked Hive MV queries preserve current data across refreshed and changed partitions.
-- Method: Strict refresh results, dirty/clean partition checks, independent Hive oracles and complete ordered results.
-- Scope: Hive partition compensation, DATE/STRING expressions, transparent and nested UNION MVs.
create external catalog mv_hive_${uuid0}
properties
(
    "type" = "hive",
    "hive.catalog.type" = "hive",
    "hive.metastore.uris" = "${hive_metastore_uris}"
);
set new_planner_optimize_timeout=10000;
set enable_materialized_view_transparent_union_rewrite = true;
set enable_materialized_view_rewrite = true;
set catalog mv_hive_${uuid0};
create database mv_hive_db_${uuid0};
use mv_hive_db_${uuid0};
CREATE TABLE t1 (
  num int,
  dt date
)
PARTITION BY (dt);
