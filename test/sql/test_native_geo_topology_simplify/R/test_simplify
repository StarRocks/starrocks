-- name: test_native_geo_topology_simplify

SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING (0 0,1 0,2 0)', 'EPSG:3857'), 0.1));
-- result:
LINESTRING (0 0, 2 0)
-- !result
SELECT ST_Area(ST_SimplifyPreserveTopology(ST_GeomFromText('POLYGON ((0 0,1 0,2 0,2 1,2 2,1 2,0 2,0 1,0 0))', 'EPSG:3857'), 0.01));
-- result:
4.0
-- !result
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('MULTIPOLYGON EMPTY', 'EPSG:4326'), 1));
-- result:
MULTIPOLYGON EMPTY
-- !result
SELECT ST_GeometryType(ST_SimplifyPreserveTopology(ST_GeomFromText('POLYGON ((0 0,1 0,2 0,2 1,2 2,1 2,0 2,0 1,0 0))', 'EPSG:3857'), 0.01));
-- result:
ST_Polygon
-- !result
SELECT ST_SRID(ST_SimplifyPreserveTopology(ST_GeomFromText('POINT (1 2)', 'EPSG:4326'), 0));
-- result:
4326
-- !result
SELECT ST_SRID(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING (0 0,1 0,2 0)', 'EPSG:3857'), 0.1));
-- result:
3857
-- !result
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('POINT (1 2)', 'EPSG:3857'), NULL));
-- result:
None
-- !result
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText(NULL, 'EPSG:3857'), -1));
-- result:
None
-- !result
SELECT ST_AsBinary(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING (0 0,1 0,2 0)', 'EPSG:3857'), 0)) = ST_AsBinary(ST_GeomFromText('LINESTRING (0 0,1 0,2 0)', 'EPSG:3857'));
-- result:
true
-- !result
SELECT ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('GEOMETRYCOLLECTION (POINT EMPTY,LINESTRING (0 0,1 0,2 0))', 'EPSG:3857'), 0.1));
-- result:
GEOMETRYCOLLECTION (POINT EMPTY, LINESTRING (0 0, 2 0))
-- !result
SET pipeline_dop=4;
-- result:
-- !result
SELECT id, ST_AsText(ST_SimplifyPreserveTopology(ST_GeomFromText('LINESTRING (0 0,1 0,2 0)', 'EPSG:3857'), t)) FROM (SELECT 1 AS id, CAST(0 AS DOUBLE) AS t UNION ALL SELECT 2, CAST(0.1 AS DOUBLE) UNION ALL SELECT 3, CAST(NULL AS DOUBLE)) tolerances ORDER BY id;
-- result:
1	LINESTRING (0 0, 1 0, 2 0)
2	LINESTRING (0 0, 2 0)
3	None
-- !result
SET pipeline_dop=1;
