-- name: test_like_substring_null_flags_above_join
-- LIKE '%x%' / REGEXP 'x' run the substring matcher. Its result must own its NULL flags: when it is a common sub
-- expression of a join's filter, next to the matched column, a shared NULL column is filtered twice and the
-- matched column comes back with other rows' NULL flags (RB-1182).
create table t (row_id int, k_grp int, c_bool boolean, c_str varchar(100)) duplicate key(row_id)
distributed by hash(row_id) buckets 1 properties ("replication_num" = "1");
