select c1, count(*) from (select if(not c_bool, c_str regexp 'a1', k_grp not in (select k_grp from t)) as a2 from t) s(c1) where c1 between 0 and 0 group by 1 order by 1;
select row_id, c_str from (select row_id, c_str, if(not c_bool, c_str regexp 'a1', k_grp not in (select k_grp from t)) as a2 from t) s(row_id, c_str, c1) where c1 between 0 and 0 order by row_id;
select row_id, c_str from (select row_id, c_str, if(not c_bool, c_str like '%a1%', k_grp not in (select k_grp from t)) as a2 from t) s(row_id, c_str, c1) where c1 between 0 and 0 order by row_id;
select row_id, c_str from (select row_id, c_str, if(not c_bool, c_str regexp 'a.1', k_grp not in (select k_grp from t)) as a2 from t) s(row_id, c_str, c1) where c1 between 0 and 0 order by row_id;
