-- name: test_ivm_two_mvs_coexist @cloud
CREATE TABLE mb (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO mb VALUES (1,10),(2,20),(3,-5);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_mb_proj
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v FROM mb WHERE v > 0;
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_mb_agg
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, sum(v) AS sv FROM mb GROUP BY k;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_mb_proj WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_mb_agg WITH SYNC MODE;
INSERT INTO mb VALUES (4,40),(2,5),(5,-1);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_mb_proj WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_mb_agg WITH SYNC MODE;
SELECT k, v FROM mv_mb_proj ORDER BY k, v;
-- result:
1	10
2	5
2	20
4	40
-- !result
SELECT k, sv FROM mv_mb_agg ORDER BY k;
-- result:
1	10
2	25
3	-5
4	40
5	-1
-- !result
SELECT COUNT(*) AS proj_diff FROM (SELECT k, v FROM mv_mb_proj EXCEPT SELECT k, v FROM mb WHERE v > 0) t;
-- result:
0
-- !result
SELECT COUNT(*) AS proj_diff_rev FROM (SELECT k, v FROM mb WHERE v > 0 EXCEPT SELECT k, v FROM mv_mb_proj) t;
-- result:
0
-- !result
SELECT COUNT(*) AS agg_diff FROM (SELECT k, sv FROM mv_mb_agg EXCEPT SELECT k, sum(v) FROM mb GROUP BY k) t;
-- result:
0
-- !result
SELECT COUNT(*) AS agg_diff_rev FROM (SELECT k, sum(v) FROM mb GROUP BY k EXCEPT SELECT k, sv FROM mv_mb_agg) t;
-- result:
0
-- !result
SELECT DISTINCT
  CASE WHEN DEFINITION LIKE '%mv_mb_proj%' OR EXTRA_MESSAGE LIKE '%mv_mb_proj%' THEN 'proj' ELSE 'agg' END AS mv,
  get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database()
  AND (DEFINITION LIKE '%mv_mb_proj%' OR EXTRA_MESSAGE LIKE '%mv_mb_proj%'
       OR DEFINITION LIKE '%mv_mb_agg%' OR EXTRA_MESSAGE LIKE '%mv_mb_agg%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2, 3;
-- result:
agg	INCREMENTAL	SUCCESS
agg	PCT	SUCCESS
proj	INCREMENTAL	SUCCESS
proj	PCT	SUCCESS
-- !result
