-- name: test_ivm_union_state_dedup @cloud
CREATE TABLE t (k INT, v INT, s VARCHAR(20), s2 VARCHAR(20), d DECIMAL(10, 2)) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO t VALUES (1,100,'a','p',1.00),(1,200,'a','q',2.00),(2,300,'b','r',3.00);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_pure
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, bitmap_union(bitmap_hash(s)) AS b, hll_union(hll_hash(s)) AS h, percentile_union(percentile_hash(d)) AS p
   FROM t GROUP BY k;
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_mixed
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, hll_union(hll_hash(s)) AS h, sum(v) AS ss, bitmap_union(bitmap_hash(s2)) AS b
   FROM t GROUP BY k;
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_two_bmp
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, bitmap_union(bitmap_hash(s)) AS b1, bitmap_union(bitmap_hash(s2)) AS b2
   FROM t GROUP BY k;
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_wrapped
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, bitmap_count(bitmap_union(bitmap_hash(s2))) AS cnt FROM t GROUP BY k;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_pure WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_mixed WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_two_bmp WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_wrapped WITH SYNC MODE;
SELECT k, bitmap_count(b), hll_cardinality(h), ROUND(percentile_approx_raw(p, 0.5), 3) FROM mv_pure ORDER BY k;
-- result:
1	1	1	1.5
2	1	1	3.0
-- !result
SELECT k, hll_cardinality(h), ss, bitmap_count(b) FROM mv_mixed ORDER BY k;
-- result:
1	1	300	2
2	1	300	1
-- !result
SELECT k, bitmap_count(b1), bitmap_count(b2) FROM mv_two_bmp ORDER BY k;
-- result:
