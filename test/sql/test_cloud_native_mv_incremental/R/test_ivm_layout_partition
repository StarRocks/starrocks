-- name: test_ivm_agg_on_partitioned @cloud
CREATE TABLE aop (id BIGINT, dt DATE, region VARCHAR(8), amt BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01'))
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO aop VALUES (1,'2026-01-10','CN',10),(2,'2026-02-10','CN',20),(3,'2026-01-15','US',5);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_aop
DISTRIBUTED BY HASH(region) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT region, SUM(amt) AS s, COUNT(*) AS c FROM aop GROUP BY region;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_aop WITH SYNC MODE;
SELECT region, s, c FROM mv_aop ORDER BY region;
-- result:
CN	30	2
US	5	1
-- !result
INSERT INTO aop VALUES (4,'2026-02-20','US',7),(5,'2026-01-25','CN',3);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_aop WITH SYNC MODE;
SELECT region, s, c FROM mv_aop ORDER BY region;
-- result:
CN	33	3
US	12	2
-- !result
SELECT COUNT(*) AS mv_rows FROM mv_aop;
-- result:
2
-- !result
SELECT COUNT(*) AS base_rows FROM (SELECT region FROM aop GROUP BY region) t;
-- result:
2
-- !result
SELECT COUNT(*) AS diff FROM (
    SELECT region, s, c FROM mv_aop EXCEPT SELECT region, SUM(amt), COUNT(*) FROM aop GROUP BY region
) t;
-- result:
0
-- !result
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT region, SUM(amt), COUNT(*) FROM aop GROUP BY region EXCEPT SELECT region, s, c FROM mv_aop
) t;
-- result:
0
-- !result
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_aop%' OR DEFINITION LIKE '%mv_aop%')
