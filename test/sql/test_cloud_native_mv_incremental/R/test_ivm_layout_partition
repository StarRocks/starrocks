-- name: test_ivm_range_partition @cloud
CREATE TABLE rp (id BIGINT, dt DATE, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01'),
    PARTITION p3 VALUES LESS THAN ('2026-04-01'))
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO rp VALUES (1,'2026-01-10',10),(2,'2026-02-10',20),(3,'2026-03-10',30);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_rp
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT id, dt, v FROM rp;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rp WITH SYNC MODE;
SELECT id, dt, v FROM mv_rp ORDER BY id;
-- result:
1	2026-01-10	10
2	2026-02-10	20
3	2026-03-10	30
-- !result
INSERT INTO rp VALUES (4,'2026-01-20',40),(5,'2026-03-20',50);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rp WITH SYNC MODE;
SELECT id, dt, v FROM mv_rp ORDER BY id;
-- result:
1	2026-01-10	10
2	2026-02-10	20
3	2026-03-10	30
4	2026-01-20	40
5	2026-03-20	50
-- !result
SELECT COUNT(*) AS mv_rows FROM mv_rp;
-- result:
5
-- !result
SELECT COUNT(*) AS base_rows FROM rp;
-- result:
5
-- !result
SELECT COUNT(*) AS diff FROM (SELECT id, dt, v FROM mv_rp EXCEPT SELECT id, dt, v FROM rp) t;
-- result:
0
-- !result
SELECT COUNT(*) AS diff_reverse FROM (SELECT id, dt, v FROM rp EXCEPT SELECT id, dt, v FROM mv_rp) t;
-- result:
0
-- !result
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_rp%' OR DEFINITION LIKE '%mv_rp%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
-- result:
INCREMENTAL	SUCCESS
PCT	SUCCESS
-- !result
