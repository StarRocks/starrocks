-- name: test_ivm_bitmap_union_dup @cloud
CREATE TABLE bm_dup (k INT, uid INT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO bm_dup VALUES (1,10),(1,20),(1,20),(2,30);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_bm_dup
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, bitmap_union(to_bitmap(uid)) AS b FROM bm_dup GROUP BY k;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_bm_dup WITH SYNC MODE;
SELECT k, bitmap_count(b) AS dc FROM mv_bm_dup ORDER BY k;
-- result:
1	2
2	1
-- !result
INSERT INTO bm_dup VALUES (1,30),(2,30),(2,40);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_bm_dup WITH SYNC MODE;
SELECT k, bitmap_count(b) AS dc FROM mv_bm_dup ORDER BY k;
-- result:
1	3
2	2
-- !result
SELECT COUNT(*) AS diff FROM (
    SELECT k, bitmap_count(b) FROM mv_bm_dup
    EXCEPT SELECT k, COUNT(DISTINCT uid) FROM bm_dup GROUP BY k) t;
-- result:
0
-- !result
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT k, COUNT(DISTINCT uid) FROM bm_dup GROUP BY k
    EXCEPT SELECT k, bitmap_count(b) FROM mv_bm_dup) t;
-- result:
0
-- !result
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_bm_dup%' OR DEFINITION LIKE '%mv_bm_dup%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
