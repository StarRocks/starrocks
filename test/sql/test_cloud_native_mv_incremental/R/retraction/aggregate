CREATE MATERIALIZED VIEW mv_pk_metric
DISTRIBUTED BY HASH(g) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT g, bitmap_union(to_bitmap(uid)) AS b, hll_union(hll_hash(uid)) AS h,
          percentile_union(percentile_hash(val)) AS p
   FROM pk_metric GROUP BY g;
