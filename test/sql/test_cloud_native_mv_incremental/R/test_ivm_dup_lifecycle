-- name: test_ivm_repeated_refresh @cloud
CREATE TABLE base_rr (
    k INT, v BIGINT
) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO base_rr VALUES (1, 10), (2, 20), (3, 30);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_rr
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, SUM(v) AS s FROM base_rr GROUP BY k;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rr WITH SYNC MODE;
SELECT k, s FROM mv_rr ORDER BY k;
-- result:
1	10
2	20
3	30
-- !result
INSERT INTO base_rr VALUES (2, 5), (4, 40);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rr WITH SYNC MODE;
SELECT k, s FROM mv_rr ORDER BY k;
-- result:
1	10
2	25
3	30
4	40
-- !result
INSERT INTO base_rr VALUES (1, 100), (5, 50);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rr WITH SYNC MODE;
SELECT k, s FROM mv_rr ORDER BY k;
-- result:
1	110
2	25
3	30
4	40
5	50
-- !result
INSERT INTO base_rr VALUES (3, 7), (6, 60);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_rr WITH SYNC MODE;
SELECT k, s FROM mv_rr ORDER BY k;
-- result:
1	110
2	25
3	37
4	40
5	50
6	60
-- !result
SELECT COUNT(*) AS mv_rows FROM mv_rr;
-- result:
6
-- !result
SELECT COUNT(*) AS base_rows FROM (SELECT k FROM base_rr GROUP BY k) t;
-- result:
6
-- !result
SELECT COUNT(*) AS diff FROM (
    SELECT k, s FROM mv_rr EXCEPT SELECT k, SUM(v) FROM base_rr GROUP BY k
) t;
-- result:
0
-- !result
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT k, SUM(v) FROM base_rr GROUP BY k EXCEPT SELECT k, s FROM mv_rr
) t;
-- result:
0
-- !result
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_rr%' OR DEFINITION LIKE '%mv_rr%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
-- result:
INCREMENTAL	SUCCESS
PCT	SUCCESS
-- !result
