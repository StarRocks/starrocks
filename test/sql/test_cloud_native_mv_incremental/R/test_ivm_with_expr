-- name: test_ivm_with_expr @cloud
CREATE TABLE base_expr (
    k INT, v INT, n INT, s VARCHAR(20), d DATETIME
) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO base_expr VALUES
    (1, 10, NULL, 'Alpha', '2025-01-15 10:30:00'),
    (2, 20, 100, 'Beta',  '2025-02-15 11:45:00');
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_expr
DISTRIBUTED BY HASH(k_plus_one) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT
    k + 100 AS k_plus_one,
    CAST(v AS BIGINT) * 2 AS v_doubled,
    CASE WHEN v > 15 THEN 'high' ELSE 'low' END AS v_bucket,
    COALESCE(n, 0) AS n_default,
    concat(lower(s), '_x') AS s_concat,
    substring(s, 1, 3) AS s_prefix,
    date_trunc('month', d) AS d_month,
    date_format(d, '%Y-%m') AS d_str
FROM base_expr;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_expr WITH SYNC MODE;
SELECT k_plus_one, v_doubled, v_bucket, n_default, s_concat, s_prefix, d_month, d_str
FROM mv_expr ORDER BY k_plus_one;
