  PRIMARY KEY(id, dt)
  PARTITION BY RANGE(dt) (PARTITION p1 VALUES LESS THAN ('2026-02-01'),
                          PARTITION p2 VALUES LESS THAN ('2026-03-01'),
                          PARTITION p3 VALUES LESS THAN ('2026-04-01'))
  DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES('replication_num'='1', 'enable_change_data_capture'='true');
