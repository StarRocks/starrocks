-- name: test_ivm_auto_refresh_on_retraction_dml @cloud
CREATE TABLE afr_pk (id INT NOT NULL, v BIGINT) PRIMARY KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 2
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');
-- result:
-- !result
INSERT INTO afr_pk VALUES (1,10),(2,20),(3,30);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_afr
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH ASYNC
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT id, v FROM afr_pk;
