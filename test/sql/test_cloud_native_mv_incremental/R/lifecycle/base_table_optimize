CREATE TABLE pk_bo (id INT NOT NULL, v BIGINT) PRIMARY KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES('replication_num'='1', 'enable_change_data_capture'='true');
-- result:
-- !result
INSERT INTO pk_bo VALUES (1,10),(2,20),(3,30);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_bo REFRESH DEFERRED MANUAL PROPERTIES("refresh_mode"="INCREMENTAL")
AS SELECT id, v FROM pk_bo;
