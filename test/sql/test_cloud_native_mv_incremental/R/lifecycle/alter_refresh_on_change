-- name: test_ivm_alter_on_change_keeps_incremental_baseline @cloud
CREATE TABLE oc_inc_base (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO oc_inc_base VALUES ('2026-10-01',1,10),('2026-10-02',2,20);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_oc_inc
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_refresh_number' = '-1')
AS SELECT dt, k, SUM(v) AS v, COUNT(*) AS c FROM oc_inc_base GROUP BY dt, k;
-- result:
-- !result
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_oc_inc';
REFRESH MATERIALIZED VIEW mv_oc_inc WITH SYNC MODE;
INSERT INTO oc_inc_base VALUES ('2026-10-02',2,20);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_oc_inc WITH SYNC MODE;
SELECT LAST_EXECUTED_REFRESH_MODE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_oc_inc';
-- result:
INCREMENTAL
-- !result
INSERT INTO oc_inc_base VALUES ('2026-10-03',3,30);
-- result:
-- !result
ALTER MATERIALIZED VIEW mv_oc_inc REFRESH ON_CHANGE;
-- result:
-- !result
function: wait_mv_refresh_count("${db[0]}", "mv_oc_inc", 3)
-- result:
None
-- !result
SELECT LAST_EXECUTED_REFRESH_MODE, coalesce(nullif(LAST_REFRESH_MODE_REASON, ''), 'NONE') FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_oc_inc';
-- result:
INCREMENTAL	NONE
-- !result
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY get_json_double(EXTRA_MESSAGE, '$.processStartTime') DESC LIMIT 1;
-- result:
INCREMENTAL
-- !result
INSERT INTO oc_inc_base VALUES ('2026-10-01',1,10);
-- result:
-- !result
function: wait_mv_refresh_count("${db[0]}", "mv_oc_inc", 4)
-- result:
None
-- !result
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY get_json_double(EXTRA_MESSAGE, '$.processStartTime') DESC LIMIT 1;
-- result:
INCREMENTAL
-- !result
set enable_materialized_view_rewrite = false;
-- result:
-- !result
function: assert_equal_result("SELECT dt, k, v, c FROM mv_oc_inc ORDER BY dt, k", "SELECT dt, k, SUM(v), COUNT(*) FROM oc_inc_base GROUP BY dt, k ORDER BY dt, k")
-- result:
None
-- !result
