-- name: test_ivm_alter_on_change_still_detects_truncate @cloud
CREATE TABLE oc_tr_base (dt date NOT NULL, k int NOT NULL, v int) DUPLICATE KEY(dt, k)
PARTITION BY RANGE(dt) (START ('2024-01-01') END ('2024-01-04') EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO oc_tr_base SELECT date_add('2024-01-01', x % 3), x % 7, x FROM TABLE(generate_series(1, 300)) AS g(x);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_oc_tr PARTITION BY dt DISTRIBUTED BY HASH(dt) BUCKETS 2 REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM oc_tr_base GROUP BY dt, k;
-- result:
-- !result
[UC]REFRESH MATERIALIZED VIEW mv_oc_tr WITH SYNC MODE;
TRUNCATE TABLE oc_tr_base PARTITION (p20240103);
-- result:
-- !result
ALTER MATERIALIZED VIEW mv_oc_tr REFRESH ON_CHANGE;
-- result:
-- !result
ALTER MATERIALIZED VIEW mv_oc_tr REFRESH MANUAL;
-- result:
-- !result
[UC]REFRESH MATERIALIZED VIEW mv_oc_tr WITH SYNC MODE;
SELECT IS_ACTIVE, INACTIVE_REASON LIKE 'incremental refresh broken by non-append-only base change:%' FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_oc_tr';
-- result:
false	1
-- !result