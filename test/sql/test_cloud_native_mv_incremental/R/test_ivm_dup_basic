-- name: test_ivm_dup_aggregate @cloud
CREATE TABLE base_dup_a2 (
    order_id BIGINT, region VARCHAR(8),
    amount DECIMAL(10,2), score BIGINT, nullable_score INT,
    flag BOOLEAN, uid INT
) DUPLICATE KEY(order_id) DISTRIBUTED BY HASH(order_id) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO base_dup_a2 VALUES
    (1001,'CN',99.90,10,5,FALSE,1),
    (1002,'US',20.50,20,NULL,FALSE,10),
    (1003,'CN',15.50,30,NULL,TRUE,1),
    (1004,'US',75.00,40,8,FALSE,10);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_dup_a2
DISTRIBUTED BY HASH(region) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT region,
       SUM(amount) AS s,
       COUNT(*) AS c_all,
       COUNT(nullable_score) AS c_non_null,
       AVG(amount) AS avg_dec,
       AVG(score) AS avg_int,
       MIN(amount) AS mn_dec,
       MAX(amount) AS mx_dec,
       MIN(region) AS mn_str,
       MAX(region) AS mx_str,
       APPROX_COUNT_DISTINCT(uid) AS acd,
       NDV(uid) AS ndv_uid,
       BOOL_OR(flag) AS any_flag
FROM base_dup_a2 GROUP BY region;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_dup_a2 WITH SYNC MODE;
SELECT region, s, c_all, c_non_null, avg_dec, avg_int, mn_dec, mx_dec, mn_str, mx_str, acd, ndv_uid, any_flag FROM mv_dup_a2 ORDER BY region;
