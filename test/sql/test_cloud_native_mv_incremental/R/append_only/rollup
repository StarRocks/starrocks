-- name: test_ivm_agg_rollup_full_key @cloud
CREATE TABLE base_agg_fk (
    region VARCHAR(8), city VARCHAR(8),
    s BIGINT SUM, mx BIGINT MAX, mn BIGINT MIN
) AGGREGATE KEY(region, city) DISTRIBUTED BY HASH(region) BUCKETS 1
PROPERTIES ('replication_num' = '1');
-- result:
-- !result
INSERT INTO base_agg_fk VALUES
    ('CN','BJ',10,100,5),('CN','BJ',20,50,8),('US','NY',30,200,1);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_agg_fk
DISTRIBUTED BY HASH(region) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT region, city, SUM(s) AS s_sum, MAX(mx) AS mx_max, MIN(mn) AS mn_min
   FROM base_agg_fk GROUP BY region, city;
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_agg_fk WITH SYNC MODE;
SELECT region, city, s_sum, mx_max, mn_min FROM mv_agg_fk ORDER BY region, city;
-- result:
CN	BJ	30	100	5
US	NY	30	200	1
-- !result
INSERT INTO base_agg_fk VALUES ('CN','BJ',5,150,2),('JP','TK',7,7,7);
-- result:
-- !result
REFRESH MATERIALIZED VIEW mv_agg_fk WITH SYNC MODE;
SELECT region, city, s_sum, mx_max, mn_min FROM mv_agg_fk ORDER BY region, city;
-- result:
CN	BJ	35	150	2
JP	TK	7	7	7
US	NY	30	200	1
-- !result
SELECT COUNT(*) AS mv_rows FROM mv_agg_fk;
-- result:
3
-- !result
SELECT COUNT(*) AS base_rows FROM (SELECT region, city FROM base_agg_fk GROUP BY region, city) t;
-- result:
3
-- !result
SELECT COUNT(*) AS diff FROM (
    SELECT region, city, s_sum, mx_max, mn_min FROM mv_agg_fk
    EXCEPT
    SELECT region, city, SUM(s), MAX(mx), MIN(mn) FROM base_agg_fk GROUP BY region, city
) t;
-- result:
0
-- !result
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT region, city, SUM(s), MAX(mx), MIN(mn) FROM base_agg_fk GROUP BY region, city
    EXCEPT
    SELECT region, city, s_sum, mx_max, mn_min FROM mv_agg_fk
) t;
-- result:
0
-- !result
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_agg_fk%' OR DEFINITION LIKE '%mv_agg_fk%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
-- result:
INCREMENTAL	SUCCESS
PCT	SUCCESS
-- !result
