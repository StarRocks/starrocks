-- name: test_ivm_agg_in_join_rejected @cloud
CREATE TABLE agg_jb (k1 INT, k2 INT, s BIGINT SUM, mx BIGINT MAX, rep VARCHAR(16) REPLACE)
AGGREGATE KEY(k1, k2) DISTRIBUTED BY HASH(k1) BUCKETS 1 PROPERTIES('replication_num'='1');
CREATE TABLE dup_jb (k INT, w BIGINT) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES('replication_num'='1');
CREATE MATERIALIZED VIEW mv_agg_join DISTRIBUTED BY HASH(k1) BUCKETS 1 REFRESH DEFERRED MANUAL PROPERTIES("refresh_mode"="INCREMENTAL")
AS SELECT a.k1, SUM(a.s) AS x FROM agg_jb a JOIN dup_jb d ON a.k1 = d.k GROUP BY a.k1;

