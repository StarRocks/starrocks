-- name: test_ivm_drop_partition_rejected @cloud
CREATE TABLE tr_dp (k INT, dt DATE, v BIGINT) DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2026-02-01'),
    PARTITION p2 VALUES LESS THAN ('2026-03-01'))
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO tr_dp VALUES (1,'2026-01-10',10),(2,'2026-02-10',20);
CREATE MATERIALIZED VIEW mv_tr_dp
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, dt, v FROM tr_dp;
REFRESH MATERIALIZED VIEW mv_tr_dp WITH SYNC MODE;
SELECT k, dt, v FROM mv_tr_dp ORDER BY k;
ALTER TABLE tr_dp DROP PARTITION p1;
[UC]REFRESH MATERIALIZED VIEW mv_tr_dp WITH SYNC MODE;
SELECT k, dt, v FROM mv_tr_dp ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_tr_dp;
SELECT COUNT(*) AS base_rows FROM tr_dp;
SELECT DISTINCT STATE, ERROR_MESSAGE LIKE '%non-append-only change on base table%' AS reject
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_tr_dp%' OR DEFINITION LIKE '%mv_tr_dp%')
  AND STATE = 'FAILED';

