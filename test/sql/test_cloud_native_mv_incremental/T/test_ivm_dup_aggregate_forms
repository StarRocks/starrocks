SELECT bucket, s, c FROM mv_gae ORDER BY bucket;
SELECT COUNT(*) AS mv_rows FROM mv_gae;
SELECT COUNT(*) AS base_rows FROM (
    SELECT id % 4 FROM items_gae GROUP BY id % 4
) t;
SELECT COUNT(*) AS diff FROM (
    SELECT bucket, s, c FROM mv_gae
    EXCEPT
    SELECT id % 4, SUM(v), COUNT(*) FROM items_gae GROUP BY id % 4
) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT id % 4, SUM(v), COUNT(*) FROM items_gae GROUP BY id % 4
    EXCEPT
    SELECT bucket, s, c FROM mv_gae
