-- name: test_ivm_agg_float_double @cloud
CREATE TABLE metrics_afd (
    id BIGINT, grp VARCHAR(8), f FLOAT, d DOUBLE
) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ('replication_num' = '1');
INSERT INTO metrics_afd VALUES (1,'A',1.5,2.25),(2,'A',0.5,0.75),(3,'B',2.5,4.0);
CREATE MATERIALIZED VIEW mv_afd
DISTRIBUTED BY HASH(grp) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT grp, SUM(f) AS sf, SUM(d) AS sd, MIN(f) AS mnf, MAX(f) AS mxf, MIN(d) AS mnd, MAX(d) AS mxd, COUNT(*) AS c
   FROM metrics_afd GROUP BY grp;
REFRESH MATERIALIZED VIEW mv_afd WITH SYNC MODE;
SELECT grp, sf, sd, mnf, mxf, mnd, mxd, c FROM mv_afd ORDER BY grp;
INSERT INTO metrics_afd VALUES (4,'A',4.0,1.0),(5,'B',1.0,8.0);
REFRESH MATERIALIZED VIEW mv_afd WITH SYNC MODE;
SELECT grp, sf, sd, mnf, mxf, mnd, mxd, c FROM mv_afd ORDER BY grp;
INSERT INTO metrics_afd VALUES (6,'C',3.25,0.5),(7,'B',0.25,2.0);
REFRESH MATERIALIZED VIEW mv_afd WITH SYNC MODE;
SELECT grp, sf, sd, mnf, mxf, mnd, mxd, c FROM mv_afd ORDER BY grp;
SELECT COUNT(*) AS mv_rows FROM mv_afd;
SELECT COUNT(*) AS base_rows FROM (
    SELECT grp FROM metrics_afd GROUP BY grp
) t;
SELECT COUNT(*) AS diff FROM (
    SELECT grp, sf, sd, mnf, mxf, mnd, mxd, c FROM mv_afd
    EXCEPT
    SELECT grp, SUM(f), SUM(d), MIN(f), MAX(f), MIN(d), MAX(d), COUNT(*) FROM metrics_afd GROUP BY grp
) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT grp, SUM(f), SUM(d), MIN(f), MAX(f), MIN(d), MAX(d), COUNT(*) FROM metrics_afd GROUP BY grp
    EXCEPT
    SELECT grp, sf, sd, mnf, mxf, mnd, mxd, c FROM mv_afd
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_afd%' OR DEFINITION LIKE '%mv_afd%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
