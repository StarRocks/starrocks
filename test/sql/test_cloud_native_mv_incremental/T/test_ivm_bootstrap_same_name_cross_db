-- name: test_ivm_bootstrap_same_name_cross_db @cloud
-- Regression: an incremental MV joining two same-named base tables in different
-- databases must key each pinned bookmark by a cross-db-unique id (Table#getUUID).
-- A bare-name key collides, so bootstrap resolves one table to the other's bookmark
-- and fails. Deterministic; also covers pinning across multiple base tables.
CREATE DATABASE db_sn_a_${uuid0};
CREATE DATABASE db_sn_b_${uuid0};
CREATE TABLE db_sn_a_${uuid0}.tj (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ("replication_num" = "1");
CREATE TABLE db_sn_b_${uuid0}.tj (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ("replication_num" = "1");
INSERT INTO db_sn_a_${uuid0}.tj SELECT generate_series, 1 FROM TABLE(generate_series(1, 5000));
INSERT INTO db_sn_b_${uuid0}.tj SELECT generate_series, 10 FROM TABLE(generate_series(1, 5000));
CREATE MATERIALIZED VIEW db_sn_a_${uuid0}.mv_sn
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT a.k AS k, COUNT(*) AS c, SUM(a.v) AS sa, SUM(b.v) AS sb
   FROM db_sn_a_${uuid0}.tj a JOIN db_sn_b_${uuid0}.tj b ON a.k = b.k GROUP BY a.k;
REFRESH MATERIALIZED VIEW db_sn_a_${uuid0}.mv_sn WITH SYNC MODE;
-- Both base tables pinned correctly: the MV must equal the direct join aggregate.
SELECT COUNT(*) FROM (
  SELECT a.k, COUNT(*) c, SUM(a.v) sa, SUM(b.v) sb
  FROM db_sn_a_${uuid0}.tj a JOIN db_sn_b_${uuid0}.tj b ON a.k = b.k GROUP BY a.k
  EXCEPT SELECT k, c, sa, sb FROM db_sn_a_${uuid0}.mv_sn) t;
SELECT COUNT(*) FROM (
  SELECT k, c, sa, sb FROM db_sn_a_${uuid0}.mv_sn
  EXCEPT SELECT a.k, COUNT(*) c, SUM(a.v) sa, SUM(b.v) sb
  FROM db_sn_a_${uuid0}.tj a JOIN db_sn_b_${uuid0}.tj b ON a.k = b.k GROUP BY a.k) t;
SELECT COUNT(*) AS mv_rows FROM db_sn_a_${uuid0}.mv_sn;
DROP DATABASE db_sn_a_${uuid0} FORCE;
DROP DATABASE db_sn_b_${uuid0} FORCE;
