-- name: test_ivm_ret_value_array @cloud
-- Complex value type (ARRAY) carried through a retractable PK projection MV. EXCEPT cannot compare
-- ARRAY, so the deterministic post-DML snapshot is the oracle: after update id2 and delete id3 the MV
-- must equal the base rows {(1,[1,2,3],a),(2,[9,9],b)}.
CREATE TABLE pv_arr (id INT NOT NULL, arr ARRAY<INT>, s VARCHAR(16))
  PRIMARY KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES('replication_num'='1', 'enable_change_data_capture'='true');
INSERT INTO pv_arr VALUES (1,[1,2,3],'a'),(2,[4,5],'b'),(3,[],'c');
CREATE MATERIALIZED VIEW mv_pv_arr REFRESH DEFERRED MANUAL PROPERTIES("refresh_mode"="INCREMENTAL")
AS SELECT id, arr, s FROM pv_arr;
REFRESH MATERIALIZED VIEW mv_pv_arr WITH SYNC MODE;
UPDATE pv_arr SET arr = [9,9] WHERE id = 2;
REFRESH MATERIALIZED VIEW mv_pv_arr WITH SYNC MODE;
DELETE FROM pv_arr WHERE id = 3;
REFRESH MATERIALIZED VIEW mv_pv_arr WITH SYNC MODE;
SELECT id, arr, s FROM mv_pv_arr ORDER BY id;

-- name: test_ivm_ret_value_json @cloud
CREATE TABLE pv_json (id INT NOT NULL, j JSON, s VARCHAR(16))
  PRIMARY KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES('replication_num'='1', 'enable_change_data_capture'='true');
INSERT INTO pv_json VALUES (1,PARSE_JSON('{"a":1}'),'a'),(2,PARSE_JSON('{"b":2}'),'b'),(3,PARSE_JSON('null'),'c');
CREATE MATERIALIZED VIEW mv_pv_json REFRESH DEFERRED MANUAL PROPERTIES("refresh_mode"="INCREMENTAL")
AS SELECT id, j, s FROM pv_json;
REFRESH MATERIALIZED VIEW mv_pv_json WITH SYNC MODE;
UPDATE pv_json SET j = PARSE_JSON('{"x":9}') WHERE id = 2;
REFRESH MATERIALIZED VIEW mv_pv_json WITH SYNC MODE;
DELETE FROM pv_json WHERE id = 3;
REFRESH MATERIALIZED VIEW mv_pv_json WITH SYNC MODE;
SELECT id, CAST(j AS VARCHAR), s FROM mv_pv_json ORDER BY id;
SELECT COUNT(*) AS diff FROM (SELECT id,CAST(j AS VARCHAR),s FROM mv_pv_json EXCEPT SELECT id,CAST(j AS VARCHAR),s FROM pv_json) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT id,CAST(j AS VARCHAR),s FROM pv_json EXCEPT SELECT id,CAST(j AS VARCHAR),s FROM mv_pv_json) t;

