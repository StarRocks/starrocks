-- name: test_ivm_agg_where_null_group_recompute @cloud
-- An update in the NULL group makes the refresh recompute that group by joining the base table to the changed group
-- keys with <=>, whose runtime filter passes NULL keys. The recompute must still apply the MV's WHERE to them.
-- f holds multiples of 0.25, so its DOUBLE sums are exact in any order.
SET enable_materialized_view_rewrite = false;
CREATE TABLE wn (id BIGINT NOT NULL, dk INT, s VARCHAR(32), f DOUBLE)
PRIMARY KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 4
PROPERTIES ('replication_num' = '1', 'enable_change_data_capture' = 'true');
INSERT INTO wn SELECT x, IF(x % 7 = 0, NULL, x % 16), IF(x % 9 = 0, NULL, IF(x % 4 = 0, 'b', concat('s', x % 6))),
(x % 41 - 20) / 4.0 FROM TABLE(generate_series(1, 400)) t(x);
CREATE MATERIALIZED VIEW mv_wn DISTRIBUTED BY HASH(dk) BUCKETS 2 REFRESH DEFERRED MANUAL
PROPERTIES ('refresh_mode' = 'INCREMENTAL')
AS SELECT dk, MIN(s) AS mn, SUM(f) AS sf FROM wn WHERE s <> 'b' GROUP BY dk;
REFRESH MATERIALIZED VIEW mv_wn WITH SYNC MODE;
UPDATE wn SET f = f + 10 WHERE dk IS NULL AND id % 2 = 0;
REFRESH MATERIALIZED VIEW mv_wn WITH SYNC MODE;
SELECT COUNT(*) AS drift FROM (
  SELECT dk, mn, sf, SUM(n) AS n FROM (
    SELECT dk, mn, sf, 1 AS n FROM mv_wn
    UNION ALL SELECT dk, MIN(s), SUM(f), -1 FROM wn WHERE s <> 'b' GROUP BY dk
  ) u GROUP BY dk, mn, sf HAVING SUM(n) <> 0) x;
SELECT dk, mn, sf FROM mv_wn WHERE dk IS NULL OR dk = 5 ORDER BY dk;
DROP MATERIALIZED VIEW mv_wn;
DROP TABLE wn;
