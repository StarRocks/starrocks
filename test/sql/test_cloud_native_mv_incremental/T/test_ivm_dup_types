-- name: test_ivm_dup_types @cloud
CREATE TABLE base_types (
    k INT,
    f FLOAT,
    db DOUBLE,
    b BOOLEAN,
    dt DATE,
    c CHAR(8)
) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
INSERT INTO base_types VALUES
    (1, 1.5, 2.25, TRUE,  '2025-01-15', 'alpha'),
    (2, 3.5, 4.75, FALSE, '2025-02-20', 'beta'),
    (3, 0.5, 9.99, TRUE,  '2025-03-10', 'gamma'),
    (4, -2.0, 0.125, FALSE, '2025-04-05', 'delta');
CREATE MATERIALIZED VIEW mv_types_proj
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, f, db, b, dt, c FROM base_types;
CREATE MATERIALIZED VIEW mv_types_agg
DISTRIBUTED BY HASH(b) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT b,
       COUNT(*) AS c,
       MIN(dt) AS earliest_dt,
       MAX(dt) AS latest_dt
FROM base_types GROUP BY b;
REFRESH MATERIALIZED VIEW mv_types_proj WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_types_agg WITH SYNC MODE;
SELECT k, f, db, b, dt, c FROM mv_types_proj ORDER BY k;
SELECT b, c, earliest_dt, latest_dt FROM mv_types_agg ORDER BY b;
INSERT INTO base_types VALUES
    (5, 10.0, 100.5, TRUE, '2024-12-01', 'epsilon'),
    (6, -1.25, 0.0, FALSE, '2025-05-30', 'zeta');
REFRESH MATERIALIZED VIEW mv_types_proj WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_types_agg WITH SYNC MODE;
SELECT k, f, db, b, dt, c FROM mv_types_proj ORDER BY k;
SELECT b, c, earliest_dt, latest_dt FROM mv_types_agg ORDER BY b;
SELECT COUNT(*) AS mv_proj_rows FROM mv_types_proj;
SELECT COUNT(*) AS base_rows FROM base_types;
SELECT COUNT(*) AS mv_agg_rows FROM mv_types_agg;
SELECT COUNT(*) AS base_agg_rows FROM (SELECT b FROM base_types GROUP BY b) t;
SELECT COUNT(*) AS diff_proj FROM (
    SELECT k, f, db, b, dt, c FROM mv_types_proj
    EXCEPT
    SELECT k, f, db, b, dt, c FROM base_types
) t;
SELECT COUNT(*) AS diff_proj_reverse FROM (
    SELECT k, f, db, b, dt, c FROM base_types
    EXCEPT
    SELECT k, f, db, b, dt, c FROM mv_types_proj
) t;
SELECT COUNT(*) AS diff_agg FROM (
    SELECT b, c, earliest_dt, latest_dt FROM mv_types_agg
    EXCEPT
    SELECT b, COUNT(*), MIN(dt), MAX(dt) FROM base_types GROUP BY b
) t;
SELECT COUNT(*) AS diff_agg_reverse FROM (
    SELECT b, COUNT(*), MIN(dt), MAX(dt) FROM base_types GROUP BY b
    EXCEPT
    SELECT b, c, earliest_dt, latest_dt FROM mv_types_agg
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_types_proj%' OR DEFINITION LIKE '%mv_types_proj%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_types_agg%' OR DEFINITION LIKE '%mv_types_agg%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
