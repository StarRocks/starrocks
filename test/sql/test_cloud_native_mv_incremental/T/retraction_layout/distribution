REFRESH MATERIALIZED VIEW mv_rd WITH SYNC MODE;
SELECT COUNT(*) AS diff FROM (SELECT id,v,s FROM mv_rd EXCEPT SELECT id,v,s FROM pk_rd WHERE v>=0) t;
