-- name: test_ivm_pk_init_version_full_scan @cloud
-- The second FULL_SCAN trigger, distinct from an added partition: a partition that EXISTED at the
-- bookmark but was still at its init (empty) version, then got data before the next refresh. For a
-- primary-key table under net-fold, a DataChanged partition whose baseVersion == PARTITION_INIT_VERSION
-- routes to FULL_SCAN (reading head is equivalent to diffing from the empty init), not VERSION_CHAIN_DIFF.
-- The empty-partition-fenced-then-filled sequence below is the only way to reach that branch.
CREATE TABLE base_init (dt date, k int, v bigint)
PRIMARY KEY(dt, k)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO base_init VALUES ('2024-01-10', 1, 10);
CREATE MATERIALIZED VIEW mv_init
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, k, v FROM base_init;
REFRESH MATERIALIZED VIEW mv_init WITH SYNC MODE;
SELECT dt, k, v FROM mv_init ORDER BY dt, k;
-- add p2 but leave it EMPTY, then refresh: the bookmark now fences p2 at its init version.
ALTER TABLE base_init ADD PARTITION p2 VALUES LESS THAN ('2024-03-01');
REFRESH MATERIALIZED VIEW mv_init WITH SYNC MODE;
SELECT dt, k, v FROM mv_init ORDER BY dt, k;
-- now fill p2: at the next refresh p2 is DataChanged with baseVersion == init -> FULL_SCAN.
INSERT INTO base_init VALUES ('2024-02-05', 2, 20), ('2024-02-06', 3, 30);
REFRESH MATERIALIZED VIEW mv_init WITH SYNC MODE;
SELECT dt, k, v FROM mv_init ORDER BY dt, k;
SELECT COUNT(*) AS diff FROM (
    SELECT dt, k, v FROM mv_init EXCEPT SELECT dt, k, v FROM base_init
) t;
SELECT COUNT(*) AS diff_rev FROM (
    SELECT dt, k, v FROM base_init EXCEPT SELECT dt, k, v FROM mv_init
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_init%' OR DEFINITION LIKE '%mv_init%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
