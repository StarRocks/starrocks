-- name: test_ivm_added_partition_dup @cloud
-- A partition added between two IVM refreshes is read head-only (no diffable base), so a compaction
-- output -- which the version-chain-diff path skips -- must still surface. Oracle: MV == full recompute.
CREATE TABLE base_ap_dup (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY RANGE(dt) (PARTITION p1 VALUES LESS THAN ('2024-02-01'))
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO base_ap_dup VALUES ('2024-01-10', 1, 10), ('2024-01-11', 2, 20);
CREATE MATERIALIZED VIEW mv_ap_dup
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, k, sum(v) AS s FROM base_ap_dup GROUP BY dt, k;
REFRESH MATERIALIZED VIEW mv_ap_dup WITH SYNC MODE;
SELECT dt, k, s FROM mv_ap_dup ORDER BY dt, k;
ALTER TABLE base_ap_dup ADD PARTITION p2 VALUES LESS THAN ('2024-03-01');
INSERT INTO base_ap_dup VALUES ('2024-02-05', 3, 30);
INSERT INTO base_ap_dup VALUES ('2024-02-06', 4, 40);
INSERT INTO base_ap_dup VALUES ('2024-02-07', 5, 50);
[UC]ALTER TABLE base_ap_dup COMPACT;
SELECT sleep(15);
REFRESH MATERIALIZED VIEW mv_ap_dup WITH SYNC MODE;
SELECT dt, k, s FROM mv_ap_dup ORDER BY dt, k;
SELECT COUNT(*) AS diff FROM (
    SELECT dt, k, s FROM mv_ap_dup EXCEPT SELECT dt, k, sum(v) FROM base_ap_dup GROUP BY dt, k
) t;
SELECT COUNT(*) AS diff_rev FROM (
    SELECT dt, k, sum(v) FROM base_ap_dup GROUP BY dt, k EXCEPT SELECT dt, k, s FROM mv_ap_dup
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_ap_dup%' OR DEFINITION LIKE '%mv_ap_dup%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_added_partition_pk @cloud
-- Primary-key variant: FULL_SCAN of the added partition's head must apply the head delete vector
-- (dropped rows must not surface) and any delta column group (updated column values must surface).
CREATE TABLE base_ap_pk (dt date, k int, v bigint)
PRIMARY KEY(dt, k)
PARTITION BY RANGE(dt) (PARTITION p1 VALUES LESS THAN ('2024-02-01'))
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
