-- name: test_ivm_added_partition_list @cloud
-- LIST-partition variant of the added-partition FULL_SCAN path: a list partition added between two
-- refreshes is absent at the base bookmark, so it is read head-only (PartitionAdded -> FULL_SCAN),
-- exactly as the RANGE case. Oracle: MV == full recompute; the added-partition refresh stays INCREMENTAL.
CREATE TABLE base_ap_list (region varchar(16), k int, v bigint)
DUPLICATE KEY(region, k)
PARTITION BY LIST(region) (
    PARTITION pcn VALUES IN ('CN'),
    PARTITION pus VALUES IN ('US')
)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO base_ap_list VALUES ('CN', 1, 10), ('US', 2, 20);
CREATE MATERIALIZED VIEW mv_ap_list
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT region, k, sum(v) AS s FROM base_ap_list GROUP BY region, k;
REFRESH MATERIALIZED VIEW mv_ap_list WITH SYNC MODE;
SELECT region, k, s FROM mv_ap_list ORDER BY region, k;
ALTER TABLE base_ap_list ADD PARTITION pjp VALUES IN ('JP');
INSERT INTO base_ap_list VALUES ('JP', 3, 30);
INSERT INTO base_ap_list VALUES ('JP', 4, 40);
REFRESH MATERIALIZED VIEW mv_ap_list WITH SYNC MODE;
SELECT region, k, s FROM mv_ap_list ORDER BY region, k;
SELECT COUNT(*) AS diff FROM (
    SELECT region, k, s FROM mv_ap_list EXCEPT SELECT region, k, sum(v) FROM base_ap_list GROUP BY region, k
) t;
SELECT COUNT(*) AS diff_rev FROM (
    SELECT region, k, sum(v) FROM base_ap_list GROUP BY region, k EXCEPT SELECT region, k, s FROM mv_ap_list
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_ap_list%' OR DEFINITION LIKE '%mv_ap_list%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
