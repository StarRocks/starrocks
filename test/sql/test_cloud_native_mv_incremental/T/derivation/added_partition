UPDATE base_ap_pk SET v = 99 WHERE dt = '2024-02-05' AND k = 3;
DELETE FROM base_ap_pk WHERE dt = '2024-02-06' AND k = 4;
REFRESH MATERIALIZED VIEW mv_ap_pk WITH SYNC MODE;
SELECT dt, k, v FROM mv_ap_pk ORDER BY dt, k;
SELECT COUNT(*) AS diff FROM (
    SELECT dt, k, v FROM mv_ap_pk EXCEPT SELECT dt, k, v FROM base_ap_pk
