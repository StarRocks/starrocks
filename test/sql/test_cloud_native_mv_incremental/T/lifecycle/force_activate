-- REFRESH ... FORCE reactivates an incremental view its incremental chain broke on and rebuilds it. It leaves alone a
-- view inactive for any other reason, as a plain refresh does.

-- name: test_ivm_force_activates_after_dup_delete @cloud
-- The view refreshes on a schedule, so activating it also queues a plain refresh; that one runs after the rebuild and
-- the view stays active.
CREATE TABLE fa_del_base (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');
INSERT INTO fa_del_base VALUES ('2026-10-01',1,10),('2026-10-01',1,10),('2026-10-02',2,20),('2026-10-03',3,30);
CREATE MATERIALIZED VIEW mv_fa_del
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED ASYNC EVERY(INTERVAL 1 DAY)
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_refresh_number' = '-1')
AS SELECT dt, k, SUM(v) AS v, COUNT(*) AS c FROM fa_del_base GROUP BY dt, k;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_fa_del';
REFRESH MATERIALIZED VIEW mv_fa_del WITH SYNC MODE;
DELETE FROM fa_del_base WHERE k = 2;
[UC]REFRESH MATERIALIZED VIEW mv_fa_del WITH SYNC MODE;
SELECT IS_ACTIVE, INACTIVE_REASON LIKE 'incremental refresh broken by non-append-only base change:%' FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_fa_del';
[UC]REFRESH MATERIALIZED VIEW mv_fa_del WITH SYNC MODE;
SELECT COUNT(*) FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' AND ERROR_MESSAGE LIKE '%is not active due to incremental refresh broken%or run %mv_fa_del FORCE, to recover.%';
REFRESH MATERIALIZED VIEW mv_fa_del FORCE WITH SYNC MODE;
SELECT STATE, get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' AND get_json_string(EXTRA_MESSAGE, '$.refreshModeReason') = 'FORCE_REFRESH';
LOOP {
  PROPERTY: {"timeout": 60, "interval": 2, "desc": "the refresh the activation queued has finished"}
  result=SELECT COUNT(*) FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' AND STATE IN ('SUCCESS', 'SKIPPED', 'FAILED');
  CHECK: int(${result}[0][0]) >= 5
} END LOOP
SELECT STATE IN ('SUCCESS', 'SKIPPED') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY get_json_double(EXTRA_MESSAGE, '$.processStartTime') DESC LIMIT 1;
SELECT IS_ACTIVE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_fa_del';
INSERT INTO fa_del_base VALUES ('2026-10-01',1,10),('2026-10-04',4,40);
REFRESH MATERIALIZED VIEW mv_fa_del WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY get_json_double(EXTRA_MESSAGE, '$.processStartTime') DESC LIMIT 1;
set enable_materialized_view_rewrite = false;
SELECT dt, k, v, c FROM mv_fa_del ORDER BY dt, k;
SELECT dt, k, SUM(v), COUNT(*) FROM fa_del_base GROUP BY dt, k ORDER BY dt, k;

