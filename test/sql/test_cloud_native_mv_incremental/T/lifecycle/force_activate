[UC]REFRESH MATERIALIZED VIEW mv_fa_opt FORCE WITH SYNC MODE;
SELECT IS_ACTIVE, INACTIVE_REASON LIKE 'base-table optimized:%' FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_fa_opt';
