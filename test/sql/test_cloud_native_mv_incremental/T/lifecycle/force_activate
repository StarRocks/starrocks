CREATE MATERIALIZED VIEW mv_fa_opt
REFRESH DEFERRED MANUAL
PROPERTIES ('refresh_mode' = 'incremental')
AS SELECT k, k2, v FROM fa_opt_base;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_fa_opt';
REFRESH MATERIALIZED VIEW mv_fa_opt WITH SYNC MODE;
