-- name: test_ivm_auto_supported_query_stays_incremental @cloud
-- Guard on the other side: CREATE now compiles the incremental plan for AUTO too, and a definition
-- that compiles must still be maintained incrementally.
CREATE TABLE sp_base (dt date, k int, v bigint SUM) AGGREGATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO sp_base VALUES ('2026-08-01',1,1),('2026-08-02',2,1);
CREATE MATERIALIZED VIEW mv_sp
PARTITION BY (date_trunc('day', `dt`))
DISTRIBUTED BY HASH(`dt`) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS v FROM sp_base GROUP BY dt, k;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_sp';
-- the first run has no TVR baseline, so PCT builds one
[UC]REFRESH MATERIALIZED VIEW mv_sp WITH SYNC MODE;
INSERT INTO sp_base VALUES ('2026-08-03',3,7);
[UC]REFRESH MATERIALIZED VIEW mv_sp WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT dt, k, v FROM mv_sp ORDER BY dt, k;
SELECT dt, k, sum(v) FROM sp_base GROUP BY dt, k ORDER BY dt, k;

-- name: test_ivm_auto_degraded_view_cannot_return_to_auto @cloud
-- ALTER compares against the mode the view actually runs in, so a degraded view is refused the mode
-- its own DDL asked for, and accepts the one it ended up with. Rebuilding is the only way back.
CREATE TABLE sw_base (dt date, k int, v bigint SUM) AGGREGATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
CREATE MATERIALIZED VIEW mv_sw (d, kk, sv)
DISTRIBUTED BY HASH(d) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS v FROM sw_base GROUP BY dt, k;
ALTER MATERIALIZED VIEW mv_sw SET ('refresh_mode' = 'auto');
ALTER MATERIALIZED VIEW mv_sw SET ('refresh_mode' = 'pct');
