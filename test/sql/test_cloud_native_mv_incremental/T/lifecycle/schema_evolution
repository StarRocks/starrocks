-- name: test_ivm_add_column @cloud
CREATE TABLE sc_add (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO sc_add VALUES (1,10),(2,20);
CREATE MATERIALIZED VIEW mv_sc_add
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v FROM sc_add;
REFRESH MATERIALIZED VIEW mv_sc_add WITH SYNC MODE;
SELECT k, v FROM mv_sc_add ORDER BY k;
ALTER TABLE sc_add ADD COLUMN w INT DEFAULT "0";
INSERT INTO sc_add VALUES (3,30,300);
REFRESH MATERIALIZED VIEW mv_sc_add WITH SYNC MODE;
SELECT k, v FROM mv_sc_add ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_sc_add;
SELECT COUNT(*) AS base_rows FROM sc_add;
SELECT COUNT(*) AS diff FROM (SELECT k, v FROM mv_sc_add EXCEPT SELECT k, v FROM sc_add) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT k, v FROM sc_add EXCEPT SELECT k, v FROM mv_sc_add) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_sc_add%' OR DEFINITION LIKE '%mv_sc_add%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

