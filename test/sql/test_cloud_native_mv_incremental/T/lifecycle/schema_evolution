-- name: test_ivm_modify_column_rejected @cloud
CREATE TABLE sc_mod (k INT, v INT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO sc_mod VALUES (1,10),(2,20);
CREATE MATERIALIZED VIEW mv_sc_mod
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v FROM sc_mod;
REFRESH MATERIALIZED VIEW mv_sc_mod WITH SYNC MODE;
SELECT k, v FROM mv_sc_mod ORDER BY k;
ALTER TABLE sc_mod MODIFY COLUMN v BIGINT;
INSERT INTO sc_mod VALUES (3,30);
[UC]REFRESH MATERIALIZED VIEW mv_sc_mod WITH SYNC MODE;
SELECT k, v FROM mv_sc_mod ORDER BY k;
SELECT IS_ACTIVE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_sc_mod';
SELECT DISTINCT STATE, ERROR_MESSAGE LIKE '%not active due to base table schema changed%' AS reject
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_sc_mod%' OR DEFINITION LIKE '%mv_sc_mod%')
  AND STATE = 'FAILED';
