-- REFRESH ... FORCE on an incrementally maintained view rewrites every partition from one snapshot of the base tables
-- and moves the incremental position to that snapshot, so the refresh after it is incremental again.

-- name: test_ivm_force_rebuilds_an_unchanged_view @cloud
CREATE TABLE frc_un_base (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');
INSERT INTO frc_un_base VALUES ('2026-10-01',1,10),('2026-10-01',1,10),('2026-10-02',2,20),('2026-10-03',3,30);
CREATE MATERIALIZED VIEW mv_frc_un_inc
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_refresh_number' = '-1')
AS SELECT dt, k, SUM(v) AS v, COUNT(*) AS c FROM frc_un_base GROUP BY dt, k;
CREATE MATERIALIZED VIEW mv_frc_un_auto
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto', 'partition_refresh_number' = '-1')
AS SELECT dt, k, SUM(v) AS v, COUNT(*) AS c FROM frc_un_base GROUP BY dt, k;
[UC]TASK_INC=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_frc_un_inc';
[UC]TASK_AUTO=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_frc_un_auto';
REFRESH MATERIALIZED VIEW mv_frc_un_inc WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_frc_un_auto WITH SYNC MODE;
-- Nothing changed, and FORCE still rewrites all three partitions.
REFRESH MATERIALIZED VIEW mv_frc_un_inc FORCE WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_frc_un_auto FORCE WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode'), get_json_string(EXTRA_MESSAGE, '$.refreshModeReason'), json_length(parse_json(EXTRA_MESSAGE), '$.mvPartitionsToRefresh') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_INC}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode'), get_json_string(EXTRA_MESSAGE, '$.refreshModeReason'), json_length(parse_json(EXTRA_MESSAGE), '$.mvPartitionsToRefresh') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_AUTO}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT TABLE_NAME, IS_ACTIVE, LAST_EXECUTED_REFRESH_MODE, LAST_REFRESH_MODE_REASON FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME LIKE 'mv_frc_un_%' ORDER BY TABLE_NAME;
INSERT INTO frc_un_base VALUES ('2026-10-02',2,20),('2026-10-04',4,40);
REFRESH MATERIALIZED VIEW mv_frc_un_inc WITH SYNC MODE;
REFRESH MATERIALIZED VIEW mv_frc_un_auto WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_INC}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_AUTO}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- Rewriting the base-side query to the view would compare the view with itself.
set enable_materialized_view_rewrite = false;
SELECT dt, k, v, c FROM mv_frc_un_inc ORDER BY dt, k;
SELECT dt, k, v, c FROM mv_frc_un_auto ORDER BY dt, k;
SELECT dt, k, SUM(v), COUNT(*) FROM frc_un_base GROUP BY dt, k ORDER BY dt, k;

