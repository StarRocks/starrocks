-- range only one of them refuses must not take out the other's rows in a partition that is still kept.
CREATE TABLE ua_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
CREATE TABLE ub_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ua_base VALUES ('2026-08-09',1,10),('2026-08-12',3,30);
INSERT INTO ub_base VALUES ('2026-08-11',102,120),('2026-08-12',103,130);
CREATE MATERIALIZED VIEW mv_ua
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT dt, k, v FROM ua_base UNION ALL SELECT dt, k, v FROM ub_base;
[UC]REFRESH MATERIALIZED VIEW mv_ua WITH SYNC MODE;
-- only ua_base has 2026-08-09, so only its bound names that range
INSERT INTO ua_base VALUES ('2026-08-09',9,99);
INSERT INTO ub_base VALUES ('2026-08-11',109,190);
REFRESH MATERIALIZED VIEW mv_ua WITH SYNC MODE;
SELECT dt, k, v FROM mv_ua ORDER BY dt, k;

-- name: test_ivm_retention_late_data_ttl_duration @cloud
-- Third retention knob, and a different applyRetention predicate than ttl_number. It is measured from now,
-- so the partition names shift with the calendar and only the counts can be asserted.
CREATE TABLE td_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO td_base VALUES (date_sub(current_date(), INTERVAL 30 DAY),1,10),(current_date(),2,20);
CREATE MATERIALIZED VIEW mv_td
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl' = '3 day')
AS SELECT dt, k, SUM(v) AS v FROM td_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_td WITH SYNC MODE;
SELECT count(*) FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_td';
INSERT INTO td_base VALUES (date_sub(current_date(), INTERVAL 30 DAY),9,99);
REFRESH MATERIALIZED VIEW mv_td WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_td';
INSERT INTO td_base VALUES (current_date(),4,40);
REFRESH MATERIALIZED VIEW mv_td WITH SYNC MODE;
SELECT count(*), sum(v) FROM mv_td;
SELECT count(*), sum(v) FROM td_base WHERE dt > date_sub(current_date(), INTERVAL 3 DAY);

-- name: test_ivm_retention_late_data_expired_partition_not_yet_dropped @cloud
-- A refused cell whose partition still exists: the refresh drops only partitions the base no longer implies,
-- so an expired one waits for the ttl scheduler. Until it goes, the late row has a home and keeping it out
-- would lose data the mv can still hold.
CREATE TABLE nd_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO nd_base VALUES ('2026-08-10',1,10),('2026-08-11',2,20);
CREATE MATERIALIZED VIEW mv_nd
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT dt, k, SUM(v) AS v FROM nd_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_nd WITH SYNC MODE;
-- the third day pushes 2026-08-10 past ttl_number without dropping it
INSERT INTO nd_base VALUES ('2026-08-12',3,30);
REFRESH MATERIALIZED VIEW mv_nd WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_nd' ORDER BY PARTITION_NAME;
INSERT INTO nd_base VALUES ('2026-08-10',9,99);
REFRESH MATERIALIZED VIEW mv_nd WITH SYNC MODE;
SELECT dt, k, v FROM mv_nd ORDER BY dt, k;

-- name: test_ivm_retention_late_data_list_partition_null_only_refused @cloud
-- Retention refuses the null partition and nothing else. The membership predicate is built from the value
-- list, which is then empty, and an empty list reads as "every row" -- so the bound would keep nothing at
-- all and drop the retained partition's rows too, silently, with the refresh still reporting SUCCESS.
CREATE TABLE no_base (region varchar(16) NULL, k int NOT NULL, v bigint) DUPLICATE KEY(region, k)
PARTITION BY (region)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO no_base VALUES ('a',1,10),(NULL,2,20);
CREATE MATERIALIZED VIEW mv_no
PARTITION BY region
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental',
            'partition_retention_condition' = 'region = "a"')
AS SELECT region, k, SUM(v) AS v FROM no_base GROUP BY region, k;
[UC]REFRESH MATERIALIZED VIEW mv_no WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_no' ORDER BY PARTITION_NAME;
-- one row for the refused partition and one for the retained one, in the same delta
INSERT INTO no_base VALUES (NULL,9,99);
INSERT INTO no_base VALUES ('a',3,30);
REFRESH MATERIALIZED VIEW mv_no WITH SYNC MODE;
SELECT ifnull(region,'NULL') AS region, k, v FROM mv_no ORDER BY region, k;
SELECT region, k, SUM(v) FROM no_base WHERE region = 'a' GROUP BY region, k ORDER BY region, k;

-- name: test_ivm_retention_late_data_unaliased_agg_column @cloud
-- Left unaliased, the aggregate's mv column is named after the expression that built it, parentheses and
-- qualified base column included. The bound projects every output name as a slot, so a name that is not a
-- bare identifier has to survive that; only the partition column reaches the predicate itself.
CREATE TABLE ua2_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ua2_base VALUES ('2026-08-10',1,10),('2026-08-11',2,20),('2026-08-12',3,30);
CREATE MATERIALIZED VIEW mv_ua2
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT dt, k, SUM(v) FROM ua2_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_ua2 WITH SYNC MODE;
INSERT INTO ua2_base VALUES ('2026-08-10',9,99);
REFRESH MATERIALIZED VIEW mv_ua2 WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_ua2';
INSERT INTO ua2_base VALUES ('2026-08-12',4,40);
REFRESH MATERIALIZED VIEW mv_ua2 WITH SYNC MODE;
SELECT count(*), sum(k) FROM mv_ua2;
SELECT count(*), sum(k) FROM (SELECT dt, k FROM ua2_base WHERE dt >= '2026-08-11' GROUP BY dt, k) t;

-- name: test_ivm_retention_late_data_datetime_partition_column @cloud
-- A DATETIME partition column: the retention window and the bound's range endpoints are datetime keys
-- rather than dates, and partition_ttl's own branch splits on that type.
CREATE TABLE dtm_base (ts datetime, k int, v bigint) DUPLICATE KEY(ts, k)
PARTITION BY date_trunc('day', ts)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO dtm_base VALUES ('2026-08-10 01:00:00',1,10),('2026-08-11 02:00:00',2,20),('2026-08-12 03:00:00',3,30);
CREATE MATERIALIZED VIEW mv_dtm
PARTITION BY ts
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT ts, k, SUM(v) AS v FROM dtm_base GROUP BY ts, k;
[UC]REFRESH MATERIALIZED VIEW mv_dtm WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_dtm' ORDER BY PARTITION_NAME;
INSERT INTO dtm_base VALUES ('2026-08-10 09:00:00',9,99);
REFRESH MATERIALIZED VIEW mv_dtm WITH SYNC MODE;
SELECT ts, k, v FROM mv_dtm ORDER BY ts, k;

-- name: test_ivm_retention_late_data_int_partition_column @cloud
-- An INT partition column. partition_ttl rejects a non-date type outright and ttl_number's shadow and
-- in-the-future predicates only apply to date types, so partition_retention_condition is the knob that
-- reaches this shape -- and the bound has to compare integers rather than dates.
CREATE TABLE ipc_base (pid int NOT NULL, k int, v bigint) DUPLICATE KEY(pid, k)
PARTITION BY (pid)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ipc_base VALUES (10,1,10),(20,2,20),(30,3,30);
CREATE MATERIALIZED VIEW mv_ipc
PARTITION BY pid
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental',
            'partition_retention_condition' = 'pid >= 20')
AS SELECT pid, k, SUM(v) AS v FROM ipc_base GROUP BY pid, k;
[UC]REFRESH MATERIALIZED VIEW mv_ipc WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_ipc' ORDER BY PARTITION_NAME;
INSERT INTO ipc_base VALUES (10,9,99);
INSERT INTO ipc_base VALUES (30,4,40);
REFRESH MATERIALIZED VIEW mv_ipc WITH SYNC MODE;
SELECT pid, k, v FROM mv_ipc ORDER BY pid, k;
SELECT pid, k, SUM(v) FROM ipc_base WHERE pid >= 20 GROUP BY pid, k ORDER BY pid, k;

-- name: test_ivm_retention_late_data_large_refused_set @cloud
-- The bound carries one range term per refused cell, and every case above refuses one or two. Sixty days
-- against ttl_number = 2 refuses fifty-eight, which is the shape a real retention window reaches: the
-- predicate has to survive being that wide without being truncated in either direction.
CREATE TABLE lrs_base (dt date, k int, v bigint) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO lrs_base
SELECT date_add('2026-01-01', INTERVAL generate_series DAY), generate_series, generate_series * 10
FROM TABLE(generate_series(0, 59));
CREATE MATERIALIZED VIEW mv_lrs
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT dt, k, SUM(v) AS v FROM lrs_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_lrs WITH SYNC MODE;
SELECT count(*) FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_lrs';
-- one row far inside the refused range and one in a partition the mv keeps, in the same delta
INSERT INTO lrs_base VALUES ('2026-01-05',999,9990);
INSERT INTO lrs_base VALUES ('2026-03-01',777,7770);
REFRESH MATERIALIZED VIEW mv_lrs WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_lrs';
SELECT count(*), sum(v) FROM mv_lrs;
SELECT count(*), sum(v) FROM (SELECT dt, k, SUM(v) v FROM lrs_base WHERE dt >= '2026-02-28' GROUP BY dt, k) t;

-- name: test_ivm_retention_late_data_iceberg_base @cloud
-- An external base. Ivm accepts ICEBERG and CLOUD_NATIVE only, so this is the whole of the external
-- surface: the delta arrives from iceberg snapshots rather than an olap bookmark, while the bound is
-- still built from the mv's own cells.
create external catalog ice_${uuid0} properties (
    "type" = "iceberg",
    "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}"
);
set catalog ice_${uuid0};
create database ice_db_${uuid0};
CREATE TABLE ice_${uuid0}.ice_db_${uuid0}.ib_base (k int, v bigint, dt date) PARTITION BY (dt);
INSERT INTO ice_${uuid0}.ice_db_${uuid0}.ib_base VALUES (1,10,'2026-08-10'),(2,20,'2026-08-11'),(3,30,'2026-08-12');
set catalog default_catalog;
create database mvdb_${uuid0};
use mvdb_${uuid0};
CREATE MATERIALIZED VIEW mv_ib
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT dt, k, SUM(v) AS v FROM ice_${uuid0}.ice_db_${uuid0}.ib_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_ib WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_ib' ORDER BY PARTITION_NAME;
INSERT INTO ice_${uuid0}.ice_db_${uuid0}.ib_base VALUES (9,99,'2026-08-10');
INSERT INTO ice_${uuid0}.ice_db_${uuid0}.ib_base VALUES (4,40,'2026-08-12');
REFRESH MATERIALIZED VIEW mv_ib WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_ib';
SELECT dt, k, v FROM mv_ib ORDER BY dt, k;
SELECT dt, k, SUM(v) FROM ice_${uuid0}.ice_db_${uuid0}.ib_base WHERE dt >= '2026-08-11' GROUP BY dt, k ORDER BY dt, k;

-- name: test_ivm_retention_late_data_iceberg_str2date @cloud
-- str2date is the transform an external string partition column needs, and it is rejected everywhere else
-- (a list mv's partition expression may not carry a transform). The mv partitions by the parsed date, so
-- the bound's endpoints are compared against str2date(ds) rather than against a stored column.
create external catalog ices_${uuid0} properties (
    "type" = "iceberg",
    "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}"
);
set catalog ices_${uuid0};
create database ices_db_${uuid0};
CREATE TABLE ices_${uuid0}.ices_db_${uuid0}.sd_base (k int, v bigint, ds string) PARTITION BY (ds);
INSERT INTO ices_${uuid0}.ices_db_${uuid0}.sd_base VALUES (1,10,'2026-08-10'),(2,20,'2026-08-11'),(3,30,'2026-08-12');
set catalog default_catalog;
create database mvsd_${uuid0};
use mvsd_${uuid0};
CREATE MATERIALIZED VIEW mv_sd
PARTITION BY str2date(ds,'%Y-%m-%d')
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental', 'partition_ttl_number' = '2')
AS SELECT ds, k, SUM(v) AS v FROM ices_${uuid0}.ices_db_${uuid0}.sd_base GROUP BY ds, k;
[UC]REFRESH MATERIALIZED VIEW mv_sd WITH SYNC MODE;
SELECT PARTITION_NAME FROM information_schema.partitions_meta
WHERE DB_NAME = database() AND TABLE_NAME = 'mv_sd' ORDER BY PARTITION_NAME;
INSERT INTO ices_${uuid0}.ices_db_${uuid0}.sd_base VALUES (9,99,'2026-08-10');
INSERT INTO ices_${uuid0}.ices_db_${uuid0}.sd_base VALUES (4,40,'2026-08-12');
REFRESH MATERIALIZED VIEW mv_sd WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_sd';
SELECT ds, k, v FROM mv_sd ORDER BY ds, k;
SELECT ds, k, SUM(v) FROM ices_${uuid0}.ices_db_${uuid0}.sd_base WHERE ds >= '2026-08-11' GROUP BY ds, k ORDER BY ds, k;
