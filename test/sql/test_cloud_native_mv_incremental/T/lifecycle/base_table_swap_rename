-- A view tracks its base tables by id but reads them by name. Swapping or renaming a base inactivates the view even
-- with enable_mv_automatic_inactive_by_base_table_changes off; its next refresh binds it to the table that now has the
-- name and recomputes, so it never mixes the rows of two tables, and incremental refresh resumes afterwards.

-- name: test_ivm_base_table_swapped_with_automatic_inactive_off @cloud @sequential
[UC]ADMIN SET FRONTEND CONFIG ("enable_mv_automatic_inactive_by_base_table_changes" = "false");
set enable_materialized_view_rewrite = false;
CREATE TABLE sw_base (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
CREATE TABLE sw_other (dt date, k int, v bigint)
DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO sw_base VALUES ('2026-08-01',1,10),('2026-08-02',1,20);
INSERT INTO sw_other VALUES ('2026-08-01',9,90),('2026-08-02',9,92);
CREATE MATERIALIZED VIEW sw_inc
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM sw_base GROUP BY dt, k;
CREATE MATERIALIZED VIEW sw_auto
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM sw_base GROUP BY dt, k;
CREATE MATERIALIZED VIEW sw_pct
PARTITION BY dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'pct')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM sw_base GROUP BY dt, k;
[UC]TASK_INC=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'sw_inc';
[UC]TASK_AUTO=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'sw_auto';
[UC]REFRESH MATERIALIZED VIEW sw_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_auto WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_pct WITH SYNC MODE;
ALTER TABLE sw_base SWAP WITH sw_other;
SELECT TABLE_NAME, INACTIVE_REASON, IS_ACTIVE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() ORDER BY TABLE_NAME;
-- Write the table that now has the name, then the swapped-out one: a view still tracking the latter would skip the
-- first refresh and recompute only 2026-08-02 from the former on the second.
INSERT INTO sw_base VALUES ('2026-08-01',9,1);
[UC]REFRESH MATERIALIZED VIEW sw_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_auto WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_pct WITH SYNC MODE;
function: assert_equal_result("SELECT dt, k, s, c FROM sw_inc ORDER BY dt, k", "SELECT dt, k, SUM(v), COUNT(*) FROM sw_base GROUP BY dt, k ORDER BY dt, k")
function: assert_equal_result("SELECT dt, k, s, c FROM sw_auto ORDER BY dt, k", "SELECT dt, k, SUM(v), COUNT(*) FROM sw_base GROUP BY dt, k ORDER BY dt, k")
function: assert_equal_result("SELECT dt, k, s, c FROM sw_pct ORDER BY dt, k", "SELECT dt, k, SUM(v), COUNT(*) FROM sw_base GROUP BY dt, k ORDER BY dt, k")
INSERT INTO sw_other VALUES ('2026-08-02',1,21);
[UC]REFRESH MATERIALIZED VIEW sw_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_auto WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW sw_pct WITH SYNC MODE;
