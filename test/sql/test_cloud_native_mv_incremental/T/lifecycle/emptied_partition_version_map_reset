-- After the mv's version map is reset, a base partition emptied earlier reads as new and empty. The rebuild must still
-- recompute the mv partition holding its old rows: incremental refreshes only add deltas to what the mv holds.
-- Every case seals 2024-01-03 the same way: its seven groups k=0..6 are truncated, then k=1 and k=8 arrive.
-- FINISH_TIME has one-second resolution and these refreshes are back to back, so QUERY_ID breaks the tie.

-- name: test_ivm_emptied_partition_after_read_column_change @cloud
CREATE TABLE ec_base (dt date NOT NULL, k int NOT NULL, v int) DUPLICATE KEY(dt, k)
PARTITION BY RANGE(dt) (START ('2024-01-01') END ('2024-01-04') EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ec_base SELECT date_add('2024-01-01', x % 3), x % 7, x FROM TABLE(generate_series(1, 300)) AS g(x);
CREATE MATERIALIZED VIEW mv_ec_inc PARTITION BY dt DISTRIBUTED BY HASH(dt) BUCKETS 2 REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM ec_base GROUP BY dt, k;
CREATE MATERIALIZED VIEW mv_ec_auto PARTITION BY dt DISTRIBUTED BY HASH(dt) BUCKETS 2 REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM ec_base GROUP BY dt, k;
[UC]TASK_INC=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_ec_inc';
[UC]TASK_AUTO=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_ec_auto';
[UC]REFRESH MATERIALIZED VIEW mv_ec_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW mv_ec_auto WITH SYNC MODE;
TRUNCATE TABLE ec_base PARTITION (p20240103);
-- reading v, both mvs are inactivated and their version maps reset
ALTER TABLE ec_base MODIFY COLUMN v BIGINT;
function: wait_alter_table_finish()
ALTER MATERIALIZED VIEW mv_ec_inc ACTIVE;
ALTER MATERIALIZED VIEW mv_ec_auto ACTIVE;
[UC]REFRESH MATERIALIZED VIEW mv_ec_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW mv_ec_auto WITH SYNC MODE;
SELECT count(*) FROM mv_ec_inc WHERE dt = '2024-01-03';
SELECT count(*) FROM mv_ec_auto WHERE dt = '2024-01-03';
INSERT INTO ec_base VALUES ('2024-01-03', 1, 9), ('2024-01-03', 8, 100), ('2024-01-01', 1, 5);
[UC]REFRESH MATERIALIZED VIEW mv_ec_inc WITH SYNC MODE;
[UC]REFRESH MATERIALIZED VIEW mv_ec_auto WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_INC}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_AUTO}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- k=1 is 9/1, not the truncated 2023/14 plus the new row
SELECT k, s, c FROM mv_ec_inc WHERE dt = '2024-01-03' ORDER BY k;
SELECT k, s, c FROM mv_ec_auto WHERE dt = '2024-01-03' ORDER BY k;
-- rows only in the mv, rows only in the defining query, and the row-count difference
SELECT (SELECT count(*) FROM (SELECT dt, k, s, c FROM mv_ec_inc EXCEPT SELECT dt, k, SUM(v), COUNT(*) FROM ec_base GROUP BY dt, k) a), (SELECT count(*) FROM (SELECT dt, k, SUM(v), COUNT(*) FROM ec_base GROUP BY dt, k EXCEPT SELECT dt, k, s, c FROM mv_ec_inc) b), (SELECT count(*) FROM mv_ec_inc) - (SELECT count(*) FROM (SELECT dt, k FROM ec_base GROUP BY dt, k) g);
SELECT (SELECT count(*) FROM (SELECT dt, k, s, c FROM mv_ec_auto EXCEPT SELECT dt, k, SUM(v), COUNT(*) FROM ec_base GROUP BY dt, k) a), (SELECT count(*) FROM (SELECT dt, k, SUM(v), COUNT(*) FROM ec_base GROUP BY dt, k EXCEPT SELECT dt, k, s, c FROM mv_ec_auto) b), (SELECT count(*) FROM mv_ec_auto) - (SELECT count(*) FROM (SELECT dt, k FROM ec_base GROUP BY dt, k) g);

