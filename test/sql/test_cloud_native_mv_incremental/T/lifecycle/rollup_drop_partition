-- An mv coarser than its base table keeps the partition covering a dropped base partition, so the
-- dropped rows survive there unless that partition is recomputed. Every case below seals 2026-08:
-- later writes all go to 2026-09, so the august mv partition is never recomputed by accident.
-- FINISH_TIME has one-second resolution and these refreshes are back to back, so QUERY_ID
-- (a UUIDv7, ordered by creation to the millisecond) breaks the tie.

-- name: test_ivm_auto_rollup_drop_partition_recovers @cloud
CREATE TABLE ar_base (dt date, k int, v bigint SUM) AGGREGATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ar_base VALUES ('2026-08-10',1,20),('2026-08-11',2,10),('2026-09-09',3,50);
CREATE MATERIALIZED VIEW mv_ar
PARTITION BY (date_trunc('month', `dt`))
DISTRIBUTED BY HASH(`dt`) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS v FROM ar_base GROUP BY dt, k;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_ar';
[UC]REFRESH MATERIALIZED VIEW mv_ar WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- reaching incremental before the drop is what makes the last step meaningful
INSERT INTO ar_base VALUES ('2026-09-09',4,7);
[UC]REFRESH MATERIALIZED VIEW mv_ar WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- the august mv partition survives the drop because 2026-08-11 is still there
ALTER TABLE ar_base DROP PARTITION p20260810;
[UC]REFRESH MATERIALIZED VIEW mv_ar WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT IS_ACTIVE, LAST_REFRESH_MODE_REASON FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_ar';
SELECT sum(v) FROM ar_base WHERE dt < '2026-09-01';
SELECT sum(v) FROM mv_ar WHERE dt < '2026-09-01';
-- back to incremental, and the totals stay exact: double counting would show up as mv > base
INSERT INTO ar_base VALUES ('2026-09-09',5,3);
[UC]REFRESH MATERIALIZED VIEW mv_ar WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT dt, k, v FROM mv_ar ORDER BY dt, k;
SELECT dt, k, sum(v) FROM ar_base GROUP BY dt, k ORDER BY dt, k;

-- name: test_ivm_incremental_rollup_drop_partition_reports @cloud
-- The same shape under refresh_mode = incremental has no fallback, so the run must fail loudly
-- rather than report success over stale rows.
CREATE TABLE ir_base (dt date, k int, v bigint SUM) AGGREGATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ir_base VALUES ('2026-08-10',1,20),('2026-08-11',2,10),('2026-09-09',3,50);
CREATE MATERIALIZED VIEW mv_ir
PARTITION BY (date_trunc('month', `dt`))
DISTRIBUTED BY HASH(`dt`) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'incremental')
AS SELECT dt, k, SUM(v) AS v FROM ir_base GROUP BY dt, k;
[UC]REFRESH MATERIALIZED VIEW mv_ir WITH SYNC MODE;
ALTER TABLE ir_base DROP PARTITION p20260810;
[UC]REFRESH MATERIALIZED VIEW mv_ir WITH SYNC MODE;
SELECT IS_ACTIVE, LAST_REFRESH_STATE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_ir';
