-- refresh_mode = AUTO: a base change that cannot be maintained incrementally falls back to a
-- PCT refresh for that run, the view stays active, and the next run is incremental again.
-- Each case asserts the refreshMode of every run, so the whole sequence is pinned.
-- FINISH_TIME has one-second resolution and these refreshes are back to back, so QUERY_ID
-- (a UUIDv7, ordered by creation to the millisecond) breaks the tie.

-- name: test_ivm_auto_drop_partition_recovers @cloud
CREATE TABLE ad_base (dt date, k int, v bigint SUM) AGGREGATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ad_base VALUES ('2026-08-01',1,1),('2026-08-02',2,1);
CREATE MATERIALIZED VIEW mv_ad
PARTITION BY (date_trunc('day', `dt`))
DISTRIBUTED BY HASH(`dt`) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT dt, k, SUM(v) AS v FROM ad_base GROUP BY dt, k;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_ad';
-- first refresh has no prior TVR baseline, so PCT builds one
[UC]REFRESH MATERIALIZED VIEW mv_ad WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- append-only, so incremental
INSERT INTO ad_base VALUES ('2026-08-02',2,5);
[UC]REFRESH MATERIALIZED VIEW mv_ad WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
-- dropping a base partition cannot be maintained incrementally: fall back, stay active
ALTER TABLE ad_base DROP PARTITION p20260801;
[UC]REFRESH MATERIALIZED VIEW mv_ad WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT IS_ACTIVE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_ad';
-- and the next append-only change is incremental again
INSERT INTO ad_base VALUES ('2026-08-03',3,7);
[UC]REFRESH MATERIALIZED VIEW mv_ad WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
SELECT dt, k, v FROM mv_ad ORDER BY dt, k;
SELECT dt, k, sum(v) FROM ad_base GROUP BY dt, k ORDER BY dt, k;

