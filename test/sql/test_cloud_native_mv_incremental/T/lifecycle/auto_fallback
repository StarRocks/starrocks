-- name: test_ivm_auto_does_not_absorb_row_delete @cloud
-- The fallback only covers a plan that cannot be built. A row-level DELETE on a DUPLICATE KEY
-- table plans fine and is refused by the backend while the plan runs, which is past the point
-- where AUTO can switch to PCT, so the view is inactivated exactly as an INCREMENTAL one is.
-- AGGREGATE KEY behaves the same; PRIMARY KEY does not, see the two cases below.
CREATE TABLE de_base (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');
INSERT INTO de_base VALUES (1,10),(2,20),(3,30);
CREATE MATERIALIZED VIEW mv_de
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT k, v FROM de_base;
[UC]TASK_NAME=SELECT TASK_NAME FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_de';
[UC]REFRESH MATERIALIZED VIEW mv_de WITH SYNC MODE;
SELECT get_json_string(EXTRA_MESSAGE, '$.refreshMode') FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' ORDER BY FINISH_TIME DESC, QUERY_ID DESC LIMIT 1;
DELETE FROM de_base WHERE k = 1;
[UC]REFRESH MATERIALIZED VIEW mv_de WITH SYNC MODE;
SELECT IS_ACTIVE, INACTIVE_REASON LIKE '%incremental refresh broken%' AS reason_match
FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_de';
SELECT DISTINCT STATE, ERROR_MESSAGE LIKE '%CDC-ERROR-1 (CHANGE_NOT_TRACKABLE):%' AS backend_rejected
FROM information_schema.task_runs WHERE TASK_NAME = '${TASK_NAME}' AND STATE = 'FAILED';

