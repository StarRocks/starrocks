ALTER MATERIALIZED VIEW mv_al SET ('refresh_mode' = 'incremental');
ALTER MATERIALIZED VIEW mv_al SET ('refresh_mode' = 'pct');
ALTER MATERIALIZED VIEW mv_al SET ('refresh_mode' = 'auto');
SELECT REFRESH_MODE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_al';

-- name: test_ivm_auto_degrades_to_pct @cloud
-- A query with no incremental plan is built as a plain PCT view. REFRESH_MODE reports the
-- configured mode, so it still reads AUTO; the absent __ROW_ID__ column and the accepted
-- FORCE refresh are what show the view is really PCT.
CREATE TABLE dg_base (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1 PROPERTIES ('replication_num' = '1');
INSERT INTO dg_base VALUES (1,10),(2,20);
CREATE MATERIALIZED VIEW mv_dg
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1', 'refresh_mode' = 'auto')
AS SELECT k, row_number() over (order by v) AS rn FROM dg_base;
SELECT REFRESH_MODE FROM information_schema.materialized_views WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_dg';
SELECT COUNT(*) AS row_id_columns FROM information_schema.columns
WHERE TABLE_SCHEMA = database() AND TABLE_NAME='mv_dg' AND COLUMN_NAME LIKE '%ROW_ID%';
REFRESH MATERIALIZED VIEW mv_dg WITH SYNC MODE;
SELECT k, rn FROM mv_dg ORDER BY k;

