-- name: test_ivm_derived_table @cloud
CREATE TABLE dt_base (k INT, v BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO dt_base VALUES (1,10),(2,20),(3,-5);
CREATE MATERIALIZED VIEW mv_dt
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v FROM (SELECT k, v FROM dt_base WHERE v > 0) t;
REFRESH MATERIALIZED VIEW mv_dt WITH SYNC MODE;
SELECT k, v FROM mv_dt ORDER BY k;
INSERT INTO dt_base VALUES (4,40),(5,-1);
REFRESH MATERIALIZED VIEW mv_dt WITH SYNC MODE;
SELECT k, v FROM mv_dt ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_dt;
SELECT COUNT(*) AS base_rows FROM (SELECT k, v FROM dt_base WHERE v > 0) t;
SELECT COUNT(*) AS diff FROM (SELECT k, v FROM mv_dt EXCEPT SELECT k, v FROM dt_base WHERE v > 0) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT k, v FROM dt_base WHERE v > 0 EXCEPT SELECT k, v FROM mv_dt) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_dt%' OR DEFINITION LIKE '%mv_dt%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;
