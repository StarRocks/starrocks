SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, a, v FROM mv_skp EXCEPT SELECT dt, a, SUM(v) FROM skp GROUP BY dt, a) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, a, SUM(v) FROM skp GROUP BY dt, a EXCEPT SELECT dt, a, v FROM mv_skp) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_sort_key_join_on_a_fingerprint_row_id @cloud
-- Five group keys push the encoded width past 32 bytes, so the row id falls back to
-- encode_fingerprint_sha256, which is not order-preserving. The declared ORDER BY is then
-- the only thing the scan can seek on.
CREATE TABLE fp (dt DATETIME, g1 INT, g2 INT, p1 BIGINT, p2 BIGINT, p3 BIGINT, v BIGINT)
DUPLICATE KEY(dt, g1)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(g1) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO fp VALUES
  ('2026-04-10 00:00:00',1,10,0,0,0,100),('2026-04-10 00:00:00',2,20,0,0,0,200),
  ('2026-04-11 00:00:00',1,10,0,0,0,110);
CREATE MATERIALIZED VIEW mv_fp
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(g1) BUCKETS 2
ORDER BY (g1, g2)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, g1, g2, p1, p2, p3, SUM(v) AS v FROM fp GROUP BY dt, g1, g2, p1, p2, p3;
REFRESH MATERIALIZED VIEW mv_fp WITH SYNC MODE;
SELECT dt, g1, g2, v FROM mv_fp ORDER BY dt, g1;

INSERT INTO fp VALUES ('2026-04-11 00:00:00',1,10,0,0,0,7);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_fp', 'g1 <=> ', 'g2 <=> ')
REFRESH MATERIALIZED VIEW mv_fp WITH SYNC MODE;
SELECT dt, g1, g2, v FROM mv_fp ORDER BY dt, g1;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, g1, g2, v FROM mv_fp EXCEPT SELECT dt, g1, g2, SUM(v) FROM fp GROUP BY dt, g1, g2) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, g1, g2, SUM(v) FROM fp GROUP BY dt, g1, g2 EXCEPT SELECT dt, g1, g2, v FROM mv_fp) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_sort_key_on_an_aggregate_output_is_not_joined @cloud
-- The mv holds the merged SUM and the delta a partial one, so equating them would drop the row.
CREATE TABLE agsk (dt DATETIME, a INT, v BIGINT) DUPLICATE KEY(dt, a)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO agsk VALUES ('2026-05-10 00:00:00',1,10),('2026-05-11 00:00:00',2,20);
CREATE MATERIALIZED VIEW mv_agsk
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2
ORDER BY (total, a)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, a, SUM(v) AS total FROM agsk GROUP BY dt, a;
REFRESH MATERIALIZED VIEW mv_agsk WITH SYNC MODE;

INSERT INTO agsk VALUES ('2026-05-11 00:00:00',2,5);
function: assert_explain_not_contains('REFRESH MATERIALIZED VIEW mv_agsk', '<=>')
REFRESH MATERIALIZED VIEW mv_agsk WITH SYNC MODE;
-- 20+5: the merge still happened, so the aggregate-output sort key cost nothing but the filter
SELECT dt, a, total FROM mv_agsk ORDER BY dt, a;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, a, total FROM mv_agsk EXCEPT SELECT dt, a, SUM(v) FROM agsk GROUP BY dt, a) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, a, SUM(v) FROM agsk GROUP BY dt, a EXCEPT SELECT dt, a, total FROM mv_agsk) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_sort_key_join_uses_the_partition_column @cloud
-- A partition holds its partition KEY constant, not the column behind it: with
-- PARTITION BY date_trunc('day', dt) one partition still carries every timestamp of that day,
-- so dt filters like any other sort column and must ride the join.
CREATE TABLE psk (dt DATETIME NOT NULL, a INT NOT NULL, b INT NOT NULL, v BIGINT)
DUPLICATE KEY(dt, a)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- 600 distinct timestamps inside one day
INSERT INTO psk SELECT date_add('2026-06-10 00:00:00', INTERVAL CAST(i AS INT) MINUTE),
       CAST(i % 7 AS INT), CAST(i % 5 AS INT), 1
FROM TABLE(generate_series(0, 599)) t(i);
SELECT count(distinct dt) AS distinct_dt_in_one_partition FROM psk;
CREATE MATERIALIZED VIEW mv_psk
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2
ORDER BY (dt, a, b)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, a, b, SUM(v) AS v FROM psk GROUP BY dt, a, b;
REFRESH MATERIALIZED VIEW mv_psk WITH SYNC MODE;

INSERT INTO psk VALUES ('2026-06-10 00:05:00',5,0,9);
-- dt takes the first slot and a the second; b gets none
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_psk', 'dt <=> ', 'a <=> ')
function: assert_explain_not_contains('REFRESH MATERIALIZED VIEW mv_psk', 'b <=> ')
REFRESH MATERIALIZED VIEW mv_psk WITH SYNC MODE;
-- 1+9: the group at 00:05 merged rather than being overwritten
SELECT dt, a, b, v FROM mv_psk WHERE dt = '2026-06-10 00:05:00' ORDER BY a;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, a, b, v FROM mv_psk EXCEPT SELECT dt, a, b, SUM(v) FROM psk GROUP BY dt, a, b) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, a, b, SUM(v) FROM psk GROUP BY dt, a, b EXCEPT SELECT dt, a, b, v FROM mv_psk) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_sort_key_join_on_an_aliased_group_key @cloud
-- a is selected twice; a sort key naming the second alias still has to find the group key behind it.
CREATE TABLE alk (dt DATETIME NOT NULL, a INT NOT NULL, v BIGINT) DUPLICATE KEY(dt, a)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO alk VALUES ('2026-09-10 00:00:00',1,10),('2026-09-11 00:00:00',2,20);
CREATE MATERIALIZED VIEW mv_alk
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(x) BUCKETS 2
ORDER BY (y)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, a AS x, a AS y, SUM(v) AS s FROM alk GROUP BY dt, a;
REFRESH MATERIALIZED VIEW mv_alk WITH SYNC MODE;

INSERT INTO alk VALUES ('2026-09-11 00:00:00',2,6);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_alk', ' <=> ')
REFRESH MATERIALIZED VIEW mv_alk WITH SYNC MODE;
-- 20+6
SELECT dt, x, y, s FROM mv_alk ORDER BY dt, x;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, x, s FROM mv_alk EXCEPT SELECT dt, a, SUM(v) FROM alk GROUP BY dt, a) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, a, SUM(v) FROM alk GROUP BY dt, a EXCEPT SELECT dt, x, s FROM mv_alk) t;
SET enable_materialized_view_rewrite = true;

