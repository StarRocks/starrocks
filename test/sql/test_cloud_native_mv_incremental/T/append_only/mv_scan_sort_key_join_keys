-- name: test_ivm_mv_scan_joins_on_the_sort_key_prefix @cloud
CREATE TABLE sk (dt DATETIME, a INT, b INT, v BIGINT) DUPLICATE KEY(dt, a)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO sk VALUES
  ('2026-01-10 00:00:00',1,10,100),('2026-01-10 00:00:00',2,20,200),
  ('2026-01-11 00:00:00',1,10,110),('2026-01-11 00:00:00',3,30,330);
CREATE MATERIALIZED VIEW mv_sk
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2
ORDER BY (b, a)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, a, b, SUM(v) AS v FROM sk GROUP BY dt, a, b;
REFRESH MATERIALIZED VIEW mv_sk WITH SYNC MODE;
SELECT dt, a, b, v FROM mv_sk ORDER BY dt, a;

-- the declared sort key rides the state-merge join, so its runtime filter can seek the mv
INSERT INTO sk VALUES ('2026-01-11 00:00:00',1,10,5);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_sk', 'b <=> ', 'a <=> ', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_sk WITH SYNC MODE;
SELECT dt, a, b, v FROM mv_sk ORDER BY dt, a;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, a, b, v FROM mv_sk EXCEPT SELECT dt, a, b, SUM(v) FROM sk GROUP BY dt, a, b) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, a, b, SUM(v) FROM sk GROUP BY dt, a, b EXCEPT SELECT dt, a, b, v FROM mv_sk) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_sort_key_join_keeps_the_null_group @cloud
CREATE TABLE skn (dt DATETIME, k INT, v BIGINT) DUPLICATE KEY(dt, k)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(dt) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO skn VALUES ('2026-02-10 00:00:00',NULL,10),('2026-02-10 00:00:00',7,70);
CREATE MATERIALIZED VIEW mv_skn
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2
ORDER BY (k)
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, k, SUM(v) AS v FROM skn GROUP BY dt, k;
REFRESH MATERIALIZED VIEW mv_skn WITH SYNC MODE;
SELECT dt, ifnull(CAST(k AS VARCHAR), 'NULL') AS k, v FROM mv_skn ORDER BY 2;

-- A NULL sort key is a real group: the second refresh must merge onto the row the first wrote,
-- so the NULL group reads 17 rather than the delta's own 7. An = join key would leave it unmatched
-- and state_union would overwrite the 10.
INSERT INTO skn VALUES ('2026-02-10 00:00:00',NULL,7),('2026-02-10 00:00:00',7,3);
REFRESH MATERIALIZED VIEW mv_skn WITH SYNC MODE;
SELECT dt, ifnull(CAST(k AS VARCHAR), 'NULL') AS k, v FROM mv_skn ORDER BY 2;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, k, v FROM mv_skn EXCEPT SELECT dt, k, SUM(v) FROM skn GROUP BY dt, k) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, k, SUM(v) FROM skn GROUP BY dt, k EXCEPT SELECT dt, k, v FROM mv_skn) t;
SET enable_materialized_view_rewrite = true;

-- name: test_ivm_mv_scan_without_order_by_keeps_only_the_row_id @cloud
CREATE TABLE skp (dt DATETIME, a INT, v BIGINT) DUPLICATE KEY(dt, a)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(a) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO skp VALUES ('2026-03-10 00:00:00',1,10),('2026-03-11 00:00:00',2,20);
