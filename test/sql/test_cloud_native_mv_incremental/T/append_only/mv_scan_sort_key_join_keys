PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, a, SUM(v) AS v FROM skp GROUP BY dt, a;
REFRESH MATERIALIZED VIEW mv_skp WITH SYNC MODE;

-- no ORDER BY, so the sort key IS __ROW_ID__ and the join already carries it. That equality stays
-- EQ: __ROW_ID__ is the mv's primary key and the encode of any group key tuple is non-null, NULLs
