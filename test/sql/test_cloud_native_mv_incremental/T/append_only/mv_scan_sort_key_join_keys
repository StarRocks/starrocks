INSERT INTO skp VALUES ('2026-03-11 00:00:00',2,5);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_skp', '__ROW_ID__ = ', 'MaterializedView: true')
function: assert_explain_not_contains('REFRESH MATERIALIZED VIEW mv_skp', '<=>')
REFRESH MATERIALIZED VIEW mv_skp WITH SYNC MODE;
