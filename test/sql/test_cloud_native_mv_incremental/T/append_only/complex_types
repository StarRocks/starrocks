-- name: test_ivm_array_col @cloud
CREATE TABLE ct_arr (k INT, arr ARRAY<INT>) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ct_arr VALUES (1,[1,2]),(2,[3]);
CREATE MATERIALIZED VIEW mv_ct_arr
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, arr FROM ct_arr;
REFRESH MATERIALIZED VIEW mv_ct_arr WITH SYNC MODE;
SELECT k, arr FROM mv_ct_arr ORDER BY k;
INSERT INTO ct_arr VALUES (3,[4,5,6]);
REFRESH MATERIALIZED VIEW mv_ct_arr WITH SYNC MODE;
SELECT k, arr FROM mv_ct_arr ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_ct_arr;
SELECT COUNT(*) AS base_rows FROM ct_arr;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_ct_arr%' OR DEFINITION LIKE '%mv_ct_arr%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_json_col @cloud
CREATE TABLE ct_json (k INT, j JSON) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO ct_json VALUES (1, parse_json('{"a":1}')),(2, parse_json('{"a":2}'));
CREATE MATERIALIZED VIEW mv_ct_json
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, j FROM ct_json;
REFRESH MATERIALIZED VIEW mv_ct_json WITH SYNC MODE;
SELECT k, get_json_int(j, '$.a') AS a FROM mv_ct_json ORDER BY k;
INSERT INTO ct_json VALUES (3, parse_json('{"a":3}'));
REFRESH MATERIALIZED VIEW mv_ct_json WITH SYNC MODE;
SELECT k, get_json_int(j, '$.a') AS a FROM mv_ct_json ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_ct_json;
SELECT COUNT(*) AS base_rows FROM ct_json;
SELECT COUNT(*) AS diff FROM (
    SELECT k, get_json_int(j, '$.a') AS a FROM mv_ct_json
    EXCEPT SELECT k, get_json_int(j, '$.a') AS a FROM ct_json) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT k, get_json_int(j, '$.a') AS a FROM ct_json
    EXCEPT SELECT k, get_json_int(j, '$.a') AS a FROM mv_ct_json) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_ct_json%' OR DEFINITION LIKE '%mv_ct_json%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

