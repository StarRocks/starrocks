SELECT child_id, child_v, parent_v FROM mv_sj ORDER BY child_id;
SELECT COUNT(*) AS mv_rows FROM mv_sj;
SELECT COUNT(*) AS base_rows FROM (
    SELECT a.id FROM tree_sj a JOIN tree_sj b ON a.parent_id = b.id
) t;
SELECT COUNT(*) AS diff FROM (
    SELECT child_id, child_v, parent_v FROM mv_sj
    EXCEPT
    SELECT a.id, a.v, b.v FROM tree_sj a JOIN tree_sj b ON a.parent_id = b.id
) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT a.id, a.v, b.v FROM tree_sj a JOIN tree_sj b ON a.parent_id = b.id
