-- name: test_ivm_cross_join @cloud
CREATE TABLE small_cj (
    k INT, v BIGINT
) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
CREATE TABLE other_cj (
    m INT, w BIGINT
) DUPLICATE KEY(m) DISTRIBUTED BY HASH(m) BUCKETS 1
PROPERTIES ('replication_num' = '1');
INSERT INTO small_cj VALUES (1, 10), (2, 20);
INSERT INTO other_cj VALUES (100, 1000), (200, 2000);
CREATE MATERIALIZED VIEW mv_cj
DISTRIBUTED BY HASH(k) BUCKETS 1
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT s.k, s.v, o.m, o.w FROM small_cj s, other_cj o;
REFRESH MATERIALIZED VIEW mv_cj WITH SYNC MODE;
SELECT k, v, m, w FROM mv_cj ORDER BY k, m;
INSERT INTO small_cj VALUES (3, 30);
REFRESH MATERIALIZED VIEW mv_cj WITH SYNC MODE;
SELECT k, v, m, w FROM mv_cj ORDER BY k, m;
INSERT INTO other_cj VALUES (300, 3000);
REFRESH MATERIALIZED VIEW mv_cj WITH SYNC MODE;
SELECT k, v, m, w FROM mv_cj ORDER BY k, m;
SELECT COUNT(*) AS mv_rows FROM mv_cj;
SELECT COUNT(*) AS base_rows FROM (SELECT s.k FROM small_cj s, other_cj o) t;
SELECT COUNT(*) AS diff FROM (
    SELECT k, v, m, w FROM mv_cj
    EXCEPT
    SELECT s.k, s.v, o.m, o.w FROM small_cj s, other_cj o
) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT s.k, s.v, o.m, o.w FROM small_cj s, other_cj o
    EXCEPT
    SELECT k, v, m, w FROM mv_cj
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE (EXTRA_MESSAGE LIKE '%mv_cj%' OR DEFINITION LIKE '%mv_cj%') AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_self_join @cloud
