-- name: test_ivm_multibucket_dup @cloud
CREATE TABLE mb_dup (k INT, v BIGINT) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 8
PROPERTIES ('replication_num' = '1');
INSERT INTO mb_dup VALUES (1,10),(2,20),(3,30),(4,40),(5,50),(6,60),(7,70),(8,80);
CREATE MATERIALIZED VIEW mv_mb_dup
DISTRIBUTED BY HASH(k) BUCKETS 4
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v FROM mb_dup;
REFRESH MATERIALIZED VIEW mv_mb_dup WITH SYNC MODE;
SELECT k, v FROM mv_mb_dup ORDER BY k;
INSERT INTO mb_dup VALUES (9,90),(10,100),(11,110),(12,120);
REFRESH MATERIALIZED VIEW mv_mb_dup WITH SYNC MODE;
SELECT k, v FROM mv_mb_dup ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_mb_dup;
SELECT COUNT(*) AS base_rows FROM mb_dup;
SELECT COUNT(*) AS diff FROM (SELECT k, v FROM mv_mb_dup EXCEPT SELECT k, v FROM mb_dup) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT k, v FROM mb_dup EXCEPT SELECT k, v FROM mv_mb_dup) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_mb_dup%' OR DEFINITION LIKE '%mv_mb_dup%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_multibucket_agg @cloud
CREATE TABLE mb_agg (k INT, s BIGINT SUM) AGGREGATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 8
PROPERTIES ('replication_num' = '1');
INSERT INTO mb_agg VALUES (1,10),(2,20),(3,30),(4,40),(1,5),(2,7);
CREATE MATERIALIZED VIEW mv_mb_agg
DISTRIBUTED BY HASH(k) BUCKETS 4
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, SUM(s) AS x FROM mb_agg GROUP BY k;
REFRESH MATERIALIZED VIEW mv_mb_agg WITH SYNC MODE;
SELECT k, x FROM mv_mb_agg ORDER BY k;
INSERT INTO mb_agg VALUES (5,50),(1,3),(6,60),(2,1);
REFRESH MATERIALIZED VIEW mv_mb_agg WITH SYNC MODE;
SELECT k, x FROM mv_mb_agg ORDER BY k;
SELECT COUNT(*) AS mv_rows FROM mv_mb_agg;
SELECT COUNT(*) AS base_rows FROM (SELECT k FROM mb_agg GROUP BY k) t;
SELECT COUNT(*) AS diff FROM (
    SELECT k, x FROM mv_mb_agg EXCEPT SELECT k, SUM(s) FROM mb_agg GROUP BY k
) t;
SELECT COUNT(*) AS diff_reverse FROM (
    SELECT k, SUM(s) FROM mb_agg GROUP BY k EXCEPT SELECT k, x FROM mv_mb_agg
) t;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_mb_agg%' OR DEFINITION LIKE '%mv_mb_agg%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

