-- name: test_ivm_mv_scan_pruned_to_changed_partitions @cloud
CREATE TABLE pb (id BIGINT, dt DATETIME, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO pb VALUES
  (1,'2026-01-10 00:00:00',10),(2,'2026-01-10 00:00:00',20),
  (1,'2026-01-11 00:00:00',11),(3,'2026-01-11 00:00:00',31),
  (2,'2026-01-12 00:00:00',22),(4,'2026-01-12 00:00:00',42);
CREATE MATERIALIZED VIEW mv_pb
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, id, SUM(v) AS v FROM pb GROUP BY dt, id;
REFRESH MATERIALIZED VIEW mv_pb WITH SYNC MODE;
SELECT dt, id, v FROM mv_pb ORDER BY dt, id;

-- delta in one day: the state-merge join reads only that day's MV partition
INSERT INTO pb VALUES (1,'2026-01-11 00:00:00',100),(5,'2026-01-11 00:00:00',500);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_pb', 'partitions=1/3', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_pb WITH SYNC MODE;
SELECT dt, id, v FROM mv_pb ORDER BY dt, id;

-- late data into two older days
INSERT INTO pb VALUES (2,'2026-01-10 00:00:00',200),(4,'2026-01-12 00:00:00',400);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_pb', 'partitions=2/3', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_pb WITH SYNC MODE;
SELECT dt, id, v FROM mv_pb ORDER BY dt, id;

-- a brand-new day has no existing state to merge, so the MV side drops out of the plan
INSERT INTO pb VALUES (6,'2026-01-13 00:00:00',60);
function: assert_explain_not_contains('REFRESH MATERIALIZED VIEW mv_pb', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_pb WITH SYNC MODE;
SELECT dt, id, v FROM mv_pb ORDER BY dt, id;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, id, v FROM mv_pb EXCEPT SELECT dt, id, SUM(v) FROM pb GROUP BY dt, id) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, id, SUM(v) FROM pb GROUP BY dt, id EXCEPT SELECT dt, id, v FROM mv_pb) t;
SET enable_materialized_view_rewrite = true;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_pb%' OR DEFINITION LIKE '%mv_pb%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_mv_scan_join_dim_change_keeps_full_scan @cloud
CREATE TABLE fj (id BIGINT, dt DATETIME, k INT, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
CREATE TABLE dj (k INT, w BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO dj VALUES (1,10),(2,20);
INSERT INTO fj VALUES
  (1,'2026-02-10 00:00:00',1,5),(2,'2026-02-11 00:00:00',2,7),(3,'2026-02-12 00:00:00',1,9);
CREATE MATERIALIZED VIEW mv_fj
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT f.dt, f.k, SUM(f.v * d.w) AS v FROM fj f JOIN dj d ON f.k = d.k GROUP BY f.dt, f.k;
REFRESH MATERIALIZED VIEW mv_fj WITH SYNC MODE;
SELECT dt, k, v FROM mv_fj ORDER BY dt, k;

-- a fact-only delta still prunes to the day it landed in
INSERT INTO fj VALUES (4,'2026-02-11 00:00:00',1,100);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_fj', 'partitions=1/3', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_fj WITH SYNC MODE;
SELECT dt, k, v FROM mv_fj ORDER BY dt, k;

-- k=1 already has fact rows on all three days, so this one dimension row moves every MV partition
INSERT INTO dj VALUES (1,3);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_fj', 'partitions=3/3', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_fj WITH SYNC MODE;
SELECT dt, k, v FROM mv_fj ORDER BY dt, k;
-- every day that carries k=1 must have picked the new dimension row up
SELECT count(*) AS days_with_k1 FROM (SELECT dt FROM mv_fj WHERE k = 1 GROUP BY dt) t;

SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, k, v FROM mv_fj EXCEPT SELECT f.dt, f.k, SUM(f.v * d.w) FROM fj f JOIN dj d ON f.k = d.k GROUP BY f.dt, f.k) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT f.dt, f.k, SUM(f.v * d.w) FROM fj f JOIN dj d ON f.k = d.k GROUP BY f.dt, f.k EXCEPT SELECT dt, k, v FROM mv_fj) t;
SET enable_materialized_view_rewrite = true;

