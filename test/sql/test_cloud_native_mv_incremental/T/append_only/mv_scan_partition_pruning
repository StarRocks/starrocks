-- name: test_ivm_mv_scan_self_join_keeps_full_scan @cloud
CREATE TABLE sj (id BIGINT, dt DATETIME, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
-- id 7 lives in both days, so a delta on one day joins rows of the other
INSERT INTO sj VALUES (7,'2026-06-10 00:00:00',10),(7,'2026-06-11 00:00:00',20);
CREATE MATERIALIZED VIEW mv_sj
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT a.dt AS dt, a.id AS id, SUM(a.v * b.v) AS total
   FROM sj a JOIN sj b ON a.id = b.id GROUP BY a.dt, a.id;
REFRESH MATERIALIZED VIEW mv_sj WITH SYNC MODE;
SELECT dt, id, total FROM mv_sj ORDER BY dt, id;

-- one day gets a row; as the non-reference side it changes the other day's aggregate too
INSERT INTO sj VALUES (7,'2026-06-11 00:00:00',5);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_sj', 'partitions=2/2', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_sj WITH SYNC MODE;
SELECT dt, id, total FROM mv_sj ORDER BY dt, id;
SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (
  SELECT dt, id, total FROM mv_sj
  EXCEPT
  SELECT a.dt, a.id, SUM(a.v * b.v) FROM sj a JOIN sj b ON a.id = b.id GROUP BY a.dt, a.id) t;
SELECT COUNT(*) AS diff_reverse FROM (
  SELECT a.dt, a.id, SUM(a.v * b.v) FROM sj a JOIN sj b ON a.id = b.id GROUP BY a.dt, a.id
  EXCEPT
  SELECT dt, id, total FROM mv_sj) t;
SET enable_materialized_view_rewrite = true;

