-- name: test_ivm_mv_scan_ignores_compacted_partitions @cloud
-- Compaction advances a base partition's visible version without writing a row. The scan has to stay
-- on the day that actually took the delta rather than spreading to every partition compaction touched.
CREATE TABLE pc (id BIGINT, dt DATETIME, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO pc VALUES (1,'2026-03-10 00:00:00',10),(2,'2026-03-11 00:00:00',20),(3,'2026-03-12 00:00:00',30);
-- more than one rowset per partition, so compaction has something to merge
INSERT INTO pc VALUES (4,'2026-03-10 00:00:00',11),(5,'2026-03-11 00:00:00',21),(6,'2026-03-12 00:00:00',31);
INSERT INTO pc VALUES (7,'2026-03-10 00:00:00',12),(8,'2026-03-11 00:00:00',22),(9,'2026-03-12 00:00:00',32);
CREATE MATERIALIZED VIEW mv_pc
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, id, SUM(v) AS v FROM pc GROUP BY dt, id;
REFRESH MATERIALIZED VIEW mv_pc WITH SYNC MODE;
-- COMPACT only raises the partition's compaction priority, so the published version has to be waited
-- for; without one the plan assertion below would have nothing to be wrong about
[UC]ALTER TABLE pc COMPACT;
function: wait_partition_compaction_published('pc')
INSERT INTO pc VALUES (1,'2026-03-11 00:00:00',100);
function: assert_explain_contains('REFRESH MATERIALIZED VIEW mv_pc', 'partitions=1/3', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_pc WITH SYNC MODE;
SELECT dt, id, v FROM mv_pc ORDER BY dt, id;
SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, id, v FROM mv_pc EXCEPT SELECT dt, id, SUM(v) FROM pc GROUP BY dt, id) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, id, SUM(v) FROM pc GROUP BY dt, id EXCEPT SELECT dt, id, v FROM mv_pc) t;
SET enable_materialized_view_rewrite = true;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_pc%' OR DEFINITION LIKE '%mv_pc%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_mv_scan_compaction_only_refresh_reads_nothing @cloud
-- A window holding nothing but compaction carries no row to merge into, so the state-merge scan reads
-- no partition at all and the refresh leaves the view where it was.
CREATE TABLE po (id BIGINT, dt DATETIME, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO po VALUES (1,'2026-04-10 00:00:00',10),(2,'2026-04-11 00:00:00',20);
INSERT INTO po VALUES (3,'2026-04-10 00:00:00',11),(4,'2026-04-11 00:00:00',21);
INSERT INTO po VALUES (5,'2026-04-10 00:00:00',12),(6,'2026-04-11 00:00:00',22);
CREATE MATERIALIZED VIEW mv_po
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT dt, id, SUM(v) AS v FROM po GROUP BY dt, id;
REFRESH MATERIALIZED VIEW mv_po WITH SYNC MODE;
SELECT dt, id, v FROM mv_po ORDER BY dt, id;
[UC]ALTER TABLE po COMPACT;
function: wait_partition_compaction_published('po')
-- every partition pruned leaves nothing to merge with, so the rule drops the MV side altogether and
-- the delta merges against NULL -- which writes nothing here, the delta being empty
function: assert_explain_not_contains('REFRESH MATERIALIZED VIEW mv_po', 'MaterializedView: true')
REFRESH MATERIALIZED VIEW mv_po WITH SYNC MODE;
SELECT dt, id, v FROM mv_po ORDER BY dt, id;
-- An unchanged view alone cannot tell a correct empty merge from a refresh that did nothing, and the
-- way it could do nothing harmfully is by moving the bookmark past rows it never merged. Loading into
-- a group the view already holds has to sum with the state that is there: 10 + 100, not 100.
INSERT INTO po VALUES (1,'2026-04-10 00:00:00',100);
REFRESH MATERIALIZED VIEW mv_po WITH SYNC MODE;
SELECT dt, id, v FROM mv_po ORDER BY dt, id;
SET enable_materialized_view_rewrite = false;
SELECT COUNT(*) AS diff FROM (SELECT dt, id, v FROM mv_po EXCEPT SELECT dt, id, SUM(v) FROM po GROUP BY dt, id) t;
SELECT COUNT(*) AS diff_reverse FROM (SELECT dt, id, SUM(v) FROM po GROUP BY dt, id EXCEPT SELECT dt, id, v FROM mv_po) t;
SET enable_materialized_view_rewrite = true;
SELECT DISTINCT get_json_string(EXTRA_MESSAGE,'$.refreshMode') AS mode, STATE
FROM information_schema.task_runs
WHERE `DATABASE` = database() AND (EXTRA_MESSAGE LIKE '%mv_po%' OR DEFINITION LIKE '%mv_po%')
  AND get_json_double(EXTRA_MESSAGE,'$.processStartTime') > 0
ORDER BY 1, 2;

-- name: test_ivm_mv_scan_compacted_dim_keeps_pruning @cloud
-- A dimension table cannot be mapped to MV partitions, so any row it writes sends the join over the whole
-- view. Compaction writes none, and must not cost the pruning the fact table's delta earned.
CREATE TABLE fd (id BIGINT, dt DATETIME, k INT, v BIGINT) DUPLICATE KEY(id, dt)
PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(id) BUCKETS 2 PROPERTIES ('replication_num' = '1');
CREATE TABLE dd (k INT, w BIGINT) DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 2 PROPERTIES ('replication_num' = '1');
INSERT INTO dd VALUES (1,10),(2,20);
INSERT INTO dd VALUES (3,30);
INSERT INTO dd VALUES (4,40);
