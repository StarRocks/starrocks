PARTITION BY date_trunc('day', dt)
DISTRIBUTED BY HASH(k) BUCKETS 2
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT f.dt, f.k, SUM(f.v * d.w) AS v FROM fd f JOIN dd d ON f.k = d.k GROUP BY f.dt, f.k;
REFRESH MATERIALIZED VIEW mv_fd WITH SYNC MODE;
SELECT dt, k, v FROM mv_fd ORDER BY dt, k;
[UC]ALTER TABLE dd COMPACT;
