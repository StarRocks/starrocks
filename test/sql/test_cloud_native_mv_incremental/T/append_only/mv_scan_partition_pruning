SELECT COUNT(*) AS diff_reverse FROM (SELECT f.dt, f.k, SUM(f.v * d.w) FROM fd f JOIN dd d ON f.k = d.k GROUP BY f.dt, f.k EXCEPT SELECT dt, k, v FROM mv_fd) t;
