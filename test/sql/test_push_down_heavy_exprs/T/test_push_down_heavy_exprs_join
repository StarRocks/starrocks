-- name: test_push_down_heavy_exprs_join
create table buyers (buyerId int not null, lastName varchar(256))
distributed by hash(buyerId) buckets 1 properties("replication_num"="1");
create table t_clients (hash varchar(256), status int)
distributed by hash(hash) buckets 1 properties("replication_num"="1");
insert into buyers values (1, 'A B'), (2, 'C D'), (3, null), (4, '');
insert into t_clients values (sha2('AB', 256), 1), (sha2('AB', 256), 2), (sha2('', 256), 3);
set push_down_heavy_exprs = true;
with b as (
    select sha2(concat(regexp_replace(ifnull(lastName, ''), '[[:space:]]+', '')), 256) hash
    from buyers
)
select * from b inner join [broadcast] t_clients using (hash) order by hash, status;
with b as (
    select buyerId, sha2(concat(regexp_replace(ifnull(lastName, ''), '[[:space:]]+', '')), 256) hash
    from buyers
)
select b.buyerId, t_clients.status from b inner join [broadcast] t_clients
on b.hash = t_clients.hash and b.buyerId = t_clients.status order by b.buyerId;
insert into t_clients values (null, 8), (sha2('missing', 256), 9);
with b as (
    select buyerId, sha2(regexp_replace(lastName, '[[:space:]]+', ''), 256) hash
    from buyers
)
select b.buyerId, t_clients.status from b inner join [broadcast] t_clients
on b.hash <=> t_clients.hash order by b.buyerId, t_clients.status;
with b as (
    select sha2(regexp_replace(lastName, '[[:space:]]+', ''), 256) hash
    from buyers
)
select count(*) from b inner join [broadcast] t_clients using (hash) where status = 9;
set push_down_heavy_exprs = false;
with b as (
    select sha2(concat(regexp_replace(ifnull(lastName, ''), '[[:space:]]+', '')), 256) hash
    from buyers
)
select * from b inner join [broadcast] t_clients using (hash) order by hash, status;
drop table buyers;
drop table t_clients;
