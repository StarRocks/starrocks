SELECT count(1), sum(v) FROM mub_${uuid0}, UNNEST(a) AS u(v);
-- result:
40	100
-- !result
SELECT CAST(regexp_extract(get_query_profile(last_query_id()), 'TableFunctionExecCount: ([0-9]+)', 1) AS BIGINT) <= 4;
-- result:
1
-- !result
SET chunk_size = 3;
-- result:
-- !result
SELECT count(1), sum(v1), sum(v2) FROM mub_${uuid0}, UNNEST(a, b) AS u(v1, v2) WHERE id = 1;
-- result:
10	10	4
-- !result
SELECT CAST(regexp_extract(get_query_profile(last_query_id()), 'TableFunctionExecCount: ([0-9]+)', 1) AS BIGINT) >= 4;
