select count(1) from t_gin_prune_pk_${uuid0} where v = 'redx';
select id from t_gin_prune_pk_${uuid0} where v = 'redx' order by id;
select id, v from t_gin_prune_pk_${uuid0} where v = 'redx' order by id;
