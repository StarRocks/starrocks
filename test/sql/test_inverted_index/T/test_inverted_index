  `ts` datetime NOT NULL,
  `v`  varchar(255) NOT NULL,
  INDEX gin_v (`v`) USING GIN ("parser" = "none")
) ENGINE=OLAP
PRIMARY KEY(`id`, `ts`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES ("replication_num" = "1", "replicated_storage" = "false");

