-- name: test_bm25_score_shared_nothing
-- BM25 relevance scoring on a shared-nothing (local) builtin GIN index (index_options=docs_and_freqs).
-- Exercises the local scan path: OlapChunkSource tablet-local Phase-1 stats (via the shared
-- build_tablet_bm25_stats) + SegmentIterator Phase-2 scoring. score() is enabled by default; the GIN index
-- feature still needs its FE config.
ADMIN SET FRONTEND CONFIG ("enable_experimental_gin" = "true");
create database bm25_${uuid0};
use bm25_${uuid0};

CREATE TABLE docs (
    id INT NOT NULL,
    content VARCHAR(65533) NOT NULL,
    INDEX idx_content (content) USING GIN ("imp_lib" = "builtin", "parser" = "english", "index_options" = "docs_and_freqs")
)
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");

insert into docs values
  (1, 'the quick brown fox'),
  (2, 'the lazy dog'),
  (3, 'quick quick fox'),
  (4, 'a slow green turtle');

-- Ranking: doc 3 (quick x2 + fox) outranks doc 1 (quick + fox); docs 2/4 do not match. Same tablet-local
-- BM25 as the shared-data path -- the Phase-1 stats are computed by the same shared helper.
SELECT id FROM docs WHERE content MATCH_ANY 'quick fox' ORDER BY score() DESC LIMIT 10;

-- Single-term query returns only the matching row.
SELECT id FROM docs WHERE content MATCH_ANY 'dog' ORDER BY score() DESC LIMIT 10;

-- Projected score() (bare in the inner query; the analyzer rejects a wrapped score(), so the outer query
-- rounds the materialized score column for a stable recorded result).
SELECT id, content, round(s, 4) AS s FROM (
    SELECT id, content, score() AS s FROM docs WHERE content MATCH_ANY 'quick fox' ORDER BY score() DESC LIMIT 2
) t;

-- Delete the top-scoring row (a duplicate-key delete predicate) and confirm the top-k pushdown pre-applies
-- it on the local path too: LIMIT 1 returns the top live row, not an empty result.
DELETE FROM docs WHERE id = 3;
SELECT id FROM docs WHERE content MATCH_ANY 'quick fox' ORDER BY score() DESC LIMIT 1;

-- A term absent from the corpus matches nothing.
SELECT count(*) FROM docs WHERE content MATCH_ANY 'zzz';

drop database bm25_${uuid0};
