-- name: test_convert_tz_out_of_range
CREATE DATABASE db_${uuid0};
USE db_${uuid0};
set sql_dialect='StarRocks';

-- constant arguments: FE folding rejects an out-of-range DATETIME and leaves the call to BE
select convert_tz('9999-12-31 23:00:00', '-05:00', 'UTC');
select convert_tz('0000-01-01 01:00:00', '+08:00', 'UTC');
select convert_tz('9999-12-31 20:00:00', 'America/New_York', 'UTC');
select convert_tz('0000-01-01 01:00:00', 'Asia/Shanghai', 'UTC');
select convert_tz('9999-12-31 23:00:00', 'UTC', '-05:00');
select convert_tz('2024-01-01 00:00:00', 'America/New_York', 'UTC');

CREATE TABLE t1 (
    id INT,
    dt DATETIME,
    from_tz VARCHAR(64),
    to_tz VARCHAR(64)
) DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");

INSERT INTO t1 VALUES
    (1, '9999-12-31 23:00:00', '-05:00', 'UTC'),
    (2, '0000-01-01 01:00:00', '+08:00', 'UTC'),
    (3, '9999-12-31 20:00:00', 'America/New_York', 'UTC'),
    (4, '0000-01-01 01:00:00', 'Asia/Shanghai', 'UTC'),
    (5, '9999-12-31 23:00:00', 'UTC', '-05:00'),
    (6, '2024-01-01 00:00:00', 'America/New_York', 'UTC');

-- time zones from columns
select id, convert_tz(dt, from_tz, to_tz) from t1 order by id;
-- constant time zones over a column
select id, convert_tz(dt, 'America/New_York', 'UTC') from t1 order by id;
select id, convert_tz(dt, '-05:00', 'UTC') from t1 order by id;

-- an out-of-range result is stored as NULL, not as an invalid DATETIME
CREATE TABLE t2 (
    id INT,
    dt DATETIME
) DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");

INSERT INTO t2 SELECT id, convert_tz(dt, from_tz, to_tz) FROM t1;
select * from t2 order by id;

DROP DATABASE db_${uuid0};
