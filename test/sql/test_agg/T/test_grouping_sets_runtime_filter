-- name: test_grouping_sets_runtime_filter
-- A runtime filter on a grouping key must not be pushed below the REPEAT_NODE when some grouping set
-- replaces that key with NULL and the filter can let NULL through. Below the repeat a row still has
-- its real key, so the filter drops it -- and with it the copy that belongs to the NULL-keyed group,
-- e.g. the ROLLUP grand total.
CREATE TABLE t0 (
    c0 BIGINT NULL,
    c1 BIGINT NULL
)
DUPLICATE KEY(c0)
DISTRIBUTED BY HASH(c0) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO t0 SELECT generate_series, 4096 - generate_series FROM TABLE(generate_series(1, 4096));
INSERT INTO t0 SELECT * FROM t0;
CREATE TABLE r (k BIGINT NULL)
DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ("replication_num" = "1");
INSERT INTO r VALUES (NULL), (1);

-- Aggregation TopN runtime filter (NULLS FIRST keeps the NULL group). A small chunk_size makes the
-- filter take effect early in the scan; with the default one the scan usually finishes first.
SELECT /*+SET_VAR(chunk_size=64)*/ c0, count(*) FROM t0 GROUP BY ROLLUP (c0) ORDER BY 1 ASC LIMIT 3;
SELECT /*+SET_VAR(chunk_size=64)*/ c0, count(*) FROM t0 GROUP BY CUBE (c0) ORDER BY 1 ASC LIMIT 3;

-- c0 is kept by every grouping set, so the filter may still be pushed below the repeat.
SELECT /*+SET_VAR(chunk_size=64)*/ c0, c1, count(*) FROM t0 GROUP BY GROUPING SETS ((c0, c1), (c0)) ORDER BY 1, 2 LIMIT 3;

-- Null-safe join runtime filter: IN (NULL, 1) keeps the grand total above the repeat.
SELECT a.c0, a.cnt FROM (SELECT c0, count(*) cnt FROM t0 GROUP BY ROLLUP (c0)) a JOIN [broadcast] r ON a.c0 <=> r.k ORDER BY 1;
SELECT a.c0, a.cnt FROM (SELECT c0, count(*) cnt FROM t0 GROUP BY ROLLUP (c0)) a JOIN [broadcast] r ON a.c0 = r.k ORDER BY 1;
