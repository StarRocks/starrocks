-- name: test_compression_dict_columns
CREATE DATABASE test_compression_dict_${uuid0};
USE test_compression_dict_${uuid0};

update information_schema.be_configs set value = "true" where name = "enable_compression_dict";

CREATE TABLE t_cdict (
  k BIGINT NOT NULL,
  v STRING,
  j JSON
) ENGINE=OLAP
DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ("replication_num" = "1", "compression_dict_columns" = "v, j");

function: assert_query_contains("show create table t_cdict", "compression_dict_columns")

insert into t_cdict values
  (1, '{"role":"assistant","parts":[{"type":"text","content":"row one"}]}', parse_json('{"a":1}')),
  (2, '{"role":"assistant","parts":[{"type":"text","content":"row two"}]}', parse_json('{"a":2}')),
  (3, '{"role":"assistant","parts":[{"type":"text","content":"row three"}]}', parse_json('{"a":3}'));

select count(*) from t_cdict;
select v from t_cdict where k = 2;
select get_json_string(j, 'a') from t_cdict where k = 3;
select sum(length(v)) from t_cdict;

ALTER TABLE t_cdict SET ("compression_dict_columns" = "v");
function: wait_alter_table_finish()
function: assert_query_contains("show create table t_cdict", "\"compression_dict_columns\" = \"v\"")

select count(*) from t_cdict;
select v from t_cdict where k = 2;

ALTER TABLE t_cdict DROP COLUMN v;
function: wait_alter_table_finish()
function: assert_query_not_contains("show create table t_cdict", "compression_dict_columns")

ALTER TABLE t_cdict ADD COLUMN v STRING;
function: wait_alter_table_finish()
function: assert_query_not_contains("show create table t_cdict", "compression_dict_columns")

update information_schema.be_configs set value = "false" where name = "enable_compression_dict";
DROP DATABASE test_compression_dict_${uuid0};
