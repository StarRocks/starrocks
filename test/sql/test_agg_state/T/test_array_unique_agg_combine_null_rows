-- name: test_array_unique_agg_combine_null_rows
-- array_unique_agg and array_agg_distinct turn a NULL input into a NULL element; their _combine must too.
DROP DATABASE IF EXISTS test_array_unique_agg_combine_null_rows_${uuid0};
CREATE DATABASE test_array_unique_agg_combine_null_rows_${uuid0};
USE test_array_unique_agg_combine_null_rows_${uuid0};

CREATE TABLE t1 (
    k INT,
    g INT,
    arr ARRAY<INT>,
    v INT
) DUPLICATE KEY(k) DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ("replication_num" = "1");

INSERT INTO t1 VALUES
    (1, 1, [1, 2], 1),
    (2, 1, NULL, NULL),
    (3, 2, NULL, NULL),
    (4, 3, [3, NULL], 3),
    (5, 3, [3], 3);

SET pipeline_dop = 1;
SET streaming_preaggregation_mode = 'force_preaggregation';

SET new_planner_agg_stage = 1;
SELECT g,
       array_sort(array_unique_agg(arr)),
       array_sort(array_unique_agg_state_merge(array_unique_agg_combine(arr))),
       array_sort(array_agg_distinct(v)),
       array_sort(array_agg_distinct_state_merge(array_agg_distinct_combine(v)))
FROM t1 GROUP BY g ORDER BY g;

SET new_planner_agg_stage = 2;
SELECT g,
       array_sort(array_unique_agg(arr)),
       array_sort(array_unique_agg_state_merge(array_unique_agg_combine(arr))),
       array_sort(array_agg_distinct(v)),
       array_sort(array_agg_distinct_state_merge(array_agg_distinct_combine(v)))
FROM t1 GROUP BY g ORDER BY g;

DROP DATABASE test_array_unique_agg_combine_null_rows_${uuid0};
