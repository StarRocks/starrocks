-- name: test_deltalake_function_predicate_partition_prune
-- description: A predicate over a function of a DATE partition column skips files on the column range it implies,
-- including functions the generic date-column simplification does not rewrite:
-- date_format(col_date, '%Y-%m-%d %H') = '2024-04-25 00' implies col_date >= '2024-04-25' and col_date < '2024-04-26'.
-- Fixture (DATE partition, 3 rows for each of 2024-04-24 .. 2024-04-27): delta_oss_db.delta_lake_par_col_date.

create external catalog delta_test_${uuid0} PROPERTIES (
    "type"="deltalake",
    "hive.metastore.uris"="${deltalake_catalog_hive_metastore_uris}",
    "aws.s3.access_key"="${oss_ak}",
    "aws.s3.secret_key"="${oss_sk}",
    "aws.s3.endpoint"="${oss_endpoint}"
);

select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') = '2024-04-25 00' group by col_date order by col_date;
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') = '2024-04-25 00'", "partitions=1/4")
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') >= '2024-04-26 00' group by col_date order by col_date;
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') >= '2024-04-26 00'", "partitions=2/4")

-- control: without function predicate pruning every file is read, and the result is the same
set enable_delta_lake_function_predicate_pruning = false;
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') = '2024-04-25 00' group by col_date order by col_date;
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where date_format(col_date, '%Y-%m-%d %H') = '2024-04-25 00'", "partitions=4/4")
set enable_delta_lake_function_predicate_pruning = true;

drop catalog delta_test_${uuid0};
