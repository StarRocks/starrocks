-- name: test_deltalake_pushdown_in_like
create external catalog delta_test_${uuid0} PROPERTIES (
    "type"="deltalake",
    "hive.metastore.uris"="${deltalake_catalog_hive_metastore_uris}",
    "aws.s3.access_key"="${oss_ak}",
    "aws.s3.secret_key"="${oss_sk}",
    "aws.s3.endpoint"="${oss_endpoint}"
);
-- result:
-- !result
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where col_date in ('2024-04-24', '2024-04-25')", "partitions=2/4")
-- result:
None
-- !result
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where col_date in ('2024-04-24', '2024-04-25') group by col_date order by col_date;
-- result:
2024-04-24	3
2024-04-25	3
-- !result
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_string where col_string in ('value1', 'value3')", "partitions=2/3")
-- result:
None
-- !result
select col_string, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_string where col_string in ('value1', 'value3') group by col_string order by col_string;
-- result:
value1	3
value3	4
-- !result
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where col_date not in ('2024-04-24', '2024-04-25') group by col_date order by col_date;
-- result:
2024-04-26	3
2024-04-27	3
-- !result
function: assert_explain_verbose_contains("select * from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where (col_date = '2024-04-24' and dayofweek(col_date) > 0) or col_date = '2024-04-26'", "partitions=2/4")
-- result:
None
-- !result
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where (col_date = '2024-04-24' and dayofweek(col_date) > 0) or col_date = '2024-04-26' group by col_date order by col_date;
-- result:
2024-04-24	3
2024-04-26	3
-- !result
select col_date, count(*) from delta_test_${uuid0}.delta_oss_db.delta_lake_par_col_date where not (col_date = '2024-04-24' and dayofweek(col_date) = 1) group by col_date order by col_date;
-- result:
2024-04-24	3
2024-04-25	3
2024-04-26	3
2024-04-27	3
-- !result
