CREATE MATERIALIZED VIEW _mv_947cbb72498e2d35811884752afda5734ac8024e (
  lo_quantity
  , lo_discount
  , d_yearmonthnum
  , _ca0003
)
COMMENT "MV recommended by AutoMV"
DISTRIBUTED BY HASH (lo_quantity, lo_discount, d_yearmonthnum) BUCKETS 64
ORDER BY (lo_quantity, lo_discount, d_yearmonthnum)
REFRESH ASYNC START("2023-12-01 10:00:00") EVERY(INTERVAL 1 DAY)
PROPERTIES (
  "replicated_storage" = "true",
  "storage_medium" = "HDD",
  "replication_num" = "1"
)
AS
SELECT
  _ta0000.lo_quantity
  ,_ta0000.lo_discount
  ,_ta0000.d_yearmonthnum
  ,(sum(_ta0000.lo_revenue)) AS _ca0003
FROM
  (
    SELECT
      `dates`.d_yearmonthnum
      ,`lineorder`.lo_quantity
      ,`lineorder`.lo_discount
      ,`lineorder`.lo_revenue
    FROM
      `lineorder`
      INNER JOIN
      `dates`
      ON (`lineorder`.lo_orderdate = `dates`.d_datekey)
  ) _ta0000
GROUP BY
  _ta0000.lo_quantity
  ,_ta0000.lo_discount
  ,_ta0000.d_yearmonthnum;
