-- A table-level threshold, not just the on/off switch: "b" is present in every row but "c" only in
-- half of them, so a sparsity factor of 0.9 must keep "c" out of its own sub-column even though the
-- be.conf global (0.3) would extract it. The column-mode update has to honour that too.
CREATE TABLE t_sparse (
    pk BIGINT NOT NULL,
    j JSON,
    v BIGINT
) PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1
PROPERTIES ("replication_num" = "1", "flat_json.enable" = "true", "flat_json.sparsity.factor" = "0.9");
INSERT INTO t_sparse VALUES
  (1, parse_json('{"a": 1, "b": "p", "c": 1}'), 1),
  (2, parse_json('{"a": 2, "b": "p", "c": 2}'), 2),
  (3, parse_json('{"a": 3, "b": "p", "c": 3}'), 3),
  (4, parse_json('{"a": 4, "b": "p", "c": 4}'), 4),
  (5, parse_json('{"a": 5, "b": "p", "c": 5}'), 5),
  (6, parse_json('{"a": 6, "b": "p"}'), 6),
  (7, parse_json('{"a": 7, "b": "p"}'), 7),
  (8, parse_json('{"a": 8, "b": "p"}'), 8),
  (9, parse_json('{"a": 9, "b": "p"}'), 9),
  (10, parse_json('{"a": 10, "b": "p"}'), 10);
select distinct coalesce(m[1], '(not flat)') as form
  from (select flat_json_meta(j) as m from t_sparse[_META_]) x order by form;
set partial_update_mode = 'column';
INSERT INTO t_sparse (pk, j) VALUES
  (11, parse_json('{"a": 111, "b": "q", "c": 111}')),
  (12, parse_json('{"a": 112, "b": "q", "c": 112}')),
  (13, parse_json('{"a": 113, "b": "q", "c": 113}')),
  (14, parse_json('{"a": 114, "b": "q", "c": 114}')),
  (15, parse_json('{"a": 115, "b": "q"}')),
  (16, parse_json('{"a": 116, "b": "q"}')),
  (17, parse_json('{"a": 117, "b": "q"}')),
  (18, parse_json('{"a": 118, "b": "q"}')),
  (19, parse_json('{"a": 119, "b": "q"}')),
  (20, parse_json('{"a": 120, "b": "q"}'));
set partial_update_mode = 'auto';
select distinct coalesce(m[1], '(not flat)') as form
  from (select flat_json_meta(j) as m from t_sparse[_META_]) x order by form;

-- This is a physical-form change only: every value must be untouched by it.
select pk, cast(j as varchar), v from t_off order by pk;
select pk, cast(j as varchar), v from t_default order by pk;
select pk, cast(j as varchar), v from t_off_row order by pk;
select pk, cast(j as varchar), v from t_sparse order by pk;
select count(*), sum(pk), sum(get_json_int(j, '$.a')), sum(v) from t_off;
select count(*), sum(pk), sum(get_json_int(j, '$.a')), sum(v) from t_default;
select count(*), sum(pk), sum(get_json_int(j, '$.a')), sum(v) from t_off_row;
select count(*), sum(pk), sum(get_json_int(j, '$.a')), sum(v) from t_sparse;

DROP DATABASE db_${uuid0};
