create table t (
    dt date not null,
    id int not null,
    score int not null,
    tag varchar(256) not null
)
primary key(dt, id)
partition by range(dt) (
    partition p1 values less than ('2026-01-02'),
    partition p2 values less than ('2026-01-03'),
    partition p3 values less than ('2026-01-04')
)
order by(score, tag)
properties('replication_num' = '1');
