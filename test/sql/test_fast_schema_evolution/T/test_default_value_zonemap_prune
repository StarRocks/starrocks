-- name: test_default_value_zonemap_prune
-- A column added by fast schema evolution is physically absent from every
-- pre-existing segment, so it reads through DefaultValueColumnIterator and every
-- row of it holds the column default. This case proves two things:
--   1. the read side never over-prunes -- a predicate that the default satisfies
--      still returns every row, in every key type;
--   2. a predicate that the default cannot satisfy prunes the segment outright,
--      which shows up in the profile as ZoneMapIndexFilterRows > 0.
-- Assertion (2) is the point of the optimisation: before it, such a query read
-- the whole segment and compared the synthesised default row by row, and
-- ZoneMapIndexFilterRows was necessarily 0 for a column absent from the segment.
create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t_dup (
    k1 int,
    v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1", "fast_schema_evolution" = "true");

-- One insert -> one rowset, so no compaction can materialise the added column
-- behind the test's back.
insert into t_dup select x, x from table(generate_series(1, 1000)) t(x);

ALTER TABLE t_dup ADD COLUMN c_int INT DEFAULT "0";
function: wait_alter_table_finish()
ALTER TABLE t_dup ADD COLUMN c_str VARCHAR(20) DEFAULT "dv";
function: wait_alter_table_finish()
-- Nullable, no declared default: the value is NULL on every row.
ALTER TABLE t_dup ADD COLUMN c_null INT;
function: wait_alter_table_finish()
ALTER TABLE t_dup ADD COLUMN c_dec DECIMAL(10, 2) DEFAULT "1.23";
function: wait_alter_table_finish()

-- Must not over-prune.
select count(*) from t_dup where c_int = 0;
select count(*) from t_dup where c_int <= 0;
select count(*) from t_dup where c_int in (0, 7);
select count(*) from t_dup where c_int is not null;
select count(*) from t_dup where c_str = 'dv';
select count(*) from t_dup where c_str < 'zz';
select count(*) from t_dup where c_null is null;
select count(*) from t_dup where c_dec = 1.23;
-- The discriminating decimal case: a fold that ignored the scale would compare
-- 1 against 100 and wrongly decide nothing matches.
select count(*) from t_dup where c_dec > 1.00;

-- Must prune, and must return the right (empty) answer.
select count(*) from t_dup where c_int = 7;
select count(*) from t_dup where c_int > 0;
select count(*) from t_dup where c_int is null;
select count(*) from t_dup where c_str = 'zz';
select count(*) from t_dup where c_null is not null;
select count(*) from t_dup where c_null = 5;
select count(*) from t_dup where c_dec = 9.99;

-- Combinations across a materialised column and a defaulted one.
select count(*) from t_dup where k1 <= 10 and c_int = 0;
select count(*) from t_dup where k1 <= 10 and c_int = 7;
select count(*) from t_dup where k1 <= 10 or c_int = 7;

-- Profile evidence that the pruning actually happened, rather than the query
-- merely returning the right answer after a full scan.
set enable_profile = true;
set enable_async_profile = false;

-- ZoneMapIndexFilterRows is fed by SegmentIterator::_get_row_ranges_by_zone_map.
-- Before this optimisation it was necessarily 0 for a column that is absent from
-- the segment, because DefaultValueColumnIterator kept every row unconditionally.
[UC]select count(*) from t_dup where c_int = 7;
create table profile_prune properties("replication_num"="1") as
    select line from table(unnest(split(get_query_profile(last_query_id()), "\n"))) t(line);
select assert_true(count(1) > 0)
    from profile_prune
    where line like '%- ZoneMapIndexFilterRows%';
select assert_true(max(cast(coalesce(nullif(regexp_extract(line, '.*- ZoneMapIndexFilterRows: ([0-9.]+).*', 1), ''), '0') as double)) > 0)
    from profile_prune
    where line like '%- ZoneMapIndexFilterRows%';

-- The mirror image: a predicate the default does satisfy must prune nothing.
[UC]select count(*) from t_dup where c_int = 0;
create table profile_keep properties("replication_num"="1") as
    select line from table(unnest(split(get_query_profile(last_query_id()), "\n"))) t(line);
select assert_true(max(cast(coalesce(nullif(regexp_extract(line, '.*- ZoneMapIndexFilterRows: ([0-9.]+).*', 1), ''), '0') as double)) = 0)
    from profile_keep
    where line like '%- ZoneMapIndexFilterRows%';

set enable_profile = false;
drop database db_${uuid0};

-- name: test_default_value_zonemap_prune_key_types
-- PRIMARY KEY reaches the fold and is proven to below. UNIQUE and AGGREGATE
-- deliberately do NOT reach it, and this case documents that rather than
-- pretending otherwise.
--
-- OlapPredicateParser::can_pushdown (be/src/storage/predicate_parser.cpp:29) is
--     keys_type == PRIMARY_KEYS || column.aggregation() == STORAGE_AGGREGATE_NONE
-- A non-key column added to a UNIQUE table is given AggregateType.REPLACE
-- (SchemaChangeHandler.java:1442) and the AGGREGATE one below is declared SUM, so
-- neither predicate is ever pushed into the storage layer and
-- DefaultValueColumnIterator::get_row_ranges_by_zone_map is never consulted for
-- them -- those answers come from post-aggregation conjunct evaluation and would
-- be identical with this optimisation reverted. The UNIQUE/AGGREGATE blocks are
-- therefore correctness regression cover only; do not read them as evidence that
-- the fold works. The fold applies to DUPLICATE value columns, every PRIMARY KEY
-- column, and key columns generally.
create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t_uniq (
    k1 int,
    v1 int
) UNIQUE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1", "fast_schema_evolution" = "true");
insert into t_uniq select x, x from table(generate_series(1, 1000)) t(x);
ALTER TABLE t_uniq ADD COLUMN c_int INT DEFAULT "0";
function: wait_alter_table_finish()
select count(*) from t_uniq where c_int = 0;
select count(*) from t_uniq where c_int = 7;
select count(*) from t_uniq where c_int is null;

CREATE TABLE t_agg (
    k1 int,
    v1 int SUM
) AGGREGATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1", "fast_schema_evolution" = "true");
insert into t_agg select x, x from table(generate_series(1, 1000)) t(x);
ALTER TABLE t_agg ADD COLUMN c_int INT SUM DEFAULT "0";
function: wait_alter_table_finish()
select count(*) from t_agg where c_int = 0;
select count(*) from t_agg where c_int = 7;
select count(*) from t_agg where c_int is null;

CREATE TABLE t_pk (
    k1 int,
    v1 int
) PRIMARY KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1", "fast_schema_evolution" = "true");
insert into t_pk select x, x from table(generate_series(1, 1000)) t(x);
ALTER TABLE t_pk ADD COLUMN c_int INT DEFAULT "0";
function: wait_alter_table_finish()
select count(*) from t_pk where c_int = 0;
select count(*) from t_pk where c_int = 7;
select count(*) from t_pk where c_int is null;

-- PRIMARY KEY bypasses the aggregation gate in can_pushdown, so unlike the two
-- tables above this one really does exercise the fold. Prove it with the same
-- profile counter used for the duplicate-key case rather than inferring it.
set enable_profile = true;
set enable_async_profile = false;
[UC]select count(*) from t_pk where c_int = 7;
create table profile_pk properties("replication_num"="1") as
    select line from table(unnest(split(get_query_profile(last_query_id()), "\n"))) t(line);
select assert_true(max(cast(coalesce(nullif(regexp_extract(line, '.*- ZoneMapIndexFilterRows: ([0-9.]+).*', 1), ''), '0') as double)) > 0)
    from profile_pk
    where line like '%- ZoneMapIndexFilterRows%';
set enable_profile = false;

drop database db_${uuid0};

-- name: test_default_value_zonemap_prune_delete
-- The delete-predicate half: a DELETE condition on a column that only exists in
-- the schema cannot match the constant default, so the pre-existing segment
-- needs no per-row delete re-check. Correctness is what is asserted here -- the
-- saving is CPU, not rows.
create database db_${uuid0};
use db_${uuid0};

CREATE TABLE t_del (
    k1 int,
    v1 int
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 1
PROPERTIES ("replication_num" = "1", "fast_schema_evolution" = "true");
insert into t_del select x, x from table(generate_series(1, 1000)) t(x);

ALTER TABLE t_del ADD COLUMN c_int INT DEFAULT "0";
function: wait_alter_table_finish()

-- Cannot match the default: nothing is deleted.
delete from t_del where c_int = 7;
select count(*) from t_del;
select count(*) from t_del where c_int = 0;

-- Matches the default: every pre-existing row is deleted.
delete from t_del where c_int = 0;
select count(*) from t_del;

drop database db_${uuid0};
