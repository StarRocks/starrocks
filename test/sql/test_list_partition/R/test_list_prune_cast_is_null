-- name: test_list_prune_cast_is_null
create table t1 (k_id int not null, c_city varchar(20) null) duplicate key(k_id, c_city)
partition by list(c_city) (partition p_north values in ('bj', 'tj'), partition p_south values in ('gz', 'sz'), partition p_num values in ('10', '20'))
distributed by hash(k_id) buckets 1 properties ("replication_num" = "1");
-- result:
-- !result
insert into t1 values (1, 'bj'), (2, 'tj'), (3, 'gz'), (4, 'sz'), (5, '10'), (6, '20');
-- result:
-- !result
select count(*) from t1 where cast(c_city as int) is null;
-- result:
4
-- !result
select sum(case when cast(c_city as int) is null then 1 else 0 end) from t1;
-- result:
4
-- !result
select k_id from t1 where cast(c_city as int) is not null order by k_id;
-- result:
5
6
-- !result
select count(*) from t1 where c_city is null;
-- result:
0
-- !result
