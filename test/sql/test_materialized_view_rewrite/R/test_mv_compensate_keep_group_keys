-- !result
INSERT INTO f SELECT date_add('2024-01-01', x % 120), x % 5, x % 7 FROM TABLE(generate_series(1, 240)) AS g(x);
-- result:
-- !result
INSERT INTO f SELECT date_add('2024-01-01', x % 120), x % 5, x % 7 FROM TABLE(generate_series(1, 240)) AS g(x);
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_f
PARTITION BY dt
DISTRIBUTED BY RANDOM
REFRESH DEFERRED MANUAL
PROPERTIES ('replication_num' = '1')
AS SELECT dt, k, SUM(v) AS s, COUNT(*) AS c FROM f GROUP BY dt, k;
