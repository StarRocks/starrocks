-- name: test_mv_rewrite_scalar_agg_missing_group
-- An aggregate without GROUP BY returns one row, also when an aggregate MV answers it and WHERE pins the MV's
-- grouping key to a value the MV does not have: the rewrite must keep the aggregation over the MV (RB-1100).
create table t_sales (sale_id int not null, product_id int null, quantity int null, price decimal(12,2) null)
duplicate key(sale_id) distributed by hash(sale_id) buckets 1 properties ("replication_num" = "1");
insert into t_sales values (1, 10, 5, 99.90), (2, 20, 7, 12.50), (3, 10, 2, 5.00);
create materialized view mv_sales_agg distributed by hash(product_id) buckets 1 refresh manual properties ("replication_num" = "1")
as select product_id, count(quantity) as cnt_quantity, sum(quantity) as sum_quantity, max(price) as max_price from t_sales group by product_id;
refresh materialized view mv_sales_agg with sync mode;
function: print_hit_materialized_views("select count(quantity) from t_sales where product_id = 999999")
select count(quantity) from t_sales where product_id = 999999;
select count(quantity), sum(quantity), max(price) from t_sales where product_id = 999999;
select count(quantity) from t_sales where product_id in (999999);
select (select count(quantity) from t_sales where product_id = 999999) as c;
select count(quantity), sum(quantity), max(price) from t_sales where product_id = 10;
select count(quantity) from t_sales where product_id = 999999 group by product_id;
drop materialized view mv_sales_agg;
