None
-- !result
SELECT ST_AsText(ST_Intersection(ST_GeomFromText('POLYGON ((0 0,4 0,4 4,0 4,0 0))', 'EPSG:3857'), ST_GeomFromText('POLYGON ((8 0,9 0,9 1,8 1,8 0))', 'EPSG:3857')));
