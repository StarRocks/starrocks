-- name: test_json_subfield_name_collides_with_real_column
create table t (k int, j json, `j.a` varchar(20)) duplicate key(k)
  distributed by hash(k) buckets 1 properties("replication_num"="1");
-- result:
-- !result
insert into t values
  (1, parse_json('{"a":1,"b":10}'), 'x1'),
  (2, parse_json('{"a":2,"b":20}'), 'x2');
-- result:
-- !result
set cbo_json_v2_rewrite = true;
-- result:
-- !result
select k, get_json_int(j, '$.a') as sub from t order by k;
-- result:
1	1
2	2
-- !result
select k, `j.a` as real_col from t order by k;
-- result:
1	x1
2	x2
-- !result
select k, `j.a` as real_col, get_json_int(j, '$.a') as sub from t order by k;
-- result:
1	x1	1
2	x2	2
-- !result
select count(*) as cnt from t where get_json_int(j, '$.a') = 1;
-- result:
1
-- !result
select k, get_json_int(j, '$.b') as other from t order by k;
-- result:
1	10
2	20
-- !result
select count(*) as cnt_b from t where get_json_int(j, '$.b') = 20;
-- result:
1
-- !result
set cbo_json_v2_rewrite = false;
-- result:
-- !result
select k, get_json_int(j, '$.a') as sub from t order by k;
-- result:
1	1
2	2
-- !result
select k, `j.a` as real_col from t order by k;
-- result:
1	x1
2	x2
-- !result
select k, `j.a` as real_col, get_json_int(j, '$.a') as sub from t order by k;
-- result:
1	x1	1
2	x2	2
-- !result
select count(*) as cnt from t where get_json_int(j, '$.a') = 1;
-- result:
1
-- !result
select k, get_json_int(j, '$.b') as other from t order by k;
-- result:
1	10
2	20
-- !result
select count(*) as cnt_b from t where get_json_int(j, '$.b') = 20;
-- result:
1
-- !result
