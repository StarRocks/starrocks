-- name: test_flat_json_quoted_key_drops_value
create table t_q (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="true");
-- result:
-- !result
create table t_q_ctl (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="false");
-- result:
-- !result
insert into t_q values
  (1, parse_json('{"\\"q\\"":1,"p":1}')),
  (2, parse_json('{"\\"q\\"":2,"p":2}')),
  (3, parse_json('{"\\"q\\"":3,"p":3}')),
  (4, parse_json('{"\\"q\\"":4,"p":4}')),
  (5, parse_json('{"\\"q\\"":5,"p":5}'));
-- result:
-- !result
insert into t_q_ctl values
  (1, parse_json('{"\\"q\\"":1,"p":1}')),
  (2, parse_json('{"\\"q\\"":2,"p":2}')),
  (3, parse_json('{"\\"q\\"":3,"p":3}')),
  (4, parse_json('{"\\"q\\"":4,"p":4}')),
  (5, parse_json('{"\\"q\\"":5,"p":5}'));
-- result:
-- !result
select flat_json_meta(j) from t_q[_META_];
-- result:
["nulls(TINYINT), p(BIGINT), remain(JSON)"]
-- !result
select k, cast(j as string) from t_q order by k;
-- result:
1	{"\"q\"": 1, "p": 1}
2	{"\"q\"": 2, "p": 2}
3	{"\"q\"": 3, "p": 3}
4	{"\"q\"": 4, "p": 4}
5	{"\"q\"": 5, "p": 5}
-- !result
select k, json_length(j), cast(json_keys(j) as string) from t_q order by k;
-- result:
1	2	["\"q\"", "p"]
2	2	["\"q\"", "p"]
3	2	["\"q\"", "p"]
4	2	["\"q\"", "p"]
5	2	["\"q\"", "p"]
-- !result
select k, cast(j as string) from t_q_ctl order by k;
-- result:
1	{"\"q\"": 1, "p": 1}
2	{"\"q\"": 2, "p": 2}
3	{"\"q\"": 3, "p": 3}
4	{"\"q\"": 4, "p": 4}
5	{"\"q\"": 5, "p": 5}
-- !result
select k, json_length(j), cast(json_keys(j) as string) from t_q_ctl order by k;
-- result:
1	2	["\"q\"", "p"]
2	2	["\"q\"", "p"]
3	2	["\"q\"", "p"]
4	2	["\"q\"", "p"]
5	2	["\"q\"", "p"]
