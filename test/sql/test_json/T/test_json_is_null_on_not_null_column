-- name: test_json_is_null_on_not_null_column
-- A JSON column declared NOT NULL never holds SQL NULL, but it can perfectly well hold the JSON
-- `null` literal -- and StarRocks documents that `IS NULL` returns true for that literal (release
-- notes of 3.1, 3.2 and 3.3, section "Behavior Changes"). SimplifiedScanColumnRule nevertheless
-- folded `IS NULL` on any NOT NULL column reference into a constant, which is sound for INT or
-- VARCHAR but not for JSON. The whole scan then collapsed into an EMPTYSET, so `WHERE j IS NULL`
-- returned no rows while the projection of the very same expression returned true on every row.
-- Note on the data: parse_json('null') yields the JSON *string* "null", not a JSON null, because
-- is_json_start_char only accepts '{', '[' and '"'. The JSON null literal has to be reached
-- through a path, hence parse_json('{"a":null}')->'$.a' below.
create table t_${uuid0} (k int, j json not null, i int not null, s varchar(20) not null)
  duplicate key(k) distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="false");
-- The same rows with flat JSON on: this is a scan-predicate folding bug in the FE, so the storage
-- layout must make no difference at all.
create table t_flat_${uuid0} (k int, j json not null, i int not null, s varchar(20) not null)
  duplicate key(k) distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="true");
-- A nullable JSON column, to pin the behaviour that was already correct.
create table t_nullable_${uuid0} (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="false");
-- Three shapes of value in the NOT NULL table: the JSON null literal, ordinary values, and the
-- JSON string "null" (which is a value, not a null).
insert into t_${uuid0} values
  (1, parse_json('{"a":null}')->'$.a', 1, 'a'),
  (2, parse_json('{"a":null}')->'$.a', 2, 'b'),
  (3, parse_json('{"a":1}')->'$.a', 3, 'c'),
  (4, parse_json('{"a":"x"}')->'$.a', 4, 'd'),
  (5, parse_json('{"a":{"b":1}}')->'$.a', 5, 'e'),
  (6, parse_json('[1,2]'), 6, 'f'),
  (7, parse_json('"null"'), 7, 'g'),
  (8, parse_json('{"a":null}')->'$.a', 8, 'h');
insert into t_flat_${uuid0} select k, j, i, s from t_${uuid0};
-- The nullable table adds the fourth shape: a missing key, which yields SQL NULL.
insert into t_nullable_${uuid0} values
  (1, parse_json('{"a":null}')->'$.a'),
  (2, parse_json('{"a":1}')->'$.a'),
  (3, parse_json('{"b":1}')->'$.a'),
  (4, null);
-- Ground truth: the projection side, which never went through the scan-predicate rules and was
-- therefore always right. Every WHERE result below has to agree with these two columns.
select k, j, j is null as is_null, j is not null as is_not_null from t_${uuid0} order by k;
-- The bug: this returned zero rows, because the predicate folded to false and the scan became an
-- EMPTYSET. Rows 1, 2 and 8 hold the JSON null literal.
select k from t_${uuid0} where j is null order by k;
select k from t_${uuid0} where j is not null order by k;
select count(*) from t_${uuid0} where j is null;
select count(*) from t_${uuid0} where j is not null;
-- The two sides must agree row for row, so this pair of queries must return the same set.
select k from t_${uuid0} where (case when j is null then 1 else 0 end) = 1 order by k;
select sum(case when j is null then 1 else 0 end) from t_${uuid0};
-- Negation and OR must stay consistent too.
select k from t_${uuid0} where not (j is null) order by k;
select k from t_${uuid0} where j is null or k = 3 order by k;
select k from t_${uuid0} where j is not null and k <= 4 order by k;
-- Same thing with flat JSON on: identical answers.
select k, j is null as is_null, j is not null as is_not_null from t_flat_${uuid0} order by k;
select k from t_flat_${uuid0} where j is null order by k;
select k from t_flat_${uuid0} where j is not null order by k;
-- A nullable JSON column: the JSON null literal and a genuine SQL NULL both count as null, an
-- absent key yields SQL NULL. This is unchanged by the fix.
select k, j, j is null as is_null from t_nullable_${uuid0} order by k;
select k from t_nullable_${uuid0} where j is null order by k;
select k from t_nullable_${uuid0} where j is not null order by k;
-- The optimization that has to stay: on a NOT NULL column of an ordinary type, IS NULL still folds
-- to a constant and the scan is still eliminated entirely.
function: assert_explain_contains('select k from t_${uuid0} where i is null', 'EMPTYSET')
function: assert_explain_contains('select k from t_${uuid0} where s is null', 'EMPTYSET')
function: assert_explain_not_contains('select k from t_${uuid0} where i is not null', 'i IS NOT NULL')
function: assert_explain_not_contains('select k from t_${uuid0} where s is not null', 's IS NOT NULL')
select k from t_${uuid0} where i is null order by k;
select k from t_${uuid0} where s is null order by k;
select count(*) from t_${uuid0} where i is not null;
select count(*) from t_${uuid0} where s is not null;
-- ... while the JSON column's predicate now survives into the scan instead of being folded away.
function: assert_explain_not_contains('select k from t_${uuid0} where j is null', 'EMPTYSET')
function: assert_explain_contains('select k from t_${uuid0} where j is null', 'j IS NULL')
function: assert_explain_contains('select k from t_${uuid0} where j is not null', 'j IS NOT NULL')
drop table t_${uuid0};
drop table t_flat_${uuid0};
drop table t_nullable_${uuid0};
