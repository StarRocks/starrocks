-- name: test_json_set_array_path_keys
CREATE DATABASE test_json_set_array_keys_${uuid0};
USE test_json_set_array_keys_${uuid0};

-- A field followed by an index must not skip the field on an array value.
SELECT json_set(parse_json('[1,2,3]'), '$.arr[0]', 777);
SELECT json_set(parse_json('[1,2,3]'), '$.other[0]', 777);
SELECT json_set(parse_json('[1,2,3]'), '$.arr[9]', 777);
SELECT json_set(parse_json('[]'), '$.arr[0]', 777);
SELECT json_set(parse_json('{"outer":[1,2,3],"keep":9}'), '$.outer.arr[0]', 777);
SELECT json_set(parse_json('[[1,2],[3,4]]'), '$[0].arr[0]', 777);

-- Root and multidimensional selectors still update/append legitimate locations.
SELECT json_set(parse_json('[1,2,3]'), '$[0]', 777);
SELECT json_set(parse_json('[1,2,3]'), '$[9]', 777);
SELECT json_set(parse_json('[]'), '$[0]', 777);
SELECT json_set(parse_json('{"arr":[1,2,3]}'), '$.arr[0]', 777);
SELECT json_set(parse_json('[[1,2],[3,4]]'), '$[0][1]', 777);
SELECT json_set(parse_json('{"arr":[[1,2],[3,4]]}'), '$.arr[0][1]', 777);

-- An ignored path does not prevent subsequent updates or undo previous ones.
SELECT json_set(parse_json('[1,2,3]'), '$.arr[0]', 777, '$[1]', 888);
SELECT json_set(parse_json('[1,2,3]'), '$[1]', 888, '$.arr[0]', 777);
SELECT json_set(parse_json('{}'), '$.arr', parse_json('[1,2]'), '$.arr[0]', 777);
SELECT json_set(parse_json('[1,2,3]'), '$', parse_json('{"arr":[1,2]}'), '$.arr[0]', 777);
SELECT json_set(NULL, '$.arr[0]', 777), json_set(parse_json('[1,2,3]'), NULL, 777), json_set(parse_json('[1,2,3]'), '$.arr[0]', NULL);

CREATE TABLE cases (id INT, j JSON, p VARCHAR(100), v INT)
DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES("replication_num"="1", "flat_json.enable"="false");
