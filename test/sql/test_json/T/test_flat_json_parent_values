SET enable_query_cache=false;
CREATE TABLE t(id INT, j JSON) DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES("replication_num"="1", "flat_json.enable"="true",
           "base_compaction_forbidden_time_ranges"="* * * * *");
INSERT INTO t VALUES
  (1,parse_json('{"e":{},"a":[1,2],"d":{"p":[]},"a0":[]}')),
  (2,parse_json('{"e":{"v":10},"a":{"v":20},"d":{"p":{"v":30}},"a0":{"v":40}}'));
