-- name: test_json_array_agg_distinct_type
-- ArrayDistinctAfterAggRule rewrites array_distinct(array_agg(x)) into array_agg_distinct(x). The
-- overload lookup uses IS_NONSTRICT_SUPERTYPE_OF, which accepts a match reached through an implicit
-- cast, so it did not return null for JSON: JSON casts to BOOLEAN and BOOLEAN is the first entry of
-- NUMERIC_TYPES, so the lookup handed back array_agg_distinct(BOOLEAN) -> ARRAY<BOOLEAN>. The rule
-- then built that call while the column ref it replaced still carried ARRAY<JSON>, and the query died
-- in plan validation with "the type of arg N: array_agg_distinct is defined as ARRAY<JSON>, but the
-- actual type is ARRAY<BOOLEAN>". The rule now declines the rewrite when the overload would change the
-- result type, which leaves array_distinct(array_agg(x)) in place. That form answers correctly for
-- JSON: it buckets on the serialized bytes and falls back to JSON's own comparison on a hash
-- collision, and velocypack normalizes member order and numeric form when parse_json builds a value.
create table t (k int, g int, j json) duplicate key(k)
  distributed by hash(k) buckets 1 properties("replication_num"="1");
insert into t values
  (1, 1, parse_json('{"a":1}')),
  (2, 1, parse_json('{"a":1}')),
  (3, 1, parse_json('{"a":2}')),
  (4, 2, parse_json('[1,2]')),
  (5, 2, parse_json('[1,2]')),
  (6, 3, null),
  (7, 3, parse_json('{"a":1}')),
  (8, 4, parse_json('{"b":9}'));
-- The query that used to fail outright, and it has to deduplicate rather than merely run. array_agg
-- gives its elements no defined order, so the contents are asserted with array_length and
-- array_contains instead of by writing the array out.
select g, array_length(d) as cnt,
       array_contains(d, parse_json('{"a":1}')) as has_a1,
       array_contains(d, parse_json('{"a":2}')) as has_a2,
       array_contains(d, parse_json('[1,2]')) as has_arr,
       array_contains(d, null) as has_null
from (select g, array_distinct(array_agg(j)) d from t group by g) x order by g;
-- A one-element result has no order to depend on, so these two can be written out directly.
select g, array_distinct(array_agg(j)) from t where g in (2, 4) group by g order by g;
-- The predicate side goes through the same rewrite as the projection.
select g from t group by g having array_length(array_distinct(array_agg(j))) > 1 order by g;
-- This is the plan change the fix makes: for JSON the aggregation keeps array_agg with array_distinct
-- above it, because no array_agg_distinct overload can return ARRAY<JSON>.
function: assert_explain_not_contains('select g, array_distinct(array_agg(j)) from t group by g', 'array_agg_distinct')
-- The guard has to stay narrow: a type array_agg_distinct really is registered for still gets the
-- rewrite, and still answers the same.
function: assert_explain_contains('select g, array_distinct(array_agg(k)) from t group by g', 'array_agg_distinct')
select g, array_length(array_distinct(array_agg(k))) as cnt from t group by g order by g;
