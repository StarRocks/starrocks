-- name: test_flat_json_empty_object_subtree
-- A row whose value AT the requested path is an empty JSON object used to be reported as SQL NULL,
-- i.e. as if the key were not there at all. On flat_json.enable=true the nested leaves become
-- sub-columns (o.x, a.b.y) and everything else is kept in the `remain` sub-column. When the FE
-- pushes $.o down as a column access path the BE re-roots the flat path tree at `o`
-- (JsonMerger::set_root_path) and rebuilds the node from the sub-columns plus the remain. The
-- rebuild ended with `null_result.append(slice.isEmptyObject())`: an empty merge result was taken
-- to mean "this row has no such key". For a row that really stores {"o":{}} the merge is empty --
-- o.x is NULL for it and the remain only carries the skeleton {"o":{}} -- so the row was called
-- NULL: json_exists() said 0, `count(*) ... where json_exists()` under-counted, and the value
-- itself came back NULL. Reading the whole column (`select j`) was unaffected and showed {"o": {}},
-- so the same row contradicted itself depending on whether the subtree was pushed down.
-- Trigger window: `o` must be an object in every row of the segment (mix in one scalar or array and
-- the deriver stops at `o`, hands back a plain JSON sub-column and the merge is never reached), and
-- at least one leaf below `o` must be extracted (otherwise `o` goes to the remain whole and is
-- returned verbatim). Rows 1-8 are what buy o.x and a.b.y that status.
-- Row 9 is the defect: {} at one level and at two levels. Row 10 genuinely lacks both keys and must
-- stay NULL -- that is the guard against over-correcting. Row 11 is a NULL document. Row 12 has the
-- nodes with only non-extracted children, so it can only be answered by merging the remain.
create table t_${uuid0} (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="true");
create table t_ctl_${uuid0} (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="false");
insert into t_${uuid0} values
  (1, parse_json('{"o":{"x":1},"a":{"b":{"y":1}}}')),
  (2, parse_json('{"o":{"x":2},"a":{"b":{"y":2}}}')),
  (3, parse_json('{"o":{"x":3},"a":{"b":{"y":3}}}')),
  (4, parse_json('{"o":{"x":4},"a":{"b":{"y":4}}}')),
  (5, parse_json('{"o":{"x":5},"a":{"b":{"y":5}}}')),
  (6, parse_json('{"o":{"x":6},"a":{"b":{"y":6}}}')),
  (7, parse_json('{"o":{"x":7},"a":{"b":{"y":7}}}')),
  (8, parse_json('{"o":{"x":8},"a":{"b":{"y":8}}}')),
  (9, parse_json('{"o":{},"a":{"b":{}}}')),
  (10, parse_json('{"p":1}')),
  (11, NULL),
  (12, parse_json('{"o":{"z":9},"a":{"b":{"z":9}}}'));
-- The control table is loaded from the same literals rather than with INSERT ... SELECT, so that a
-- wrong answer on the flat table cannot be copied into the control.
insert into t_ctl_${uuid0} values
  (1, parse_json('{"o":{"x":1},"a":{"b":{"y":1}}}')),
  (2, parse_json('{"o":{"x":2},"a":{"b":{"y":2}}}')),
  (3, parse_json('{"o":{"x":3},"a":{"b":{"y":3}}}')),
  (4, parse_json('{"o":{"x":4},"a":{"b":{"y":4}}}')),
  (5, parse_json('{"o":{"x":5},"a":{"b":{"y":5}}}')),
  (6, parse_json('{"o":{"x":6},"a":{"b":{"y":6}}}')),
  (7, parse_json('{"o":{"x":7},"a":{"b":{"y":7}}}')),
  (8, parse_json('{"o":{"x":8},"a":{"b":{"y":8}}}')),
  (9, parse_json('{"o":{},"a":{"b":{}}}')),
  (10, parse_json('{"p":1}')),
  (11, NULL),
  (12, parse_json('{"o":{"z":9},"a":{"b":{"z":9}}}'));
-- The defect needs this exact schema: o.x and a.b.y extracted, everything else in remain. If a
-- future change to the path deriver stops extracting them, the queries below go down another path
-- and stop testing anything, so pin the shape here.
select flat_json_meta(j) from t_${uuid0}[_META_];
-- Reading the whole column never went through the subtree merge and was always right; it is the
-- reference the pushed-down reads below have to agree with.
select k, cast(j as string) as whole from t_${uuid0} order by k;
set cbo_prune_json_subfield = true;
-- Channel 1: no v2 rewrite, so every read of $.o goes through the merge.
set cbo_json_v2_rewrite = false;
select k, cast(j->'$.o' as string) as o_sub, cast(j->'$.a.b' as string) as ab_sub,
       cast(j->'$.a' as string) as a_sub
from t_${uuid0} order by k;
select k, (j->'$.o') is null as o_isnull, (j->'$.a.b') is null as ab_isnull
from t_${uuid0} order by k;
select k, json_exists(j,'$.o') as ex_o, json_exists(j,'$.a.b') as ex_ab, json_exists(j,'$.a') as ex_a
from t_${uuid0} order by k;
select k, get_json_string(j,'$.o') as gjs_o from t_${uuid0} order by k;
-- The user-visible harm: 10 rows have $.o, not 9.
select count(*) as cnt_o from t_${uuid0} where json_exists(j,'$.o');
-- $.a.b is two levels deep, so it also proves the empty object is recognised below the first level.
select count(*) as cnt_ab from t_${uuid0} where json_exists(j,'$.a.b');
-- Channel 2: with the v2 rewrite on, the casts read typed sub-columns, but json_exists forces the
-- access path back to JSON and still goes through the merge, so this channel must be checked too.
set cbo_json_v2_rewrite = true;
select k, cast(j->'$.o' as string) as o_sub, cast(j->'$.a.b' as string) as ab_sub,
       cast(j->'$.a' as string) as a_sub
from t_${uuid0} order by k;
select k, (j->'$.o') is null as o_isnull, (j->'$.a.b') is null as ab_isnull
from t_${uuid0} order by k;
select k, json_exists(j,'$.o') as ex_o, json_exists(j,'$.a.b') as ex_ab, json_exists(j,'$.a') as ex_a
from t_${uuid0} order by k;
select count(*) as cnt_o from t_${uuid0} where json_exists(j,'$.o');
select count(*) as cnt_ab from t_${uuid0} where json_exists(j,'$.a.b');
-- Channel 3: the same flat table with the sub-field push-down switched off. The merge is not
-- re-rooted then, so this channel was already correct and is the closest possible control -- same
-- table, same rows, same storage, only the push-down differs.
set cbo_prune_json_subfield = false;
set cbo_json_v2_rewrite = false;
select k, cast(j->'$.o' as string) as o_sub, cast(j->'$.a.b' as string) as ab_sub,
       cast(j->'$.a' as string) as a_sub
from t_${uuid0} order by k;
select k, json_exists(j,'$.o') as ex_o, json_exists(j,'$.a.b') as ex_ab, json_exists(j,'$.a') as ex_a
from t_${uuid0} order by k;
select count(*) as cnt_o from t_${uuid0} where json_exists(j,'$.o');
select count(*) as cnt_ab from t_${uuid0} where json_exists(j,'$.a.b');
-- Control: the same rows on a table that is not flattened. Flat JSON is a storage layout, so every
-- answer in all three channels above must equal the corresponding answer here.
set cbo_prune_json_subfield = true;
set cbo_json_v2_rewrite = false;
select k, cast(j->'$.o' as string) as o_sub, cast(j->'$.a.b' as string) as ab_sub,
       cast(j->'$.a' as string) as a_sub
from t_ctl_${uuid0} order by k;
select k, (j->'$.o') is null as o_isnull, (j->'$.a.b') is null as ab_isnull
from t_ctl_${uuid0} order by k;
select k, json_exists(j,'$.o') as ex_o, json_exists(j,'$.a.b') as ex_ab, json_exists(j,'$.a') as ex_a
from t_ctl_${uuid0} order by k;
select k, get_json_string(j,'$.o') as gjs_o from t_ctl_${uuid0} order by k;
select count(*) as cnt_o from t_ctl_${uuid0} where json_exists(j,'$.o');
select count(*) as cnt_ab from t_ctl_${uuid0} where json_exists(j,'$.a.b');
set cbo_json_v2_rewrite = true;
select k, cast(j->'$.o' as string) as o_sub, cast(j->'$.a.b' as string) as ab_sub,
       cast(j->'$.a' as string) as a_sub
from t_ctl_${uuid0} order by k;
select k, json_exists(j,'$.o') as ex_o, json_exists(j,'$.a.b') as ex_ab, json_exists(j,'$.a') as ex_a
from t_ctl_${uuid0} order by k;
select count(*) as cnt_o from t_ctl_${uuid0} where json_exists(j,'$.o');
select count(*) as cnt_ab from t_ctl_${uuid0} where json_exists(j,'$.a.b');
-- A JSON null leaf is a different story and is NOT what this fix is about, so pin it here: the
-- deriver types a leaf that is ever json-null as JSON rather than BIGINT, so the null is stored as
-- a JSON value and survives the merge. {"o":{"x":null}} therefore still reads back whole, and the
-- empty object in the same column still has to be an empty object.
create table t_jn_${uuid0} (k int, j json) duplicate key(k)
  distributed by hash(k) buckets 1
  properties("replication_num"="1","flat_json.enable"="true");
insert into t_jn_${uuid0} values
  (1, parse_json('{"o":{"x":1}}')),
  (2, parse_json('{"o":{"x":2}}')),
  (3, parse_json('{"o":{"x":3}}')),
  (4, parse_json('{"o":{"x":4}}')),
  (5, parse_json('{"o":{"x":5}}')),
  (6, parse_json('{"o":{"x":6}}')),
  (7, parse_json('{"o":{"x":7}}')),
  (8, parse_json('{"o":{"x":8}}')),
  (9, parse_json('{"o":{"x":null}}')),
  (10, parse_json('{"o":{}}')),
  (11, parse_json('{"p":1}'));
select flat_json_meta(j) from t_jn_${uuid0}[_META_];
set cbo_prune_json_subfield = true;
set cbo_json_v2_rewrite = false;
select k, cast(j->'$.o' as string) as o_sub, json_exists(j,'$.o') as ex_o,
       (j->'$.o') is null as o_isnull
from t_jn_${uuid0} order by k;
drop table t_${uuid0};
drop table t_ctl_${uuid0};
drop table t_jn_${uuid0};
