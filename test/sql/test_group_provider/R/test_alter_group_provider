-- name: test_alter_group_provider
CREATE GROUP PROVIDER gp_unix_${uuid0} PROPERTIES ("type" = "unix", "keep" = "original", "change" = "before");
-- result:
-- !result
ALTER GROUP PROVIDER gp_unix_${uuid0} SET ("change" = "after");
-- result:
-- !result
SHOW CREATE GROUP PROVIDER gp_unix_${uuid0};
