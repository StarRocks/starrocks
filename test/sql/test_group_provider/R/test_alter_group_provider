[REGEX](?s)(?=.*"keep" = "original")(?=.*"change" = "after")(?=.*"type" = "unix").*
-- !result
ALTER GROUP PROVIDER gp_unix_${uuid0} SET ("change" = "after2");
-- result:
-- !result
SHOW CREATE GROUP PROVIDER gp_unix_${uuid0};
