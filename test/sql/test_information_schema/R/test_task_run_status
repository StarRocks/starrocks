function: execute_sql("submit task task_src_insert_${uuid0} as insert into ss select * from ss", True)["result"] == (("task_src_insert_${uuid0}", "SUBMITTED"),)
-- result:
True
-- !result
LOOP {
  PROPERTY: {"timeout": 30, "interval": 2, "desc": "wait for INSERT task run to appear"}
  result=select count(*) from information_schema.task_runs where task_name='task_src_insert_${uuid0}';
  CHECK: int(${result}[-1][0]) > 0
} END LOOP
select distinct TASK_SOURCE from information_schema.task_runs where task_name='task_src_insert_${uuid0}';
-- result:
INSERT
-- !result
LOOP {
  PROPERTY: {"timeout": 30, "interval": 2, "desc": "wait for INSERT task run to finish"}
  result=select STATE from information_schema.task_runs where task_name='task_src_insert_${uuid0}';
  CHECK: len(to_array(${result})) > 0 and all(row[0] in ("SUCCESS", "FAILED", "CANCELLED") for row in to_array(${result}))
} END LOOP
select STATE, COALESCE(NULLIF(ERROR_MESSAGE, ''), 'NO_ERROR') from information_schema.task_runs where task_name='task_src_insert_${uuid0}';
-- result:
SUCCESS	NO_ERROR
-- !result
function: execute_sql("submit task task_src_ctas_${uuid0} as create table ss_ctas as select event_day, pv from ss", True)["result"] == (("task_src_ctas_${uuid0}", "SUBMITTED"),)
-- result:
True
-- !result
LOOP {
  PROPERTY: {"timeout": 30, "interval": 2, "desc": "wait for CTAS task run to appear"}
  result=select count(*) from information_schema.task_runs where task_name='task_src_ctas_${uuid0}';
  CHECK: int(${result}[-1][0]) > 0
} END LOOP
select distinct TASK_SOURCE from information_schema.task_runs where task_name='task_src_ctas_${uuid0}';
-- result:
CTAS
-- !result
LOOP {
  PROPERTY: {"timeout": 30, "interval": 2, "desc": "wait for CTAS task run to finish"}
  result=select STATE from information_schema.task_runs where task_name='task_src_ctas_${uuid0}';
  CHECK: len(to_array(${result})) > 0 and all(row[0] in ("SUCCESS", "FAILED", "CANCELLED") for row in to_array(${result}))
} END LOOP
select STATE, COALESCE(NULLIF(ERROR_MESSAGE, ''), 'NO_ERROR') from information_schema.task_runs where task_name='task_src_ctas_${uuid0}';
-- result:
SUCCESS	NO_ERROR
