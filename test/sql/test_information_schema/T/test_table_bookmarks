-- ==============================================================
-- Section 7: multi-db and multi-table coverage
-- Verifies that (a) bookmarks from multiple databases appear with
-- distinct DB_IDs, (b) bookmarks from multiple tables in one db
-- appear with distinct TABLE_IDs, (c) filters by db_id / table_id
-- isolate correctly, (d) JOIN works across (db, table) rows.
-- ==============================================================
-- name: test_table_bookmarks_multi_db_table @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

-- Explicitly create both databases. (Framework only auto-creates db[0]
-- when the case has no CREATE DATABASE; here we drive db naming ourselves
-- so ${db[0]} is the first explicit name = db_a_${uuid0}.)
CREATE DATABASE db_a_${uuid0};
CREATE DATABASE db_b_${uuid0};

USE db_a_${uuid0};
CREATE TABLE t1 (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
CREATE TABLE t2 (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t1 VALUES (1);
INSERT INTO t2 VALUES (2);

USE db_b_${uuid0};
CREATE TABLE t3 (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t3 VALUES (3);

-- Take one bookmark per (db, table). 3 bookmarks total across 2 dbs.
[UC]bm_t1=SELECT bookmark_create("db_a_${uuid0}", "t1", "mh1", "1800000");
[UC]bm_t2=SELECT bookmark_create("db_a_${uuid0}", "t2", "mh2", "1800000");
[UC]bm_t3=SELECT bookmark_create("db_b_${uuid0}", "t3", "mh3", "1800000");

----------------------------------------------------------------------
-- (a) Two databases visible: 2 distinct DB_IDs for our bookmarks.
----------------------------------------------------------------------
SELECT COUNT(DISTINCT db_id) AS distinct_dbs
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id IN (${bm_t1}, ${bm_t2}, ${bm_t3});

----------------------------------------------------------------------
-- (b) Two tables in db A: 2 distinct TABLE_IDs share one DB_ID.
----------------------------------------------------------------------
SELECT COUNT(DISTINCT table_id) AS distinct_tables_in_db_a
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id IN (${bm_t1}, ${bm_t2});

----------------------------------------------------------------------
-- (c) Filter isolation:
--     - WHERE bookmark_id = bm_t3 -> only the t3 row (1 db_id).
--     - WHERE bookmark_id = bm_t1 -> only the t1 row (1 table_id).
----------------------------------------------------------------------
SELECT COUNT(*) AS rows_for_t3
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${bm_t3};

SELECT COUNT(*) AS rows_for_t1
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${bm_t1};

----------------------------------------------------------------------
-- (d) JOIN summary + partitions + references across both databases.
--     Group by db_id to show per-db row counts.
----------------------------------------------------------------------
SELECT COUNT(DISTINCT s.db_id) AS dbs,
       COUNT(DISTINCT s.bookmark_id) AS bookmarks,
       COUNT(DISTINCT p.physical_partition_id) AS partitions,
       COUNT(DISTINCT r.holder_id) AS holders
  FROM information_schema.table_bookmark_summary s
  JOIN information_schema.table_bookmark_partitions p
    USING (db_id, table_id, bookmark_id)
  JOIN information_schema.table_bookmark_references r
    USING (db_id, table_id, bookmark_id)
  WHERE s.bookmark_id IN (${bm_t1}, ${bm_t2}, ${bm_t3});

----------------------------------------------------------------------
-- (e) Same table NAME ('t1') across different dbs gets distinct
--     TABLE_IDs. (Verifies we never collapse rows by id only.)
----------------------------------------------------------------------
-- Create same-named table in db B
USE db_b_${uuid0};
CREATE TABLE t1 (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t1 VALUES (99);
[UC]bm_b_t1=SELECT bookmark_create("db_b_${uuid0}", "t1", "mh4", "1800000");

-- Both 't1' rows visible, distinguished by DB_ID + TABLE_ID.
SELECT COUNT(DISTINCT db_id) AS distinct_dbs,
       COUNT(DISTINCT table_id) AS distinct_tables
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id IN (${bm_t1}, ${bm_b_t1});

CLEANUP {
  SELECT bookmark_release("db_a_${uuid0}", "t1", "${bm_t1}", "mh1");
  SELECT bookmark_release("db_a_${uuid0}", "t2", "${bm_t2}", "mh2");
  SELECT bookmark_release("db_b_${uuid0}", "t3", "${bm_t3}", "mh3");
  SELECT bookmark_release("db_b_${uuid0}", "t1", "${bm_b_t1}", "mh4");
  DROP DATABASE IF EXISTS db_a_${uuid0} FORCE;
  DROP DATABASE IF EXISTS db_b_${uuid0} FORCE;
} END CLEANUP

-- ==============================================================
-- Section 8: TTL on references and in the summary structs
-- One bookmark, two references: holder "ttl_h" with an explicit TTL,
-- holder "nottl_h" reusing the same bookmark with no TTL (-1).
-- ==============================================================
-- name: test_table_bookmarks_ttl @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

-- ttl_h acquired first (explicit TTL), nottl_h second (no TTL / -1, reuses bookmark).
-- SLEEP gives nottl_h a strictly later acquire time: oldest/newest break equal-millisecond
-- ties by smallest holder id, so without the gap a same-ms run would collapse both to
-- nottl_h and drop ttl_h from the summary.
[UC]ttlbm=SELECT bookmark_create("${db[0]}", "t", "ttl_h", "123456789");
SELECT SLEEP(1);
[UC]ttlbm_dup=SELECT bookmark_create("${db[0]}", "t", "nottl_h", "-1");

-- References: each holder reports its own TTL (ttl_h = 123456789, nottl_h = -1).
-- Unlimited lease -> EXPIRE_TIME NULL; bounded lease -> EXPIRE_TIME set. Never renewed -> RENEW_COUNT 0.
SELECT holder_id, ttl_ms, expire_time IS NOT NULL AS has_expire, renew_count
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${ttlbm}
  ORDER BY holder_id;

-- Summary: oldest reference is ttl_h (its explicit TTL), newest is nottl_h (-1).
SELECT
  oldest_reference.id AS oldest_holder,
  oldest_reference.ttl_ms AS oldest_ttl,
  newest_reference.id AS newest_holder,
  newest_reference.ttl_ms AS newest_ttl
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${ttlbm};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${ttlbm}", "ttl_h");
  SELECT bookmark_release("${db[0]}", "t", "${ttlbm_dup}", "nottl_h");
} END CLEANUP

-- ==============================================================
-- Section 9: cluster ceiling is folded into TTL_MS / EXPIRE_TIME; RENEW_COUNT increments
-- ==============================================================
-- name: test_table_bookmarks_lease_observability @cloud @sequential
-- Writes FE-global bookmark_reference_max_ttl_ms; skip the concurrent pass so it
-- cannot overlap cases that assume the default ceiling (-1).

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

[UC]ob=SELECT bookmark_create("${db[0]}", "t", "obs_h", "1800000");

-- Default cap -1: TTL_MS is the per-reference 1800000ms; expire is 1800s after CREATE_TIME.
SELECT ttl_ms, renew_count,
       unix_timestamp(expire_time) - unix_timestamp(create_time) AS expire_offset_s
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${ob};

SELECT bookmark_renew("${db[0]}", "t", "${ob}", "obs_h", "1800000");

SELECT renew_count FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${ob} AND holder_id = 'obs_h';

[UC]ADMIN SET FRONTEND CONFIG ("bookmark_reference_max_ttl_ms" = "60000");

-- 60s ceiling caps the 1800s lease. Keep it well above sweep latency so lowering the
-- ceiling cannot let the daemon drop the pin before these assertions.
SELECT ttl_ms,
       unix_timestamp(expire_time) - unix_timestamp(COALESCE(last_renew_time, create_time)) AS expire_offset_s
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${ob};

SELECT oldest_reference.ttl_ms FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${ob};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${ob}", "obs_h");
  ADMIN SET FRONTEND CONFIG ("bookmark_reference_max_ttl_ms" = "-1");
} END CLEANUP

-- ==============================================================
-- Section 10: stored TTL -1 is folded by the cluster ceiling into TTL_MS / EXPIRE_TIME
-- This is the "TTL_MS used to lie" case: unlimited per-reference lease, cap on.
-- ==============================================================
-- name: test_table_bookmarks_unlimited_capped @cloud @sequential
-- Writes FE-global bookmark_reference_max_ttl_ms; skip the concurrent pass so it
-- cannot overlap cases that assume the default ceiling (-1).

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

[UC]capbm=SELECT bookmark_create("${db[0]}", "t", "cap_h", "-1");

-- Cap off: stored -1 stays -1 and EXPIRE_TIME is NULL.
SELECT ttl_ms, expire_time IS NOT NULL AS has_expire, renew_count
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${capbm};

[UC]ADMIN SET FRONTEND CONFIG ("bookmark_reference_max_ttl_ms" = "3600000");

-- 1h ceiling becomes the effective lease; EXPIRE_TIME is 3600s after CREATE_TIME.
SELECT ttl_ms, expire_time IS NOT NULL AS has_expire,
       unix_timestamp(expire_time) - unix_timestamp(create_time) AS expire_offset_s
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${capbm};

SELECT oldest_reference.ttl_ms, newest_reference.ttl_ms
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${capbm};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${capbm}", "cap_h");
  ADMIN SET FRONTEND CONFIG ("bookmark_reference_max_ttl_ms" = "-1");
} END CLEANUP

-- ==============================================================
-- Section 11: renew moves EXPIRE_TIME to last_renew + TTL, not create + TTL
-- ==============================================================
-- name: test_table_bookmarks_renew_moves_expire @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

[UC]mv=SELECT bookmark_create("${db[0]}", "t", "mv_h", "1800000");
SELECT SLEEP(2);
SELECT bookmark_renew("${db[0]}", "t", "${mv}", "mv_h", "1800000");

-- Lease start is LAST_RENEW_TIME, so expire is 1800s after renew, strictly after create+1800s.
SELECT renew_count,
       unix_timestamp(expire_time) - unix_timestamp(last_renew_time) AS from_renew_s,
       (unix_timestamp(expire_time) - unix_timestamp(create_time)) > 1800 AS later_than_create
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${mv} AND holder_id = 'mv_h';

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${mv}", "mv_h");
} END CLEANUP

-- ==============================================================
-- Section 12: TTL sweep drops an expired reference and leaves a live sibling
-- Waits for the BookmarkManager cleanup daemon (default 60s).
-- ==============================================================
-- name: test_table_bookmarks_ttl_sweep @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

-- 1s lease on the first bookmark; 30min lease on a later bookmark of the same table.
[UC]short_bm=SELECT bookmark_create("${db[0]}", "t", "sweep_short", "1000");
INSERT INTO t VALUES (2);
[UC]long_bm=SELECT bookmark_create("${db[0]}", "t", "sweep_long", "1800000");

SELECT COUNT(*) FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${short_bm};
SELECT holder_id FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${long_bm};

LOOP {
  PROPERTY: {"timeout": 90, "interval": 2, "desc": "wait for TTL sweep to expire the 1s lease"}
  result=SELECT COUNT(*) FROM information_schema.table_bookmark_references WHERE bookmark_id = ${short_bm};
  CHECK: int(${result}[-1][0]) == 0
} END LOOP

-- The 30min sibling is still pinned; the expired bookmark is gone from summary too.
SELECT holder_id, renew_count FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${long_bm};
SELECT COUNT(*) FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${short_bm};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${long_bm}", "sweep_long");
} END CLEANUP
