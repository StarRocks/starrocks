-- ==============================================================
-- Section 1: basic single-bookmark coverage
-- ==============================================================
-- name: test_table_bookmarks_basic @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (
    k BIGINT NOT NULL,
    dt DATE NOT NULL,
    v BIGINT
) DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01'),
    PARTITION p2 VALUES LESS THAN ('2024-03-01'),
    PARTITION p3 VALUES LESS THAN ('2024-04-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO t VALUES (1, '2024-01-15', 10), (2, '2024-02-15', 20), (3, '2024-03-15', 30);

[UC]bookmark_id=SELECT bookmark_create("${db[0]}", "t", "h1", "1800000");

-- Summary: exactly 1 row; counts reflect 3 partitions x 1 physical sub-partition.
SELECT logical_partition_count, physical_partition_count, reference_count
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${bookmark_id};

-- Partitions: 3 logical x 1 physical = 3 rows.
SELECT COUNT(*) AS partition_rows
  FROM information_schema.table_bookmark_partitions
  WHERE bookmark_id = ${bookmark_id};

-- References: 1 row.
SELECT holder_id
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id = ${bookmark_id};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${bookmark_id}", "h1");
} END CLEANUP

-- ==============================================================
-- Section 2: multi-bookmark + multi-reference on one table
-- Verifies summary row-per-bookmark, partitions row-per-(bm, partition),
-- references row-per-(bm, holder), OLDEST/NEWEST_REFERENCE.
-- ==============================================================
-- name: test_table_bookmarks_multi @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (
    k BIGINT NOT NULL,
    dt DATE NOT NULL
) DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01'),
    PARTITION p2 VALUES LESS THAN ('2024-03-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

INSERT INTO t VALUES (1, '2024-01-15');

-- Bookmark b1 with two holders (same state -> same bookmark id, two references).
[UC]b1=SELECT bookmark_create("${db[0]}", "t", "alpha", "1800000");
[UC]b1_dup=SELECT bookmark_create("${db[0]}", "t", "beta", "1800000");

-- Mutate state, then take bookmark b2 with one holder.
INSERT INTO t VALUES (2, '2024-02-15');
[UC]b2=SELECT bookmark_create("${db[0]}", "t", "gamma", "1800000");

-- Summary: 2 distinct bookmarks (b1 and b2); b1.reference_count = 2, b2.reference_count = 1.
SELECT (bookmark_id = ${b1}) AS is_b1, reference_count
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id IN (${b1}, ${b2})
  ORDER BY bookmark_id;

-- Partitions: b1 has 2 partition rows (state at b1), b2 has 2 (state at b2).
SELECT (bookmark_id = ${b1}) AS is_b1, COUNT(*) AS partition_rows
  FROM information_schema.table_bookmark_partitions
  WHERE bookmark_id IN (${b1}, ${b2})
  GROUP BY bookmark_id
  ORDER BY bookmark_id;

-- References: b1 has 2 (alpha, beta), b2 has 1 (gamma). Total 3 rows.
SELECT (bookmark_id = ${b1}) AS is_b1, holder_id
  FROM information_schema.table_bookmark_references
  WHERE bookmark_id IN (${b1}, ${b2})
  ORDER BY bookmark_id, holder_id;

-- OLDEST/NEWEST_REFERENCE on b1: alpha acquired first, beta after.
-- Tie-break is lex-smallest holder id on equal time, so the smaller
-- holder_id may flip if bookmark_create returns the same millisecond.
SELECT
  oldest_reference.id AS oldest_holder,
  newest_reference.id AS newest_holder
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${b1};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${b1}", "alpha");
  SELECT bookmark_release("${db[0]}", "t", "${b1_dup}", "beta");
  SELECT bookmark_release("${db[0]}", "t", "${b2}", "gamma");
} END CLEANUP

-- ==============================================================
-- Section 3: LATEST_CHANGED_PHYSICAL_PARTITIONS ARRAY<STRUCT>
-- Verifies top-3 cap, descending-time order, < 3 partitions case.
-- ==============================================================
-- name: test_table_bookmarks_latest_updated @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t_big (
    k BIGINT NOT NULL,
    dt DATE NOT NULL
) DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01'),
    PARTITION p2 VALUES LESS THAN ('2024-03-01'),
    PARTITION p3 VALUES LESS THAN ('2024-04-01'),
    PARTITION p4 VALUES LESS THAN ('2024-05-01'),
    PARTITION p5 VALUES LESS THAN ('2024-06-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');

-- Stagger inserts so the 5 partitions have distinct visibleVersionTimes.
INSERT INTO t_big VALUES (1, '2024-01-15');
INSERT INTO t_big VALUES (2, '2024-02-15');
INSERT INTO t_big VALUES (3, '2024-03-15');
INSERT INTO t_big VALUES (4, '2024-04-15');
INSERT INTO t_big VALUES (5, '2024-05-15');

[UC]big_bm=SELECT bookmark_create("${db[0]}", "t_big", "h_big", "1800000");

-- Top-3 cap: array_length = 3 even though 5 partitions exist.
SELECT array_length(latest_changed_physical_partitions) AS top_n
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${big_bm};

-- Verify descending time order -- each element's time >= next element's time.
SELECT
  latest_changed_physical_partitions[1].time >= latest_changed_physical_partitions[2].time AS o1,
  latest_changed_physical_partitions[2].time >= latest_changed_physical_partitions[3].time AS o2
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${big_bm};

-- < 3 partitions case: a 2-partition table -> array_length = 2 (no NULL pad).
CREATE TABLE t_small (
    k BIGINT NOT NULL,
    dt DATE NOT NULL
) DUPLICATE KEY(k, dt)
PARTITION BY RANGE(dt) (
    PARTITION p1 VALUES LESS THAN ('2024-02-01'),
    PARTITION p2 VALUES LESS THAN ('2024-03-01')
)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ('replication_num' = '1');
INSERT INTO t_small VALUES (1, '2024-01-15');
[UC]small_bm=SELECT bookmark_create("${db[0]}", "t_small", "h_small", "1800000");

SELECT array_length(latest_changed_physical_partitions) AS top_n
  FROM information_schema.table_bookmark_summary
  WHERE bookmark_id = ${small_bm};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t_big", "${big_bm}", "h_big");
  SELECT bookmark_release("${db[0]}", "t_small", "${small_bm}", "h_small");
} END CLEANUP

-- ==============================================================
-- Section 4: JOIN across all three tables on (db_id, table_id, bookmark_id)
-- ==============================================================
-- name: test_table_bookmarks_join @cloud

[UC]ADMIN SET FRONTEND CONFIG ("enable_bookmark_meta_functions" = "true");

CREATE TABLE t (k BIGINT) DISTRIBUTED BY HASH(k) BUCKETS 1
  PROPERTIES ('replication_num' = '1');
INSERT INTO t VALUES (1);

[UC]jb=SELECT bookmark_create("${db[0]}", "t", "j1", "1800000");

-- Full 3-way join -- every row should agree on bookmark_id.
SELECT s.bookmark_id, p.physical_partition_id, r.holder_id
  FROM information_schema.table_bookmark_summary s
  JOIN information_schema.table_bookmark_partitions p
    USING (db_id, table_id, bookmark_id)
  JOIN information_schema.table_bookmark_references r
    USING (db_id, table_id, bookmark_id)
  WHERE s.bookmark_id = ${jb};

CLEANUP {
  SELECT bookmark_release("${db[0]}", "t", "${jb}", "j1");
} END CLEANUP

