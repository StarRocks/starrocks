-- name: test_load_job_privilege
create database db_${uuid0};
use db_${uuid0};
create table t_open (k int, v varchar(3) not null) duplicate key(k) distributed by hash(k) buckets 1 properties("replication_num" = "1");
create table t_secret (k int, v varchar(3) not null) duplicate key(k) distributed by hash(k) buckets 1 properties("replication_num" = "1");
set enable_insert_strict = false;
set insert_max_filter_ratio = 1;
insert into t_open values (1, 'ok'), (2, 'open-row');
insert into t_secret values (1, 'ok'), (2, 'secret-row');
shell: curl --location-trusted -u root: -T ${root_path}/lib/../common/data/stream_load/sr_load_job_privilege.csv -XPUT -H "Expect:100-continue" -H label:sl_secret_${uuid0} -H column_separator:, -H max_filter_ratio:1 ${url}/api/db_${uuid0}/t_secret/_stream_load
[UC]id_open=select id from information_schema.loads where db_name='db_${uuid0}' and table_name='t_open' and type='INSERT';
[UC]id_secret=select id from information_schema.loads where db_name='db_${uuid0}' and table_name='t_secret' and type='INSERT';
select tracking_log from information_schema.load_tracking_logs where job_id=${id_secret};

create user if not exists u_${uuid0};
grant impersonate on user root to u_${uuid0};
grant select on table db_${uuid0}.t_open to user u_${uuid0};

-- The user sees only the load job on the table it has a privilege on, and only that job's rejected rows.
execute as u_${uuid0} with no revert;
select table_name, type from information_schema.loads where db_name='db_${uuid0}' order by table_name, type;
select tracking_log from information_schema.load_tracking_logs where job_id=${id_open};
select tracking_log from information_schema.load_tracking_logs where job_id=${id_secret};
select count(*) from information_schema.stream_loads where db_name='db_${uuid0}';
execute as root with no revert;

-- Without SELECT, a privilege on the table shows the jobs, without the rows they rejected or what leads to them.
grant insert on table db_${uuid0}.t_secret to user u_${uuid0};
execute as u_${uuid0} with no revert;
select table_name, type, tracking_sql is null, properties is null from information_schema.loads where db_name='db_${uuid0}' order by table_name, type;
select tracking_log from information_schema.load_tracking_logs where job_id=${id_secret};
select tracking_url is null, tracking_sql is null from information_schema.stream_loads where db_name='db_${uuid0}';
execute as root with no revert;

-- OPERATE alone shows every job the same way.
create user if not exists u_op_${uuid0};
grant impersonate on user root to u_op_${uuid0};
grant operate on system to user u_op_${uuid0};
execute as u_op_${uuid0} with no revert;
select table_name, type, tracking_sql is null, properties is null from information_schema.loads where db_name='db_${uuid0}' order by table_name, type;
select tracking_log from information_schema.load_tracking_logs where job_id=${id_open};
execute as root with no revert;

-- SELECT shows the rows.
grant select on table db_${uuid0}.t_secret to user u_${uuid0};
execute as u_${uuid0} with no revert;
select table_name, type, tracking_sql is null, properties is null from information_schema.loads where db_name='db_${uuid0}' order by table_name, type;
select tracking_log from information_schema.load_tracking_logs where job_id=${id_secret};
select tracking_url is null, tracking_sql is null from information_schema.stream_loads where db_name='db_${uuid0}';
execute as root with no revert;

drop user u_${uuid0};
drop user u_op_${uuid0};
drop database db_${uuid0} force;
