-- result:
None
-- !result
function: assert_query_error_contains("SELECT row(array_filter(x -> false, [g])) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t", "use ST_AsText or ST_AsBinary on geo elements")
-- result:
None
-- !result
function: assert_query_error_contains("CREATE VIEW nested_view_${uuid0} AS SELECT cardinality([g]) AS n FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t", "Nested GEOGRAPHY/GEOMETRY types are not supported in saved SQL definitions")
