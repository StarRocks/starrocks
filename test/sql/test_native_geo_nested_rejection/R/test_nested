-- name: test_nested_geo_geography
CREATE TABLE nested_fixture_${uuid0} (id INT, wkt VARCHAR(64)) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 3 PROPERTIES("replication_num"="1");
-- result:
-- !result
INSERT INTO nested_fixture_${uuid0} VALUES (1, 'POINT (1 2)'), (2, NULL), (3, 'POINT EMPTY');
-- result:
-- !result
SELECT id, (array_map(x -> ST_AsText(x), array_filter(x -> x IS NOT NULL, [g])))[1], ST_AsText(map{1:g}[1]), ST_AsText(row([g]).col1[1]) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t ORDER BY id;
-- result:
1	POINT (1 2)	POINT (1 2)	POINT (1 2)
2	None	None	None
3	POINT EMPTY	POINT EMPTY	POINT EMPTY
-- !result
SELECT id, ST_AsText(x) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t, UNNEST([g]) u(x) ORDER BY id;
-- result:
1	POINT (1 2)
2	None
3	POINT EMPTY
-- !result
SELECT cardinality(array_agg(g)), ST_AsText((map_agg(id, g))[1]) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t;
-- result:
3	POINT (1 2)
-- !result
SELECT id, ST_AsText(m[id]) FROM (
    SELECT id, IF(id = 1, map{id:g}, map{CAST(id AS BIGINT):g}) AS m
    FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t
) q ORDER BY id;
-- result:
1	POINT (1 2)
2	None
3	POINT EMPTY
-- !result
WITH src AS (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0})
SELECT id, ST_AsText(m[id]) FROM (
    SELECT id, map{id:g} AS m FROM src
    UNION ALL
    SELECT id, map{CAST(id AS BIGINT):g} AS m FROM src
) q ORDER BY id;
-- result:
1	POINT (1 2)
1	POINT (1 2)
2	None
2	None
3	POINT EMPTY
3	POINT EMPTY
-- !result
function: assert_query_error_contains("SELECT cardinality(map_from_arrays([g], [id])) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t", "Map key doesn't support type")
