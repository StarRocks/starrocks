None
-- !result
function: assert_query_error_contains("SELECT [g] = [g] FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t", "does not support binary predicate operation")
-- result:
None
-- !result
function: assert_query_error_contains("SELECT cardinality(array_sort([g])) FROM (SELECT id, ST_GeogFromText(wkt) AS g FROM nested_fixture_${uuid0}) t", "No matching function with signature: array_sort")
-- result:
