-- name: test_flexible_partial_update_disabled @cloud @sequential
create database test_flex_pu_off_${uuid0};
use test_flex_pu_off_${uuid0};
CREATE TABLE t (pk BIGINT NOT NULL, c1 BIGINT, c2 BIGINT, c3 BIGINT DEFAULT "7")
PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1 PROPERTIES("replication_num" = "1");
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "column_separator:," -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_base.csv ${url}/api/test_flex_pu_off_${uuid0}/t/_stream_load
sync;
-- enable_flexible_partial_update is off on the BE and the FE: the token is refused instead of being ignored
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3,__op" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update.json ${url}/api/test_flex_pu_off_${uuid0}/t/_stream_load
-- on the BE only: the FE refuses to plan it
update information_schema.be_configs set value = "true" where name = "enable_flexible_partial_update";
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3,__op" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update.json ${url}/api/test_flex_pu_off_${uuid0}/t/_stream_load
update information_schema.be_configs set value = "false" where name = "enable_flexible_partial_update";
-- the other partial update modes are unaffected
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "column_separator:," -H "partial_update:true" -H "partial_update_mode:column" -H "columns:pk,c1" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.csv ${url}/api/test_flex_pu_off_${uuid0}/t/_stream_load
sync;
select * from t order by pk;
drop database test_flex_pu_off_${uuid0} force;

-- name: test_flexible_partial_update @cloud @sequential
create database test_flex_pu_${uuid0};
use test_flex_pu_${uuid0};
admin set frontend config ("enable_flexible_partial_update" = "true");
update information_schema.be_configs set value = "true" where name = "enable_flexible_partial_update";
CREATE TABLE t_row (pk BIGINT NOT NULL, c1 BIGINT, c2 BIGINT, c3 BIGINT DEFAULT "7")
PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1 PROPERTIES("replication_num" = "1");
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "column_separator:," -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_base.csv ${url}/api/test_flex_pu_${uuid0}/t_row/_stream_load
sync;
-- each row updates only the columns present in it: pk=1 sets c1; pk=2 sets c2 and an explicit NULL c3; pk=3 sets
-- c1 and c3; pk=4 is deleted; pk=6 and pk=7 are new keys whose omitted columns take the column defaults
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3,__op" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update.json ${url}/api/test_flex_pu_${uuid0}/t_row/_stream_load
sync;
select * from t_row order by pk;
-- a second load on top of the first one
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_second.json ${url}/api/test_flex_pu_${uuid0}/t_row/_stream_load
sync;
select * from t_row order by pk;
admin set frontend config ("enable_flexible_partial_update" = "false");
update information_schema.be_configs set value = "false" where name = "enable_flexible_partial_update";
drop database test_flex_pu_${uuid0} force;

-- name: test_flexible_partial_update_rejected @cloud @sequential
create database test_flex_pu_reject_${uuid0};
use test_flex_pu_reject_${uuid0};
admin set frontend config ("enable_flexible_partial_update" = "true");
update information_schema.be_configs set value = "true" where name = "enable_flexible_partial_update";
CREATE TABLE t (pk BIGINT NOT NULL, c1 BIGINT, c2 BIGINT, c3 BIGINT)
PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_ai (pk BIGINT NOT NULL, ai BIGINT NOT NULL AUTO_INCREMENT, c1 BIGINT, c2 BIGINT)
PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1 PROPERTIES("replication_num" = "1");
CREATE TABLE t_sk (pk BIGINT NOT NULL, c1 BIGINT, c2 BIGINT, c3 BIGINT)
PRIMARY KEY(pk) DISTRIBUTED BY HASH(pk) BUCKETS 1 ORDER BY (c1) PROPERTIES("replication_num" = "1");
-- no flexible-aware conditional update
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "merge_condition:c1" -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t/_stream_load
-- a column computed from others is in no row's column set
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2=c1+1" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t/_stream_load
-- a row can omit a column only in JSON
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "column_separator:," -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.csv ${url}/api/test_flex_pu_reject_${uuid0}/t/_stream_load
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t/_stream_load
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t_ai/_stream_load
-- a row that omits a sort key column would be placed by its NULL placeholder
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible_row" -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t_sk/_stream_load
-- the column-mode apply (partial_update_mode=flexible) is not supported yet
shell: curl --location-trusted -u root: -X PUT -H "Expect:100-continue" -H "format:json" -H "strip_outer_array:true" -H "partial_update:true" -H "partial_update_mode:flexible" -H "columns:pk,c1,c2,c3" -T ${root_path}/lib/../common/data/stream_load/flexible_partial_update_one.json ${url}/api/test_flex_pu_reject_${uuid0}/t/_stream_load
select count(*) from t;
select count(*) from t_ai;
select count(*) from t_sk;
admin set frontend config ("enable_flexible_partial_update" = "false");
update information_schema.be_configs set value = "false" where name = "enable_flexible_partial_update";
drop database test_flex_pu_reject_${uuid0} force;
