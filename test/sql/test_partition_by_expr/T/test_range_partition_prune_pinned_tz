-- name: test_range_partition_prune_pinned_tz
-- from_unixtime(ts, format, time_zone) pins how the epoch is rendered, so the partition a row lands
-- on no longer follows whoever is loading or querying. epoch 1636250400 is 2021-11-07 in UTC and
-- 2021-11-06 in America/New_York, which is what tells the two forms apart.
set time_zone = 'America/New_York';
CREATE TABLE t_pinned_utc (
        dt bigint NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(from_unixtime(dt, '%Y-%m-%d', 'UTC'))
(START ("2021-11-05") END ("2021-11-10") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
CREATE TABLE t_session_tz (
        dt bigint NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(from_unixtime(dt))
(START ("2021-11-05") END ("2021-11-10") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
insert into t_pinned_utc values (1636250400,1);
insert into t_session_tz values (1636250400,1);
-- the pinned table places the row by UTC, the session one by America/New_York. The partition value
-- is computed from the overload the expression actually names, so the arguments are not dropped.
select count(*) from t_pinned_utc partition(p20211107);
select count(*) from t_pinned_utc partition(p20211106);
select count(*) from t_session_tz partition(p20211107);
select count(*) from t_session_tz partition(p20211106);

-- A constant inside New_York's rollback window costs the session-zone table its pruning; the pinned
-- one never renders in that zone and is unaffected.
insert into t_pinned_utc values (1636113600,2),(1636200000,3),(1636264799,4),(1636372800,5),(1636459200,6);
insert into t_session_tz values (1636113600,2),(1636200000,3),(1636264799,4),(1636372800,5),(1636459200,6);
select dt, id from t_pinned_utc where dt < 1636264800 order by id;
function: assert_explain_contains('select dt from t_pinned_utc where dt < 1636264800', 'partitions=3/5')
function: assert_explain_contains('select dt from t_session_tz where dt < 1636264800', 'partitions=5/5')
select dt, id from t_session_tz where dt < 1636264800 order by id;
-- the three branches of a predicate add up to the table on both
select count(*) from (
        (select * from t_pinned_utc where dt < 1636264800)
        union all (select * from t_pinned_utc where not (dt < 1636264800))
        union all (select * from t_pinned_utc where (dt < 1636264800) is null)) t;
select count(*) from (
        (select * from t_session_tz where dt < 1636264800)
        union all (select * from t_session_tz where not (dt < 1636264800))
        union all (select * from t_session_tz where (dt < 1636264800) is null)) t;

-- from_unixtime_ms() has only the one-argument overload, so extra arguments must be refused rather
-- than silently resolved to something the BE cannot run.
CREATE TABLE t_ms_extra_args (
        dt bigint NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(from_unixtime_ms(dt, '%Y-%m-%d'))
(START ("2021-11-05") END ("2021-11-07") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
