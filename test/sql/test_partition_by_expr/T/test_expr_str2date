CREATE TABLE partition_str2date (
        create_time varchar(100),
        sku_id varchar(100),
        total_amount decimal,
        id int
)
PARTITION BY RANGE(str2date(create_time, '%Y-%m-%d'))(
START ("2021-01-01") END ("2021-01-10") EVERY (INTERVAL 1 DAY)
)
PROPERTIES (
"replication_num" = "1"
);
