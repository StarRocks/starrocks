-- name: test_expr_partition_predicate_kept
-- Pruning and predicate elimination want opposite implications out of the same filter. Pruning needs
-- every matching row to fall inside the bounds; dropping the predicate claims the reverse, that every
-- row in the kept partitions matches it. A filter mapped through a partition expression establishes
-- only the first, because the expression collapses many source values onto one partition value.
set time_zone = 'Asia/Shanghai';
CREATE TABLE t_pred_ms (
        dt bigint NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(from_unixtime_ms(dt))
(START ("2021-01-01") END ("2021-01-10") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
insert into t_pred_ms values (1609430400000,1),(1609689600000,4),(1609689600500,5),(1609776000000,6);
-- 1609689600000 lands on the partition 1609689600500 maps to but does not satisfy ">=", so the
-- predicate has to survive the pruning that keeps that partition.
select dt, id from t_pred_ms where dt >= 1609689600500 order by id;
function: assert_explain_contains('select dt from t_pred_ms where dt >= 1609689600500', 'PREDICATES: 1: dt >= 1609689600500')
-- "not (dt < c)" normalizes to the same shape and must behave the same way
select dt, id from t_pred_ms where not (dt < 1609689600500) order by id;
-- the three branches of a predicate must add up to the whole table: dropping the predicate on one
-- branch double-counts the rows it should have rejected
select count(*) from (
        (select * from t_pred_ms where dt >= 1609689600500)
        union all (select * from t_pred_ms where not (dt >= 1609689600500))
        union all (select * from t_pred_ms where (dt >= 1609689600500) is null)) t;
select count(*) from (
        (select * from t_pred_ms where dt < 1609689600500)
        union all (select * from t_pred_ms where not (dt < 1609689600500))
        union all (select * from t_pred_ms where (dt < 1609689600500) is null)) t;

-- date_trunc() is not on ExprRewriter's whitelist: its filter is the original predicate on the source
-- column, the elimination stays sound, and the optimization must not be lost.
CREATE TABLE t_pred_trunc (
        dt datetime NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY date_trunc('day', dt)
(START ("2025-04-28") END ("2025-05-02") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
insert into t_pred_trunc values ('2025-04-28 06:00:00',1),('2025-04-29 06:00:00',2),('2025-04-30 06:00:00',3);
select dt, id from t_pred_trunc where dt >= '2025-04-29 00:00:00' order by id;
select count(*) from (
        (select * from t_pred_trunc where dt >= '2025-04-29 00:00:00')
        union all (select * from t_pred_trunc where not (dt >= '2025-04-29 00:00:00'))
        union all (select * from t_pred_trunc where (dt >= '2025-04-29 00:00:00') is null)) t;
