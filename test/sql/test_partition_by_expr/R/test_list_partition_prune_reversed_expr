CREATE TABLE t_retention (
        dt datetime NOT NULL,
        id int NULL
)
DUPLICATE KEY(dt, id)
PARTITION BY RANGE(dt)
(START ("2024-02-01") END ("2024-02-08") EVERY (INTERVAL 1 DAY))
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
-- result:
-- !result
insert into t_retention values ('2024-02-01 00:00:00',1),('2024-02-03 00:00:00',2),('2024-02-05 00:00:00',3),('2024-02-06 00:00:00',4);
-- result:
-- !result
select count(*) from t_retention;
-- result:
4
-- !result
alter table t_retention DROP PARTITIONS WHERE datediff('2024-02-07', dt) >= 5;
-- result:
-- !result
select dt, id from t_retention order by id;
-- result:
2024-02-03 00:00:00	2
2024-02-05 00:00:00	3
2024-02-06 00:00:00	4
-- !result
