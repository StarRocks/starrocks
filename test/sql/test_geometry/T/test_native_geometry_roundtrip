-- name: test_native_geometry_roundtrip
create database db_${uuid0};
use db_${uuid0};

create table geometry_roundtrip (
    id int not null,
    shape geometry
) primary key(id)
distributed by hash(id)
buckets 1
properties('replication_num' = '1');

insert into geometry_roundtrip values
    (1, ST_GeomFromText('POINT (1 2)')),
    (2, ST_GeomFromText('LINESTRING (0 0, 1 1)')),
    (3, ST_GeomFromWKB(to_binary('010100000000000000000008400000000000001040', 'hex')));

select id,
       ST_AsText(shape),
       ST_AsText(ST_GeomFromWKB(ST_AsBinary(shape))),
       hex(ST_AsBinary(shape))
from geometry_roundtrip
order by id;

insert into geometry_roundtrip values (1, ST_GeomFromText('POINT (9 10)'));

select id, ST_AsText(shape)
from geometry_roundtrip
order by id;

drop database db_${uuid0};
