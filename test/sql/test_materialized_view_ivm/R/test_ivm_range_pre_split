-- name: test_ivm_range_pre_split @cloud
create external catalog ivm_ice_${uuid0}
properties
(
    "type" = "iceberg",
    "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}"
);
-- result:
-- !result
set catalog ivm_ice_${uuid0};
