set enable_range_distribution = true;
-- result:
-- !result
CREATE MATERIALIZED VIEW mv_range_pre_split
REFRESH DEFERRED MANUAL
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT region, amount FROM ivm_ice_${uuid0}.ivm_ice_db_${uuid0}.base;
-- result:
-- !result
set enable_range_distribution = false;
-- result:
-- !result
SELECT instr(PRIMARY_KEY, '__ROW_ID__') > 0 AS pk_is_row_id
FROM information_schema.tables_config
WHERE TABLE_SCHEMA = 'db_${uuid0}' AND TABLE_NAME = 'mv_range_pre_split';
-- result:
1
-- !result
SELECT BUCKETS FROM information_schema.partitions_meta
WHERE DB_NAME = 'db_${uuid0}' AND TABLE_NAME = 'mv_range_pre_split';
-- result:
1
-- !result
[UC]REFRESH MATERIALIZED VIEW mv_range_pre_split WITH SYNC MODE;
SELECT count(*), count(distinct amount), sum(amount) FROM mv_range_pre_split;
