-- The property refuses MANUAL, so an interval schedule is the only way to drive these by hand;
-- DEFERRED then keeps that schedule from racing the manual refreshes.

-- name: test_ivm_auto_refresh_limit_create_rejected
create external catalog arpl_ice_${uuid0}
properties
(
    "type" = "iceberg",
    "iceberg.catalog.type" = "hive",
    "hive.metastore.uris" = "${iceberg_catalog_hive_metastore_uris}"
);
set catalog arpl_ice_${uuid0};
create database arpl_ice_db_${uuid0};
use arpl_ice_db_${uuid0};
create table base (k int, v bigint, dt date) partition by(dt);
insert into base values (1, 10, '2026-09-01'), (1, 10, '2026-09-02'), (1, 10, '2026-09-03'), (1, 10, '2026-09-04'), (1, 10, '2026-09-05');
set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
CREATE MATERIALIZED VIEW mv_arpl_create PARTITION BY dt
REFRESH DEFERRED ASYNC EVERY(INTERVAL 1 DAY)
PROPERTIES ("refresh_mode" = "INCREMENTAL", "auto_refresh_partitions_limit" = "2")
AS SELECT k, v, dt FROM arpl_ice_${uuid0}.arpl_ice_db_${uuid0}.base;
-- the identical DDL without the limit must succeed, otherwise the refusal above proves nothing
CREATE MATERIALIZED VIEW mv_arpl_create PARTITION BY dt
REFRESH DEFERRED ASYNC EVERY(INTERVAL 1 DAY)
PROPERTIES ("refresh_mode" = "INCREMENTAL")
AS SELECT k, v, dt FROM arpl_ice_${uuid0}.arpl_ice_db_${uuid0}.base;
REFRESH MATERIALIZED VIEW mv_arpl_create WITH SYNC MODE;
SELECT REFRESH_MODE, LAST_REFRESH_STATE FROM information_schema.materialized_views
WHERE TABLE_SCHEMA = database() AND TABLE_NAME = 'mv_arpl_create';
SELECT count(*), sum(v) FROM mv_arpl_create;
drop materialized view mv_arpl_create;
drop table arpl_ice_${uuid0}.arpl_ice_db_${uuid0}.base force;
drop database arpl_ice_${uuid0}.arpl_ice_db_${uuid0} force;
drop database db_${uuid0} force;
drop catalog arpl_ice_${uuid0};

