-- name: test_paimon_partition_pruning
create external catalog paimon_coverage_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'native';
[ORDER]select id, region, amount from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 order by id;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "east" order by id;
select sum(amount) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "west";
select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ("east", "west") and amount >= 20 order by id;
select count(*) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "missing";
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = 'east'", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ('east', 'west')", "partitions=2/3")
set paimon_reader_mode = 'jni';
[ORDER]select id, region, amount from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 order by id;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "east" order by id;
select sum(amount) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "west";
select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ("east", "west") and amount >= 20 order by id;
select count(*) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "missing";
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = 'east'", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ('east', 'west')", "partitions=2/3")
set paimon_reader_mode = 'auto';
[ORDER]select id, region, amount from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 order by id;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "east" order by id;
select sum(amount) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "west";
select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null;
[ORDER]select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ("east", "west") and amount >= 20 order by id;
select count(*) from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = "missing";
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region = 'east'", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region is null", "partitions=1/3")
function: assert_explain_contains("select id from paimon_coverage_${uuid0}.paimon_test.partitioned_v1 where region in ('east', 'west')", "partitions=2/3")
set catalog default_catalog;
drop catalog paimon_coverage_${uuid0};
