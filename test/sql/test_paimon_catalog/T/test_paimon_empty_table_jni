-- name: test_paimon_empty_table_jni
create external catalog paimon_coverage_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'jni';
select count(*), count(id), sum(id), min(id), max(id) from paimon_coverage_${uuid0}.paimon_test.empty_v1;
select id, value from paimon_coverage_${uuid0}.paimon_test.empty_v1;
select id from paimon_coverage_${uuid0}.paimon_test.empty_v1 where id = 1 limit 1;
select value, count(*) from paimon_coverage_${uuid0}.paimon_test.empty_v1 group by value;
set catalog default_catalog;
drop catalog paimon_coverage_${uuid0};
