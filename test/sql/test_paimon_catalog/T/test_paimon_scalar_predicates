-- name: test_paimon_scalar_predicates
create external catalog paimon_predicates_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'native';
-- Projection order differs from the stored schema.
[ORDER]select c_string, id, c_int from paimon_predicates_${uuid0}.paimon_test.scalar_types where id in (1, 4) order by id;
-- NULL predicates and SQL three-valued logic.
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_int is null;
[ORDER]select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_int is not null order by id;
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_int <=> NULL;
select count(*) from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_int not in (3, NULL);
-- Compound and multi-column predicates.
[ORDER]select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_bool = true and (c_int < 10 or c_int > 2147483646) order by id;
[ORDER]select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_int > c_smallint order by id;
-- Decimal literals use the column precision and scale.
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_dec_9_2 = cast(0.10 as decimal(9, 2));
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_dec_20_4 = cast(-9999999999999999.9999 as decimal(20, 4));
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_dec_38_10 = cast(42.0000000001 as decimal(38, 10));
-- Date, timestamp and Unicode predicates.
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_date < cast("2024-01-01" as date);
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_ts_ntz >= cast("2038-01-01 00:00:00" as datetime);
select id from paimon_predicates_${uuid0}.paimon_test.scalar_types where c_string = "string 值 🚀";
-- Aggregates exclude NULLs and retain integer boundaries.
select count(*), count(c_int), count(distinct c_int), sum(cast(c_int as bigint)), min(c_int), max(c_int) from paimon_predicates_${uuid0}.paimon_test.scalar_types;
-- Ordered LIMIT and an empty result.
