-- name: test_paimon_writer_snapshot
create external catalog paimon_writer_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'native';
[ORDER]select id, amount from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 order by id;
select count(*) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 where amount = 10;
select count(*), sum(amount) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1;
set paimon_reader_mode = 'jni';
[ORDER]select id, amount from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 order by id;
select count(*) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 where amount = 10;
select count(*), sum(amount) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1;
set paimon_reader_mode = 'auto';
[ORDER]select id, amount from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 order by id;
select count(*) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1 where amount = 10;
select count(*), sum(amount) from paimon_writer_${uuid0}.paimon_test.writer_refresh_v1;
set catalog default_catalog;
drop catalog paimon_writer_${uuid0};
