-- name: test_paimon_insert_into_relational_sources
function: create_paimon_ddl_catalog("paimon_write_${uuid0}", "${uuid0}")
set paimon_reader_mode = 'native';
set pipeline_dop = 4;
create database paimon_write_${uuid0}.writer_db;
create database paimon_insert_source_${uuid0};
create table paimon_insert_source_${uuid0}.src (id int,value int) duplicate key(id) distributed by hash(id) buckets 2 properties ('replication_num'='1');
insert into paimon_insert_source_${uuid0}.src values (1,10),(2,20),(3,30),(4,40);
create table paimon_write_${uuid0}.writer_db.target_rows (id int not null,value int) primary key(id) properties ('bucket'='3','file.format'='parquet');
insert into paimon_write_${uuid0}.writer_db.target_rows select a.id,a.value+b.value from paimon_insert_source_${uuid0}.src a join paimon_insert_source_${uuid0}.src b on a.id=b.id;
insert into paimon_write_${uuid0}.writer_db.target_rows select id+10,value from paimon_insert_source_${uuid0}.src where id<=2 union all select id+20,value from paimon_insert_source_${uuid0}.src where id>2;
insert into paimon_write_${uuid0}.writer_db.target_rows select 100,count(*) from paimon_insert_source_${uuid0}.src;
insert into paimon_write_${uuid0}.writer_db.target_rows by name select 7 as value,200 as id;
insert into paimon_write_${uuid0}.writer_db.target_rows (value,id) select 8,201;
insert into paimon_write_${uuid0}.writer_db.target_rows (id) values (202);
insert into paimon_write_${uuid0}.writer_db.target_rows select 999,999 where false;
insert into paimon_write_${uuid0}.writer_db.target_rows select id+1000,cast(value as int) from paimon_insert_source_${uuid0}.src order by id limit 2;
[ORDER]select id,value from paimon_write_${uuid0}.writer_db.target_rows order by id;
CLEANUP {
  set catalog default_catalog;
  drop table if exists paimon_write_${paimon_ddl_warehouse_id}.writer_db.target_rows;
  drop database if exists paimon_write_${paimon_ddl_warehouse_id}.writer_db;
  drop catalog if exists paimon_write_${paimon_ddl_warehouse_id};
  drop database if exists paimon_insert_source_${paimon_ddl_warehouse_id} force;
} END CLEANUP

