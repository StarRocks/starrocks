-- name: test_paimon_insert_into_utf8
function: create_paimon_ddl_catalog("paimon_write_${uuid0}", "${uuid0}")
set paimon_reader_mode = 'native';
set pipeline_dop = 4;
create database paimon_write_${uuid0}.writer_db;
create table paimon_write_${uuid0}.writer_db.utf8_rows (id int not null, value varchar(2)) primary key(id) properties ('bucket'='1', 'file.format'='parquet');
insert into paimon_write_${uuid0}.writer_db.utf8_rows values (1, '中文'), (2, '中a'), (3, '😀文'), (4, NULL);
function: assert_query_error_contains("insert into paimon_write_${uuid0}.writer_db.utf8_rows values (5, '中文a')", "character length exceeded")
function: assert_query_error_contains("insert into paimon_write_${uuid0}.writer_db.utf8_rows values (6, 'abc')", "character length exceeded")
-- An upsert forces native merging rather than the direct Parquet fast path.
insert into paimon_write_${uuid0}.writer_db.utf8_rows values (1, '更新');
function: assert_paimon_readers("select id, value from paimon_write_${uuid0}.writer_db.utf8_rows", "utf8_rows", "native")
[ORDER]select id, value, char_length(value), length(value) from paimon_write_${uuid0}.writer_db.utf8_rows order by id;
function: create_paimon_ddl_catalog("paimon_write_reader_${uuid0}", "${uuid0}")
set paimon_reader_mode = 'jni';
[ORDER]select id, value, char_length(value), length(value) from paimon_write_reader_${uuid0}.writer_db.utf8_rows order by id;
-- Exercise a multibyte primary key and nested string leaves after an upsert.
set paimon_reader_mode = 'native';
create table paimon_write_${uuid0}.writer_db.utf8_nested (id varchar(2) not null, a array<varchar(2)>, m map<varchar(2), varchar(2)>, r struct<field_value varchar(2), nested array<varchar(2)>>) primary key(id) properties ('bucket'='1', 'file.format'='parquet');
insert into paimon_write_${uuid0}.writer_db.utf8_nested select '中文', ['旧值', NULL], map{'中文':'旧值'}, named_struct('field_value', '旧值', 'nested', ['旧值']);
insert into paimon_write_${uuid0}.writer_db.utf8_nested select '中a', ['😀文', '中a'], map{'中文':'你好'}, named_struct('field_value', '😀文', 'nested', ['中文']);
insert into paimon_write_${uuid0}.writer_db.utf8_nested values ('空值', NULL, NULL, NULL);
insert into paimon_write_${uuid0}.writer_db.utf8_nested select '中文', ['更新', NULL], map{'中文':'😀文'}, named_struct('field_value', '你好', 'nested', ['😀文']);
function: assert_paimon_readers("select id, a, m, r from paimon_write_${uuid0}.writer_db.utf8_nested", "utf8_nested", "native")
[ORDER]select id, a[1], a[2], m['中文'], r.field_value, r.nested[1] from paimon_write_${uuid0}.writer_db.utf8_nested order by id;
set paimon_reader_mode = 'jni';
[ORDER]select id, a[1], a[2], m['中文'], r.field_value, r.nested[1] from paimon_write_reader_${uuid0}.writer_db.utf8_nested order by id;
CLEANUP {
  set catalog default_catalog;
  drop table if exists paimon_write_${paimon_ddl_warehouse_id}.writer_db.utf8_nested;
  drop table if exists paimon_write_${paimon_ddl_warehouse_id}.writer_db.utf8_rows;
  drop database if exists paimon_write_${paimon_ddl_warehouse_id}.writer_db;
  drop catalog if exists paimon_write_reader_${paimon_ddl_warehouse_id};
  drop catalog if exists paimon_write_${paimon_ddl_warehouse_id};
} END CLEANUP
