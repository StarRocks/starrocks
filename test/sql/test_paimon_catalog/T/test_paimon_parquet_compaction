[ORDER]select id from paimon_static_${uuid0}.paimon_test.pk_parquet_compacted_v1 where amount >= 40 order by id;
function: assert_paimon_reader("select id, amount, flag from paimon_static_${uuid0}.paimon_test.pk_parquet_compacted_v1 order by id", "pk_parquet_compacted_v1", "starrocks")
