-- name: test_paimon_deletion_vectors_parquet
create external catalog paimon_dv_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'auto';
[ORDER]select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id;
select count(*), count(amount), sum(amount), sum(score) from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1;
select count(*) from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id = 2 or amount in (10, 20);
select id from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where amount is null;
function: assert_paimon_reader("select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id", "pk_dv_parquet_v1", "starrocks")
set paimon_reader_mode = 'native';
[ORDER]select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id;
select count(*), count(amount), sum(amount), sum(score) from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1;
select count(*) from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id = 2 or amount in (10, 20);
select id from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where amount is null;
function: assert_paimon_reader("select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id", "pk_dv_parquet_v1", "starrocks")
set paimon_reader_mode = 'jni';
[ORDER]select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id;
function: assert_paimon_reader("select id, amount, score from paimon_dv_${uuid0}.paimon_test.pk_dv_parquet_v1 where id in (1, 2, 3, 1001) order by id", "pk_dv_parquet_v1", "jni")
set catalog default_catalog;
drop catalog paimon_dv_${uuid0};

