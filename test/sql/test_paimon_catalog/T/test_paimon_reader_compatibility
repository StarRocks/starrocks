-- name: test_paimon_compatibility_json
create external catalog paimon_boundaries_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set time_zone = 'UTC';
set enable_count_star_optimization = false;
set paimon_reader_mode = 'auto';
[ORDER]select id,v from paimon_boundaries_${uuid0}.paimon_test.reader_json_v1 order by id;
function: assert_paimon_readers("select id,v from paimon_boundaries_${uuid0}.paimon_test.reader_json_v1 order by id", "reader_json_v1", "jni", "FILE_FORMAT")
set paimon_reader_mode = 'native';
function: assert_query_error_contains("select id,v from paimon_boundaries_${uuid0}.paimon_test.reader_json_v1 order by id", "FILE_FORMAT")
set paimon_reader_mode = 'jni';
[ORDER]select id,v from paimon_boundaries_${uuid0}.paimon_test.reader_json_v1 order by id;
function: assert_paimon_readers("select id,v from paimon_boundaries_${uuid0}.paimon_test.reader_json_v1 order by id", "reader_json_v1", "jni", "EXPLICIT_MODE")
set catalog default_catalog;
drop catalog paimon_boundaries_${uuid0};

