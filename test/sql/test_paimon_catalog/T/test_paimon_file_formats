-- name: test_paimon_file_formats
create external catalog paimon_static_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"enable_get_stats_from_external_metadata" = "true",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'auto';
[ORDER]select id, amount, flag from paimon_static_${uuid0}.paimon_test.append_parquet_v1 order by id;
select count(*), count(amount), sum(amount), min(amount), max(amount) from paimon_static_${uuid0}.paimon_test.append_parquet_v1;
select id from paimon_static_${uuid0}.paimon_test.append_parquet_v1 where amount is null;
[ORDER]select id from paimon_static_${uuid0}.paimon_test.append_parquet_v1 where amount >= 30 order by id;
function: assert_paimon_reader("select id, amount, flag from paimon_static_${uuid0}.paimon_test.append_parquet_v1 order by id", "append_parquet_v1", "starrocks")
