-- name: test_paimon_catalog_ddl_lifecycle
function: create_paimon_ddl_catalog("paimon_ddl_${uuid0}", "${uuid0}")
create database paimon_ddl_${uuid0}.ddl_db;
create database if not exists paimon_ddl_${uuid0}.ddl_db;
function: assert_query_error_contains("create database paimon_ddl_${uuid0}.ddl_db", "database exists")
create table paimon_ddl_${uuid0}.ddl_db.append_demo (id bigint not null, payload varchar(17) default null comment 'payload comment', dt date) comment 'append schema' partition by (dt) properties ('bucket'='-1', 'file.format'='parquet');
create table if not exists paimon_ddl_${uuid0}.ddl_db.append_demo (ignored int);
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.append_demo (ignored int)", "already exists")
set paimon_reader_mode = 'jni';
select count(*) from paimon_ddl_${uuid0}.ddl_db.append_demo;
-- A separate Catalog loads the persisted schema instead of reusing the writer's metadata.
function: create_paimon_ddl_catalog("paimon_ddl_reader_${uuid0}", "${uuid0}")
select get_json_string(fields, '$[0].name'), get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].type'), get_json_string(fields, '$[1].description'), get_json_string(fields, '$[2].type'), partition_keys, primary_keys, get_json_string(options, '$.bucket'), comment from paimon_ddl_reader_${uuid0}.ddl_db.`append_demo$schemas`;
function: assert_query_error_contains("drop database paimon_ddl_${uuid0}.ddl_db", "nonempty")
function: assert_query_error_contains("drop database paimon_ddl_${uuid0}.ddl_db force", "nonempty")
select count(*) from paimon_ddl_${uuid0}.ddl_db.append_demo;
drop table paimon_ddl_${uuid0}.ddl_db.append_demo;
drop table if exists paimon_ddl_${uuid0}.ddl_db.append_demo;
create table paimon_ddl_${uuid0}.ddl_db.append_demo (replacement int);
select get_json_string(fields, '$[0].name'), get_json_string(fields, '$[0].type'), json_length(fields) from paimon_ddl_${uuid0}.ddl_db.`append_demo$schemas`;
drop table paimon_ddl_${uuid0}.ddl_db.append_demo;
drop database paimon_ddl_${uuid0}.ddl_db;
drop database if exists paimon_ddl_${uuid0}.ddl_db;
CLEANUP {
  set catalog default_catalog;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.append_demo;
  drop database if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db;
  drop catalog if exists paimon_ddl_reader_${paimon_ddl_warehouse_id};
  drop catalog if exists paimon_ddl_${paimon_ddl_warehouse_id};
} END CLEANUP

-- name: test_paimon_catalog_ddl_primary_keys
function: create_paimon_ddl_catalog("paimon_ddl_${uuid0}", "${uuid0}")
create database paimon_ddl_${uuid0}.ddl_db;
-- The keys need not lead the schema; omitted nullability is inferred as NOT NULL.
create table paimon_ddl_${uuid0}.ddl_db.pk_sql (payload varchar(17), Id bigint, dt date) primary key (Id, dt) partition by (DT) properties ('bucket'='4', 'bucket-key'='Id');
create table paimon_ddl_${uuid0}.ddl_db.pk_property (payload int, Id bigint) properties ('primary-key'='ID', 'bucket'='2');
create table paimon_ddl_${uuid0}.ddl_db.pk_explicit (Id bigint not null) primary key (Id);
create table paimon_ddl_${uuid0}.ddl_db.pk_property_composite (payload int, Id bigint, dt date) partition by (dt) properties ('primary-key'=' ID, dt ', 'bucket'='2', 'bucket-key'='Id');
create table paimon_ddl_${uuid0}.ddl_db.pk_both (payload int, Id bigint, dt date) primary key (Id, dt) properties ('primary-key'='ID,DT');
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_key (Id bigint, dt date) primary key(Id, dt) properties ('primary-key'='dt,Id')", "same columns in order")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_key (Id bigint, dt date) primary key(Id) properties ('primary-key'='dt')", "same columns in order")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_key (Id bigint) properties ('primary-key'='missing')", "does not exist")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_key (Id bigint) properties ('primary-key'='Id,ID')", "Duplicate")
-- Explicit NULL must still be rejected for both primary-key spellings.
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_sql (id bigint null) primary key(id)", "cannot be nullable")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_property (id bigint null) properties ('primary-key'='id')", "cannot be nullable")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_default_sql (id bigint default null) primary key(id)", "Invalid default value")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_default_property (id bigint default null) properties ('primary-key'='id')", "Invalid default value")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_default (id int default '1')", "Paimon only supports DEFAULT NULL")
-- Failed analysis must not leave partial native tables behind.
[ORDER]show tables from paimon_ddl_${uuid0}.ddl_db;
function: create_paimon_ddl_catalog("paimon_ddl_reader_${uuid0}", "${uuid0}")
set paimon_reader_mode = 'jni';
-- DESC currently uses the nullable read conversion; $schemas exposes the native constraints.
select get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].type'), get_json_string(fields, '$[2].type'), primary_keys, partition_keys from paimon_ddl_reader_${uuid0}.ddl_db.`pk_sql$schemas`;
select get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].type'), primary_keys from paimon_ddl_reader_${uuid0}.ddl_db.`pk_property$schemas`;
select get_json_string(fields, '$[0].type'), primary_keys from paimon_ddl_reader_${uuid0}.ddl_db.`pk_explicit$schemas`;
select get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].name'), get_json_string(fields, '$[1].type'), get_json_string(fields, '$[2].name'), get_json_string(fields, '$[2].type'), primary_keys, partition_keys from paimon_ddl_reader_${uuid0}.ddl_db.`pk_property_composite$schemas`;
select get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].type'), get_json_string(fields, '$[2].type'), primary_keys from paimon_ddl_reader_${uuid0}.ddl_db.`pk_both$schemas`;
[ORDER]show tables from paimon_ddl_reader_${uuid0}.ddl_db;
CLEANUP {
  set catalog default_catalog;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_sql;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_property;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_default_sql;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_default_property;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_default;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.pk_sql;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.pk_property;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.pk_explicit;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.pk_property_composite;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.pk_both;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_key;
  drop database if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db;
  drop catalog if exists paimon_ddl_reader_${paimon_ddl_warehouse_id};
  drop catalog if exists paimon_ddl_${paimon_ddl_warehouse_id};
} END CLEANUP

-- name: test_paimon_catalog_ddl_types_and_rejections
function: create_paimon_ddl_catalog("paimon_ddl_${uuid0}", "${uuid0}")
create database paimon_ddl_${uuid0}.ddl_db;
create table paimon_ddl_${uuid0}.ddl_db.type_demo (amount decimal(20, 6), event_time datetime, numbers array<int>, attributes map<varchar(12), decimal(10, 2)>, detail struct<code int, labels array<varchar(9)>>) properties ('file.format'='parquet');
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (dt date) partition by days(dt)", "partition expressions")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('unknown-option'='value')", "Unknown Paimon table property")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('bucket'='not-an-integer')", "Invalid value")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('bucket'='0')", "bucket")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('write-only'='not-a-boolean')", "Invalid value")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('snapshot.time-retained'='not-a-duration')", "Invalid value")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int) properties ('path'='hidden')", "schema override")
function: assert_query_error_contains("create table paimon_ddl_${uuid0}.ddl_db.bad_definition (id int, v int) primary key(id) properties ('merge-engine'='aggregation', 'fields.v.aggregate-function'='sum')", "Unknown Paimon table property")
function: create_paimon_ddl_catalog("paimon_ddl_reader_${uuid0}", "${uuid0}")
set paimon_reader_mode = 'jni';
select get_json_string(fields, '$[0].type'), get_json_string(fields, '$[1].type') from paimon_ddl_reader_${uuid0}.ddl_db.`type_demo$schemas`;
select get_json_string(fields, '$[2].type.type'), get_json_string(fields, '$[2].type.element'), get_json_string(fields, '$[3].type.type'), get_json_string(fields, '$[3].type.key'), get_json_string(fields, '$[3].type.value') from paimon_ddl_reader_${uuid0}.ddl_db.`type_demo$schemas`;
select get_json_string(fields, '$[4].type.type'), get_json_string(fields, '$[4].type.fields[0].name'), get_json_string(fields, '$[4].type.fields[0].type'), get_json_string(fields, '$[4].type.fields[1].name'), get_json_string(fields, '$[4].type.fields[1].type.type'), get_json_string(fields, '$[4].type.fields[1].type.element') from paimon_ddl_reader_${uuid0}.ddl_db.`type_demo$schemas`;
-- The independent catalog must see only the successfully created table.
[ORDER]show tables from paimon_ddl_reader_${uuid0}.ddl_db;
CLEANUP {
  set catalog default_catalog;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.bad_definition;
  drop table if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db.type_demo;
  drop database if exists paimon_ddl_${paimon_ddl_warehouse_id}.ddl_db;
  drop catalog if exists paimon_ddl_reader_${paimon_ddl_warehouse_id};
  drop catalog if exists paimon_ddl_${paimon_ddl_warehouse_id};
} END CLEANUP
