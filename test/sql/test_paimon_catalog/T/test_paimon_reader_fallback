-- name: test_paimon_reader_fallback
create external catalog paimon_static_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"enable_get_stats_from_external_metadata" = "true",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'auto';
function: assert_paimon_reader("select image from paimon_static_${uuid0}.paimon_test.image_blob", "image_blob", "native")
function: assert_paimon_native_profile("select image from paimon_static_${uuid0}.paimon_test.image_blob")
function: assert_paimon_reader("select v from paimon_static_${uuid0}.paimon_test.variant_basic", "variant_basic", "starrocks")
set paimon_reader_mode = 'jni';
function: assert_query_error_contains("select image from paimon_static_${uuid0}.paimon_test.image_blob", "Unsupported type: BLOB")
function: assert_query_error_contains("select v from paimon_static_${uuid0}.paimon_test.variant_basic", "Reading VARIANT through the Paimon JNI reader is not yet supported")
[ORDER]select id from paimon_static_${uuid0}.paimon_test.image_blob order by id;
[ORDER]select id from paimon_static_${uuid0}.paimon_test.variant_basic order by id;
set catalog default_catalog;
drop catalog paimon_static_${uuid0};
