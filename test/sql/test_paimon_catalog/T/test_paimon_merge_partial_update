-- name: test_paimon_merge_partial_update_parquet
create external catalog paimon_matrix_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
set paimon_reader_mode = 'auto';
[ORDER]select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id;
[ORDER]select score, id from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id;
[ORDER]select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 where amount >= 10 order by id;
[ORDER]select id from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 where amount is null order by id;
select count(*), count(amount), sum(amount) from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1;
function: assert_paimon_reader("select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id", "pk_partial_update_parquet_v1", "native")
function: assert_paimon_native_profile("select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id")
set paimon_reader_mode = 'native';
[ORDER]select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id;
function: assert_paimon_reader("select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id", "pk_partial_update_parquet_v1", "native")
function: assert_paimon_native_profile("select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id")
set paimon_reader_mode = 'jni';
[ORDER]select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id;
function: assert_paimon_reader("select id, amount, score from paimon_matrix_${uuid0}.paimon_test.pk_partial_update_parquet_v1 order by id", "pk_partial_update_parquet_v1", "jni")
set catalog default_catalog;
drop catalog paimon_matrix_${uuid0};

