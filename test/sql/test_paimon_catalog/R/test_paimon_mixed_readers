-- name: test_paimon_mixed_readers
create external catalog paimon_boundaries_${uuid0}
properties (
"type" = "paimon",
"paimon.catalog.type" = "filesystem",
"paimon.catalog.warehouse" = "oss://${oss_bucket}/ci_catalog_test_data/paimon/",
"aws.s3.access_key" = "${oss_ak}",
"aws.s3.secret_key" = "${oss_sk}",
"aws.s3.endpoint" = "${oss_endpoint}"
);
-- result:
-- !result
set time_zone = 'UTC';
-- result:
-- !result
set enable_count_star_optimization = false;
-- result:
-- !result
set paimon_reader_mode = 'auto';
-- result:
-- !result
[ORDER]select id,v,p from paimon_boundaries_${uuid0}.paimon_test.reader_mixed_partitions_v1 order by id;
-- result:
1	10	east
2	20	west
