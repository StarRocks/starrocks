function: assert_paimon_readers("select id,v,p from paimon_boundaries_${uuid0}.paimon_test.reader_mixed_partitions_v1 order by id", "reader_mixed_partitions_v1", "starrocks,native", "RAW_FILES,NATIVE_SUPPORTED")
