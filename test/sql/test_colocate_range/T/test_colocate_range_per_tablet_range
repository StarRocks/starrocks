-- name: test_colocate_range_per_tablet_range @cloud @sequential
-- A table or partition created in a range colocate group that already has several ColocateRanges gets one tablet
-- per ColocateRange, and each tablet must carry its own key range. Splitting a tablet other than the first must keep
-- every row reachable, and deletes routed to such a tablet of a primary key table must take effect.
set enable_range_distribution = true;
set enable_tablet_pre_split = false;

create database db_${uuid0};
use db_${uuid0};

create table t_seed (k1 bigint not null, v bigint)
    duplicate key(k1) order by (k1)
    properties('replication_num' = '1', 'colocate_with' = 'grp_snp_${uuid0}:k1');
insert into t_seed select x, x from table(generate_series(1, 40000)) as g(x);
-- Gives the group several ColocateRanges.
function: set_first_tablet_id("t_seed")
alter table t_seed split tablet (${tablet_id}) properties ('tablet_reshard_target_size' = '-4');
function: wait_reshard_job_finish("t_seed", "SPLIT_TABLET", 1)

-- A table created in the group now gets one tablet per ColocateRange; split its third tablet.
create table t (k1 bigint not null, v bigint)
    duplicate key(k1) order by (k1)
    properties('replication_num' = '1', 'colocate_with' = 'grp_snp_${uuid0}:k1');
insert into t select x, x from table(generate_series(1, 40000)) as g(x);
-- Splits in a range colocate group are refused until the group is aligned again after the split above.
shell: s=false; for i in $(seq 1 50); do s=$(${mysql_cmd} -Ne "show proc '/colocation_group'" 2>/dev/null | grep "grp_snp_${uuid0}" | awk '{print $NF}'); [ "$s" = "true" ] && break; sleep 2; done; echo "stable=$s"
[UC]tid=SELECT b.TABLET_ID FROM information_schema.be_tablets b, information_schema.tables_config c WHERE b.TABLE_ID = c.TABLE_ID AND c.TABLE_SCHEMA = 'db_${uuid0}' AND c.TABLE_NAME = 't' ORDER BY b.TABLET_ID LIMIT 1 OFFSET 2;
alter table t split tablet (${tid}) properties ('tablet_reshard_target_size' = '-4');
function: wait_reshard_job_finish("t", "SPLIT_TABLET", 1)

select count(*) from t;
select count(*) from t where k1 = 25000;
select count(*) from t a join t b on a.k1 = b.k1;

create table pk_seed (k1 bigint not null, v bigint) primary key(k1) order by (k1)
    properties('replication_num' = '1', 'colocate_with' = 'grp_pk_${uuid0}:k1');
insert into pk_seed select x, x from table(generate_series(1, 40000)) as g(x);
function: set_first_tablet_id("pk_seed")
alter table pk_seed split tablet (${tablet_id}) properties ('tablet_reshard_target_size' = '-4');
function: wait_reshard_job_finish("pk_seed", "SPLIT_TABLET", 1)

-- Deletes of keys that are routed to tablets other than the first.
create table pk (k1 bigint not null, v bigint) primary key(k1) order by (k1)
    properties('replication_num' = '1', 'colocate_with' = 'grp_pk_${uuid0}:k1');
insert into pk select x, x from table(generate_series(1, 40000)) as g(x);
delete from pk where k1 in (5, 25000, 39000);
select count(*) from pk;
select k1 from pk where k1 in (5, 25000, 39000) order by k1;

drop table pk;
drop table pk_seed;
drop table t;
drop table t_seed;
drop database db_${uuid0};
