CREATE TABLE `lm_dict` (
  `k1` bigint NULL,
  `v1` varchar(255) NULL,
  `v2` varchar(255) NULL,
  `v3` varchar(255) NULL,
  `v9` varchar(255) NULL
) ENGINE=OLAP
DUPLICATE KEY(`k1`)
DISTRIBUTED BY HASH(`k1`) BUCKETS 1
PROPERTIES ("replication_num" = "1");
