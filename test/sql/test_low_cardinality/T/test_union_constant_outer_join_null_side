-- name: test_union_constant_outer_join_null_side
-- A column set to a string constant below an outer join is NULL above it on unmatched rows, so a UNION branch must
-- take it from the join instead of the dictionary code of the constant (RB-1423).
create table t_city (id int not null, c_city varchar(20) null) duplicate key(id) distributed by hash(id) buckets 1 properties ("replication_num" = "1");
insert into t_city values (1, 'bj'), (2, 'sh'), (3, 'sz'), (4, 'gz'), (5, 'bj'), (6, 'sh'), (7, NULL), (8, 'hz');
[UC] analyze full table t_city;
function: wait_global_dict_ready('c_city', 't_city')
select x, count(*) from (select c_city from t_city union all select a.x from (select distinct 'sz' as x) a right join t_city tr on tr.c_city = 'no-such-city') u(x) group by x order by x;
select x, count(*) from (select a.x from (select distinct 'sz' as x) a right join t_city tr on tr.c_city = 'no-such-city') u(x) group by x order by x;
select x, count(*) from (select c_city from t_city union all select a.x from t_city tr left join (select distinct 'sz' as x) a on tr.c_city = 'no-such-city') u(x) group by x order by x;
