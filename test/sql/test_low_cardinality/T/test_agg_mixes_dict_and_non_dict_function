-- name: test_agg_mixes_dict_and_non_dict_function
admin set frontend config ("dict_thrash_guard_threshold" = "1000000");

set cbo_enable_low_cardinality_optimize = true;
set low_cardinality_optimize_v2 = true;

CREATE TABLE `agg_mixed_dict_t` (
  `s` varchar(65533) NULL,
  `g` int NULL
) ENGINE=OLAP
DUPLICATE KEY(`s`)
DISTRIBUTED BY HASH(`s`) BUCKETS 1
PROPERTIES (
"replication_num" = "1"
);

insert into agg_mixed_dict_t
select concat('V', generate_series % 3), cast(generate_series % 2 as int)
from TABLE(generate_series(0, 299));

[UC] analyze full table agg_mixed_dict_t;

function: wait_global_dict_ready('s', 'agg_mixed_dict_t')

-- `group_concat` is not a dictionary-capable aggregate, so it forces `s` to be decoded for the
-- whole aggregate. `min`/`max` on the SAME column are dictionary-capable and were accepted before
-- that decode was known, so they stayed registered as producing a dictionary value while their
-- input had been materialised as strings. The plan then carried `min` typed INT under a VARCHAR
-- column ref and the plan validator rejected the query with
--     Invalid agg function plan: min with ...
-- or, depending on which validator ran first,
--     Invalid plan: Type check failed. the type of arg N: min ... is defined as VARCHAR,
--     but the actual type is INT
-- A predicate on the column is needed: without one the aggregate is not reached in that shape.
-- `group_concat` is wrapped in `length` only so the expected result stays short: its own output
-- concatenates the whole group in no defined order.
[ORDER]
select g, min(s), length(group_concat(s, ' ')) from agg_mixed_dict_t where s is null or s != 'V0' group by g order by g;

[ORDER]
select g, max(s), length(group_concat(s, ' ')) from agg_mixed_dict_t where s is null or s != 'V0' group by g order by g;

[ORDER]
select g, count(*), count(s), min(s), max(s), length(group_concat(s, ' '))
from agg_mixed_dict_t where s is null or s != 'V0' group by g order by g;

-- a dictionary-capable aggregate on its own must keep working
[ORDER]
select g, min(s), max(s) from agg_mixed_dict_t where s is null or s != 'V0' group by g order by g;
