-- name: test_dict_decode_group_by_key_range
CREATE DATABASE db_${uuid0};
USE db_${uuid0};
CREATE TABLE t (s STRING, name STRING) PROPERTIES ("replication_num" = "1");
INSERT INTO t VALUES ('1001', 'a'), ('1002', 'b'), ('1003', 'c');

[UC] ANALYZE FULL TABLE t;
function: wait_global_dict_ready('s', 't')
function: wait_global_dict_ready('name', 't')

-- An integer expression over a dict column is evaluated through the dict (DictDecode), so its
-- group-by key holds the expression's own values rather than dict codes.
function: assert_explain_verbose_contains('SELECT CAST(s AS INT), name FROM t GROUP BY 1, 2', 'DictDecode')
function: assert_explain_verbose_contains('SELECT CASE WHEN name = \'a\' THEN 1001 WHEN name = \'b\' THEN 1002 ELSE 1003 END, name FROM t GROUP BY 1, 2', 'DictDecode')

[ORDER]SELECT CAST(s AS INT), name FROM t GROUP BY 1, 2 ORDER BY 1, 2;

[ORDER]SELECT CASE WHEN name = 'a' THEN 1001 WHEN name = 'b' THEN 1002 ELSE 1003 END, name FROM t GROUP BY 1, 2 ORDER BY 1, 2;

DROP DATABASE db_${uuid0};
