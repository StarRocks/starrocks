-- name: test_zstd_compression_page_size
CREATE DATABASE test_zstd_page_${uuid0};
USE test_zstd_page_${uuid0};

CREATE TABLE t_page (
  k BIGINT NOT NULL,
  v STRING,
  w STRING,
  j JSON
) ENGINE=OLAP
DUPLICATE KEY(k)
DISTRIBUTED BY HASH(k) BUCKETS 1
PROPERTIES ("replication_num" = "1", "zstd_compression_columns" = "v:1m, w:256k, j");

function: assert_query_contains("show create table t_page", "\"zstd_compression_columns\" = \"j, v:1048576, w:262144\"")

insert into t_page values
  (1, repeat('shared scaffolding that repeats across rows ', 200), 'small one', parse_json('{"a":1}')),
  (2, repeat('shared scaffolding that repeats across rows ', 210), 'small two', parse_json('{"a":2}')),
  (3, repeat('shared scaffolding that repeats across rows ', 220), 'small three', parse_json('{"a":3}'));

select count(*) from t_page;
select length(v), w, get_json_string(j, 'a') from t_page order by k;

ALTER TABLE t_page SET ("zstd_compression_columns" = "v:256k, w");
function: wait_alter_table_finish()
function: assert_query_contains("show create table t_page", "\"zstd_compression_columns\" = \"v:262144, w\"")

select count(*) from t_page;
select length(v), w from t_page order by k;

ALTER TABLE t_page DROP COLUMN v;
function: wait_alter_table_finish()
function: assert_query_contains("show create table t_page", "\"zstd_compression_columns\" = \"w\"")

DROP DATABASE test_zstd_page_${uuid0};
