-- name: test_division_monotonicity
CREATE TABLE division_monotonicity_${uuid0} (
    id INT,
    c BIGINT
)
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
