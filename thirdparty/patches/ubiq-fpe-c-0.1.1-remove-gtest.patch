+
+# Install rules: ubiq-fpe-c upstream ships no install() targets, which makes
+# `make install` fail. Install the static library and public headers into the
+# thirdparty prefix so the StarRocks BE can link against them.
+install(TARGETS ubiqfpe-static ARCHIVE DESTINATION lib)
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/ubiq DESTINATION include)
