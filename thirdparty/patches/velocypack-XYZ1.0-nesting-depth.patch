+  // Reject documents nested past options->maxNestingDepth here, on the single path every array/object
+  // entry passes through. Without this the parser recurses until the thread stack overflows and the
+  // process dies from a signal it cannot even report. The error is reported through fail() like every
+  // other input error, so tryParse() returns false and parse() throws. 0 disables the check.
+  inline bool increaseNesting() {
+    if (options->maxNestingDepth != 0 &&
+        static_cast<unsigned int>(++_nesting) > options->maxNestingDepth) {
+      return fail(Exception::ParseError, "JSON nesting depth exceeds maximum");
+    }
+    return true;
+  }
 
   inline void decreaseNesting() { --_nesting; }
 
