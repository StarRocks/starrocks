--- velocypack-XYZ1.0.orig/include/velocypack/Options.h	2022-10-27 18:22:53.000000000 +0000
+++ velocypack-XYZ1.0/include/velocypack/Options.h	2026-09-18 00:00:00.000000000 +0000
@@ -149,6 +149,11 @@
   // write tags to JSON output
   bool debugTags = false;
 
+  // Maximum object/array nesting depth accepted by the Parser. The parser recurses once per level,
+  // so without a cap a deeply nested document overflows the thread stack and crashes the process.
+  // 0 means unlimited (the pre-cap behaviour). The host (StarRocks) overrides this via its own config.
+  unsigned int maxNestingDepth = 1024;
+
   // default options with the above settings
   static Options Defaults;
 };
--- velocypack-XYZ1.0.orig/include/velocypack/Parser.h	2022-10-27 18:22:53.000000000 +0000
+++ velocypack-XYZ1.0/include/velocypack/Parser.h	2026-09-18 00:00:00.000000000 +0000
@@ -304,7 +304,16 @@
     return i;
   }
 
-  inline void increaseNesting() { ++_nesting; }
+  // Reject documents nested past options->maxNestingDepth here, on the single path every array/object
+  // entry passes through. Without this the parser recurses until the thread stack overflows and the
+  // process dies from a signal it cannot even report. A ParseError is what tryParse() already turns
+  // into an error code, so over-deep input fails like any other malformed JSON. 0 disables the check.
+  inline void increaseNesting() {
+    if (options->maxNestingDepth != 0 &&
+        static_cast<unsigned int>(++_nesting) > options->maxNestingDepth) {
+      throw Exception(Exception::ParseError, "JSON nesting depth exceeds maximum");
+    }
+  }
 
   inline void decreaseNesting() { --_nesting; }
 
