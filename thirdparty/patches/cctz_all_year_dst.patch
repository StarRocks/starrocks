Backport year-round DST handling to CCTZ 2.3.

Upstream: https://github.com/google/cctz/commit/e15249377c813e77338d4ddb31411d6716c8bdd0
Follow-up: https://github.com/google/cctz/commit/e0494c62ee26caae7afa886b7de8750f08be14d5

CCTZ 2.3 has a void ExtendTransitions() and does not synthesize transition
types. Adapt the upstream check to validate the final type directly, and
return failure to Load() for a mismatched year-round DST footer. Preserve
existing sentinel generation and all historical transitions.

diff --git a/src/time_zone_info.cc b/src/time_zone_info.cc
--- a/src/time_zone_info.cc
+++ b/src/time_zone_info.cc
@@ -106,6 +106,21 @@
   const auto s64maxU = static_cast<std::uint_fast64_t>(s64max);
   if (v <= s64maxU) return static_cast<std::int_fast64_t>(v);
   return static_cast<std::int_fast64_t>(v - s64maxU - 1) - s64max - 1;
+}
+
+// Does the rule for future transitions call for year-round daylight time?
+// See tz/zic.c:stringzone() for the details on how such rules are encoded.
+bool AllYearDST(const PosixTimeZone& posix) {
+  if (posix.dst_start.date.fmt != PosixTransition::N) return false;
+  if (posix.dst_start.date.n.day != 0) return false;
+  if (posix.dst_start.time.offset != 0) return false;
+
+  if (posix.dst_end.date.fmt != PosixTransition::J) return false;
+  if (posix.dst_end.date.j.day != kDaysPerYear[0]) return false;
+  const auto offset = posix.std_offset - posix.dst_offset;
+  if (posix.dst_end.time.offset + offset != kSecsPerDay) return false;
+
+  return true;
 }

 // Generate a year-relative offset for a PosixTransition.
@@ -286,7 +301,7 @@

 // Use the POSIX-TZ-environment-variable-style string to handle times
 // in years after the last transition stored in the zoneinfo data.
-void TimeZoneInfo::ExtendTransitions(const std::string& name,
+bool TimeZoneInfo::ExtendTransitions(const std::string& name,
                                      const Header& hdr) {
   extended_ = false;
   bool extending = !future_spec_.empty();
@@ -305,6 +320,17 @@
     const TransitionType& tt(transition_types_[index]);
     CheckTransition(name, tt, posix.std_offset, false, posix.std_abbr);
     extending = false;
+  }
+
+  // Check dst_abbr before inspecting the start/end rules: standard-only
+  // specifications leave those fields uninitialized (upstream #229).
+  if (extending && !posix.dst_abbr.empty() && AllYearDST(posix)) {
+    const TransitionType& tt(transition_types_[transitions_.back().type_index]);
+    if (tt.utc_offset != posix.dst_offset || !tt.is_dst ||
+        &abbreviations_[tt.abbr_index] != posix.dst_abbr) {
+      return false;
+    }
+    extending = false;  // The final DST transition remains in effect.
   }

   if (extending && hdr.timecnt < 2) {
@@ -324,7 +350,7 @@
       tr.unix_time = 2147483647;  // 2038-01-19T03:14:07+00:00
       tr.type_index = type_index;
     }
-    return;  // last transition wins
+    return true;  // last transition wins
   }

   // Extend the transitions for an additional 400 years using the
@@ -386,6 +412,7 @@
     tr++->type_index = tr0->type_index;
   }
   assert(tr == &transitions_[0] + transitions_.size());
+  return true;
 }

