+void Socket::WriteRequest::start_timing(Socket* s) {
+    setup_size = 0;
+    first_byte_written = false;
+    if (!FLAGS_socket_write_timing) {
+        enqueue_us = 0;
+        return;
+    }
+    enqueue_us = butil::cpuwide_time_us();
+    const int64_t bytes_ahead =
+        s->_unwritten_bytes.load(butil::memory_order_relaxed);
+    SocketWriteTimingVars* vars = GetWriteTimingVars(s);
+    vars->bytes_ahead << bytes_ahead;
+    vars->bytes_ahead_max << bytes_ahead;
+}
+
+void Socket::WriteRequest::check_first_byte_written(Socket* s) {
+    if (enqueue_us == 0 || first_byte_written || data.size() >= setup_size) {
+        return;
+    }
+    first_byte_written = true;
+    GetWriteTimingVars(s)->first_byte << (butil::cpuwide_time_us() - enqueue_us);
+}
+
+void Socket::WriteRequest::on_all_bytes_written(Socket* s) {
+    if (enqueue_us == 0 || setup_size == 0) {
+        return;
+    }
+    const int64_t latency_us = butil::cpuwide_time_us() - enqueue_us;
+    SocketWriteTimingVars* vars = GetWriteTimingVars(s);
+    if (!first_byte_written) {
+        vars->first_byte << latency_us;
+    }
+    vars->last_byte << latency_us;
+}
